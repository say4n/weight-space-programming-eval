# Downloaded model weights (GBs). The reference repo is a git submodule (see
# .gitmodules), pinned by commit, so it is not vendored here.
models/

# Sandbox scratch: each run copies the network it is allowed to read in here.
results/**/work/

# Trained/evaluated model checkpoints (GBs per checkpoint). Regenerated by the
# experiment; only the scores and small JSON records belong in git.
results/**/models/
results/**/_smoke/
*.safetensors

# Raw per-turn model event streams (~3 MB per run). The small derived audit
# (tool_free / tool_calls) is kept in scores.json; rerun to regenerate these.
results/**/events.jsonl

.venv/
.venv-kinetix/
__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/
.pi/

# Prompts are byte-copies of the pinned submodule inputs; the run records which
# case and network id it used, so these are redundant in git.
results/**/prompt.txt
