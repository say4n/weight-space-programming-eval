{"t": 1793688195.334304, "s": 0.48, "code": "import numpy as np\nnp.set_printoptions(precision=4, suppress=True, linewidth=200)\n\nfor l in range(4):\n    print(\"LAYER\", l)\n    for name in [\"ln1_w\",\"ln1_b\",\"ln2_w\",\"ln2_b\"]:\n        a=W[f\"{name}.{l}\"]\n        print(name, \"mean\",a.mean(),\"std\",a.std(),\"min\",a.min(),\"max\",a.max(),\"norm\",np.linalg.norm(a))\n    for name in [\"W_q\",\"W_k\",\"W_v\",\"W_o\",\"W_fc\",\"W_proj\"]:\n        a=W[f\"{name}.{l}\"]\n        print(name, a.shape, \"norm\",np.linalg.norm(a), \"std\",a.std(), \"mean\",a.mean(), \"sv\", np.linalg.svd(a,compute_uv=False)[:10])\n    print()\n\n# head-wise QK/OV stats\nfor l in range(4):\n    print(\"=== LAYER\",l,\"heads ===\")\n    for j in range(6):\n        s=slice(j*64,(j+1)*64)\n        Wq=W[f\"W_q.{l}\"][s,:]; Wk=W[f\"W_k.{l}\"][s,:]; Wv=W[f\"W_v.{l}\"][s,:]; Wo=W[f\"W_o.{l}\"][:,s]\n        A=Wq.T@Wk  # d x d\n        # QK matrix eigen/SVD\n        sv=np.linalg.svd(A,compute_uv=False)\n        tr=np.trace(A); fro=np.linalg.norm(A)\n        # symmetry?\n        asym=np.linalg.norm(A-A.T)/fro\n        # OV\n        OV=Wo@Wv\n        svov=np.linalg.svd(OV,compute_uv=False)\n        print(f\"H{l}{j} qn {np.linalg.norm(Wq):.2f} kn {np.linalg.norm(Wk):.2f} vn {np.linalg.norm(Wv):.2f} on {np.linalg.norm(Wo):.2f} | A fro {fro:.2f} tr {tr:.2f} asym {asym:.3f} sv[:5] {sv[:5]} | OV fro {np.linalg.norm(OV):.2f} sv[:5] {svov[:5]}\")\n    print()\n", "out": "LAYER 0\nln1_w mean 0.26770642 std 0.21465456 min 0.01654764 max 1.0134335 norm 6.7240934\nln1_b mean 0.00065349764 std 0.036595043 min -0.12149114 max 0.14177816 norm 0.7172278\nln2_w mean 0.8168376 std 0.33119047 min 0.04681267 max 1.6411812 norm 17.272343\nln2_b mean 0.017958164 std 0.066667244 min -0.55371493 max 0.16627714 norm 1.3529725\nW_q (384, 384) norm 22.703794 std 0.05912429 mean 0.00014389718 sv [5.0385 4.9994 4.7025 4.377  4.3428 4.2944 4.0581 4.0325 3.9503 3.9226]\nW_k (384, 384) norm 23.2143 std 0.060453866 mean -