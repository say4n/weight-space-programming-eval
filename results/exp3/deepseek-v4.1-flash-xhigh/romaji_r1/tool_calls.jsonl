{"n": 1, "code": "import numpy as np\nnp.set_printoptions(precision=4, suppress=True, linewidth=200)\n\nnames=sorted(W.keys())\nprint(\"keys\", len(names))\nfor k in names:\n    print(k, W[k].shape, W[k].dtype)\n\nprint(\"\\nLayerNorm params\")\nfor l in range(4):\n    for nm in [f\"ln1_w.{l}\",f\"ln1_b.{l}\",f\"ln2_w.{l}\",f\"ln2_b.{l}\"]:\n        a=W[nm]\n        print(nm, \"mean\",a.mean(),\"std\",a.std(),\"min\",a.min(),\"max\",a.max(),\"norm\",np.linalg.norm(a))\n\nprint(\"\\nMatrix norms and spectra\")\nfor l in range(4):\n    for nm in [\"W_q\",\"W_k\",\"W_v\",\"W_o\",\"W_fc\",\"W_proj\"]:\n        a=W[f\"{nm}.{l}\"]\n        s=np.linalg.svd(a, compute_uv=False)\n        print(f\"{nm}.{l}\", \"shape\",a.shape, \"fro\",np.linalg.norm(a), \"spec\",s[0], \"s1/s0\",s[1]/s[0] if len(s)>1 else 0, \"effrank\",(s.sum()**2)/(s@s), \"mean\",a.mean(),\"std\",a.std())\n\nprint(\"\\nPer-head row/col norms\")\nfor l in range(4):\n    print(\"LAYER\",l)\n    for j in range(6):\n        s=slice(64*j,64*(j+1))\n        q=W[f\"W_q.{l}\"][s,:]; k=W[f\"W_k.{l}\"][s,:]; v=W[f\"W_v.{l}\"][s,:]; o=W[f\"W_o.{l}\"][:,s]\n        print(j, \"qnorm\",np.linalg.norm(q), \"knorm\",np.linalg.norm(k), \"vnorm\",np.linalg.norm(v), \"onorm\",np.linalg.norm(o),\n              \"qrow\",np.linalg.norm(q,axis=1).mean(), \"krow\",np.linalg.norm(k,axis=1).mean(),\n              \"vrow\",np.linalg.norm(v,axis=1).mean(), \"ocol\",np.linalg.norm(o,axis=0).mean())\n\nprint(\"\\nTop singular values per head Q,K,V,OV\")\nfor l in range(4):\n    print(\"LAYER\",l)\n    for j in range(6):\n        s=slice(64*j,64*(j+1))\n        q=W[f\"W_q.{l}\"][s,:]; k=W[f\"W_k.{l}\"][s,:]; v=W[f\"W_v.{l}\"][s,:]; o=W[f\"W_o.{l}\"][:,s]\n        sq=np.linalg.svd(q,compute_uv=False); sk=np.linalg.svd(k,compute_uv=False)\n        sv=np.linalg.svd(v,compute_uv=False); ov=o@v; so=np.linalg.svd(ov,compute_uv=False)\n        print(j, \"Q\",sq[:3], \"K\",sk[:3], \"V\",sv[:3], \"OV\",so[:3])\n", "out": "keys 40\nW_fc.0 (1536, 3