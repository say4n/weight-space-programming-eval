{"t": 1793685927.231922, "s": 0.2, "code": "import numpy as np\n\n# Basic shapes and norm summary\nnames = list(W.keys())\nprint(\"keys:\", names)\nprint(\"num keys\", len(names))\nfor l in range(4):\n    print(\"\\nLAYER\", l)\n    for nm in ['ln1_w','ln1_b','W_q','W_k','W_v','W_o','ln2_w','ln2_b','W_fc','W_proj']:\n        A=W[f'{nm}.{l}']\n        print(nm, A.shape, 'mean', float(A.mean()), 'std', float(A.std()), 'min',float(A.min()),'max',float(A.max()))\n    # head-wise norms\n    for j in range(6):\n        s=slice(j*64,(j+1)*64)\n        q=W[f'W_q.{l}'][s]\n        k=W[f'W_k.{l}'][s]\n        v=W[f'W_v.{l}'][s]\n        o=W[f'W_o.{l}'][:,s]\n        # QK bilinear and OV\n        QK=q.T@k\n        OV=o@v\n        print(f\"head L{l}H{j} norms q={np.linalg.norm(q):.3f} k={np.linalg.norm(k):.3f} v={np.linalg.norm(v):.3f} o={np.linalg.norm(o):.3f} QK={np.linalg.norm(QK):.3f} OV={np.linalg.norm(OV):.3f} OVrank={np.linalg.matrix_rank(OV, tol=1e-4)}\")\n", "out": "keys: ['ln1_w.0', 'ln1_b.0', 'W_q.0', 'W_k.0', 'W_v.0', 'W_o.0', 'ln2_w.0', 'ln2_b.0', 'W_fc.0', 'W_proj.0', 'ln1_w.1', 'ln1_b.1', 'W_q.1', 'W_k.1', 'W_v.1', 'W_o.1', 'ln2_w.1', 'ln2_b.1', 'W_fc.1', 'W_proj.1', 'ln1_w.2', 'ln1_b.2', 'W_q.2', 'W_k.2', 'W_v.2', 'W_o.2', 'ln2_w.2', 'ln2_b.2', 'W_fc.2', 'W_proj.2', 'ln1_w.3', 'ln1_b.3', 'W_q.3', 'W_k.3', 'W_v.3', 'W_o.3', 'ln2_w.3', 'ln2_b.3', 'W_fc.3', 'W_proj.3']\nnum keys 40\n\nLAYER 0\nln1_w (384,) mean 0.26770642399787903 std 0.2146545648574829 min 0.016547640785574913 max 1.0134334564208984\nln1_b (384,) mean 0.0006534976419061422 std 0.036595042794942856 min -0.12149114161729813 max 0.1417781561613083\nW_q (384, 384) mean 0.00014389718126039952 std 0.05912429094314575 min -0.7540718913078308 max 0.7281814813613892\nW_k (384, 384) mean -6.987292726989836e-05 std 0.0604538656771183 min -0.6490139365196228 max 0.6215847134590149\nW_v (384, 384) mean 2.470862636982929e-05 std 0.04738885164260864 min -0.3947039246559143 max 0.4368957579135895\nW_o (384, 384) 