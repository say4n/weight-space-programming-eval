{"t": 1793685957.433364, "s": 0.2, "code": "import numpy as np\nnp.set_printoptions(precision=3, suppress=True, linewidth=200)\nfor l in range(4):\n    print('LAYER', l)\n    for name in ['ln1_w','ln1_b','ln2_w','ln2_b','W_q','W_k','W_v','W_o','W_fc','W_proj']:\n        a=W[f'{name}.{l}']\n        print(f'{name}: shape={a.shape} mean={a.mean(): .4g} std={a.std(): .4g} norm={np.linalg.norm(a):.4g}')\n    print()\nfor h in range(6):\n    for l in range(4):\n        s=slice(64*h,64*(h+1))\n        q=W[f'W_q.{l}'][s,:]; k=W[f'W_k.{l}'][s,:]; v=W[f'W_v.{l}'][s,:]; o=W[f'W_o.{l}'][:,s]\n        uq,sq,vq=np.linalg.svd(q, full_matrices=False)\n        uk,sk,vk=np.linalg.svd(k, full_matrices=False)\n        uv,sv,vv=np.linalg.svd(v, full_matrices=False)\n        uo,so,vo=np.linalg.svd(o, full_matrices=False)\n        ov = o @ v\n        fro=np.linalg.norm(ov)\n        ident=np.linalg.norm(ov - (np.trace(ov)/384)*np.eye(384))\n        qk = q @ k.T\n        print(f'L{l}H{h}: |q|={np.linalg.norm(q):.2f} |k|={np.linalg.norm(k):.2f} |v|={np.linalg.norm(v):.2f} |o|={np.linalg.norm(o):.2f} '\n              f'sq[:3]={sq[:3]} sk[:3]={sk[:3]} sv[:3]={sv[:3]} so[:3]={so[:3]} |OV|={fro:.2f} idres={ident/np.linalg.norm(ov):.3f}')\n    print()\n", "out": "LAYER 0\nln1_w: shape=(384,) mean= 0.2965 std= 0.1884 norm=6.884\nln1_b: shape=(384,) mean= 0.0003872 std= 0.03113 norm=0.6101\nln2_w: shape=(384,) mean= 0.8718 std= 0.3382 norm=18.32\nln2_b: shape=(384,) mean= 0.0134 std= 0.06913 norm=1.38\nW_q: shape=(384, 384) mean= 5.472e-05 std= 0.04601 norm=17.67\nW_k: shape=(384, 384) mean= 6.684e-06 std= 0.04822 norm=18.52\nW_v: shape=(384, 384) mean= 1.748e-05 std= 0.0389 norm=14.94\nW_o: shape=(384, 384) mean=-0.0001201 std= 0.0431 norm=16.55\nW_fc: shape=(1536, 384) mean= 0.0007535 std= 0.0721 norm=55.38\nW_proj: shape=(384, 1536) mean=-9.917e-07 std= 0.06511 norm=50.01\n\nLAYER 1\nln1_w: shape=(384,) mean= 0.5058 std= 0.08918 norm=10.07\nln1_b: shape=(384,) mean= 0.01103 std= 0.1546 norm=3.03