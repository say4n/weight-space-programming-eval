{"t": 1793685998.628097, "s": 0.33, "code": "import numpy as np\nnp.set_printoptions(precision=3, suppress=True, linewidth=180)\nfor l in range(4):\n    print(\"LAYER\", l)\n    for name in [\"ln1_w\",\"ln1_b\",\"ln2_w\",\"ln2_b\"]:\n        a=W[f\"{name}.{l}\"]\n        print(name, \"mean\", float(a.mean()), \"std\", float(a.std()), \"min\", float(a.min()), \"max\", float(a.max()))\n    for name in [\"W_q\",\"W_k\",\"W_v\",\"W_o\",\"W_fc\",\"W_proj\"]:\n        A=W[f\"{name}.{l}\"]\n        print(name, A.shape, \"mean\", float(A.mean()), \"std\", float(A.std()), \"fro\", float(np.linalg.norm(A)))\n    print()\n# per-head QK and OV norms, singular value summaries\nfor l in range(4):\n    print(\"=== LAYER\", l, \"heads ===\")\n    for h in range(6):\n        s=slice(h*64,(h+1)*64)\n        Wq=W[f\"W_q.{l}\"][s,:]; Wk=W[f\"W_k.{l}\"][s,:]; Wv=W[f\"W_v.{l}\"][s,:]; Wo=W[f\"W_o.{l}\"][:,s]\n        B=Wq.T@Wk / 8.0\n        OV=Wv.T@Wo.T  # check dimensions: Wv.T 384x64 @ Wo.T? Wo 384x64, Wo.T 64x384 => 384x384\n        # actually use W_o rows slice s: Wo_rows=W_o[s,:] (64x384); OV=Wv.T @ Wo_rows\n        OV2=Wv.T@W[f\"W_o.{l}\"][s,:]\n        ev=np.linalg.eigvalsh((B+B.T)/2)\n        evo=np.linalg.eigvalsh((OV2+OV2.T)/2)\n        print(f\"H{h} qn {np.linalg.norm(Wq):.2f} kn {np.linalg.norm(Wk):.2f} vn {np.linalg.norm(Wv):.2f} on {np.linalg.norm(Wo):.2f} \"\n              f\"QK maxeig {ev[-1]:.2f} mineig {ev[0]:.2f} neg {np.sum(ev<0)} \"\n              f\"OV maxeig {evo[-1]:.2f} mineig {evo[0]:.2f} rank {np.linalg.matrix_rank(OV2, tol=1e-6)}\")\n    print()\n", "out": "LAYER 0\nln1_w mean 0.29650038480758667 std 0.18837299942970276 min 0.035216715186834335 max 0.9784557819366455\nln1_b mean 0.0003871750086545944 std 0.031133055686950684 min -0.09542398899793625 max 0.09060516208410263\nln2_w mean 0.8717605471611023 std 0.33815905451774597 min 0.042033784091472626 max 1.774962306022644\nln2_b mean 0.013403773307800293 std 0.06913173198699951 min -0.6236110329627991 max 0.