{"t": 1793707544.6871748, "s": 0.63, "code": "import faulthandler, sys, time, os, glob, traceback\nimport numpy as np\nRUN_TAG = \"run11\"\n_t0 = time.time()\n_logf = open(\"runlog.txt\", \"a\", buffering=1)\ndef log(*a):\n    m = f\"[{time.time()-_t0:7.2f}s] \" + \" \".join(map(str, a))\n    print(m, flush=True); _logf.write(m + \"\\n\")\nlog(\"=== start ===\", RUN_TAG, sys.version.split()[0])\nfaulthandler.enable(sys.stderr); faulthandler.dump_traceback_later(120, exit=True)\nclass Tee:\n    def __init__(self, *fs): self.fs = fs\n    def write(self, x):\n        for f in self.fs: f.write(x); f.flush()\n    def flush(self):\n        for f in self.fs: f.flush()\nsys.stdout = Tee(sys.stdout, open(f\"out_{RUN_TAG}.txt\", \"w\"))\n\nKEYS = [f\"{n}.{l}\" for l in range(4) for n in\n        (\"W_q\",\"W_k\",\"W_v\",\"W_o\",\"W_fc\",\"W_proj\",\"ln1_w\",\"ln1_b\",\"ln2_w\",\"ln2_b\")]\nwith np.load(\"blocks.npz\", allow_pickle=False) as z:\n    T = {k: np.asarray(z[k], np.float32) for k in z.files}\nlog(\"loaded:\", len(T), \"keys\")\nmiss = [k for k in KEYS if k not in T]; extra = [k for k in T if k not in KEYS]\nlog(\"schema:\", \"OK\" if not miss and not extra else f\"DRIFT {miss} {extra}\")\nif miss or extra: raise RuntimeError(\"schema mismatch\")\nfor k, ref in ((\"W_fc.0\",51.650),(\"W_proj.3\",85.089),(\"W_q.2\",37.483),(\"W_k.1\",28.602),(\"ln1_w.0\",6.724)):\n    n = float(np.linalg.norm(T[k]))\n    log(f\"fro[{k}]={n:.3f} ref={ref:.3f}\", \"OK\" if abs(n-ref) < 0.05 else \"MISMATCH\")\n    if abs(n-ref) >= 0.05: raise RuntimeError(\"loader validation failed\")\n\n# ============== ANALYSIS (editable) ==============\nL, H, dh, d = 4, 6, 64, 384\nWQ = [T[f\"W_q.{l}\"] for l in range(L)]; WK = [T[f\"W_k.{l}\"] for l in range(L)]\nWV = [T[f\"W_v.{l}\"] for l in range(L)]; WO = [T[f\"W_o.{l}\"] for l in range(L)]\ndef fro(x): return float(np.linalg.norm(x))\ndef sv4(x): return np.linalg.svd(x, compute_uv=False)[:4]\nnp.set_printoptions(precision=3, suppress=True, linewidth=200)\n\nGOLD_N = {\n \"L0\":[(4.13,4.91,5.35,5.21),(12.46,12.64,9.26,10.20),(6.46,6.83,5.99,5.54),\n       (6.63,6.82,4.88,5.47),(2.17,2.62,8.28,8.94),(15.90,15.96,9.41,10.60)],\n \"L1\":[(10.56,9.83,12.95,11.17),(14.53,12.80,11.06,10.66),(12.69,11.35,12.12,11.19),\n       (12.70,11.75,11.32,10.14),(12.59,11.51,10.92,9.91),(14.14,12.58,11.23,10.92)],\n \"L2\":[(15.22,14.53,13.81,13.64),(14.68,14.47,14.68,14.21),(17.26,16.72,12.99,13.00),\n       (15.01,14.61,14.46,14.25),(15.58,15.20,13.47,13.50),(13.84,13.30,15.55,15.08)],\n \"L3\":[(14.95,14.54,15.59,15.37),(13.43,13.31,15.61,15.27),(14.99,14.47,15.92,16.03),\n       (10.54,10.52,17.86,18.20),(13.65,13.26,16.27,16.26),(15.03,14.81,13.87,14.16)],\n}\nworst = 0.0\nfor l in range(L):\n    for h in range(H):\n        s = slice(h*dh, (h+1)*dh)\n        got = (fro(WQ[l][s, :]), fro(WK[l][s, :]), fro(WV[l][s, :]), fro(WO[l][:, s]))\n        worst = max(worst, max(abs(a-b) for a, b in zip(got, GOLD_N[f\"L{l}\"][h])))\nlog(\"partition regression, worst |d| =\", round(worst, 4))\nif worst > 0.05: raise RuntimeError(\"convention regression failed\")\n\nGM = {\"L0\":[(5.195,3.389,0.846,0.657),(17.223,12.122,11.496,9.727),(4.486,3.573,2.993,2.852),\n            (7.675,5.606,3.45,2.355),(0.319,0.242,0.19,0.144),(14.076,13.759,13.195,12.466)],\n      \"L1\":[(8.928,6.891,6.051,5.755),(19.138,14.766,13.796,11.021),(14.486,12.667,10.219,7.24),\n            (15.986,13.278,10.22,7.207),(14.823,11.74,10.94,7.505),(20.182,16.183,12.284,11.201)],\n      \"L2\":[(7.484,7.099,6.816,6.471),(7.258,6.545,5.975,5.73),(10.83,10.274,9.752,9.397),\n            (8.092,7.027,6.199,6.131),(11.608,9.684,7.179,6.746),(6.303,5.923,5.478,4.701)],\n      \"L3\":[(5.595,5.383,5.21,5.13),(4.398,4.278,4.169,4.085),(6.246,5.499,5.294,4.868),\n            (3.686,3.263,2.903,2.724),(5.722,5.04,4.858,4.363),(5.408,5.262,5.14,5.017)]}\nGO = {\"L0\":[(6.898,3.897,1.936,1.638),(4.703,4.573,4.424,4.248),(4.786,3.621,3.514,2.916),\n            (2.168,1.997,1.875,1.555),(18.815,15.373,5.587,3.989),(5.61,5.503,5.123,4.867)],\n      \"L1\":[(9.927,9.271,8.872,7.793),(6.211,5.658,5.403,5.113),(6.799,6.707,6.454,6.192),\n            (7.119,6.39,5.875,5.68),(6.354,5.996,5.642,5.541),(5.781,5.643,5.336,4.976)],\n      \"L2\":[(5.556,5.132,5.005,4.795),(8.652,6.394,6.333,6.217),(4.742,4.585,4.492,4.275),\n            (6.179,5.765,5.693,5.322),(5.445,5.184,5.128,4.988),(8.467,7.339,6.951,6.407)],\n      \"L3\":[(7.123,6.403,6.09,5.949),(9.373,6.819,6.701,6.663),(11.577,7.787,6.815,6.5),\n            (18.625,12.287,11.952,11.362),(11.774,10.138,8.487,7.578),(13.046,7.099,6.721,6.521)]}\nGA = {\"L0\":[.72,.71,.71,.71,.72,.71], \"L1\":[.74,.73,.73,.73,.72,.73],\n      \"L2\":[.73,.73,.73,.74,.74,.73], \"L3\":[.73,.74,.73,.73,.72,.78]}\n\ndef rankcorr(a, b):\n    a = np.asarray(a, float).ravel(); b = np.asarray(b, float).ravel()\n    ra = np.empty(a.size); ra[np.argsort(a)] = np.arange(a.size)\n    rb = np.empty(b.size); rb[np.argsort(b)] = np.arange(b.size)\n    return float(np.corrcoef(ra, rb)[0, 1])\n\nsvs = {f: [] for f in (\"m64\", \"m384\", \"o384\", \"o64\")}\ndef donor_O(l, h):\n    s = slice(h*dh, (h+1)*dh)\n    O = WO[l][:, s] @ WV[l][s, :]\n    assert O.shape == (d, d)\n    return O\nfor l in range(L):\n    for h in range(H):\n        s = slice(h*dh, (h+1)*dh)\n        q, k, v, o = WQ[l][s, :], WK[l][s, :], WV[l][s, :], WO[l][:, s]\n        assert q.shape == k.shape == v.shape == (dh, d) and o.shape == (d, dh)\n        m64, m384, o384, o64 = q @ k.T, q.T @ k, o @ v, v @ o\n        assert m64.shape == (dh, dh) and m384.shape == (d, d)\n        assert o384.shape == (d, d) and o64.shape == (dh, dh)\n        svs[\"m64\"].append(sv4(m64)); svs[\"m384\"].append(sv4(m384))\n        svs[\"o384\"].append(sv4(o384)); svs[\"o64\"].append(sv4(o64))\nsvs = {f: np.array(x) for f, x in svs.items()}\nGOLD_Mm = np.array([v for l in range(L) for v in GM[f\"L{l}\"]])\nGOLD_Oo = np.array([v for l in range(L) for v in GO[f\"L{l}\"]])\nprint(\"== FINGERPRINT AUDIT (fixed indexing) ==\")\nrows = {\"M64\": (svs[\"m64\"], GOLD_Mm), \"M384\": (svs[\"m384\"], GOLD_Mm),\n        \"O384\": (svs[\"o384\"], GOLD_Oo), \"O64\": (svs[\"o64\"], GOLD_Oo)}\nbest = {}\nfor name, (X, G) in rows.items():\n    err = np.linalg.norm(X - G, axis=1)\n    decades = np.array([rankcorr(x, g) for x, g in zip(X, G)])\n    cs = np.array([(a*b).sum()/(b*b).sum() for a, b in zip(X, G)])\n    best[name] = (err.mean(), decades.mean())\n    log(f\"{name}: err/head={err.mean():.4f} rho_mean={decades.mean():.3f} \"\n        f\"median_scale={np.median(cs):.3f} worst={err.argmax()}\")\nlog(\"fingerprints:\",\n    {\"O384\": \"MATCH\" if best[\"O384\"][0] < 0.05 else \"unresolved\",\n     \"M\": \"M64\" if best[\"M64\"][0] < 0.05 else (\"M384\" if best[\"M384\"][0] < 0.05 else \"unresolved\")})\ngo1 = GOLD_Oo[:, 0]; gm1 = GOLD_Mm[:, 0]\nprint(\"head |  g_sM1   m64_1  m384_1 |  g_sOV1  o384_1   o64_1\")\nfor i, (l, h) in enumerate((l, h) for l in range(L) for h in range(H)):\n    print(f\"L{l}H{h} | {gm1[i]:7.3f} {svs['m64'][i,0]:7.3f} {svs['m384'][i,0]:7.3f}\"\n          f\" | {go1[i]:7.3f} {svs['o384'][i,0]:7.3f} {svs['o64'][i,0]:7.3f}\")\n\nprint(\"== alpha probe (which candidate = run-1 alphaOV?) ==\")\nprint(\"head | gold_a   a1=s1/fro  a2=s1^2/ss  a3=symfrac\")\na_ok, a3v = 0.0, []\nfor i, (l, h) in enumerate((l, h) for l in range(L) for h in range(H)):\n    s = slice(h*dh, (h+1)*dh)\n    O = donor_O(l, h); sv = np.linalg.svd(O, compute_uv=False)\n    a1 = sv[0]/fro(O); a2 = sv[0]**2/(sv**2).sum()\n    a3 = fro((O + O.T)/2)/fro(O); a3v.append(a3)\n    g = GA[f\"L{l}\"][h]; a_ok = max(a_ok, abs(a3 - g))\n    print(f\"L{l}H{h} | {g:6.2f} | {a1:8.3f} {a2:9.3f} {a3:9.3f}\")\nlog(\"alpha verdict: a3 max|d| =\", round(a_ok, 3), \"(sym-fraction hypothesis)\",\n    \"CONFIRMED\" if a_ok < 0.03 else \"not a3\")\n\nprint(\"== fdef composition (x100; rows=donors) ==\")\nMX = {}\nfor l0 in range(L-1):\n    for l1 in range(l0+1, L):\n        for kind, WA in ((\"K\", WK), (\"Q\", WQ), (\"V\", WV)):\n            Mx = np.zeros((H, H))\n            for h0 in range(H):\n                O = donor_O(l0, h0); fo = fro(O)\n                for h1 in range(H):\n                    w = WA[l1][slice(h1*dh, (h1+1)*dh), :]\n                    P = w @ O\n                    Mx[h0, h1] = 100.0 * fro(P) / max(fo * fro(w), 1e-9)\n            MX[(l0, l1, kind)] = Mx\n            print(f\" l0=L{l0} -> l1=L{l1} ({kind}-comp):\"); print(np.round(Mx).astype(int))\nGOLD_CK = {\n (0,1): np.array([[437,626,672,736,694,527],[136,93,96,91,95,97],[131,159,169,191,180,136],\n                  [193,250,274,301,280,206],[429,675,709,762,705,581],[162,153,153,155,160,164]]),\n (0,2): np.array([[256,121,317,359,369,212],[100,124,94,94,97,92],[125,133,122,124,191,136],\n                  [129,100,148,162,166,115],[292,100,363,412,408,256],[125,151,144,120,126,106]]),\n (0,3): np.array([[154,139,172,121,176,115],[99,100,98,99,95,134],[122,120,115,119,122,116],\n                  [100,103,99,97,102,103],[204,145,246,146,246,104],[110,139,109,97,93,157]])}\nGOLD_CQV = {\n (0,1,\"Q\"): np.array([[220,240,215,268,248,232],[173,146,142,132,140,151],[195,136,134,135,139,153],\n                      [137,133,139,157,145,136],[185,216,206,257,227,192],[179,166,165,149,169,177]]),\n (0,1,\"V\"): np.array([[83,69,71,73,67,71],[166,158,144,173,168,149],[156,90,102,90,96,91],\n                      [83,77,76,76,75,77],[51,49,48,51,46,49],[186,252,223,278,252,237]])}\nres = []\nfor key, Mx in MX.items():\n    l0, l1, kind = key\n    if (l0, l1, kind) in GOLD_CQV: g = GOLD_CQV[(l0, l1, kind)]\n    elif kind == \"K\" and (l0, l1) in GOLD_CK: g = GOLD_CK[(l0, l1)]\n    else: g = None\n    if g is not None:\n        r = rankcorr(Mx, g); res.append((key, r)); log(\"TOPO\", key, \"PASS\" if r > 0.6 else \"FAIL\", f\"rho={r:.2f}\")\n    elif Mx.max() / max(Mx.mean(), 1e-9) <= 1.8:\n        res.append((key, 1.0)); log(\"TOPO\", key, \"PASS (flat)\")\n    else:\n        res.append((key, -1.0)); log(\"TOPO\", key, \"FAIL (unexpected structure)\")\n\nprint(\"== fdef per-head OV stats + donor shares (target = next layer) ==\")\nprint(\"head |  nQ   qk_s1   s1_O   fro_O  effrk   tr/d  s2/s1 | Kshare Vshare\")\nfor l in range(L):\n    for h in range(H):\n        s = slice(h*dh, (h+1)*dh)\n        O = donor_O(l, h); sv = np.linalg.svd(O, compute_uv=False)\n        er = float(sv.sum()**2 / (sv**2).sum())\n        q1 = float(sv4(WQ[l][s, :] @ WK[l][s, :].T)[0])\n        if l < 3:\n            km = MX[(l, l+1, \"K\")].mean(1); vm = MX[(l, l+1, \"V\")].mean(1)\n            ks, vs = km[h]/km.mean(), vm[h]/vm.mean()\n        else: ks = vs = float(\"nan\")\n        print(f\"L{l}H{h} | {fro(WQ[l][s,:]):5.2f} {q1:6.2f} {sv[0]:6.2f} {fro(O):6.2f} \"\n              f\"{er:6.2f} {float(np.trace(O))/d:6.3f} {sv[1]/sv[0]:5.2f} | {ks:5.2f} {vs:5.2f}\")\n\nprint(\"== MLP spectra (fdef) ==\")\nprint(\"layer | fro_fc  fro_pr | sv1_fc  sv1_pr | effrk_fc effrk_pr | e8%_fc e8%_pr | corr(sv_fc,sv_pr)\")\nfor l in range(L):\n    F, Pr = T[f\"W_fc.{l}\"], T[f\"W_proj.{l}\"]\n    sf = np.linalg.svd(F, compute_uv=False); sp = np.linalg.svd(Pr, compute_uv=False)\n    rhof = float(np.corrcoef(sf[:64], sp[:64])[0, 1])\n    print(f\"  {l}  | {fro(F):7.3f} {fro(Pr):7.3f} | {sf[0]:6.3f} {sp[0]:6.3f} | \"\n          f\"{float((sf.sum()**2)/(sf**2).sum()):8.1f} {float((sp.sum()**2)/(sp**2).sum()):8.1f} | \"\n          f\"{100*(sf[:8]**2).sum()/(sf**2).sum():5.1f} {100*(sp[:8]**2).sum()/(sp**2).sum():6.1f} | {rhof:6.3f}\")\nlog(\"=== exit ===\")\n", "out": "[   0.00s] === start === run11 3.12.13\n[   0.00s] loaded: 40 keys\n[   0.00s] schema: OK\n[   0.00s] fro[W_fc.0]=51.650 ref=51.650 OK\n[   0.00s] fro[W_proj.3]=85.089 ref=85.089 OK\n[   0.00s] fro[W_q.2]=37.483 ref=37.483 OK\n[   0.01s] fro[W_k.1]=28.602 ref=28.602 OK\n[   0.01s] fro[ln1_w.0]=6.724 ref=6.724 OK\n[   0.01s] partition regression, worst |d| = 0.005\n== FINGERPRINT AUDIT (fixed indexing) ==\n[   0.24