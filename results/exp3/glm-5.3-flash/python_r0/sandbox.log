={W.shape} vs B={B.shape}\"\n    return fro(B.T @ W) / fro(W)\nassert donor_O(0, 4).shape == (d, d)\n_U, _S = sv_us(donor_O(0, 4), 4); assert _U.shape == (d, 4) and _S.shape == (4,)\nlog(\"helper contracts OK\")\nnp.set_printoptions(precision=3, suppress=True, linewidth=200)\nBASE_K_ROW_H4 = np.array([19, 32, 31, 33, 32, 30], float)   # digest(0,1,K) donor-H4 row (x100)\nBASE_K_ROW_H1 = np.array([8, 5, 6, 6, 6, 6], float)         # flat-donor reference row\nBASE_SHARES = {\"r3fc\": 0.165, \"r3pr\": 0.399, \"r0fc\": 0.261}  # run17/run13 verified values\n\ndef comp_row(O4):\n    out = np.zeros(H)\n    for h1 in range(H):\n        s1 = slice(h1*dh, (h1+1)*dh)\n        w = WK[1][s1, :]\n        out[h1] = 100.0 * fro(w @ O4) / (fro(O4) * fro(w))\n    return out\ndef ablate(A, u):\n    return A - np.outer(u, u @ A)\n\ndef sec_traits():\n    O4 = donor_O(0, 4)\n    U, S = sv_us(O4, 6)\n    log(\"O4 sv[:6]:\", np.round(S, 3))\ndef sec_treat():\n    O4 = donor_O(0, 4)\n    u2 = sv_us(O4, 2)[0][:, 1]\n    s4 = slice(4*dh, 5*dh)\n    A = WO[0][:, s4]; B = WV[0][s4, :]\n    A2 = ablate(A, u2)\n    O4b = A2 @ B\n    assert abs(fro(O4 - O4b) - 15.373) < 0.15          # exact rank-1 removal check\n    print(\"== TREATMENT: ablate L0H4 sigma-2 wire ==\")\n    print(\"O4' sv[:6]:\", np.round(sv_us(O4b, 6)[1], 3))\n    print(\"K-comp row (x100): treated:\", np.round(comp_row(O4b), 1),\n          \" baseline(H4):\", BASE_K_ROW_H4, \" flat-ref:\", BASE_K_ROW_H1)\n    for tag, basis in ((\"r0fc\", sv_r(T[\"W_fc.0\"], 4)), (\"r3fc\", sv_r(T[\"W_fc.3\"], 4)),\n                       (\"r3pr\", sv_l(T[\"W_proj.3\"], 4))):\n        log(f\"share[{tag}]: {BASE_SHARES[tag]:.3f} -> {share(O4b, basis, tag):.3f}\")\ndef sec_control():\n    O4 = donor_O(0, 4)\n    u2 = sv_us(O4, 2)[0][:, 1]\n    rng = np.random.default_rng(7)\n    e = rng.standard_normal(d); e /= fro(e)\n    for u in sv_us(O4, 3)[0].T:                        # orthogonalize to top-3 modes\n        e -= (u @ e) * u\n    e /= fro(e)\n    s4 = slice(4*dh, 5*dh)\n    A = WO[0][:, s4]; B = WV[0][s4, :]\n    Ac = ablate(A, e)\n    O4c = Ac @ B\n    d_rand = abs(fro(O4) - fro(O4c)); d_wire = 15.373\n    print(\"== CONTROL: ablate random direction (matched fro loss target %.3f, actual %.3f) ==\" % (d_wire, d_rand))\n    print(\"K-comp row (x100): control:\", np.round(comp_row(O4c), 1))\n    for tag, basis in ((\"r0fc\", sv_r(T[\"W_fc.0\"], 4)), (\"r3fc\", sv_r(T[\"W_fc.3\"], 4)),\n                       (\"r3pr\", sv_l(T[\"W_proj.3\"], 4))):\n        log(f\"share[{tag}]: {share(O4, basis, tag):.3f} -> {share(O4c, basis, tag):.3f}\")\nrun_sec(\"traits\", sec_traits)\nrun_sec(\"treat\", sec_treat)\nrun_sec(\"control\", sec_control)\ndef sec_metrics():\n    with open(\"METRICS.md\", \"a\") as f:\n        f.write(\"\\n## run21 intervention (ablate L0H4 sigma-2 wire vs random dir)\\n\")\n        f.write(\"k-comp row/signs and span shares: see out_run21.txt + runlog deltas\\n\")\n    log(\"appended METRICS.md note\")\nrun_sec(\"metrics\", sec_metrics)\nlog(\"=== exit ===\")\n", "out": "[   0.00s] === start === run21 3.12.13\n[   0.00s] loaded: 40 keys\n[   0.00s] fro[W_fc.0]=51.650 OK\n[   0.01s] fro[W_proj.3]=85.089 OK\n[   0.01s] fro[W_q.2]=37.483 OK\n[   0.01s] fro[W_k.1]=28.602 OK\n[   0.01s] fro[ln1_w.0]=6.724 OK\n[   0.01s] helper contracts OK\n[   0.02s] O4 sv[:6]: [18.815 15.373  5.587  3.989  2.502  2.324]\n== TREATMENT: ablate L0H4 sigma-2 wire ==\nO4' sv[:6]: [18.815  5.587  3.989  2.502  2.324  2.015]\nK-comp row (x100): treated: [16.2 30.9 29.  31.4 29.8 28.9]  baseline(H4): [19. 32. 31. 33. 32. 30.]  flat-ref: [8. 5. 6. 6. 6. 6.]\n[   0.04s] [skip treat] NameError: name 'sv_r' is not defined\n== CONTROL: ablate random direction (matched fro loss target 15.373, actual 0.001) ==\nK-comp row (x100): control: [19.4 32.5 30.9 33.4 32.1 30.1]\n[   0.07s] [skip control] NameError: name 'sv_r' is not defined\n[   0.07s] appended METRICS.md note\n[   0.07s] === exit ===\n"}
{"t": 1793709932.654885, "s": 0.67, "code": "import faulthandler, sys, time, os, glob, traceback\nimport numpy as np\nRUN_TAG = \"run22\"\n_t0 = time.time(); _logf = open(\"runlog.txt\", \"a\", buffering=1)\ndef log(*a):\n    m = f\"[{time.time()-_t0:7.2f}s] \" + \" \".join(map(str, a))\n    print(m, flush=True); _logf.write(m + \"\\n\")\ndef run_sec(name, fn):\n    try:\n        fn()\n    except Exception as e:\n        log(f\"[skip {name}] {type(e).__name__}: {e}\")\nlog(\"=== start ===\", RUN_TAG, sys.version.split()[0])\nfaulthandler.enable(sys.stderr); faulthandler.dump_traceback_later(120, exit=True)\nclass Tee:\n    def __init__(self, *fs): self.fs = fs\n    def write(self, x):\n        for f in self.fs: f.write(x); f.flush()\n    def flush(self):\n        for f in self.fs: f.flush()\nsys.stdout = Tee(sys.stdout, open(f\"out_{RUN_TAG}.txt\", \"w\"))\nKEYS = [f\"{n}.{l}\" for l in range(4) for n in\n        (\"W_q\",\"W_k\",\"W_v\",\"W_o\",\"W_fc\",\"W_proj\",\"ln1_w\",\"ln1_b\",\"ln2_w\",\"ln2_b\")]\nwith np.load(\"blocks.npz\", allow_pickle=False) as z:\n    T = {k: np.asarray(z[k], np.float32) for k in z.files}\nlog(\"loaded:\", len(T), \"keys\")\nfor k, ref in ((\"W_fc.0\",51.650),(\"W_proj.3\",85.089),(\"W_q.2\",37.483),(\"W_k.1\",28.602),(\"ln1_w.0\",6.724)):\n    n = float(np.linalg.norm(T[k])); log(f\"fro[{k}]={n:.3f}\", \"OK\" if abs(n-ref) < 0.05 else \"MISMATCH\")\n    if abs(n-ref) >= 0.05: raise RuntimeError(\"loader validation failed\")\nL, H, dh, d = 4, 6, 64, 384\nWQ = [T[f\"W_q.{l}\"] for l in range(L)]; WK = [T[f\"W_k.{l}\"] for l in range(L)]\nWV = [T[f\"W_v.{l}\"] for l in range(L)]; WO = [T[f\"W_o.{l}\"] for l in range(L)]\ndef fro(x): return float(np.linalg.norm(x))\ndef donor_O(l, h):\n    s = slice(h*dh, (h+1)*dh)\n    return WO[l][:, s] @ WV[l][s, :]\ndef sv_us(M, k):\n    U, S, _ = np.linalg.svd(M, full_matrices=False)\n    return U[:, :k], S[:k]\ndef sv_l(M, k): return np.linalg.svd(M, full_matrices=False)[0][:, :k]\ndef sv_r(M, k): return np.linalg.svd(M, full_matrices=False)[2][:k, :].T\ndef share(W, B, tag=\"\"):\n    assert W.shape[0] == B.shape[0] == d, f\"share({tag}): W={W.shape} vs B={B.shape}\"\n    return fro(B.T @ W) / fro(W)\nassert donor_O(0, 4).shape == (d, d)\n_U, _S = sv_us(donor_O(0, 4), 4); assert _U.shape == (d, 4) and _S.shape == (4,)\nassert sv_r(T[\"W_fc.3\"], 4).shape == (d, 4)\nassert sv_l(T[\"W_proj.3\"], 4).shape == (d, 4)\nlog(\"helper contracts OK (incl sv_l/sv_r)\")\nnp.set_printoptions(precision=3, suppress=True, linewidth=200)\nROW_H4 = np.array([19, 32, 31, 33, 32, 30], float)\nROW_H0 = np.array([19, 30, 28, 31, 30, 28], float)\nFLAT   = np.array([8, 5, 6, 6, 6, 6], float)\nBASE   = {\"r0fc\": 0.261, \"r1fc\": 0.186, \"r2fc\": 0.214, \"r3fc\": 0.165, \"r3pr\": 0.399}\nBASE_H0 = {\"r0fc\": 0.359, \"r1fc\": 0.247, \"r2fc\": 0.263, \"r3fc\": 0.216, \"r3pr\": 0.333}\nSPANS = {\"r0fc\": (\"fc\", 0), \"r1fc\": (\"fc\", 1), \"r2fc\": (\"fc\", 2), \"r3fc\": (\"fc\", 3),\n         \"r3pr\": (\"pr\", 3)}\ndef span(tagkey):\n    kind, lr = SPANS[tagkey]\n    M = T[f\"W_fc.{lr}\"] if kind == \"fc\" else T[f\"W_proj.{lr}\"]\n    return sv_r(M, 4) if kind == \"fc\" else sv_l(M, 4)\ndef kcomp_row(O4):\n    out = np.zeros(H)\n    for h1 in range(H):\n        w = WK[1][slice(h1*dh, (h1+1)*dh), :]\n        out[h1] = 100.0 * fro(w @ O4) / (fro(O4) * fro(w))\n    return out\ndef probe(l, h, n_modes, label):\n    Ol = donor_O(l, h)\n    U, S = sv_us(Ol, 6)\n    s = slice(h*dh, (h+1)*dh)\n    A, B = WO[l][:, s], WV[l][s, :]\n    A2 = A.copy()\n    for m in range(n_modes):\n        A2 = A2 - np.outer(U[:, m], U[:, m] @ A2)\n    Ob = A2 @ B\n    d_removed = fro(Ol - Ob)\n    line = [f\"{label}: removed_fro={d_removed:.3f}\" +\n            \"\".join(f\" s{m+1}\" for m in range(n_modes))]\n    line.append(f\"smask[:6]={np.round(sv_us(Ob, 6)[1], 3)}\")\n    if l == 0 and h == 4:\n        line.append(f\"Krow(H4): {np.round(kcomp_row(Ob), 1)} (was {list(ROW_H4)}, flat {list(FLAT)})\")\n        for t in BASE:\n            line.append(f\"{t}: {BASE[t]:.3f}->{share(Ob, span(t), t):.3f}\")\n    if l == 0 and h == 0:\n        line.append(f\"Krow(H0): {np.round(kcomp_row(Ob), 1)} (was {list(ROW_H0)})\")\n        for t in BASE_H0:\n            line.append(f\"{t}: {BASE_H0[t]:.3f}->{share(Ob, span(t), t):.3f}\")\n    log(\"PROBE\", label, *line)\nrun_sec(\"smoke\", lambda: log(\"sanity O4 sv[:6]:\", np.round(sv_us(donor_O(0, 4), 6)[1], 3)))\nrun_sec(\"P1_s2_H4\",  lambda: probe(0, 4, 1, \"H4 only sigma2\"))\nrun_sec(\"P2_s1_H4\",  lambda: probe(0, 4, 0 + 1, \"H4 only sigma1\") if False else probe(0, 4, 1, \"H4 only sigma1(doc: ablate m1)\") if False else probe(0, 4, 0, \"noop-guard\") if False else probe(0, 4, 1, \"H4 top-1(=sigma1)\"))\nrun_sec(\"P3_s12_H4\", lambda: probe(0, 4, 2, \"H4 sigma1+2\"))\nrun_sec(\"P4_s1_H0\",  lambda: probe(0, 0, 1, \"H0 sigma1\"))\nrun_sec(\"P5_ctrl\",   lambda: probe_ctrl(donor_O(0, 4)))\ndef probe_ctrl(O4):\n    rng = np.random.default_rng(7)\n    e = rng.standard_normal(d); e /= fro(e)\n    Usim = sv_us(O4, 6)[0]\n    for u in Usim.T:\n        e -= (u @ e) * u\n    e /= fro(e)\n    s = slice(4*dh, 5*dh)\n    A, B = WO[0][:, s], WV[0][s, :]\n    Ac = A - np.outer(e, e @ A)\n    Oc = Ac @ B\n    log(\"CONTROL random-dir: removed_fro =\", round(fro(O4 - Oc), 3),\n        \"Krow:\", np.round(kcomp_row(Oc), 1),\n        \"r3fc:\", round(share(Oc, span(\"r3fc\"), \"c\"), 3))\nlog(\"=== exit ===\")\n", "out": "[   0.00s] === start === run22 3.12.13\n[   0.00s] loaded: 40 keys\n[   0.01s] fro[W_fc.0]=51.650 OK\n[   0.01s] fro[W_proj.3]=85.089 OK\n[   0.01s] fro[W_q.2]=37.483 OK\n[   0.01s] fro[W_k.1]=28.602 OK\n[   0.01s] fro[ln1_w.0]=6.724 OK\n[   0.06s] helper contracts OK (incl sv_l/sv_r)\n[   0.07s] sanity O4 sv[:6]: [18.815 15.373  5.587  3.989  2.502  2.324]\n[   0.21s] PROBE H4 only sigma2 H4 only sigma2: removed_fro=18.815 s1 smask[:6]=[15.373  5.587  3.989  2.502  2.324  2.015] Krow(H4): [21.3 31.  30.3 32.6 31.9 28.4] (was [np.float64(19.0), np.float64(32.0), np.float64(31.0), np.float64(33.0), np.float64(32.0), np.float64(30.0)], flat [np.float64(8.0), np.float64(5.0), np.float64(6.0), np.float64(6.0), np.float64(6.0), np.float64(6.0)]) r0fc: 0.261->0.345 r1fc: 0.186->0.218 r2fc: 0.214->0.280 r3fc: 0.165->0.235 r3pr: 0.399->0.160\n[   0.34s] PROBE H4 top-1(=sigma1) H4 top-1(=sigma1): removed_fro=18.815 s1 smask[:6]=[15.373  5.587  3.989  2.502  2.324  2.015] Krow(H4): [21.3 31.  30.3 32.6 31.9 28.4] (was [np.float64(19.0), np.float64(32.0), np.float64(31.0), np.float64(33.0), np.float64(32.0), np.float64(30.0)], flat [np.float64(8.0), np.float64(5.0), np.float64(6.0), np.float64(6.0), np.float64(6.0), np.float64(6.0)]) r0fc: 0.261->0.345 r1fc: 0.186->0.218 r2fc: 0.214->0.280 r3fc: 0.165->0.235 r3pr: 0.399->0.160\n[   0.47s] PROBE H4 sigma1+2 H4 sigma1+2: removed_fro=24.296 s1 s2 smask[:6]=[5.587 3.989 2.502 2.324 2.015 1.847] Krow(H4): [ 7.4 10.3 11.6 11.4 12.5  9.1] (was [np.float64(19.0), np.float64(32.0), np.float64(31.0), np.float64(33.0), np.float64(32.0), np.float64(30.0)], flat [np.float64(8.0), np.float64(5.0), np.float64(6.0), np.float64(6.0), np.float64(6.0), np.float64(6.0)]) r0fc: 0.261->0.363 r1fc: 0.186->0.176 r2fc: 0.214->0.170 r3fc: 0.165->0.173 r3pr: 0.399->0.226\n[   0.60s] PROBE H0 sigma1 H0 sigma1: removed_fro=6.898 s1 smask[:6]=[3.897 1.936 1.638 1.469 0.903 0.832] Krow(H0): [13.2 24.7 23.5 25.2 24.7 23.3] (was [np.float64(19.0), np.float64(30.0), np.float64(28.0), np.float64(31.0), np.float64(30.0), np.float64(28.0)]) r0fc: 0.359->0.168 r1fc: 0.247->0.075 r2fc: 0.263->0.105 r3fc: 0.216->0.100 r3pr: 0.333->0.304\n[   0.60s] [skip P5_ctrl] NameError: name 'probe_ctrl' is not defined\n[   0.60s] === exit ===\n"}
{"t": 1793710101.767861, "s": 0.19, "code": "import faulthandler, sys, time, os, glob, traceback\nimport numpy as np\nRUN_TAG = \"run23\"\n_t0 = time.time(); _logf = open(\"runlog.txt\", \"a\", buffering=1)\ndef log(*a):\n    m = f\"[{time.time()-_t0:7.2f}s] \" + \" \".join(map(str, a))\n    print(m, flush=True); _logf.write(m + \"\\n\")\ndef run_sec(name, fn):\n    try:\n        fn()\n    except Exception as e:\n        log(f\"[skip {name}] {type(e).__name__}: {e}\")\nlog(\"=== start ===\", RUN_TAG, sys.version.split()[0])\nfaulthandler.enable(sys.stderr); faulthandler.dump_traceback_later(120, exit=True)\nclass Tee:\n    def __init__(self, *fs): self.fs = fs\n    def write(self, x):\n        for f in self.fs: f.write(x); f.flush()\n    def flush(self):\n        for f in self.fs: f.flush()\nsys.stdout = Tee(sys.stdout, open(f\"out_{RUN_TAG}.txt\", \"w\"))\nKEYS = [f\"{n}.{l}\" for l in range(4) for n in\n        (\"W_q\",\"W_k\",\"W_v\",\"W_o\",\"W_fc\",\"W_proj\",\"ln1_w\",\"ln1_b\",\"ln2_w\",\"ln2_b\")]\nwith np.load(\"blocks.npz\", allow_pickle=False) as z:\n    T = {k: np.asarray(z[k], np.float32) for k in z.files}\nlog(\"loaded:\", len(T), \"keys\")\nfor k, ref in ((\"W_fc.0\",51.650),(\"W_proj.3\",85.089),(\"W_q.2\",37.483),(\"W_k.1\",28.602),(\"ln1_w.0\",6.724)):\n    n = float(np.linalg.norm(T[k])); log(f\"fro[{k}]={n:.3f}\", \"OK\" if abs(n-ref) < 0.05 else \"MISMATCH\")\n    if abs(n-ref) >= 0.05: raise RuntimeError(\"loader validation failed\")\nL, H, dh, d = 4, 6, 64, 384\nWQ = [T[f\"W_q.{l}\"] for l in range(L)]; WK = [T[f\"W_k.{l}\"] for l in range(L)]\nWV = [T[f\"W_v.{l}\"] for l in range(L)]; WO = [T[f\"W_o.{l}\"] for l in range(L)]\ndef fro(x): return float(np.linalg.norm(x))\ndef rankcorr(a, b):\n    ra = np.empty(a.size); ra[np.argsort(a)] = np.arange(a.size)\n    rb = np.empty(b.size); rb[np.argsort(b)] = np.arange(b.size)\n    return float(np.corrcoef(ra, rb)[0, 1])\ndef donor_O(l, h):\n    s = slice(h*dh, (h+1)*dh)\n    return WO[l][:, s] @ WV[l][s, :]\ndef sv_us(M, k):\n    U, S, _ = np.linalg.svd(M, full_matrices=False)\n    return U[:, :k], S[:k]\ndef sv_l(M, k): return np.linalg.svd(M, full_matrices=False)[0][:, :k]\ndef sv_r(M, k): return np.linalg.svd(M, full_matrices=False)[2][:k, :].T\ndef share(W, B, tag=\"\"):\n    assert W.shape[0] == B.shape[0] == d, f\"share({tag}): W={W.shape} vs B={B.shape}\"\n    return fro(B.T @ W) / fro(W)\nU4, S4 = sv_us(donor_O(0, 4), 4); U0, S0 = sv_us(donor_O(0, 0), 4)\nassert U4.shape == (d, 4) and U0.shape == (d, 4)\nassert sv_r(T[\"W_fc.3\"], 4).shape == (d, 4) and sv_l(T[\"W_proj.3\"], 4).shape == (d, 4)\nlog(\"helper contracts OK\")\nnp.set_printoptions(precision=3, suppress=True, linewidth=200)\nROW_H4 = np.array([19, 32, 31, 33, 32, 30], float)\nROW_H0 = np.array([19, 30, 28, 31, 30, 28], float)\nFLAT = np.array([8, 5, 6, 6, 6, 6], float)\nDIGESTS = {\"(0,1,K)\": (5493, 194, 309), \"(0,1,Q)\": (2643, 80, 64), \"(0,1,V)\": (2153, 43, 25),\n           \"(0,2,K)\": (3582, 158, 232), \"(0,3,K)\": (2420, 81, 137)}\nMX = {}\nfor l0 in range(L-1):\n    for l1 in range(l0+1, L):\n        for kind, WA in ((\"K\", WK), (\"Q\", WQ), (\"V\", WV)):\n            Mx = np.zeros((H, H))\n            for h0 in range(H):\n                O = donor_O(l0, h0); fo = fro(O)\n                for h1 in range(H):\n                    w = WA[l1][slice(h1*dh, (h1+1)*dh), :]\n                    Mx[h0, h1] = 100.0 * fro(w @ O) / max(fo * fro(w), 1e-9)\n            MX[(l0, l1, kind)] = Mx\n            log(\"digest\", (l0, l1, kind), int(np.round(Mx.sum()*10)),\n                int(np.round(Mx[0, 0]*10)), int(np.round(Mx[4, 2]*10)))\n\ndef probe(l, h, n_modes, label):\n    Ol = donor_O(l, h)\n    U, S = sv_us(Ol, 6)\n    s = slice(h*dh, (h+1)*dh)\n    A, B = WO[l][:, s], WV[l][s, :]\n    A2 = A.copy()\n    for m in range(n_modes):\n        A2 = A2 - np.outer(U[:, m], U[:, m] @ A2)\n    Ob = A2 @ B\n    log(f\"PROBE {label}: removed_fro={fro(Ol-Ob):.3f} smask={np.round(sv_us(Ob,6)[1],3)} \"\n        f\"Krow={np.round(kcomp_row(Ob),1)} vs_{list(ROW_H4 if h==4 else ROW_H0)}\")\ndef kcomp_row(O4):\n    out = np.zeros(H)\n    for h1 in range(H):\n        w = WK[1][slice(h1*dh, (h1+1)*dh), :]\n        out[h1] = 100.0 * fro(w @ O4) / (fro(O4) * fro(w))\n    return out\ndef ctrl():\n    rng = np.random.default_rng(7)\n    O4 = donor_O(0, 4)\n    e = rng.standard_normal(d); e /= fro(e)\n    for u in U4.T: e -= (u @ e) * u\n    e /= fro(e)\n    s = slice(4*dh, 5*dh)\n    Oc = (WO[0][:, s] - np.outer(e, e @ WO[0][:, s])) @ WV[0][s, :]\n    log(\"CONTROL: removed_fro =\", round(fro(O4 - Oc), 3), \"; Krow =\", np.round(kcomp_row(Oc), 1))\ndef profile():\n    print(\"== subspace-read profile: per-slice alignment with donor top-2 spans (random=0.072) ==\")\n    for l in (1, 2, 3):\n        line = []\n        for kind, WA in ((\"K\", WK), (\"Q\", WQ), (\"V\", WV)):\n            a4, a0 = [], []\n            for h in range(H):\n                W = WA[l][slice(h*dh, (h+1)*dh), :]\n                a4.append(fro(W @ U4[:, :2]) / fro(W))\n                a0.append(fro(W @ U0[:, :2]) / fro(W))\n            line.append(f\"{kind}: med4={np.median(a4):.3f} max4={max(a4):.3f} \"\n                        f\"med0={np.median(a0):.3f} max0={max(a0):.3f}\")\n        print(f\"  L{l} | \" + \" | \".join(line))\nrun_sec(\"P_H0_1to3\", lambda: probe(0, 0, 3, \"H0 sigma1-3 (88% energy)\"))\nrun_sec(\"P_ctrl\", ctrl)\nrun_sec(\"profile\", profile)\ndef sec_metrics():\n    with open(\"METRICS.md\", \"a\") as f:\n        f.write(\"\\n## run22/23 interventions\\n\"\n                \"H4: sigma1-only or sigma2-only leaves K-row intact; both (89% fro) collapses to ~flat \"\n                \"-> routing = top-2 subspace, redundant modes.\\n\"\n                \"H0: sigma1 removal: K-row -31% shape kept (routing partly in small modes); \"\n                \"span shares collapse (sigma1 = persistence wire).\\n\")\n    log(\"appended METRICS.md (interventions)\")\nrun_sec(\"metrics\", sec_metrics)\nlog(\"=== exit ===\")\n", "out": "[   0.00s] === start === run23 3.12.13\n[   0.01s] loaded: 40 keys\n[   0.01s] fro[W_fc.0]=51.650 OK\n[   0.01s] fro[W_proj.3]=85.089 OK\n[   0.01s] fro[W_q.2]=37.483 OK\n[   0.01s] fro[W_k.1]=28.602 OK\n[   0.01s] fro[ln1_w.0]=6.724 OK\n[   0.07s] helper contracts OK\n[   0.07s] digest (0, 1, 'K') 5493 194 309\n[   0.08s] digest (0, 1, 'Q') 2643 80 64\n[   0.08s] digest (0, 1, 'V') 2153 43 25\n[   0.08s] digest (0, 2, 'K') 3582 158 232\n[   0.08s] digest (0, 2, 'Q') 2021 56 59\n[   0.08s] digest (0, 2, 'V') 1551 26 27\n[   0.08s] digest (0, 3, 'K') 2420 81 137\n[   0.08s] digest (0, 3, 'Q') 1800 40 39\n[   0.08s] digest (0, 3, 'V') 1505 29 25\n[   0.08s] digest (1, 2, 'K') 2033 67 57\n[   0.08s] digest (1, 2, 'Q') 2176 71 64\n[   0.08s] digest (1, 2, 'V') 1968 49 61\n[   0.08s] digest (1, 3, 'K') 1969 59 51\n[   0.08s] digest (1, 3, 'Q') 1911 55 51\n[   0.09s] digest (1, 3, 'V') 1712 45 50\n[   0.09s] digest (2, 3, 'K') 1912 51 49\n[   0.09s] digest (2, 3, 'Q') 1914 51 53\n[   0.09s] digest (2, 3, 'V') 1756 49 50\n[   0.11s] PROBE H0 sigma1-3 (88% energy): removed_fro=8.156 smask=[1.638 1.469 0.903 0.832 0.706 0.651] Krow=[6.4 7.8 8.  8.1 8.1 7.4] vs_[np.float64(19.0), np.float64(30.0), np.float64(28.0), np.float64(31.0), np.float64(30.0), np.float64(28.0)]\n[   0.11s] CONTROL: removed_fro = 0.26 ; Krow = [19.4 32.5 30.9 33.4 32.1 30.1]\n== subspace-read profile: per-slice alignment with donor top-2 spans (random=0.072) ==\n  L1 | K: med4=0.473 max4=0.502 med0=0.448 max0=0.477 | Q: med4=0.086 max4=0.099 med0=0.098 max0=0.108 | V: med4=0.030 max4=0.033 med0=0.042 max0=0.051\n  L2 | K: med4=0.294 max4=0.351 med0=0.282 max0=0.326 | Q: med4=0.076 max4=0.095 med0=0.079 max0=0.097 | V: med4=0.030 max4=0.036 med0=0.035 max0=0.042\n  L3 | K: med4=0.126 max4=0.198 med0=0.123 max0=0.186 | Q: med4=0.055 max4=0.063 med0=0.059 max0=0.067 | V: med4=0.029 max4=0.062 med0=0.035 max0=0.065\n[   0.12s] appended METRICS.md (interventions)\n[   0.12s] === exit ===\n"}
{"t": 1793710239.4389272, "s": 0.14, "code": "import faulthandler, sys, time, os, glob, traceback\nimport numpy as np\nRUN_TAG = \"run24\"\n_t0 = time.time(); _logf = open(\"runlog.txt\", \"a\", buffering=1)\ndef log(*a):\n    m = f\"[{time.time()-_t0:7.2f}s] \" + \" \".join(map(str, a))\n    print(m, flush=True); _logf.write(m + \"\\n\")\ndef run_sec(name, fn):\n    try:\n        fn()\n    except Exception as e:\n        log(f\"[skip {name}] {type(e).__name__}: {e}\")\nlog(\"=== start ===\", RUN_TAG, sys.version.split()[0])\nfaulthandler.enable(sys.stderr); faulthandler.dump_traceback_later(120, exit=True)\nclass Tee:\n    def __init__(self, *fs): self.fs = fs\n    def write(self, x):\n        for f in self.fs: f.write(x); f.flush()\n    def flush(self):\n        for f in self.fs: f.flush()\nsys.stdout = Tee(sys.stdout, open(f\"out_{RUN_TAG}.txt\", \"w\"))\nKEYS = [f\"{n}.{l}\" for l in range(4) for n in\n        (\"W_q\",\"W_k\",\"W_v\",\"W_o\",\"W_fc\",\"W_proj\",\"ln1_w\",\"ln1_b\",\"ln2_w\",\"ln2_b\")]\nwith np.load(\"blocks.npz\", allow_pickle=False) as z:\n    T = {k: np.asarray(z[k], np.float32) for k in z.files}\nlog(\"loaded:\", len(T), \"keys\")\nfor k, ref in ((\"W_fc.0\",51.650),(\"W_proj.3\",85.089),(\"W_q.2\",37.483),(\"W_k.1\",28.602),(\"ln1_w.0\",6.724)):\n    n = float(np.linalg.norm(T[k])); log(f\"fro[{k}]={n:.3f}\", \"OK\" if abs(n-ref) < 0.05 else \"MISMATCH\")\n    if abs(n-ref) >= 0.05: raise RuntimeError(\"loader validation failed\")\nL, H, dh, d = 4, 6, 64, 384\nWQ = [T[f\"W_q.{l}\"] for l in range(L)]; WK = [T[f\"W_k.{l}\"] for l in range(L)]\nWV = [T[f\"W_v.{l}\"] for l in range(L)]; WO = [T[f\"W_o.{l}\"] for l in range(L)]\ndef fro(x): return float(np.linalg.norm(x))\ndef rankcorr(a, b):\n    ra = np.empty(a.size); ra[np.argsort(a)] = np.arange(a.size)\n    rb = np.empty(b.size); rb[np.argsort(b)] = np.arange(b.size)\n    return float(np.corrcoef(ra, rb)[0, 1])\ndef donor_O(l, h):\n    s = slice(h*dh, (h+1)*dh)\n    return WO[l][:, s] @ WV[l][s, :]\ndef sv_us(M, k):\n    U, S, _ = np.linalg.svd(M, full_matrices=False)\n    return U[:, :k], S[:k]\ndef sv_l(M, k): return np.linalg.svd(M, full_matrices=False)[0][:, :k]\ndef sv_r(M, k): return np.linalg.svd(M, full_matrices=False)[2][:k, :].T\ndef share(W, B, tag=\"\"):\n    assert W.shape[0] == B.shape[0] == d, f\"share({tag}): W={W.shape} vs B={B.shape}\"\n    return fro(B.T @ W) / fro(W)\nassert sv_r(T[\"W_fc.3\"], 4).shape == (d, 4) and sv_l(T[\"W_proj.3\"], 4).shape == (d, 4)\nlog(\"helper contracts OK\")\nnp.set_printoptions(precision=3, suppress=True, linewidth=200)\nMX = {}\nfor l0 in range(L-1):\n    for l1 in range(l0+1, L):\n        for kind, WA in ((\"K\", WK), (\"Q\", WQ), (\"V\", WV)):\n            Mx = np.zeros((H, H))\n            for h0 in range(H):\n                O = donor_O(l0, h0); fo = fro(O)\n                for h1 in range(H):\n                    w = WA[l1][slice(h1*dh, (h1+1)*dh), :]\n                    Mx[h0, h1] = 100.0 * fro(w @ O) / max(fo * fro(w), 1e-9)\n            MX[(l0, l1, kind)] = Mx\n            log(\"digest\", (l0, l1, kind), int(np.round(Mx.sum()*10)),\n                int(np.round(Mx[0, 0]*10)), int(np.round(Mx[4, 2]*10)))\nTDIG = {\"(0,1,K)\": (5493,194,309), \"(0,1,Q)\": (2643,80,64), \"(0,1,V)\": (2153,43,25),\n        \"(0,2,K)\": (3582,158,232), \"(0,2,Q)\": (2021,56,59), \"(0,2,V)\": (1551,26,27),\n        \"(0,3,K)\": (2420,81,137), \"(0,3,Q)\": (1800,40,39), \"(0,3,V)\": (1505,29,25),\n        \"(1,2,K)\": (2033,67,57),  \"(1,2,Q)\": (2176,71,64),  \"(1,2,V)\": (1968,49,61),\n        \"(1,3,K)\": (1969,59,51),  \"(1,3,Q)\": (1911,55,51),  \"(1,3,V)\": (1712,45,50),\n        \"(2,3,K)\": (1912,51,49),  \"(2,3,Q)\": (1914,51,53),  \"(2,3,V)\": (1756,49,50)}\nGOLD_CK = {(0,1): np.array([[437,626,672,736,694,527],[136,93,96,91,95,97],[131,159,169,191,180,136],\n                [193,250,274,301,280,206],[429,675,709,762,705,581],[162,153,153,155,160,164]]),\n           (0,2): np.array([[256,121,317,359,369,212],[100,124,94,94,97,92],[125,133,122,124,191,136],\n                [129,100,148,162,166,115],[292,100,363,412,408,256],[125,151,144,120,126,106]]),\n           (0,3): np.array([[154,139,172,121,176,115],[99,100,98,99,95,134],[122,120,115,119,122,116],\n                [100,103,99,97,102,103],[204,145,246,146,246,104],[110,139,109,97,93,157]])}\nGOLD_CQ = {(0,1): np.array([[220,240,215,268,248,232],[173,146,142,132,140,151],[195,136,134,135,139,153],\n                [137,133,139,157,145,136],[185,216,206,257,227,192],[179,166,165,149,169,177]])}\nGOLD_CV = {(0,1): np.array([[83,69,71,73,67,71],[166,158,144,173,168,149],[156,90,102,90,96,91],\n                [83,77,76,76,75,77],[51,49,48,51,46,49],[186,252,223,278,252,237]])}\nfor key, Mx in MX.items():\n    l0, l1, kind = key\n    G = {\"K\": GOLD_CK, \"Q\": GOLD_CQ, \"V\": GOLD_CV}[kind].get((l0, l1))\n    if G is not None:\n        r = rankcorr(Mx, G); log(\"TOPO\", key, \"PASS\" if r > 0.6 else \"FAIL\", f\"rho={r:.2f}\")\n    elif Mx.max()/max(Mx.mean(), 1e-9) <= 1.8:\n        log(\"TOPO\", key, \"PASS (flat)\")\n    else:\n        log(\"TOPO\", key, \"FAIL (unexpected structure)\")\ndef sec_gain():\n    s = slice(4*dh, 5*dh)\n    A, B = WO[0][:, s], WV[0][s, :]\n    O4 = donor_O(0, 4)\n    u2 = sv_us(O4, 2)[0][:, 1]\n    O4g = A @ B + np.outer(u2, u2 @ O4)      # doubles the sigma-2 mode\n    assert abs(fro(O4g - O4) - 15.373) < 0.15\n    row0 = np.array([100.0*fro(WK[1][slice(h1*dh, (h1+1)*dh), :] @ O4)/(fro(O4)*fro(WK[1][slice(h1*dh,(h1+1)*dh),:])) for h1 in range(H)])\n    rowg = np.array([100.0*fro(WK[1][slice(h1*dh, (h1+1)*dh), :] @ O4g)/(fro(O4g)*fro(WK[1][slice(h1*dh,(h1+1)*dh),:])) for h1 in range(H)])\n    log(\"GAIN x2 H4@sigma2: removed==added_fro=15.373;\",\n        \"Krow:\", np.round(row0,1), \"->\", np.round(rowg,1),\n        \"| r3fc:\", round(share(O4, sv_r(T[\"W_fc.3\"],4)),3), \"->\", round(share(O4g, sv_r(T[\"W_fc.3\"],4)),3),\n        \"| r3pr:\", round(share(O4, sv_l(T[\"W_proj.3\"],4)),3), \"->\", round(share(O4g, sv_l(T[\"W_proj.3\"],4)),3))\ndef sec_profile():\n    U4 = sv_us(donor_O(0, 4), 2)[0]; U0 = sv_us(donor_O(0, 0), 2)[0]\n    rows = {}\n    for l in (1, 2, 3):\n        d4 = {\"K\": [], \"Q\": [], \"V\": []}; d0 = {\"K\": [], \"Q\": [], \"V\": []}\n        for kind, WA in ((\"K\", WK), (\"Q\", WQ), (\"V\", WV)):\n            for h in range(H):\n                W = WA[l][slice(h*dh, (h+1)*dh), :]\n                d4[kind].append(fro(W @ U4)/fro(W)); d0[kind].append(fro(W @ U0)/fro(W))\n        rows[l] = {k: (float(np.median(d4[k])), float(np.median(d0[k]))) for k in (\"K\",\"Q\",\"V\")}\n    log(\"profile medians (a4, a0):\", rows)\n    return rows\ndef sec_doc():\n    rows = sec_profile() if False else _ROWS.get(\"p\", {})  # placeholder replaced below\nrun_sec(\"gain\", sec_gain)\nprof = {}\ndef sec_prof():\n    global prof\n    prof = sec_profile()\nrun_sec(\"profile\", sec_prof)\ndef sec_write():\n    if not prof: raise RuntimeError(\"profile missing\")\n    doc = (\n    \"# exp3 \u2014 definitions, circuit map, interventions (final consolidation, runs 8-24)\\n\\n\"\n    \"## model\\n4 layers, 6 heads, d=384, d_head=64, d_mlp=1536. Snapshot: blocks.npz only \"\n    \"(no lnf/W_E/W_U). Storage: W_q/k/v = (H*64,384), head h = rows; W_o = (384,H*64), head h = cols.\\n\\n\"\n    \"## metric dictionary (all values gold-locked vs run-1 output)\\n\"\n    \"nQ/nK/nV/nO = fro of row/col slices [24/24]; zM=fro(q_h.T@k_h), zOV=fro(o_h@v_h) [24/24];\\n\"\n    \"svM/svOV = top-4 sv of M_h / O_h [24/24]; alphaOV = ||(O+O.T)/2||_F/||O||_F [24/24, max dev 0.005];\\n\"\n    \"V-comp = 100*sqrt(384)*||Wv_t O_d||_F/(||Wv_t||_F ||O_d||_F) [exact, s=1.0]; \"\n    \"K-comp same form +-8%; Q-comp operator OPEN. baseM/baseOV, traceOV: OPEN.\\n\\n\"\n    \"## circuit (verified)\\n\"\n    \"- Composition: single hand-off L0->L1; rho(K)=.96/.97/.98 for L0->L1/L2/L3 donors H0,H4; \"\n    \"V-channel L0->L1 donors H1,H5 (rho=1.00); all L1+ pairs flat.\\n\"\n    \"- Routing rule (interventions): donor ROUTE content = top-k subspace (H4: top-2, either mode \"\n    \"alone suffices; H0: top-3, sigma2/3 carry mass), mode-redundant. Removing top-k (89%/88% energy) \"\n    \"collapses K-row to flat [7-12] vs [19-33] baseline.\\n\"\n    \"- Persistence: H4@sigma2 carries 82.8% of its final-readout-span energy; H0@sigma1 92%.\\n\"\n    \"- Final lane (r3fc abs): L3H3 15.6 (broadband, top-3 only 48%) > M2 8.1 > M1 7.3 > M0 6.2 \"\n    \"> L3H4 4.8 > L0H4 4.2 (single mode, sigma2). Final MLP transforms (input-share 0.32 vs \"\n    \"write-share 0.19 for L3H3; its top modes absent from write span).\\n\"\n    \"- Subspace-read profile (median, vs random 0.072): K: L1 .47/.45 -> L2 .29/.28 -> L3 .13/.12 \"\n    \"(routing cone ~x0.6/layer); Q near-random all layers; V BELOW random (0.03-0.05) everywhere \"\n    \"= geometric repulsion of value slices from donor k-subspace.\\n\"\n    \"- Donor-detector census: 62.5% of top-64 W_fc.3 units >=3x random donor-cos; 49.5% of all \u2014 \"\n    \"distributed encoding, no per-unit detectors.\\n\\n\"\n    \"## open items\\n\"\n    \"Q-comp gold operator; baseM/baseOV (permutation null rejected); traceOV; lnf/W_U absent \"\n    \"(no logit-lens/vocab metrics possible); no forward pass in harness -> interventions are \"\n    \"weight-space-signature experiments only.\")\n    open(\"METRICS.md\", \"w\").write(doc)\n    log(\"wrote METRICS.md (consolidated),\", len(doc.splitlines()), \"lines\")\nrun_sec(\"prof\", sec_prof)\nrun_sec(\"doc\", sec_write)\nlog(\"=== exit ===\")\n", "out": "[   0.00s] === start === run24 3.12.13\n[   0.00s] loaded: 40 keys\n[   0.01s] fro[W_fc.0]=51.650 OK\n[   0.01s] fro[W_proj.3]=85.089 OK\n[   0.01s] fro[W_q.2]=37.483 OK\n[   0.01s] fro[W_k.1]=28.602 OK\n[   0.01s] fro[ln1_w.0]=6.724 OK\n[   0.05s] helper contracts OK\n[   0.06s] digest (0, 1, 'K') 5493 194 309\n[   0.06s] digest (0, 1, 'Q') 2643 80 64\n[   0.06s] digest (0, 1, 'V') 2153 43 25\n[   0.06s] digest (0, 2, 'K') 3582 158 232\n[   0.06s] digest (0, 2, 'Q') 2021 56 59\n[   0.06s] digest (0, 2, 'V') 1551 26 27\n[   0.06s] digest (0, 3, 'K') 2420 81 137\n[   0.06s] digest (0, 3, 'Q') 1800 40 39\n[   0.06s] digest (0, 3, 'V') 1505 29 25\n[   0.06s] digest (1, 2, 'K') 2033 67 57\n[   0.06s] digest (1, 2, 'Q') 2176 71 64\n[   0.06s] digest (1, 2, 'V') 1968 49 61\n[   0.06s] digest (1, 3, 'K') 1969 59 51\n[   0.07s] digest (1, 3, 'Q') 1911 55 51\n[   0.07s] digest (1, 3, 'V') 1712 45 50\n[   0.07s] digest (2, 3, 'K') 1912 51 49\n[   0.07s] digest (2, 3, 'Q') 1914 51 53\n[   0.07s] digest (2, 3, 'V') 1756 49 50\n\n[stderr]\nTraceback (most recent call last):\n  File \"<string>\", line 88, in <module>\n  File \"<string>\", line 38, in rankcorr\nValueError: shape mismatch: value array of shape (36,) could not be broadcast to indexing result of shape (6,6)\n"}
{"t": 1793710392.313808, "s": 0.29, "code": "import faulthandler, sys, time, os, glob, traceback\nimport numpy as np\nRUN_TAG = \"run25\"\n_t0 = time.time(); _logf = open(\"runlog.txt\", \"a\", buffering=1)\ndef log(*a):\n    m = f\"[{time.time()-_t0:7.2f}s] \" + \" \".join(map(str, a))\n    print(m, flush=True); _logf.write(m + \"\\n\")\ndef run_sec(name, fn):\n    try:\n        fn()\n    except Exception as e:\n        log(f\"[skip {name}] {type(e).__name__}: {e}\")\nlog(\"=== start ===\", RUN_TAG, sys.version.split()[0])\nfaulthandler.enable(sys.stderr); faulthandler.dump_traceback_later(120, exit=True)\nclass Tee:\n    def __init__(self, *fs): self.fs = fs\n    def write(self, x):\n        for f in self.fs: f.write(x); f.flush()\n    def flush(self):\n        for f in self.fs: f.flush()\nsys.stdout = Tee(sys.stdout, open(f\"out_{RUN_TAG}.txt\", \"w\"))\nKEYS = [f\"{n}.{l}\" for l in range(4) for n in\n        (\"W_q\",\"W_k\",\"W_v\",\"W_o\",\"W_fc\",\"W_proj\",\"ln1_w\",\"ln1_b\",\"ln2_w\",\"ln2_b\")]\nwith np.load(\"blocks.npz\", allow_pickle=False) as z:\n    T = {k: np.asarray(z[k], np.float32) for k in z.files}\nlog(\"loaded:\", len(T), \"keys\")\nfor k, ref in ((\"W_fc.0\",51.650),(\"W_proj.3\",85.089),(\"W_q.2\",37.483),(\"W_k.1\",28.602),(\"ln1_w.0\",6.724)):\n    n = float(np.linalg.norm(T[k])); log(f\"fro[{k}]={n:.3f}\", \"OK\" if abs(n-ref) < 0.05 else \"MISMATCH\")\n    if abs(n-ref) >= 0.05: raise RuntimeError(\"loader validation failed\")\nL, H, dh, d = 4, 6, 64, 384\nWQ = [T[f\"W_q.{l}\"] for l in range(L)]; WK = [T[f\"W_k.{l}\"] for l in range(L)]\nWV = [T[f\"W_v.{l}\"] for l in range(L)]; WO = [T[f\"W_o.{l}\"] for l in range(L)]\ndef fro(x): return float(np.linalg.norm(x))\ndef rankcorr(a, b):\n    a = np.asarray(a, float).ravel(); b = np.asarray(b, float).ravel()\n    assert a.shape == b.shape\n    ra = np.empty(a.size, float); ra[np.argsort(a)] = np.arange(a.size)\n    rb = np.empty(b.size, float); rb[np.argsort(b)] = np.arange(b.size)\n    return float(np.corrcoef(ra, rb)[0, 1])\ndef donor_O(l, h):\n    s = slice(h*dh, (h+1)*dh)\n    return WO[l][:, s] @ WV[l][s, :]\ndef sv_us(M, k):\n    U, S, _ = np.linalg.svd(M, full_matrices=False)\n    return U[:, :k], S[:k]\ndef sv_l(M, k): return np.linalg.svd(M, full_matrices=False)[0][:, :k]\ndef sv_r(M, k): return np.linalg.svd(M, full_matrices=False)[2][:k, :].T\ndef share(W, B, tag=\"\"):\n    assert W.shape[0] == B.shape[0] == d, f\"share({tag}): W={W.shape} vs B={B.shape}\"\n    return fro(B.T @ W) / fro(W)\n# ---- helper contracts (incl. rankcorr unit check) ----\nassert sv_r(T[\"W_fc.3\"], 4).shape == (d, 4) and sv_l(T[\"W_proj.3\"], 4).shape == (d, 4)\nassert abs(rankcorr(np.array([1.,2.,3.,4.]), np.array([1.,3.,2.,4.])) - 0.8) < 1e-9\nassert abs(rankcorr(np.array([[1.,2.],[3.,4.]]), np.array([[1.,3.],[2.,4.]])) - 0.8) < 1e-9\nlog(\"helper contracts OK (incl. 2-D rankcorr unit check)\")\nnp.set_printoptions(precision=3, suppress=True, linewidth=200)\nMX = {}\nfor l0 in range(L-1):\n    for l1 in range(l0+1, L):\n        for kind, WA in ((\"K\", WK), (\"Q\", WQ), (\"V\", WV)):\n            Mx = np.zeros((H, H))\n            for h0 in range(H):\n                O = donor_O(l0, h0); fo = fro(O)\n                for h1 in range(H):\n                    w = WA[l1][slice(h1*dh, (h1+1)*dh), :]\n                    Mx[h0, h1] = 100.0 * fro(w @ O) / max(fo * fro(w), 1e-9)\n            MX[(l0, l1, kind)] = Mx\n            log(\"digest\", (l0, l1, kind), int(np.round(Mx.sum()*10)),\n                int(np.round(Mx[0, 0]*10)), int(np.round(Mx[4, 2]*10)))\nGOLD_CK = {(0,1): np.array([[437,626,672,736,694,527],[136,93,96,91,95,97],[131,159,169,191,180,136],\n                [193,250,274,301,280,206],[429,675,709,762,705,581],[162,153,153,155,160,164]]),\n           (0,2): np.array([[256,121,317,359,369,212],[100,124,94,94,97,92],[125,133,122,124,191,136],\n                [129,100,148,162,166,115],[292,100,363,412,408,256],[125,151,144,120,126,106]]),\n           (0,3): np.array([[154,139,172,121,176,115],[99,100,98,99,95,134],[122,120,115,119,122,116],\n                [100,103,99,97,102,103],[204,145,246,146,246,104],[110,139,109,97,93,157]])}\nGOLD_CQ = {(0,1): np.array([[220,240,215,268,248,232],[173,146,142,132,140,151],[195,136,134,135,139,153],\n                [137,133,139,157,145,136],[185,216,206,257,227,192],[179,166,165,149,169,177]])}\nGOLD_CV = {(0,1): np.array([[83,69,71,73,67,71],[166,158,144,173,168,149],[156,90,102,90,96,91],\n                [83,77,76,76,75,77],[51,49,48,51,46,49],[186,252,223,278,252,237]])}\nfor key, Mx in MX.items():\n    l0, l1, kind = key\n    G = {\"K\": GOLD_CK, \"Q\": GOLD_CQ, \"V\": GOLD_CV}[kind].get((l0, l1))\n    if G is not None:\n        r = rankcorr(Mx, G); log(\"TOPO\", key, \"PASS\" if r > 0.6 else \"FAIL\", f\"rho={r:.2f}\")\n    elif Mx.max()/max(Mx.mean(), 1e-9) <= 1.8:\n        log(\"TOPO\", key, \"PASS (flat)\")\n    else:\n        log(\"TOPO\", key, \"FAIL (unexpected structure)\")\ndef sec_gain():\n    s = slice(4*dh, 5*dh)\n    A, B = WO[0][:, s], WV[0][s, :]\n    O4, u2 = donor_O(0, 4), sv_us(donor_O(0, 4), 2)[0][:, 1]\n    O4g = A @ B + np.outer(u2, u2 @ O4)\n    assert abs(fro(O4g - O4) - 15.373) < 0.15\n    def krow(O):\n        r = []\n        for h1 in range(H):\n            w = WK[1][slice(h1*dh, (h1+1)*dh), :]\n            r.append(100.0 * fro(w @ O) / (fro(O) * fro(w)))\n        return np.round(r, 1)\n    log(\"GAIN x2 H4@sigma2: added_fro=15.373; Krow:\", krow(O4), \"->\", krow(O4g),\n        \"| r3fc:\", round(share(O4, sv_r(T[\"W_fc.3\"], 4)), 3), \"->\",\n        round(share(O4g, sv_r(T[\"W_fc.3\"], 4)), 3),\n        \"| r3pr:\", round(share(O4, sv_l(T[\"W_proj.3\"], 4)), 3), \"->\",\n        round(share(O4g, sv_l(T[\"W_proj.3\"], 4)), 3))\ndef profile_med(seed=0):\n    U4 = sv_us(donor_O(0, 4), 2)[0]; U0 = sv_us(donor_O(0, 0), 2)[0]\n    rows = {}\n    for l in (1, 2, 3):\n        d4 = {\"K\": [], \"Q\": [], \"V\": []}; d0 = {\"K\": [], \"Q\": [], \"V\": []}\n        for kind, WA in ((\"K\", WK), (\"Q\", WQ), (\"V\", WV)):\n            for h in range(H):\n                W = WA[l][slice(h*dh, (h+1)*dh), :]\n                d4[kind].append(fro(W @ U4) / fro(W)); d0[kind].append(fro(W @ U0) / fro(W))\n        rows[l] = {kd: (float(np.median(d4[kd])), float(np.median(d0[kd])))\n                   for kd in (\"K\", \"Q\", \"V\")}\n        log(\"profile\", l, rows[l])\n    return rows\ndef sec_prof(): profile_med()\ndef sec_doc():\n    med = profile_med()\n    doc = (\n    \"# exp3 \u2014 definitions, circuit map, interventions (consolidated record, runs 8-25)\\n\\n\"\n    \"## model\\n4 layers, 6 heads, d=384, d_head=64, d_mlp=1536. Snapshot: blocks.npz only \"\n    \"(no lnf/W_E/W_U in this harness). Storage: W_q/k/v = (H*64,384) rows-per-head; \"\n    \"W_o = (384,H*64) cols-per-head.\\n\\n\"\n    \"## metric dictionary (gold-locked vs run-1 output)\\n\"\n    \"nQ..nO = fro of slices [24/24]; zM=fro(q_h.T@k_h), zOV=fro(o_h@v_h) [24/24]; \"\n    \"svM/svOV top-4 [24/24]; alphaOV = symfrac ||(O+O.T)/2||F/||O||F [24/24, maxdev 0.005]; \"\n    \"V-comp = 100*sqrt(384)*||Wv_t O_d||/(||Wv_t|| ||O_d||) EXACT; K-comp same form +-8%; \"\n    \"Q-comp operator OPEN. baseM/baseOV (perm-null rejected), traceOV: OPEN.\\n\\n\"\n    \"## circuit (verified)\\n\"\n    \"1) composition: single hand-off L0->L1; K-rho .96/.97/.98 (donors H0,H4 rows); \"\n    \"V-channel L0->L1 donors H1,H5 (rho 1.00); all L1+ pairs flat.\\n\"\n    \"2) interventions: donor ROUTE content = top-k subspace, mode-redundant \"\n    \"(H4: sigma1-only or sigma2-only row intact, both 89% energy -> flat [7-12]); \"\n    \"H0: sigma1-only row -31% (route mainly sigma2/3), sigma1-3 (88%) -> flat [6-8]. \"\n    \"PERSIST = large-sigma direction locked to downstream reader spans: H4@sigma2 (82.8% of \"\n    \"r3fc energy), H0@sigma1 (92% of lane).\\n\"\n    \"3) final lane r3fc abs: L3H3 15.6 broadband (top-3 48%) > M2 8.1 > M1 7.3 > M0 6.2 > \"\n    \"L3H4 4.8 > L0H4 4.2 (single-mode sigma2). Final MLP transforms: L3H3 input-share .32 \"\n    \"vs write-share .19; its top modes ~absent from write span (m2/m3 ~0.000-0.001).\\n\"\n    \"4) subspace-read profile (median vs random 0.072):\\n\"\n    f\"   L1 K {med[1]['K'][0]:.3f}/{med[1]['K'][1]:.3f} -> L2 K {med[2]['K'][0]:.3f}/{med[2]['K'][1]:.3f} \"\n    f\"-> L3 K {med[3]['K'][0]:.3f}/{med[3]['K'][1]:.3f}  (routing cone, ~x0.6/layer; matches gold rows)\\n\"\n    \"   Q near-random at all layers (0.055-0.098); V BELOW random (0.029-0.051) = value slices \"\n    \"geometrically repelled from donor k-subspace.\\n\"\n    \"5) census: 62.5% of top-64 W_fc.3 units >=3x random donor-cos (49.5% of all 1536) \u2014 \"\n    \"distributed encoding; donor census r0fc self-read: L0H0 .359, L0H4 .261.\\n\\n\"\n    \"## open items\\n\"\n    \"Q comp gold operator; baseM/baseOV; traceOV; lnf/W_U absent (no vocab-side story); \"\n    \"no forward pass in harness -> interventions are weight-space-signature experiments.\")\n    open(\"METRICS.md\", \"w\").write(doc)\n    print(\"---- METRICS.md ----\"); print(doc)\nrun_sec(\"gain\", sec_gain)\nrun_sec(\"prof\", sec_prof)\nrun_sec(\"doc\", sec_doc)\nlog(\"=== exit ===\")\n", "out": "[   0.00s] === start === run25 3.12.13\n[   0.01s] loaded: 40 keys\n[   0.01s] fro[W_fc.0]=51.650 OK\n[   0.01s] fro[W_proj.3]=85.089 OK\n[   0.01s] fro[W_q.2]=37.483 OK\n[   0.01s] fro[W_k.1]=28.602 OK\n[   0.01s] fro[ln1_w.0]=6.724 OK\n[   0.05s] helper contracts OK (incl. 2-D rankcorr unit check)\n[   0.06s] digest (0, 1, 'K') 5493 194 309\n[   0.06s] digest (0, 1, 'Q') 2643 80 64\n[   0.06s] digest (0, 1, 'V') 2153 43 25\n[   0.06s] digest (0, 2, 'K') 3582 158 232\n[   0.06s] digest (0, 2, 'Q') 2021 56 59\n[   0.06s] digest (0, 2, 'V') 1551 26 27\n[   0.06s] digest (0, 3, 'K') 2420 81 137\n[   0.06s] digest (0, 3, 'Q') 1800 40 39\n[   0.06s] digest (0, 3, 'V') 1505 29 25\n[   0.06s] digest (1, 2, 'K') 2033 67 57\n[   0.06s] digest (1, 2, 'Q') 2176 71 64\n[   0.06s] digest (1, 2, 'V') 1968 49 61\n[   0.06s] digest (1, 3, 'K') 1969 59 51\n[   0.07s] digest (1, 3, 'Q') 1911 55 51\n[   0.07s] digest (1, 3, 'V') 1712 45 50\n[   0.07s] digest (2, 3, 'K') 1912 51 49\n[   0.07s] digest (2, 3, 'Q') 1914 51 53\n[   0.07s] digest (2, 3, 'V') 1756 49 50\n[   0.07s] TOPO (0, 1, 'K') PASS rho=0.96\n[   0.07s] TOPO (0, 1, 'Q') FAIL rho=0.36\n[   0.07s] TOPO (0, 1, 'V') PASS rho=1.00\n[   0.07s] TOPO (0, 2, 'K') PASS rho=0.97\n[   0.07s] TOPO (0, 2, 'Q') PASS (flat)\n[   0.07s] TOPO (0, 2, 'V') PASS (flat)\n[   0.07s] TOPO (0, 3, 'K') PASS rho=0.98\n[   0.07s] TOPO (0, 3, 'Q') PASS (flat)\n[   0.07s] TOPO (0, 3, 'V') PASS (flat)\n[   0.07s] TOPO (1, 2, 'K') PASS (flat)\n[   0.07s] TOPO (1, 2, 'Q') PASS (flat)\n[   0.07s] TOPO (1, 2, 'V') PASS (flat)\n[   0.07s] TOPO (1, 3, 'K') PASS (flat)\n[   0.07s] TOPO (1, 3, 'Q') PASS (flat)\n[   0.07s] TOPO (1, 3, 'V') PASS (flat)\n[   0.07s] TOPO (2, 3, 'K') PASS (flat)\n[   0.07s] TOPO (2, 3, 'Q') PASS (flat)\n[   0.07s] TOPO (2, 3, 'V') PASS (flat)\n[   0.17s] GAIN x2 H4@sigma2: added_fro=15.373; Krow: [19.4 32.5 30.9 33.4 32.1 30.1] -> [21.9 33.9 32.6 35.2 34.1 31.2] | r3fc: 0.165 -> 0.214 | r3pr: 0.399 -> 0.293\n[   0.20s] profile 1 {'K': (0.4733089472473676, 0.4484135245514893), 'Q': (0.08638961719005986, 0.09843370737883442), 'V': (0.030176499695755886, 0.042443042628006494)}\n[   0.20s] profile 2 {'K': (0.2940026958554156, 0.2817779413166904), 'Q': (0.07553430048666825, 0.07850031207489708), 'V': (0.03040723526639139, 0.03488425189286658)}\n[   0.20s] profile 3 {'K': (0.1259783388541594, 0.12269825830468646), 'Q': (0.054877243720028016, 0.05904974250908626), 'V': (0.028780905243095654, 0.0354150217106367)}\n[   0.22s] profile 1 {'K': (0.4733089472473676, 0.4484135245514893), 'Q': (0.08638961719005986, 0.09843370737883442), 'V': (0.030176499695755886, 0.042443042628006494)}\n[   0.22s] profile 2 {'K': (0.2940026958554156, 0.2817779413166904), 'Q': (0.07553430048666825, 0.07850031207489708), 'V': (0.03040723526639139, 0.03488425189286658)}\n[   0.22s] profile 3 {'K': (0.1259783388541594, 0.12269825830468646), 'Q': (0.054877243720028016, 0.05904974250908626), 'V': (0.028780905243095654, 0.0354150217106367)}\n---- METRICS.md ----\n# exp3 \u2014 definitions, circuit map, interventions (consolidated record, runs 8-25)\n\n## model\n4 layers, 6 heads, d=384, d_head=64, d_mlp=1536. Snapshot: blocks.npz only (no lnf/W_E/W_U in this harness). Storage: W_q/k/v = (H*64,384) rows-per-head; W_o = (384,H*64) cols-per-head.\n\n## metric dictionary (gold-locked vs run-1 output)\nnQ..nO = fro of slices [24/24]; zM=fro(q_h.T@k_h), zOV=fro(o_h@v_h) [24/24]; svM/svOV top-4 [24/24]; alphaOV = symfrac ||(O+O.T)/2||F/||O||F [24/24, maxdev 0.005]; V-comp = 100*sqrt(384)*||Wv_t O_d||/(||Wv_t|| ||O_d||) EXACT; K-comp same form +-8%; Q-comp operator OPEN. baseM/baseOV (perm-null rejected), traceOV: OPEN.\n\n## circuit (verified)\n1) composition: single hand-off L0->L1; K-rho .96/.97/.98 (donors H0,H4 rows); V-channel L0->L1 donors H1,H5 (rho 1.00); all L1+ pairs flat.\n2) interventions: donor ROUTE content = top-k subspace, mode-redundant (H4: sigma1-only or sigma2-only row intact, both 89% energy -> flat [7-12]); H0: sigma1-only row -31% (route mainly sigma2/3), sigma1-3 (88%) -> flat [6-8]. PERSIST = large-sigma direction locked to downstream reader spans: H4@sigma2 (82.8% of r3fc energy), H0@sigma1 (92% of lane).\n3) final lane r3fc abs: L3H3 15.6 broadband (top-3 48%) > M2 8.1 > M1 7.3 > M0 6.2 > L3H4 4.8 > L0H4 4.2 (single-mode sigma2). Final MLP transforms: L3H3 input-share .32 vs write-share .19; its top modes ~absent from write span (m2/m3 ~0.000-0.001).\n4) subspace-read profile (median vs random 0.072):\n   L1 K 0.473/0.448 -> L2 K 0.294/0.282 -> L3 K 0.126/0.123  (routing cone, ~x0.6/layer; matches gold rows)\n   Q near-random at all layers (0.055-0.098); V BELOW random (0.029-0.051) = value slices geometrically repelled from donor k-subspace.\n5) census: 62.5% of top-64 W_fc.3 units >=3x random donor-cos (49.5% of all 1536) \u2014 distributed encoding; donor census r0fc self-read: L0H0 .359, L0H4 .261.\n\n## open items\nQ comp gold operator; baseM/baseOV; traceOV; lnf/W_U absent (no vocab-side story); no forward pass in harness -> interventions are weight-space-signature experiments.\n[   0.22s] === exit ===\n"}
{"t": 1793710638.6295428, "s": 0.23, "code": "import faulthandler, sys, time, os, glob, traceback\nimport numpy as np\nRUN_TAG = \"run26\"\n_t0 = time.time(); _logf = open(\"runlog.txt\", \"a\", buffering=1)\ndef log(*a):\n    m = f\"[{time.time()-_t0:7.2f}s] \" + \" \".join(map(str, a))\n    print(m, flush=True); _logf.write(m + \"\\n\")\ndef run_sec(name, fn):\n    try:\n        fn()\n    except Exception as e:\n        log(f\"[skip {name}] {type(e).__name__}: {e}\")\nlog(\"=== start ===\", RUN_TAG, sys.version.split()[0])\nfaulthandler.enable(sys.stderr); faulthandler.dump_traceback_later(120, exit=True)\nclass Tee:\n    def __init__(self, *fs): self.fs = fs\n    def write(self, x):\n        for f in self.fs: f.write(x); f.flush()\n    def flush(self):\n        for f in self.fs: f.flush()\nsys.stdout = Tee(sys.stdout, open(f\"out_{RUN_TAG}.txt\", \"w\"))\nKEYS = [f\"{n}.{l}\" for l in range(4) for n in\n        (\"W_q\",\"W_k\",\"W_v\",\"W_o\",\"W_fc\",\"W_proj\",\"ln1_w\",\"ln1_b\",\"ln2_w\",\"ln2_b\")]\nwith np.load(\"blocks.npz\", allow_pickle=False) as z:\n    T = {k: np.asarray(z[k], np.float32) for k in z.files}\nlog(\"loaded:\", len(T), \"keys\")\nfor k, ref in ((\"W_fc.0\",51.650),(\"W_proj.3\",85.089),(\"W_q.2\",37.483),(\"W_k.1\",28.602),(\"ln1_w.0\",6.724)):\n    n = float(np.linalg.norm(T[k])); log(f\"fro[{k}]={n:.3f}\", \"OK\" if abs(n-ref) < 0.05 else \"MISMATCH\")\n    if abs(n-ref) >= 0.05: raise RuntimeError(\"loader validation failed\")\nL, H, dh, d = 4, 6, 64, 384\nWQ = [T[f\"W_q.{l}\"] for l in range(L)]; WK = [T[f\"W_k.{l}\"] for l in range(L)]\nWV = [T[f\"W_v.{l}\"] for l in range(L)]; WO = [T[f\"W_o.{l}\"] for l in range(L)]\ndef fro(x): return float(np.linalg.norm(x))\ndef donor_O(l, h):\n    s = slice(h*dh, (h+1)*dh)\n    return WO[l][:, s] @ WV[l][s, :]\ndef sv_us(M, k):\n    U, S, _ = np.linalg.svd(M, full_matrices=False)\n    return U[:, :k], S[:k]\ndef sv_l(M, k): return np.linalg.svd(M, full_matrices=False)[0][:, :k]\ndef sv_r(M, k): return np.linalg.svd(M, full_matrices=False)[2][:k, :].T\nassert sv_r(T[\"W_fc.3\"], 4).shape == (d, 4) and sv_l(T[\"W_proj.3\"], 4).shape == (d, 4)\nlog(\"helper contracts OK\")\nnp.set_printoptions(precision=3, suppress=True, linewidth=200)\nMX = {}\nfor l0 in range(L-1):\n    for l1 in range(l0+1, L):\n        for kind, WA in ((\"K\", WK), (\"Q\", WQ), (\"V\", WV)):\n            Mx = np.zeros((H, H))\n            for h0 in range(H):\n                O = donor_O(l0, h0); fo = fro(O)\n                for h1 in range(H):\n                    w = WA[l1][slice(h1*dh, (h1+1)*dh), :]\n                    Mx[h0, h1] = 100.0 * fro(w @ O) / max(fo * fro(w), 1e-9)\n            MX[(l0, l1, kind)] = Mx\n            log(\"digest\", (l0, l1, kind), int(np.round(Mx.sum()*10)),\n                int(np.round(Mx[0, 0]*10)), int(np.round(Mx[4, 2]*10)))\ndef sec_gaindiag():\n    s = slice(4*dh, 5*dh)\n    A, B = WO[0][:, s], WV[0][s, :]\n    O4 = donor_O(0, 4)\n    U4, S4 = sv_us(O4, 4)\n    u2 = U4[:, 1]\n    _, _, Vt4 = np.linalg.svd(O4, full_matrices=False)\n    v2 = Vt4[1, :]\n    add = np.outer(u2, u2 @ O4)\n    delta = add - S4[1] * np.outer(u2, v2)\n    log(\"diag: ||u2^T O4|| =\", round(fro(add), 6),\n        \"| ||add - sigma2*u2v2^T|| =\", round(float(fro(delta)), 6), \"(model check)\")\n    O4g = O4 + add\n    log(\"diag: sv(O4g)[:4] =\", np.round(np.linalg.svd(O4g, compute_uv=False)[:4], 3),\n        \"(expect [18.815, ~30.75, 5.587, ...])\")\n    Rd3 = sv_r(T[\"W_fc.3\"], 4); Uw3 = sv_l(T[\"W_proj.3\"], 4)\n    for nm, O in ((\"O4\", O4), (\"O4g\", O4g)):\n        nf, npn = fro(Rd3.T @ O), fro(Uw3.T @ O)\n        den = fro(O)\n        log(f\"diag {nm}: r3fc num={nf:.4f} den={den:.4f} share={nf/den:.4f} | \"\n            f\"r3pr num={npn:.4f} share={npn/den:.4f}\")\n        U, S = sv_us(O, 3)\n        p = np.linalg.norm(Rd3.T @ U, axis=0)\n        log(f\"diag {nm}: per-mode fc abs =\", np.round(S*p, 3),\n            \"fr =\", np.round((S*p)**2/max(nf**2, 1e-12), 3))\nrun_sec(\"gaindiag\", sec_gaindiag)\nlog(\"=== exit ===\")\n", "out": "[   0.00s] === start === run26 3.12.13\n[   0.01s] loaded: 40 keys\n[   0.01s] fro[W_fc.0]=51.650 OK\n[   0.01s] fro[W_proj.3]=85.089 OK\n[   0.01s] fro[W_q.2]=37.483 OK\n[   0.01s] fro[W_k.1]=28.602 OK\n[   0.01s] fro[ln1_w.0]=6.724 OK\n[   0.06s] helper contracts OK\n[   0.06s] digest (0, 1, 'K') 5493 194 309\n[   0.06s] digest (0, 1, 'Q') 2643 80 64\n[   0.06s] digest (0, 1, 'V') 2153 43 25\n[   0.06s] digest (0, 2, 'K') 3582 158 232\n[   0.06s] digest (0, 2, 'Q') 2021 56 59\n[   0.06s] digest (0, 2, 'V') 1551 26 27\n[   0.06s] digest (0, 3, 'K') 2420 81 137\n[   0.06s] digest (0, 3, 'Q') 1800 40 39\n[   0.06s] digest (0, 3, 'V') 1505 29 25\n[   0.06s] digest (1, 2, 'K') 2033 67 57\n[   0.06s] digest (1, 2, 'Q') 2176 71 64\n[   0.07s] digest (1, 2, 'V') 1968 49 61\n[   0.07s] digest (1, 3, 'K') 1969 59 51\n[   0.07s] digest (1, 3, 'Q') 1911 55 51\n[   0.07s] digest (1, 3, 'V') 1712 45 50\n[   0.07s] digest (2, 3, 'K') 1912 51 49\n[   0.07s] digest (2, 3, 'Q') 1914 51 53\n[   0.07s] digest (2, 3, 'V') 1756 49 50\n[   0.09s] diag: ||u2^T O4|| = 15.372949 | ||add - sigma2*u2v2^T|| = 4e-06 (model check)\n[   0.09s] diag: sv(O4g)[:4] = [30.746 18.815  5.587  3.989] (expect [18.815, ~30.75, 5.587, ...])\n[   0.14s] diag O4: r3fc num=4.2432 den=25.7946 share=0.1645 | r3pr num=10.2886 share=0.3989\n[   0.15s] diag O4: per-mode fc abs = [0.926 3.861 1.315] fr = [0.048 0.828 0.096]\n[   0.15s] diag O4g: r3fc num=7.9197 den=37.0721 share=0.2136 | r3pr num=10.8707 share=0.2932\n[   0.16s] diag O4g: per-mode fc abs = [7.721 0.926 1.315] fr = [0.951 0.014 0.028]\n[   0.16s] === exit ===\n"}
