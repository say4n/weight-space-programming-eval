{"t": 1793705528.2122371, "s": 0.47, "code": "import numpy as np\nnp.set_printoptions(precision=3, suppress=True, linewidth=250)\nD = 384\nH = 6\nprint(\"== tensors ==\")\nfor n in sorted(W.keys()):\n    a = W[n].astype(np.float64)\n    print(f\"  {n:12s} {str(a.shape):14s} fro={np.linalg.norm(a):9.3f}\")\n\ndef get(l,h):\n    s = slice(64*h, 64*(h+1))\n    return (W[f'W_q.{l}'][s].astype(np.float64), W[f'W_k.{l}'][s].astype(np.float64),\n            W[f'W_v.{l}'][s].astype(np.float64), W[f'W_o.{l}'][:, s].astype(np.float64))\n\nMops = {}; OVops = {}\nprint(\"\\n== per-head features ==\")\nprint(\"head |  nQ   nK   nV   nO |  zM   baseM rM | zOV  baseOV rOV | alphaOV traceOV | svM[:4] | svOV[:4]\")\nfor l in range(4):\n    for h in range(6):\n        Q,K,V,O = get(l,h)\n        M = Q.T @ K\n        OV = O @ V\n        zM = np.linalg.norm(M); zOV = np.linalg.norm(OV)\n        baseM = np.linalg.norm(Q,2)*np.linalg.norm(K,2)/np.sqrt(D)   # isotropic baseline\n        baseOV = np.linalg.norm(O,2)*np.linalg.norm(V,2)/np.sqrt(D)\n        sym = (OV+OV.T)/2\n        alpha = np.linalg.norm(sym)/zOV\n        tau = np.trace(OV)/zOV\n        sM = np.linalg.svd(M, compute_uv=False)\n        sOV = np.linalg.svd(OV, compute_uv=False)\n        Mops[(l,h)] = M; OVops[(l,h)] = OV\n        print(f\"L{l}H{h} | {np.linalg.norm(Q):5.2f} {np.linalg.norm(K):5.2f} {np.linalg.norm(V):5.2f} {np.linalg.norm(O):5.2f} | {zM:5.2f} {baseM:5.2f} {zM/max(baseM,1e-9):4.2f} | {zOV:6.2f} {baseOV:6.2f} {zOV/max(baseOV,1e-9):4.2f} | {alpha:5.2f} {tau:6.2f} | {sM[:4]} | {sOV[:4]}\")\n\ndef comb(A,B):\n    return np.linalg.norm(A @ B)\n\ndef riso(nA, nB):\n    return nA*nB/np.sqrt(D)\n\nprint(\"\\n== K-composition ratios (x100), rows=source head (l0,h0), cols=target head (l1,h1) ==\")\nopr = Mops\nfor l0 in range(4):\n    for l1 in range(4):\n        if l1 <= l0: continue\n        M_ = np.zeros((6,6))\n        for h0 in range(6):\n            OV = None\n            Q,K,V,O = get(l0,h0)\n            OV = O @ V\n            nOV = np.linalg.norm(OV)\n            for h1 in range(6):\n                Q2,K2,V2,O2 = get(l1,h1)\n                M2 = Q2.T @ K2\n                z = np.linalg.norm(M2 @ OV)\n                base = np.linalg.norm(M2)*nOV/np.sqrt(D)\n                M_[h0,h1] = z/max(base,1e-12)*100.0\n        print(f\"\\n l0=L{l0} -> l1=L{l1} (K-comp):\")\n        print(M_.astype(int))\n\nprint(\"\\n== Q-composition ratios (x100) ==\")\nfor l0 in range(4):\n    for l1 in range(4):\n        if l1 <= l0: continue\n        M_ = np.zeros((6,6))\n        for h0 in range(6):\n            Q,K,V,O = get(l0,h0)\n            OV = O @ V\n            nOV = np.linalg.norm(OV)\n            for h1 in range(6):\n                Q2,K2,V2,O2 = get(l1,h1)\n                M2 = Q2.T @ K2\n                z = np.linalg.norm(OV.T @ M2)\n                base = np.linalg.norm(M2)*nOV/np.sqrt(D)\n                M_[h0,h1] = z/max(base,1e-12)*100.0\n        print(f\"\\n l0=L{l0} -> l1=L{l1} (Q-comp):\")\n        print(M_.astype(int))\n\nprint(\"\\n== V-composition ratios (x100) ==\")\nfor l0 in range(4):\n    for l1 in range(4):\n        if l1 <= l0: continue\n        M_ = np.zeros((6,6))\n        for h0 in range(6):\n            Q,K,V,O = get(l0,h0)\n            OV = O @ V\n            nOV = np.linalg.norm(OV)\n            for h1 in range(6):\n                Q2,K2,V2,O2 = get(l1,h1)\n                V2o = np.linalg.norm(V2)\n                z = np.linalg.norm(V2 @ OV)\n                base = V2o*nOV/np.sqrt(D)\n                M_[h0,h1] = z/max(base,1e-12)*100.0\n        print(f\"\\n l0=L{l0} -> l1=L{l1} (V-comp):\")\n        print(M_.astype(int))\n\nprint(\"\\n== LN weight norms / biases ==\")\nfor l in range(4):\n    for pre in ['ln1','ln2']:\n        w = W[f'{pre}_w.{l}'].astype(np.float64); b = W[f'{pre}_b.{l}'].astype(np.float64)\n        print(f\"  {pre}.{l}: |w|={np.linalg.norm(w):6.3f}  |b|={np.linalg.norm(b):6.3f}  max|b|={np.abs(b).max():5.3f}\")\nw = W['lnf_w'].astype(np.float64); b = W['lnf_b'].astype(np.float64)\nprint(f\"  lnf : |w|={np.linalg.norm(w):6.3f}  |b|={np.linalg.norm(b):6.3f}\")\n\nprint(\"\\n== MLP linear proxy ==\")\nfor l in range(4):\n    F = W[f'W_proj.{l}'].astype(np.float64) @ W[f'W_fc.{l}'].astype(np.float64)\n    s = np.linalg.svd(F, compute_uv=False)\n    print(f\"  L{l}: |F|={np.linalg.norm(F):8.2f}  sv[:6]={s[:6]}  trace={np.trace(F):7.2f}\")\n", "out": "== tensors ==\n  W_fc.0       (1536, 384)    fro=   51.650\n  W_fc.1       (1536, 384)    fro=   80.261\n  W_fc.2       (1536, 384)    fro=   79.454\n  W_fc.3       (1536, 384)    fro=   78.189\n  W_k.0        (384, 384)     fro=   23.214\n  W_k.1        (384, 384)     fro=   28.602\n  W_k.2        (384, 384)     fro=   36.356\n  W_k.3        (384, 384)     fro=   33.221\n  W_o.0        (384, 384)     fro=   19.600\n  W_o.1        (384, 384)     fro=   26.151\n  W_o.2        (384, 384)     fro=   34.205\n  W_o.3        (384, 384)     fro=   39.017\n  W_proj.0     (384, 1536)    fro=   45.806\n  W_proj.1     (384, 1536)    fro=   75.119\n  W_proj.2     (384, 1536)    fro=   77.477\n  W_proj.3     (384, 1536)    fro=   85.089\n  W_q.0        (384, 384)     fro=   22.704\n  W_q.1        (384, 384)     fro=   31.676\n  W_q.2        (384, 384)     fro=   37.483\n  W_q.3        (384, 384)     fro=   33.940\n  W_v.0        (384, 384)     fro=   18.197\n  W_v.1        (384, 384)     fro=   28.469\n  W_v.2        (384, 384)     fro=   34.746\n  W_v.3        (384, 384)     fro=   38.939\n  ln1_b.0      (384,)         fro=    0.717\n  ln1_b.1      (384,)         fro=    3.033\n  ln1_b.2      (384,)         fro=    2.621\n  ln1_b.3      (384,)         fro=    1.862\n  ln1_w.0      (384,)         fro=    6.724\n  ln1_w.1      (384,)         fro=    9.505\n  ln1_w.2      (384,)         fro=   14.457\n  ln1_w.3      (384,)         fro=   15.105\n  ln2_b.0      (384,)         fro=    1.353\n  ln2_b.1      (384,)         fro=    2.877\n  ln2_b.2      (384,)         fro=    2.91