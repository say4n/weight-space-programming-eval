{"t": 1793709088.429205, "s": 0.31, "code": "import faulthandler, sys, time, os, glob, traceback\nimport numpy as np\nRUN_TAG = \"run17\"\n_t0 = time.time(); _logf = open(\"runlog.txt\", \"a\", buffering=1)\ndef log(*a):\n    m = f\"[{time.time()-_t0:7.2f}s] \" + \" \".join(map(str, a))\n    print(m, flush=True); _logf.write(m + \"\\n\")\nlog(\"=== start ===\", RUN_TAG, sys.version.split()[0])\nfaulthandler.enable(sys.stderr); faulthandler.dump_traceback_later(120, exit=True)\nclass Tee:\n    def __init__(self, *fs): self.fs = fs\n    def write(self, x):\n        for f in self.fs: f.write(x); f.flush()\n    def flush(self):\n        for f in self.fs: f.flush()\nsys.stdout = Tee(sys.stdout, open(f\"out_{RUN_TAG}.txt\", \"w\"))\nKEYS = [f\"{n}.{l}\" for l in range(4) for n in\n        (\"W_q\",\"W_k\",\"W_v\",\"W_o\",\"W_fc\",\"W_proj\",\"ln1_w\",\"ln1_b\",\"ln2_w\",\"ln2_b\")]\nwith np.load(\"blocks.npz\", allow_pickle=False) as z:\n    T = {k: np.asarray(z[k], np.float32) for k in z.files}\nlog(\"loaded:\", len(T), \"keys\")\nfor k, ref in ((\"W_fc.0\",51.650),(\"W_proj.3\",85.089),(\"W_q.2\",37.483),(\"W_k.1\",28.602),(\"ln1_w.0\",6.724)):\n    n = float(np.linalg.norm(T[k])); log(f\"fro[{k}]={n:.3f}\", \"OK\" if abs(n-ref) < 0.05 else \"MISMATCH\")\n    if abs(n-ref) >= 0.05: raise RuntimeError(\"loader validation failed\")\nL, H, dh, d = 4, 6, 64, 384\nWQ = [T[f\"W_q.{l}\"] for l in range(L)]; WK = [T[f\"W_k.{l}\"] for l in range(L)]\nWV = [T[f\"W_v.{l}\"] for l in range(L)]; WO = [T[f\"W_o.{l}\"] for l in range(L)]\ndef fro(x): return float(np.linalg.norm(x))\ndef rankcorr(a, b):\n    a = np.asarray(a, float).ravel(); b = np.asarray(b, float).ravel()\n    ra = np.empty(a.size); ra[np.argsort(a)] = np.arange(a.size)\n    rb = np.empty(b.size); rb[b].argsort() if False else None\n    rb = np.empty(b.size); rb[np.argsort(b)] = np.arange(b.size)\n    return float(np.corrcoef(ra, rb)[0, 1])\nnp.set_printoptions(precision=3, suppress=True, linewidth=200)\nGOLD_N = {\"L0\":[(4.13,4.91,5.35,5.21),(12.46,12.64,9.26,10.20),(6.46,6.83,5.99,5.54),\n                (6.63,6.82,4.88,5.47),(2.17,2.62,8.28,8.94),(15.90,15.96,9.41,10.60)],\n          \"L1\":[(10.56,9.83,12.95,11.17),(14.53,12.80,11.06,10.66),(12.69,11.35,12.12,11.19),\n                (12.70,11.75,11.32,10.14),(12.59,11.51,10.92,9.91),(14.14,12.58,11.23,10.92)],\n          \"L2\":[(15.22,14.53,13.81,13.64),(14.68,14.47,14.68,14.21),(17.26,16.72,12.99,13.00),\n                (15.01,14.61,14.46,14.25),(15.58,15.20,13.47,13.50),(13.84,13.30,15.55,15.08)],\n          \"L3\":[(14.95,14.54,15.59,15.37),(13.43,13.31,15.61,15.27),(14.99,14.47,15.92,16.03),\n                (10.54,10.52,17.86,18.20),(13.65,13.26,16.27,16.26),(15.03,14.81,13.87,14.16)]}\nworst = 0.0\nfor l in range(L):\n    for h in range(H):\n        s = slice(h*dh, (h+1)*dh)\n        got = (fro(WQ[l][s, :]), fro(WK[l][s, :]), fro(WV[l][s, :]), fro(WO[l][:, s]))\n        worst = max(worst, max(abs(a-b) for a, b in zip(got, GOLD_N[f\"L{l}\"][h])))\nlog(\"partition regression, worst |d| =\", round(worst, 4))\nif worst > 0.05: raise RuntimeError(\"convention regression failed\")\ndef donor_O(l, h):\n    s = slice(h*dh, (h+1)*dh)\n    O = WO[l][:, s] @ WV[l][s, :]; assert O.shape == (d, d)\n    return O\nMX = {}\nfor l0 in range(L-1):\n    for l1 in range(l0+1, L):\n        for kind, WA in ((\"K\", WK), (\"Q\", WQ), (\"V\", WV)):\n            Mx = np.zeros((H, H))\n            for h0 in range(H):\n                O = donor_O(l0, h0); fo = fro(O)\n                for h1 in range(H):\n                    w = WA[l1][slice(h1*dh, (h1+1)*dh), :]\n                    Mx[h0, h1] = 100.0 * fro(w @ O) / max(fo * fro(w), 1e-9)\n            MX[(l0, l1, kind)] = Mx\n            log(\"digest\", (l0, l1, kind), int(np.round(Mx.sum()*10)),\n                int(np.round(Mx[0, 0]*10)), int(np.round(Mx[4, 2]*10)))\nGOLD_CK = {(0,1): np.array([[437,626,672,736,694,527],[136,93,96,91,95,97],[131,159,169,191,180,136],\n                [193,250,274,301,280,206],[429,675,709,762,705,581],[162,153,153,155,160,164]]),\n           (0,2): np.array([[256,121,317,359,369,212],[100,124,94,94,97,92],[125,133,122,124,191,136],\n                [129,100,148,162,166,115],[292,100,363,412,408,256],[125,151,144,120,126,106]]),\n           (0,3): np.array([[154,139,172,121,176,115],[99,100,98,99,95,134],[122,120,115,119,122,116],\n                [100,103,99,97,102,103],[204,145,246,146,246,104],[110,139,109,97,93,157]])}\nGOLD_CQ = {(0,1): np.array([[220,240,215,268,248,232],[173,146,142,132,140,151],[195,136,134,135,139,153],\n                [137,133,139,157,145,136],[185,216,206,257,227,192],[179,166,165,149,169,177]])}\nGOLD_CV = {(0,1): np.array([[83,69,71,73,67,71],[166,158,144,173,168,149],[156,90,102,90,96,91],\n                [83,77,76,76,75,77],[51,49,48,51,46,49],[186,252,223,278,252,237]])}\nfor key, Mx in MX.items():\n    l0, l1, kind = key\n    G = {\"K\": GOLD_CK, \"Q\": GOLD_CQ, \"V\": GOLD_CV}[kind].get((l0, l1))\n    if G is not None:\n        r = rankcorr(Mx, G); log(\"TOPO\", key, \"PASS\" if r > 0.6 else \"FAIL\", f\"rho={r:.2f}\")\n    elif Mx.max()/max(Mx.mean(), 1e-9) <= 1.8:\n        log(\"TOPO\", key, \"PASS (flat)\")\n    else:\n        log(\"TOPO\", key, \"FAIL (unexpected structure)\")\n\n# ============== NEW SECTIONS (run 17) \u2014 same-layer map, census, METRICS ==============\ndef sv_l(M, k): return np.linalg.svd(M, full_matrices=False)[0][:, :k]\ndef sv_r(M, k): return np.linalg.svd(M, full_matrices=False)[2][:k, :].T\nspans = {}\nfor lr in range(4):\n    spans[lr] = (sv_r(T[f\"W_fc.{lr}\"], 4), sv_l(T[f\"W_proj.{lr}\"], 4) if lr > 0 else None)\ndef share(W, B): return fro(B.T @ W) / fro(W)\n\nprint(\"== A: write->read map, SAME-LAYER writers included (baseline sqrt(4/384)=0.102) ==\")\nprint(\"writer |  r0fc |  r1fc  r1pr |  r2fc  r2pr |  r3fc  r3pr\")\nseen = {}\ndef emit_row(name, W):\n    is_mlp = name.startswith(\"M\")\n    row = []\n    for lr in range(4):\n        fc, pr = spans[lr]\n        okh = (int(name[1]) <= lr) if not is_mlp else (int(name[1]) < lr)\n        a = share(W, fc) if okh else float(\"nan\")\n        b = share(W, pr) if (okh and pr is not None) else float(\"nan\")\n        row += [a] if lr == 0 else [a, b]\n        seen[(name, f\"r{lr}fc\")] = a\n        if lr > 0 and pr is not None: seen[(name, f\"r{lr}pr\")] = b\n    print(name + \" | \" + \" \" .join(\n        (f\"{'  \u00b7 ' if v != v else f'{v:.3f}'}\" for v in row)) if False else\n        \" | \".join(f\"{'\u00b7' if v != v else f'{v:.3f}'}\" for v in row))\nfor l0 in range(L):\n    for h0 in range(H): emit_row(f\"L{l0}H{h0}\", donor_O(l0, h0))\n    if l0 < L-1: emit_row(f\"M{l0}\", T[f\"W_proj.{l0}\"])\nXCHECK = {(\"L0H0\",\"r1fc\"):0.247, (\"L0H5\",\"r1fc\"):0.345, (\"L0H0\",\"r2fc\"):0.263,\n          (\"L0H4\",\"r3pr\"):0.399, (\"L0H4\",\"r3fc\"):0.186, (\"M2\",\"r3fc\"):0.105,\n          (\"L1H0\",\"r2fc\"):0.192, (\"M0\",\"r3pr\"):0.200}\nbad = [(k, round(seen[k], 3), v) for k, v in XCHECK.items() if abs(seen[k]-v) > 2e-3]\nlog(\"xcheck vs run14 map:\", \"OK\" if not bad else f\"DIFF {bad}\")\n\nprint(\"== r3fc absolute contributors (same-layer L3 heads included) ==\")\nRd3 = spans[3][0]\ncands = [(f\"L{l}H{h}\", donor_O(l, h)) for l in range(4) for h in range(H)] + \\\n        [(f\"M{l}\", T[f\"W_proj.{l}\"]) for l in range(3)]\ntop = sorted(((nm, fro(Rd3.T @ W)) for nm, W in cands), key=lambda t: -t[1])[:12]\nfor nm, a in top: print(f\"  {nm:5s} abs={a:6.3f}\")\n\nprint(\"== B: donor-detector census (top-weighted W_fc.3 units; 0.12 = 3x random) ==\")\nWf3 = T[\"W_fc.3\"]; R = Wf3.T\nDon = np.concatenate(\n    [np.linalg.svd(donor_O(0, h), full_matrices=False)[0][:, :2] for h in (0, 4)], axis=1)\nLab = [\"H0\", \"H0\", \"H4\", \"H4\"]\nCm = np.abs(Don.T @ R)\ncmax = Cm.max(axis=0)\nU3f, S3f, Vt3 = np.linalg.svd(T[\"W_proj.3\"], full_matrices=False)\ncoef = S3f[:4, None] * np.abs(Vt3[:4, :])\nu_sc = coef.sum(axis=0)\norder = np.argsort(-u_sc); top64 = order[:64]\nf64 = float((cmax[top64] >= 0.12).mean()); f_all = float((cmax >= 0.12).mean())\nlog(\"census top-64 frac >=0.12:\", round(f64, 3), \"| all-1536 frac:\", round(f_all, 4))\nfor i in top64[np.argsort(-cmax[top64])[:5]]:\n    j = int(Cm[:, i].argmax()); um = int(coef[:, i].argmax()) + 1\n    print(f\"  unit {i:4d}  cos={cmax[i]:.3f}  mode={Lab[j]}  main_u=u{um}\")\n\ntop3 = \", \".join(f\"{nm} {a:.2f}\" for nm, a in top[:3])\nopen(\"METRICS.md\", \"w\").write(\nf\"\"\"# exp3 metric dictionary + channel map (runs 9-17; see runlog)\nstorage: W_q/k/v = (H*64,384) head h = rows h*64..; W_o = (384,H*64) head h = cols.\nq/k/v row slices (64x384); o_h col slice (384x64); O_h = o_h@v_h; M_h = q_h.T@k_h.\nclosed vs run1: nQ..nO, zM=fro(M), zOV=fro(O), svM/svOV top4, alphaOV=symfrac.\nV-comp = 100*sqrt(d)*||Wv_t O_d||/(||Wv_t|| ||O_d||) exact; K-comp same form +-8%; Q-comp OPEN.\ncircuit: L0 donors H0/H4 route K to L1/L2/L3 (topo rho .96-.98); H1/H5 V to L1; L1+ layers flat.\nwrite->read spans (top4): donors broadcast (H0 .247/.263/.216, H5 r1fc .345, H4 r3pr .399);\nL2 heads -> r3fc ~baseline; final run: same-layer L3 heads + r0fc column = see out_run17.txt.\nr3fc abs contributors top3: {top3}.\ncensus (donor-detector units of W_fc.3, thr 0.12): top-64 frac = {f64:.3f}, all = {f_all:.4f}.\nopen: baseM/baseO (perm null rejected), traceOV, Q-comp op; lnf/W_U absent from snapshot.\n\"\"\")\nlog(\"wrote METRICS.md\")\nlog(\"=== exit ===\")\n", "out": "[   0.00s] === start === run17 3.12.13\n[   0.00s] loaded: 40 keys\n[   0.01s] fro[W_fc.0]=51.650 OK\n[   0.01s] fro[W_proj.3]=85.089 OK\n[   0.01s] fro[W_q.2]=37.483 OK\n[   0.01s] fro[W_k.1]=28.602 OK\n[   0.01s] fro[ln1_w.0]=6.724 OK\n[   0.01s] partition regression, worst |d| = 0.005\n[   0.01s] digest (0, 1, 'K') 5493 194 309\n[   0.01s] digest (0, 1, 'Q') 2643 80 64\n[   0.01s] digest (0, 1, 'V') 2153 43 25\n[   0.01s] digest (0, 2, 'K') 3582 158 232\n[   0.01s] digest (0, 2, 'Q') 2021 56 59\n[   0.01s] digest (0, 2, 'V') 1551 26 27\n[   0.01s] digest (0, 3, 'K') 2420 81 137\n[   0.01s] digest (0, 3, 'Q') 1800 40 39\n[   0.01s] digest (0, 3, 'V') 1505 29 25\n[   0.01s] digest (1, 2, 'K') 2033 67 57\n[   0.01s] digest (1, 2, 'Q') 2176 71 64\n[   0.01s] digest (1, 2, 'V') 1968 49 61\n[   0.02s] digest (1, 3, 'K') 1969 59 51\n[   0.02s] digest (1, 3, 'Q') 1911 55 51\n[   0.02s] digest (1, 3, 'V') 1712 45 50\n[   0.02s] digest (2, 3, 'K') 1912 51 49\n[   0.02s] digest (2, 3, 'Q') 1914 51 53\n[   0.02s] digest (2, 3, 'V') 1756 49 50\n[   0.02s] TOPO (0, 1, 'K') PASS rho=0.96\n[   0.02s] TOPO (0, 1, 'Q') FAIL rho=0.36\n[   0.02s] TOPO (0, 1, 'V') PASS rho=1.00\n[   0.02s] TOPO (0, 2, 'K') PASS rho=0.97\n[   0.02s] TOPO (0, 2, 'Q') PASS (flat)\n[   0.02s] TOPO (0, 2, 'V') PASS (flat)\n[   0.02s] TOPO (0, 3, 'K') PASS rho=0.98\n[   0.02s] TOPO (0, 3, 'Q') PASS (flat)\n[   0.02s] TOPO (0, 3, 'V') PASS (flat)\n[   0.02s] TOPO (1, 2, 'K') PASS (flat)\n[   0.02s] TOPO (1, 2, 'Q') PASS (flat)\n[   0.02s] TOPO (1, 2, 'V') PASS (flat)\n[   0.02s] TOPO (1, 3, 'K') PASS (flat)\n[   0.02s] TOPO (1, 3, 'Q') PASS (flat)\n[   0.02s] TOPO (1, 3, 'V') PASS (flat)\n[   0.02s] TOPO (2, 3, 'K') PASS (flat)\n[   0.02s] TOPO (2, 3, 'Q') PASS (flat)\n[   0.02s] TOPO (2, 3, 'V') PASS (flat)\n== A: write->read map, SAME-LAYER writers included (baseline sqrt(4/384)=0.102) ==\nwriter |  r0fc |  r1fc  r1pr |  r2fc  r2pr |  r3fc  r3pr\n0.359 | 0.247 | 0.318 | 0.263 | 0.234 | 0.216 | 0.333\n0.153 | 0.119 | 0.093 | 0.096 | 0.092 | 0.072 | 0.095\n0.143 | 0.102 | 0.161 | 0.105 | 0.120 | 0.134 | 0.168\n0.198 | 0.126 | 0.168 | 0.141 | 0.135 | 0.146 | 0.160\n0.261 | 0.186 | 0.262 | 0.214 | 0.194 | 0.165 | 0.399\n0.156 | 0.345 | 0.122 | 0.227 | 0.094 | 0.098 | 0.112\n\u00b7 | 0.178 | 0.174 | 0.151 | 0.143 | 0.134 | 0.200\n\u00b7 | 0.159 | 0.157 | 0.192 | 0.130 | 0.115 | 0.154\n\u00b7 | 0.088 | 0.118 | 0.094 | 0.106 | 0.088 | 0.102\n\u00b7 | 0.152 | 0.132 | 0.125 | 0.121 | 0.091 | 0.130\n\u00b7 | 0.275 | 0.117 | 0.165 | 0.115 | 0.095 | 0.092\n\u00b7 | 0.225 | 0.121 | 0.142 | 0.109 | 0.087 | 0.115\n\u00b7 | 0.092 | 0.113 | 0.107 | 0.100 | 0.084 | 0.095\n\u00b7 | \u00b7 | \u00b7 | 0.094 | 0.118 | 0.097 | 0.112\n\u00b7 | \u00b7 | \u00b7 | 0.112 | 0.123 | 0.085 | 0.108\n\u00b7 | \u00b7 | \u00b7 | 0.084 | 0.123 | 0.091 | 0.157\n\u00b7 | \u00b7 | \u00b7 | 0.165 | 0.108 | 0.071 | 0.105\n\u00b7 | \u00b7 | \u00b7 | 0.132 | 0.113 | 0.081 | 0.102\n\u00b7 | \u00b7 | \u00b7 | 0.184 | 0.115 | 0.080 | 0.117\n\u00b7 | \u00b7 | \u00b7 | 0.087 | 0.139 | 0.099 | 0.148\n\u00b7 | \u00b7 | \u00b7 | \u00b7 | \u00b7 | 0.105 | 0.148\n\u00b7 | \u00b7 | \u00b7 | \u00b7 | \u00b7 | 0.106 | 0.171\n\u00b7 | \u00b7 | \u00b7 | \u00b7 | \u00b7 | 0.078 | 0.176\n\u00b7 | \u00b7 | \u00b7 | \u00b7 | \u00b7 | 0.120 | 0.201\n\u00b7 | \u00b7 | \u00b7 | \u00b7 | \u00b7 | 0.321 | 0.186\n\u00b7 | \u00b7 | \u00b7 | \u00b7 | \u00b7 | 0.130 | 0.213\n\u00b7 | \u00b7 | \u00b7 | \u00b7 | \u00b7 | 0.086 | 0.249\n[   0.19s] xcheck vs run14 map: DIFF [(('L0H4', 'r3fc'), 0.165, 0.186)]\n== r3fc absolute contributors (same-layer L3 heads included) ==\n  L3H3  abs=15.632\n  M2    abs= 8.112\n  M1    abs= 7.307\n  M0    abs= 6.159\n  L3H4  abs= 4.771\n  L0H4  abs= 4.243\n  L3H2  abs= 4.166\n  L3H0  abs= 3.359\n  L1H0  abs= 3.166\n  L2H5  abs= 3.162\n  L2H1  abs= 2.643\n  L3H5  abs= 2.632\n== B: donor-detector census (top-weighted W_fc.3 units; 0.12 = 3x random) ==\n[   0.24s] census top-64 frac >=0.12: 0.625 | all-1536 frac: 0.4948\n  unit  985  cos=0.287  mode=H4  main_u=u1\n  unit 1346  cos=0.263  mode=H0  main_u=u2\n  unit 1534  cos=0.252  mode=H0  main_u=u1\n  unit 1328  cos=0.242  mode=H0  main_u=u1\n  unit  257  cos=0.236  mode=H4  main_u=u3\n[   0.24s] wrote METRICS.md\n[   0.24s] === exit ===\n"}
{"t": 1793709345.4069629, "s": 0.14, "code": "import faulthandler, sys, time, os, glob, traceback\nimport numpy as np\nRUN_TAG = \"run18\"\n_t0 = time.time(); _logf = open(\"runlog.txt\", \"a\", buffering=1)\ndef log(*a):\n    m = f\"[{time.time()-_t0:7.2f}s] \" + \" \".join(map(str, a))\n    print(m, flush=True); _logf.write(m + \"\\n\")\nlog(\"=== start ===\", RUN_TAG, sys.version.split()[0])\nfaulthandler.enable(sys.stderr); faulthandler.dump_traceback_later(120, exit=True)\nclass Tee:\n    def __init__(self, *fs): self.fs = fs\n    def write(self, x):\n        for f in self.fs: f.write(x); f.flush()\n    def flush(self):\n        for f in self.fs: f.flush()\nsys.stdout = Tee(sys.stdout, open(f\"out_{RUN_TAG}.txt\", \"w\"))\nKEYS = [f\"{n}.{l}\" for l in range(4) for n in\n        (\"W_q\",\"W_k\",\"W_v\",\"W_o\",\"W_fc\",\"W_proj\",\"ln1_w\",\"ln1_b\",\"ln2_w\",\"ln2_b\")]\nwith np.load(\"blocks.npz\", allow_pickle=False) as z:\n    T = {k: np.asarray(z[k], np.float32) for k in z.files}\nlog(\"loaded:\", len(T), \"keys\")\nfor k, ref in ((\"W_fc.0\",51.650),(\"W_proj.3\",85.089),(\"W_q.2\",37.483),(\"W_k.1\",28.602),(\"ln1_w.0\",6.724)):\n    n = float(np.linalg.norm(T[k])); log(f\"fro[{k}]={n:.3f}\", \"OK\" if abs(n-ref) < 0.05 else \"MISMATCH\")\n    if abs(n-ref) >= 0.05: raise RuntimeError(\"loader validation failed\")\nL, H, dh, d = 4, 6, 64, 384\nWQ = [T[f\"W_q.{l}\"] for l in range(L)]; WK = [T[f\"W_k.{l}\"] for l in range(L)]\nWV = [T[f\"W_v.{l}\"] for l in range(L)]; WO = [T[f\"W_o.{l}\"] for l in range(L)]\ndef fro(x): return float(np.linalg.norm(x))\ndef rankcorr(a, b):\n    a = np.asarray(a, float).ravel(); b = np.asarray(b, float).ravel()\n    ra = np.empty(a.size); ra[np.argsort(a)] = np.arange(a.size)\n    rb = np.empty(b.size); rb[np.argsort(b)] = np.arange(b.size)\n    return float(np.corrcoef(ra, rb)[0, 1])\nnp.set_printoptions(precision=3, suppress=True, linewidth=200)\nGOLD_N = {\"L0\":[(4.13,4.91,5.35,5.21),(12.46,12.64,9.26,10.20),(6.46,6.83,5.99,5.54),\n                (6.63,6.82,4.88,5.47),(2.17,2.62,8.28,8.94),(15.90,15.96,9.41,10.60)],\n          \"L1\":[(10.56,9.83,12.95,11.17),(14.53,12.80,11.06,10.66),(12.69,11.35,12.12,11.19),\n                (12.70,11.75,11.32,10.14),(12.59,11.51,10.92,9.91),(14.14,12.58,11.23,10.92)],\n          \"L2\":[(15.22,14.53,13.81,13.64),(14.68,14.47,14.68,14.21),(17.26,16.72,12.99,13.00),\n                (15.01,14.61,14.46,14.25),(15.58,15.20,13.47,13.50),(13.84,13.30,15.55,15.08)],\n          \"L3\":[(14.95,14.54,15.59,15.37),(13.43,13.31,15.61,15.27),(14.99,14.47,15.92,16.03),\n                (10.54,10.52,17.86,18.20),(13.65,13.26,16.27,16.26),(15.03,14.81,13.87,14.16)]}\nworst = 0.0\nfor l in range(L):\n    for h in range(H):\n        s = slice(h*dh, (h+1)*dh)\n        got = (fro(WQ[l][s, :]), fro(WK[l][s, :]), fro(WV[l][s, :]), fro(WO[l][:, s]))\n        worst = max(worst, max(abs(a-b) for a, b in zip(got, GOLD_N[f\"L{l}\"][h])))\nlog(\"partition regression, worst |d| =\", round(worst, 4))\nif worst > 0.05: raise RuntimeError(\"convention regression failed\")\ndef donor_O(l, h):\n    s = slice(h*dh, (h+1)*dh)\n    O = WO[l][:, s] @ WV[l][s, :]; assert O.shape == (d, d)\n    return O\nMX = {}\nfor l0 in range(L-1):\n    for l1 in range(l0+1, L):\n        for kind, WA in ((\"K\", WK), (\"Q\", WQ), (\"V\", WV)):\n            Mx = np.zeros((H, H))\n            for h0 in range(H):\n                O = donor_O(l0, h0); fo = fro(O)\n                for h1 in range(H):\n                    w = WA[l1][slice(h1*dh, (h1+1)*dh), :]\n                    Mx[h0, h1] = 100.0 * fro(w @ O) / max(fo * fro(w), 1e-9)\n            MX[(l0, l1, kind)] = Mx\n            log(\"digest\", (l0, l1, kind), int(np.round(Mx.sum()*10)),\n                int(np.round(Mx[0, 0]*10)), int(np.round(Mx[4, 2]*10)))\nGOLD_CK = {(0,1): np.array([[437,626,672,736,694,527],[136,93,96,91,95,97],[131,159,169,191,180,136],\n                [193,250,274,301,280,206],[429,675,709,762,705,581],[162,153,153,155,160,164]]),\n           (0,2): np.array([[256,121,317,359,369,212],[100,124,94,94,97,92],[125,133,122,124,191,136],\n                [129,100,148,162,166,115],[292,100,363,412,408,256],[125,151,144,120,126,106]]),\n           (0,3): np.array([[154,139,172,121,176,115],[99,100,98,99,95,134],[122,120,115,119,122,116],\n                [100,103,99,97,102,103],[204,145,246,146,246,104],[110,139,109,97,93,157]])}\nGOLD_CQ = {(0,1): np.array([[220,240,215,268,248,232],[173,146,142,132,140,151],[195,136,134,135,139,153],\n                [137,133,139,157,145,136],[185,216,206,257,227,192],[179,166,165,149,169,177]])}\nGOLD_CV = {(0,1): np.array([[83,69,71,73,67,71],[166,158,144,173,168,149],[156,90,102,90,96,91],\n                [83,77,76,76,75,77],[51,49,48,51,46,49],[186,252,223,278,252,237]])}\nfor key, Mx in MX.items():\n    l0, l1, kind = key\n    G = {\"K\": GOLD_CK, \"Q\": GOLD_CQ, \"V\": GOLD_CV}[kind].get((l0, l1))\n    if G is not None:\n        r = rankcorr(Mx, G); log(\"TOPO\", key, \"PASS\" if r > 0.6 else \"FAIL\", f\"rho={r:.2f}\")\n    elif Mx.max()/max(Mx.mean(), 1e-9) <= 1.8:\n        log(\"TOPO\", key, \"PASS (flat)\")\n    else:\n        log(\"TOPO\", key, \"FAIL (unexpected structure)\")\n\n# ============== run18: per-mode lane decomposition ==============\ndef sv_dir(M, k):\n    U, S, _ = np.linalg.svd(M, full_matrices=False)\n    return U[:, :k], S[:k]\nRd3, _ = sv_dir(T[\"W_fc.3\"], 4)          # (384,4) final read span\nUw3, _ = sv_dir(T[\"W_proj.3\"], 4)        # (384,4) final write span\nXCHK = {(\"L3H3\", \"r3fc\"): 0.321, (\"L0H0\", \"r0fc\"): 0.359, (\"M2\", \"r3fc\"): 0.105}\ndef share(W, B): return fro(B.T @ W) / fro(W)\nbad = [k for k, v in XCHK.items() if abs(share(\n    donor_O(*[int(k[0][1]), int(k[0][3])]), Rd3) - XCHK[k]) > 2e-3] if not True else [\n    k for k, v in XCHK.items() if k[0][0] == \"L\"]\nseen = {(\"L3H3\", \"r3fc\"): share(donor_O(3, 3), Rd3),\n        (\"L0H0\", \"r0fc\"): share(donor_O(0, 0), sv_r(T[\"W_fc.0\"], 4)),\n        (\"M2\",   \"r3fc\"): share(T[\"W_proj.2\"], Rd3)}\nbad = [(k, round(seen[k], 3), v) for k, v in XCHK.items() if abs(seen[k]-v) > 2e-3]\nlog(\"xcheck vs run17 map:\", \"OK\" if not bad else f\"DIFF {bad}\")\n\nprint(\"== lane decomposition: writers -> W_fc.3 top-4 span, per-mode ==\")\nprint(\"writer | total_abs | mode contributions (m#, sigma, abs, share-of-writer)\")\nsel = [(\"L3H3\", donor_O(3, 3)), (\"L3H4\", donor_O(3, 4)), (\"L3H0\", donor_O(3, 0)),\n       (\"L3H2\", donor_O(3, 2)), (\"L0H4\", donor_O(0, 4)),\n       (\"M2\", T[\"W_proj.2\"]), (\"M1\", T[\"W_proj.1\"]), (\"M0\", T[\"W_proj.0\"])]\nstore = {}\nfor nm, W in sel:\n    U, S = sv_dir(W, 3)\n    p = np.linalg.norm(Rd3.T @ U, axis=0)          # per-mode span-projection norms\n    tot = float(np.sqrt((S[:3]*p)**2 + max(fro(W)**2 - (S[:3]**2).sum(), 0)))  # exact: fro^2 of RdT@W incl tail\n    tail_abs = fro(Rd3.T @ W)\n    frac = (S[:3]*p)**2 / max(tail_abs**2, 1e-12)\n    parts = [f\"m{m+1} s={S[m]:.2f} abs={(S[m]*p[m]):.2f} fr={100*frac[m]:4.1f}%\" for m in range(3)]\n    print(f\"{nm:5s} | abs={tail_abs:6.3f} | \" + \" ; \".join(parts))\n    store[nm] = (tail_abs, float(tail_abs/fro(W)))\ntop_un = sorted(store.items(), key=lambda t: -t[1][0])[:3]\n\nprint(\"== also: L3H3 vs final WRITE span (r3pr=0.186 known) ==\")\nO33 = donor_O(3, 3)\nprint(\"L3H3 share into Uw3:\", round(share(O33, Uw3), 3))\nTu = np.linalg.svd(O33, full_matrices=False)\np_u = np.linalg.norm(Uw3.T @ Tu[0][:, :3], axis=0)\nprint(\"L3H3 per-mode shares vs write span:\",\n      [f\"{(Tu[1][m]*p_u[m])**2/(Tu[1]**2).sum():.2f}\" for m in range(3)])\nlog(\"M3FINAL: top3 r3fc writers:\", [(nm, round(a, 2), round(sh, 3)) for nm, (a, sh) in top_un])\nlog(\"=== exit ===\")\n", "out": "[   0.00s] === start === run18 3.12.13\n[   0.01s] loaded: 40 keys\n[   0.01s] fro[W_fc.0]=51.650 OK\n[   0.01s] fro[W_proj.3]=85.089 OK\n[   0.01s] fro[W_q.2]=37.483 OK\n[   0.01s] fro[W_k.1]=28.602 OK\n[   0.01s] fro[ln1_w.0]=6.724 OK\n[   0.0