, :]\n    assert O.shape == (384, 384)\n    return O\n\nprint(\"== fdef per-head OV (O384) ==\")\nprint(\"head |    s1     fro  effrk   tr/d  sv2/sv1\")\nfor l in range(L):\n    for h in range(H):\n        O = donor_O(l, h); sv = np.linalg.svd(O, compute_uv=False)\n        er = float(sv.sum()**2 / (sv**2).sum())\n        print(f\"L{l}H{h} | {sv[0]:7.3f} {fro(O):7.3f} {er:6.2f} {float(np.trace(O))/d:7.3f} {sv[1]/sv[0]:6.3f}\")\n\ndef rankcorr(a, b):\n    a = np.asarray(a, float).ravel(); b = np.asarray(b, float).ravel()\n    ra = np.empty(a.size); ra[np.argsort(a)] = np.arange(a.size)\n    rb = np.empty(b.size); rb[np.argsort(b)] = np.arange(b.size)\n    return float(np.corrcoef(ra, rb)[0, 1])\nGOLD_CK = {\n (0,1): np.array([[437,626,672,736,694,527],[136,93,96,91,95,97],[131,159,169,191,180,136],\n                  [193,250,274,301,280,206],[429,675,709,762,705,581],[162,153,153,155,160,164]]),\n (0,2): np.array([[256,121,317,359,369,212],[100,124,94,94,97,92],[125,133,122,124,191,136],\n                  [129,100,148,162,166,115],[292,100,363,412,408,256],[125,151,144,120,126,106]]),\n (0,3): np.array([[154,139,172,121,176,115],[99,100,98,99,95,134],[122,120,115,119,122,116],\n                  [100,103,99,97,102,103],[204,145,246,146,246,104],[110,139,109,97,93,157]])}\nGOLD_CQV = {\n (0,1,\"Q\"): np.array([[220,240,215,268,248,232],[173,146,142,132,140,151],[195,136,134,135,139,153],\n                      [137,133,139,157,145,136],[185,216,206,257,227,192],[179,166,165,149,169,177]]),\n (0,1,\"V\"): np.array([[83,69,71,73,67,71],[166,158,144,173,168,149],[156,90,102,90,96,91],\n                      [83,77,76,76,75,77],[51,49,48,51,46,49],[186,252,223,278,252,237]])}\n\nprint(\"== fdef composition (x100; rows=donors H0..H5) ==\")\nres = []\nfor l0 in range(L-1):\n    for l1 in range(l0+1, L):\n        for kind, WA in ((\"K\", WK), (\"Q\", WQ), (\"V\", WV)):\n            Mx = np.zeros((H, H))\n            for h0 in range(H):\n                O = donor_O(l0, h0); fo = fro(O)\n                for h1 in range(H):\n                    w = WA[l1][slice(h1*dh, (h1+1)*dh), :]\n                    P = w @ O\n                    Mx[h0, h1] = 100.0 * fro(P) / max(fo * fro(w), 1e-9)\n            print(f\" l0=L{l0} -> l1=L{l1} ({kind}-comp):\"); print(np.round(Mx).astype(int))\n            key = None\n            if (l0, l1, kind) in GOLD_CQV: key, G = (l0, l1, kind), GOLD_CQV[(l0, l1, kind)]\n            elif kind == \"K\" and (l0, l1) in GOLD_CK: key, G = (l0, l1, kind), GOLD_CK[(l0, l1)]\n            if key is not None:\n                r = rankcorr(Mx, G); res.append((key, r))\n                log(\"TOPO\", key, \"PASS\" if r > 0.6 else \"FAIL\", f\"rho={r:.2f}\")\n            elif Mx.max() / max(Mx.mean(), 1e-9) <= 1.8:\n                res.append((None, 1.0)); log(\"TOPO\", (l0, l1, kind), \"PASS (flat)\")\n            else:\n                res.append((None, -1.0)); log(\"TOPO\", (l0, l1, kind), \"FAIL (unexpected structure)\")\nlog(\"TOPO summary:\", [(str(k) if k else \"flatpair\", round(r, 2)) for k, r in res])\nlog(\"=== exit ===\")\n", "out": "[   0.00s] === start === run10 3.12.13\n[   0.00s] loaded: 40 keys\n[   0.00s] schema: OK\n[   0.00s] fro[W_fc.0]=51.650 ref=51.650 OK\n[   0.00s] fro[W_proj.3]=85.089 ref=85.089 OK\n[   0.01s] fro[W_q.2]=37.483 ref=37.483 OK\n[   0.01s] fro[W_k.1]=28.602 ref=28.602 OK\n[   0.01s] fro[ln1_w.0]=6.724 ref=6.724 OK\n== LOCKED CONVENTIONS ==\n q/k/v: head h = rows h*64:(h+1)*64   ->  q_h = W_q[h] @ x\n o    : head h = cols h*64:(h+1)*64   ->  out_h = W_o[:,h] @ (W_v[h] @ x)\n M384 = Wq_h.T @ Wk_h ; M64 = Wq_h @ Wk_h.T ;  O384 = W_o[:,h] @ W_v[h] ; O64 = W_v[h] @ W_o[:,h]\n[   0.01s] partition regression, worst |d| = 0.005\n[   0.23s] svM err/head: {'M384': 8.552, 'M64': 7.399} best: M64\n[   0.23s] svOV err/head: {'O384': 6.1773, 'O64': 6.5819} best: O384\n== fdef per-head OV (O384) ==\nhead |    s1     fro  effrk   tr/d  sv2/sv1\nL0H0 |   6.898   8.667   8.57   0.004  0.565\nL0H1 |   4.7