{"t": 1793707951.658637, "s": 0.14, "code": "import faulthandler, sys, time, os, glob, traceback\nimport numpy as np\nRUN_TAG = \"run12\"\n_t0 = time.time()\n_logf = open(\"runlog.txt\", \"a\", buffering=1)\ndef log(*a):\n    m = f\"[{time.time()-_t0:7.2f}s] \" + \" \".join(map(str, a))\n    print(m, flush=True); _logf.write(m + \"\\n\")\nlog(\"=== start ===\", RUN_TAG, sys.version.split()[0])\nfaulthandler.enable(sys.stderr); faulthandler.dump_traceback_later(120, exit=True)\nclass Tee:\n    def __init__(self, *fs): self.fs = fs\n    def write(self, x):\n        for f in self.fs: f.write(x); f.flush()\n    def flush(self):\n        for f in self.fs: f.flush()\nsys.stdout = Tee(sys.stdout, open(f\"out_{RUN_TAG}.txt\", \"w\"))\nKEYS = [f\"{n}.{l}\" for l in range(4) for n in\n        (\"W_q\",\"W_k\",\"W_v\",\"W_o\",\"W_fc\",\"W_proj\",\"ln1_w\",\"ln1_b\",\"ln2_w\",\"ln2_b\")]\nwith np.load(\"blocks.npz\", allow_pickle=False) as z:\n    T = {k: np.asarray(z[k], np.float32) for k in z.files}\nlog(\"loaded:\", len(T), \"keys\")\nfor k, ref in ((\"W_fc.0\",51.650),(\"W_proj.3\",85.089),(\"W_q.2\",37.483),(\"W_k.1\",28.602),(\"ln1_w.0\",6.724)):\n    n = float(np.linalg.norm(T[k]))\n    log(f\"fro[{k}]={n:.3f}\", \"OK\" if abs(n-ref) < 0.05 else \"MISMATCH\")\n    if abs(n-ref) >= 0.05: raise RuntimeError(\"loader validation failed\")\n\nL, H, dh, d = 4, 6, 64, 384\nWQ = [T[f\"W_q.{l}\"] for l in range(L)]; WK = [T[f\"W_k.{l}\"] for l in range(L)]\nWV = [T[f\"W_v.{l}\"] for l in range(L)]; WO = [T[f\"W_o.{l}\"] for l in range(L)]\ndef fro(x): return float(np.linalg.norm(x))\ndef sv4(x): return np.linalg.svd(x, compute_uv=False)[:4]\ndef rankcorr(a, b):\n    a = np.asarray(a, float).ravel(); b = np.asarray(b, float).ravel()\n    ra = np.empty(a.size); ra[np.argsort(a)] = np.arange(a.size)\n    rb = np.empty(b.size); rb[np.argsort(b)] = np.arange(b.size)\n    return float(np.corrcoef(ra, rb)[0, 1])\nnp.set_printoptions(precision=3, suppress=True, linewidth=200)\n\nGOLD_Z = {\n \"L0\":[(6.46,.27,24.02,8.67,.36,23.87),(32.53,.98,33.10,17.07,.27,63.48),(9.09,.25,35.84,8.59,.25,34.48),\n       (11.47,.44,25.84,5.29,.13,39.86),(.77,.02,43.37,25.79,1.17,22.05),(46.28,.77,59.88,18.56,.31,60.01)],\n \"L1\":[(19.77,.58,33.82,27.50,.56,49.12),(38.04,1.33,28.67,19.96,.34,58.37),(28.94,.90,32.10,23.71,.40,59.21),\n       (30.21,1.04,28.92,20.85,.38,54.61),(29.18,1.00,29.24,19.57,.35,55.59),(37.56,1.33,28.24,20.35,.33,61.20)],\n \"L2\":[(30.02,.54,55.54,25.17,.31,81.56),(28.88,.51,56.51,28.89,.46,63.41),(41.77,.85,48.91,22.62,.27,84.52),\n       (29.18,.63,46.68,27.63,.32,85.11),(32.90,.73,45.34,24.78,.32,76.30),(24.33,.46,53.23,31.88,.45,71.44)],\n \"L3\":[(28.00,.32,86.76,31.62,.42,75.96),(22.92,.28,81.73,33.15,.51,65.16),(27.79,.41,67.30,34.64,.65,53.58),\n       (14.27,.24,59.50,48.68,.97,50.06),(23.44,.36,64.29,36.64,.64,57.13),(28.65,.28,100.80,30.62,.77,39.96)],\n}\nrng = np.random.default_rng(0); NP = 6\nprint(\"== AUDIT A: zM/zOV identity + permutation baselines ==\")\nprint(\"head | zM_g zM_fro | zO_g zO_fro | bM_g bM_p | bO_g bO_p\")\naM = aO = abm = abo = 0.0\nfor l in range(L):\n    for h in range(H):\n        s = slice(h*dh, (h+1)*dh)\n        q, k, v, o = WQ[l][s, :], WK[l][s, :], WV[l][s, :], WO[l][:, s]\n        zM = fro(q.T @ k); zO = fro(o @ v)\n        pm, po = [], []\n        for _ in range(NP):\n            qi, ki = q[rng.permutation(dh), :], k[rng.permutation(dh), :]\n            vi2, oi = v[rng.permutation(dh), :], o[:, rng.permutation(dh)]\n            pm.append(fro(qi.T @ ki)); po.append(fro(oi @ vi2))\n        bp, bo = float(np.mean(pm)), float(np.mean(po))\n        zMg, bgM, rMg, zOg, bgO, rOg = GOLD_Z[f\"L{l}\"][h]\n        aM = max(aM, abs(zM - zMg)); aO = max(aO, abs(zO - zOg))\n        abm = max(abm, abs(bp - bgM)); abo = max(abo, abs(bo - bgO))\n        print(f\"L{l}H{h} | {zMg:6.2f} {zM:6.2f} | {zOg:6.2f} {zO:6.2f} | {bgM:5.3f} {bp:5.3f} | {bgO:5.3f} {bo:5.3f}\")\nlog(\"auditzM:\", \"MATCH\" if aM < 0.06 else \"unresolved\", round(aM, 3),\n    \"| zO:\", \"MATCH\" if aO < 0.06 else \"partial\", round(aO, 3),\n    \"| baseM perm:\", \"MATCH\" if abm < 0.08 else \"mismatch\", round(abm, 3),\n    \"| baseO perm:\", \"MATCH\" if abo < 0.08 else \"mismatch\", round(abo, 3))\n\nprint(\"== AUDIT B: gold composition normalization / Q-operator sweep ==\")\nDM = {}\nfor l0 in range(L-1):\n    for l1 in range(l0+1, L):\n        for kind, WA in ((\"K\", WK), (\"Q\", WQ), (\"V\", WV)):\n            Pn = np.zeros((H, H)); De = np.zeros((H, H))\n            for h0 in range(H):\n                s0 = slice(h0*dh, (h0+1)*dh)\n                O = WO[l0][:, s0] @ WV[l0][s0, :]\n                for h1 in range(H):\n                    s1 = slice(h1*dh, (h1+1)*dh)\n                    w = WA[l1][s1, :]\n                    Pn[h0, h1] = fro(w @ O); De[h0, h1] = fro(O) * fro(w)\n            DM[(l0, l1, kind)] = (Pn, De)\nGOLD_T = {(0,1,\"K\"): [437,626,672,736,694,527,136,93,96,91,95,97,131,159,169,191,180,136,\n                     193,250,274,301,280,206,429,675,709,762,705,581,162,153,153,155,160,164],\n          (0,2,\"K\"): [256,121,317,359,369,212,100,124,94,94,97,92,125,133,122,124,191,136,\n                     129,100,148,162,166,115,292,100,363,412,408,256,125,151,144,120,126,106],\n          (0,3,\"K\"): [154,139,172,121,176,115,99,100,98,99,95,134,122,120,115,119,122,116,\n                     100,103,99,97,102,103,204,145,246,146,246,104,110,139,109,97,93,157],\n          (0,1,\"V\"): [83,69,71,73,67,71,166,158,144,173,168,149,156,90,102,90,96,91,\n                     83,77,76,76,75,77,51,49,48,51,46,49,186,252,223,278,252,237],\n          (0,1,\"Q\"): [220,240,215,268,248,232,173,146,142,132,140,151,195,136,134,135,139,153,\n                     137,133,139,157,145,136,185,216,206,257,227,192,179,166,165,149,169,177]}\nsqd = float(np.sqrt(d))\nfor key in [(0,1,\"K\"), (0,2,\"K\"), (0,3,\"K\"), (0,1,\"V\")]:\n    Pn, De = DM[key]; g = np.array(GOLD_T[key], float)\n    c = sqd * 100.0 * Pn.ravel() / De.ravel()\n    s = (c*g).sum() / (c*c).sum()\n    rel = float(np.linalg.norm(s*c - g) / np.linalg.norm(g))\n    log(\"KV\", key, f\"s={s:.3f} rel_res={100*rel:.1f}%\", \n        \"CLOSED\" if rel < 0.04 else \"check\", f\"rho={rankcorr(c, g):.2f}\")\nfor mode in (\"w_at_O\", \"O_at_wT\", \"donor_q\"):\n    c = np.zeros(36)\n    for h0 in range(H):\n        s0 = slice(h0*dh, (h0+1)*dh)\n        O = WO[0][:, s0] @ WV[0][s0, :]\n        for h1 in range(H):\n            s1 = slice(h1*dh, (h1+1)*dh)\n            w = WQ[1][s1, :]\n            P = (w @ O) if mode == \"w_at_O\" else ((O @ w.T) if mode == \"O_at_wT\" else (WQ[0][s0, :] @ O))\n            c[h0*6+h1] = sqd * 100.0 * fro(P) / (fro(O) * fro(w))\n    g = np.array(GOLD_T[(0,1,\"Q\")], float)\n    s = (c*g).sum()/(c*c).sum(); rel = float(np.linalg.norm(s*c - g)/np.linalg.norm(g))\n    log(\"Q\", mode, f\"s={s:.3f} rel_res={100*rel:.1f}%\", f\"rho={rankcorr(c, g):.2f}\")\n\nprint(\"== NEW: L3 readout alignment (W_proj.3 left-sv vs head O left-sv) ==\")\nU3, S3, _ = np.linalg.svd(T[\"W_proj.3\"], full_matrices=False)\nassert U3.shape == (d, d)\nprint(\"W_proj.3 sv[:6] =\", np.round(S3[:6], 3),\n      \"e8% =\", round(100*float((S3[:8]**2).sum()/(S3**2).sum()), 1))\nu4 = U3[:, :4]\nfor h in range(H):\n    s = slice(h*dh, (h+1)*dh)\n    Uo, _, _ = np.linalg.svd(WO[3][:, s], full_matrices=False)\n    A = np.abs(u4.T @ Uo[:, :4])\n    print(f\"L3H{h}: max_align={A.max():.3f} mean_align={A.mean():.3f}\")\nlog(\"=== exit ===\")\n", "out": "[   0.00s] === start === run12 3.12.13\n[   0.01s] loaded: 40 keys\n[   0.01s] fro[W_fc.0]=51.650 OK\n[   0.01s] fro[W_proj.3]=85.089 OK\n[   0.01s] fro[W_q.2]=37.483 OK\n[   0.01s] fro[W_k.1]=28.602 OK\n[   0.01s] fro[ln1_w.0]=6.724 OK\n== AUDIT A: zM/zOV identity + permutation baselines ==\nhead | zM_g zM_fro | zO_g zO_fro | bM_g bM_p | bO_g bO_p\nL0H0 |   6.46   6.46 |   8.67   8.67 | 0.270 2.408 | 0.360 3.598\nL0H1 |  32.53  32.53 |  17.07  17.07 | 0.980 20.352 | 0.270 12.290\nL0H2 |   9.09   9.09 |   8.59   8.59 | 0.250 5.435 | 0.250 4.139\nL0H3 |  11.47  11.47 |   5.29   5.29 | 0.440 5.491 | 0.130 3.391\nL0H4 |   0.77   0.77 |  25.79  25.79 | 0.020 0.713 | 1.170 9.387\nL0H5 |  46.28  46.28 |  18.56  18.56 | 0.770 31.607 | 0.310 12.458\nL1H0 |  19.77  19.77 |  27.50  27.50 | 0.580 12.904 | 0.560 17.878\nL1H1 |  38.04  38.04 |  19.96  19.96 | 1.330 23.000 | 0.340 14.869\nL1H2 |  28.94  28.94 |  23.71  23.71 | 0.900 17.734 | 0.400 16.872\nL1H3 |  30.21  30.21 |  20.85  20.85 | 1.040 18.679 | 0.380 14.382\nL1H4 |  29.18  29.18 |  19.57  19.57 | 1.000 17.837 | 0.350 13.489\nL1H5 |  37.56  37.56 |  20.35  20.35 | 1.330 22.455 | 0.330 15.375\nL2H0 |  30.02  30.02 |  25.17  25.17 | 0.540 27.631 | 0.310 23.554\nL2H1 |  28.88  28.88 |  28.89  28.89 | 0.510 26.565 | 0.460 26.066\nL2H2 |  41.77  41.77 |  22.62  22.62 | 0.850 36.070 | 0.270 21.102\nL2H3 |  29.18  29.18 |  27.63  27.63 | 0.630 27.498 | 0.320 25.761\nL2H4 |  32.90  32.90 |  24.78  24.78 | 0.730 29.574 | 0.320 22.761\nL2H5 |  24.33  24.33 |  31.88  31.88 | 0.460 23.064 | 0.450 29.342\nL3H0 |  28.00  28.00 |  31.62  31.62 | 0.320 27.167 | 0.420 29.925\nL3H1 |  22.92  22.92 |  33.15  33.15 | 0.280 22.339 | 0.510 29.756\nL3H2 |  27.79  27.79 |  34.64  34.64 | 0.410 27.107 | 0.650 31.923\nL3H3 |  14.27  14.27 |  48.68  48.68 | 0.240 13.862 | 0.970 40.654\nL3H4 |  23.44  23.44 |  36.64  36.64 | 0.360 22.640 | 0.640 33.020\nL3H5 |  28.65  28.65 |  30.62  30.62 | 0.280 27.820 | 0.770 24.610\n[   0.02s] auditzM: MATCH 0.005 | zO: MATCH 0.005 | baseM perm: mismatch 35.22 | baseO perm: mismatch 39.684\n== AUDIT B: gold composition normalization / Q-operator sweep ==\n[   0.04s] KV (0, 1, 'K') s=1.102 rel_res=8.4% check rho=0.96\n[   0.04s] KV (0, 2, 'K') s=0.900 rel_res=7.9% check rho=0.97\n[   0.04s] KV (0, 3, 'K') s=0.972 rel_res=5.9% check rho=0.98\n[   0.04s] KV (0, 1, 'V') s=0.997 rel_res=0.3% CLOSED rho=1.00\n[   0.04s] Q w_at_O s=1.188 rel_res=26.2% rho=0.36\n[   0.04s] Q O_at_wT s=1.201 rel_res=33.6% rho=-0.64\n[   0.04s] Q donor_q s=1.399 rel_res=51.1% rho=-0.02\n== NEW: L3 readout alignment (W_proj.3 left-sv vs head O left-sv) ==\nW_proj.3 sv[:6] = [28.175 20.293 19.292 19.135 18.708 18.57 ] e8% = 45.4\nL3H0: max_align=0.401 mean_align=0.109\nL3H1: max_align=0.173 mean_align=0.070\nL3H2: max_align=0.591 mean_align=0.089\nL3H3: max_align=0.319 mean_align=0.078\nL3H4: max_align=0.506 mean_align=0.097\nL3H5: max_align=0.447 mean_align=0.119\n[   0.07s] === exit ===\n"}
{"t": 1793708289.04323, "s": 0.43, "code": "import faulthandler, sys, time, os, glob, traceback\nimport numpy as np\nRUN_TAG = \"run13\"\n_t0 = time.time(); _logf = open(\"runlog.txt\", \"a\", buffering=1)\ndef log(*a):\n    m = f\"[{time.time()-_t0:7.2f}s] \" + \" \".join(map(str, a))\n    print(m, flush=True); _logf.write(m + \"\\n\")\nlog(\"=== start ===\", RUN_TAG, sys.version.split()[0])\nfaulthandler.enable(sys.stderr); faulthandler.dump_traceback_later(120, exit=True)\nclass Tee:\n    def __init__(self, *fs): self.fs = fs\n    def write(self, x):\n        for f in self.fs: f.write(x); f.flush()\n    def flush(self):\n        for f in self.fs: f.flush()\nsys.stdout = Tee(sys.stdout, open(f\"out_{RUN_TAG}.txt\", \"w\"))\nKEYS = [f\"{n}.{l}\" for l in range(4) for n in\n        (\"W_q\",\"W_k\",\"W_v\",\"W_o\",\"W_fc\",\"W_proj\",\"ln1_w\",\"ln1_b\",\"ln2_w\",\"ln2_b\")]\nwith np.load(\"blocks.npz\", allow_pickle=False) as z:\n    T = {k: np.asarray(z[k], np.float32) for k in z.files}\nlog(\"loaded:\", len(T), \"keys\")\nfor k, ref in ((\"W_fc.0\",51.650),(\"W_proj.3\",85.089),(\"W_q.2\",37.483),(\"W_k.1\",28.602),(\"ln1_w.0\",6.724)):\n    n = float(np.linalg.norm(T[k])); log(f\"fro[{k}]={n:.3f}\", \"OK\" if abs(n-ref) < 0.05 else \"MISMATCH\")\n    if abs(n-ref) >= 0.05: raise RuntimeError(\"loader validation failed\")\nL, H, dh, d = 4, 6, 64, 384\nWQ = [T[f\"W_q.{l}\"] for l in range(L)]; WK = [T[f\"W_k.{l}\"] for l in range(L)]\nWV = [T[f\"W_v.{l}\"] for l in range(L)]; WO = [T[f\"W_o.{l}\"] for l in range(L)]\nLN1 = [T[f\"ln1_w.{l}\"] for l in range(L)]\ndef fro(x): return float(np.linalg.norm(x))\ndef sv4(x): return np.linalg.svd(x, compute_uv=False)[:4]\nnp.set_printoptions(precision=3, suppress=True, linewidth=200)\nGOLD_N = {  # regression: per-head (4,) fro blocks\n \"L0\":[(4.13,4.91,5.35,5.21),(12.46,12.64,9.26,10.20),(6.46,6.83,5.99,5.54),\n       (6.63,6.82,4.88,5.47),(2.17,2.62,8.28,8.94),(15.90,15.96,9.41,10.60)],\n \"L1\":[(10.56,9.83,12.95,11.17),(14.53,12.80,11.06,10.66),(12.69,11.35,12.12,11.19),\n       (12.70,11.75,11.32,10.14),(12.59,11.51,10.92,9.91),(14.14,12.58,11.23,10.92)],\n \"L2\":[(15.22,14.53,13.81,13.64),(14.68,14.47,14.68,14.21),(17.26,16.72,12.99,13.00),\n       (15.01,14.61,14.46,14.25),(15.58,15.20,13.47,13.50),(13.84,13.30,15.55,15.08)],\n \"L3\":[(14.95,14.54,15.59,15.37),(13.43,13.31,15.61,15.27),(14.99,14.47,15.92,16.03),\n       (10.54,10.52,17.86,18.20),(13.65,13.26,16.27,16.26),(15.03,14.81,13.87,14.16)]}\nworst = 0.0\nfor l in range(L):\n    for h in range(H):\n        s = slice(h*dh, (h+1)*dh)\n        got = (fro(WQ[l][s, :]), fro(WK[l][s, :]), fro(WV[l][s, :]), fro(WO[l][:, s]))\n        worst = max(worst, max(abs(a-b) for a, b in zip(got, GOLD_N[f\"L{l}\"][h])))\nlog(\"partition regression, worst |d| =\", round(worst, 4))\nif worst > 0.05: raise RuntimeError(\"convention regression failed\")\ndef donor_O(l, h):\n    s = slice(h*dh, (h+1)*dh)\n    O = WO[l][:, s] @ WV[l][s, :]; assert O.shape == (d, d)\n    return O\n\nprint(\"== A: composition formula hunt (s-free per table, rel_res, rho) ==\")\nGOLD = {\n (0,1,\"K\"): [437,626,672,736,694,527,136,93,96,91,95,97,131,159,169,191,180,136,\n             193,250,274,301,280,206,429,675,709,762,705,581,162,153,153,155,160,164],\n (0,2,\"K\"): [256,121,317,359,369,212,100,124,94,94,97,92,125,133,122,124,191,136,\n             129,100,148,162,166,115,292,100,363,412,408,256,125,151,144,120,126,106],\n (0,3,\"K\"): [154,139,172,121,176,115,99,100,98,99,95,134,122,120,115,119,122,116,\n             100,103,99,97,102,103,204,145,246,146,246,104,110,139,109,97,93,157],\n (0,1,\"Q\"): [220,240,215,268,248,232,173,146,142,132,140,151,195,136,134,135,139,153,\n             137,133,139,157,145,136,185,216,206,257,227,192,179,166,165,149,169,177],\n (0,2,\"Q\"): [172,151,203,213,232,155,104,93,107,108,106,103,115,129,94,116,102,143,\n             113,108,119,126,133,114,147,112,191,215,223,127,118,144,169,106,117,100],\n (0,3,\"Q\"): [81,93,93,126,109,102,93,89,98,95,94,116,92,104,113,125,128,102,\n             95,107,97,115,104,97,69,76,85,106,91,84,108,114,102,88,92,160],\n (0,1,\"V\"): [83,69,71,73,67,71,166,158,144,173,168,149,156,90,102,90,96,91,\n             83,77,76,76,75,77,51,49,48,51,46,49,186,252,223,278,252,237],\n (0,2,\"V\"): [51,63,69,59,62,55,97,105,97,101,97,92,87,98,84,88,86,88,\n             88,88,90,82,85,84,41,50,53,45,48,44,132,114,141,119,130,107],\n (0,3,\"V\"): [55,49,54,58,60,77,96,89,95,98,99,84,88,83,95,93,95,97,\n             90,84,92,96,94,81,45,40,48,46,50,87,112,103,105,95,102,96]}\nsqd = float(np.sqrt(d))\ndef build(l0, l1, kind, mode):\n    WA = {\"K\": WK, \"Q\": WQ, \"V\": WV}[kind]\n    Pn = np.zeros((H, H)); De = np.zeros((H, H))\n    for h0 in range(H):\n        s0 = slice(h0*dh, (h0+1)*dh)\n        O = donor_O(l0, h0)\n        if \"d\" in mode: Oe = O * LN1[l0][None, :]\n        else: Oe = O\n        for h1 in range(H):\n            s1 = slice(h1*dh, (h1+1)*dh)\n            w = WA[l1][s1, :]\n            if \"t\" in mode: w = w * LN1[l1][None, :]\n            P = w @ Oe\n            if mode == \"spec\": Pn[h0, h1] = float(np.linalg.svd(P, compute_uv=False)[0])\n            else: Pn[h0, h1] = fro(P)\n            De[h0, h1] = fro(Oe) * fro(w)\n    return 100.0 * sqd * Pn / De\nbase, best = {}, {}\nfor kind in (\"K\", \"Q\", \"V\"):\n    base[kind], best[kind] = {}, None\n    for l1 in (1, 2, 3):\n        g = np.array(GOLD[(0, l1, kind)], float)\n        for mode in (\"plain\", \"tgain\", \"dgain\", \"both\", \"spec\"):\n            c = build(0, l1, kind, mode).ravel()\n            s = (c*g).sum()/(c*c).sum()\n            rel = float(np.linalg.norm(s*c - g)/np.linalg.norm(g))\n            base[kind][(l1, mode)] = (s, rel)\n            if best[kind] is None or rel < best[kind][1]: best[kind] = ((l1, mode), rel)\nfor kind in (\"K\", \"Q\", \"V\"):\n    for (l1, mode), (s, rel) in sorted(base[kind].items()):\n        log(kind, l1, mode, f\"s={s:.3f} rel={100*rel:.1f}%\")\n    log(\"BEST\", kind, best[kind],\n        \"CLOSED\" if best[kind][1] < 0.03 else (\"NEAR\" if best[kind][1] < 0.10 else \"OPEN\"))\n# K plain per-target factor diagnostic\nPn, De = None, None\nc21 = build(0, 1, \"K\", \"plain\").reshape(H, H)\ng21 = np.array(GOLD[(0, 1, \"K\")], float).reshape(H, H)\nGt = np.median(g21 / np.maximum(c21, 1e-9), axis=0)\nzt = np.array([GOLD_Z_ZM] if False else [row for row in [\n (19.77, 13.76), (38.04, 11.93), (28.94, 10.26), (30.21, 10.19), (29.18, 13.15), (37.56, 10.20)]])\nprint(\"K plain per-target factor G_t:\", np.round(Gt, 3))\nprint(\"corr(G_t, zM_t) =\", round(float(np.corrcoef(Gt, zt[:,0])[0,1]), 3),\n      \" corr(G_t, nK_t) =\", round(float(np.corrcoef(Gt, zt[:,1])[0,1]), 3))\n\nprint(\"== B: L3 readout span energy (baseline sqrt(4/384) = 0.102) ==\")\nU3, S3, _ = np.linalg.svd(T[\"W_proj.3\"], full_matrices=False)\nu4 = U3[:, :4]\nVf3 = np.linalg.svd(T[\"W_fc.3\"], full_matrices=False)[2]   # read dirs = right sv of W_fc.3\nA3 = np.abs(Vf3[:4, :] @ u4)\nprint(\"W_fc.3-read vs W_proj.3-write max/mean alignment:\",\n      round(float(A3.max()), 3), \"/\", round(float(A3.mean()), 3))\nfor l in range(L):\n    row = []\n    for h in range(H):\n        O = donor_O(l, h)\n        row.append(fro(u4.T @ O) / fro(O))\n    print(f\"L{l}: span-energy f4 per head =\", np.round(row, 3))\n\ndef rankcorr(a, b):\n    a = np.asarray(a, float).ravel(); b = np.asarray(b, float).ravel()\n    ra = np.empty(a.size); ra[np.argsort(a)] = np.arange(a.size)\n    rb = np.empty(b.size); rb[np.argsort(b)] = np.arange(b.size)\n    return float(np.corrcoef(ra, rb)[0, 1])\nMX = {}\nfor l0 in range(L-1):\n    for l1 in range(l0+1, L):\n        for kind, WA in ((\"K\", WK), (\"Q\", WQ), (\"V\", WV)):\n            Mx = np.zeros((H, H))\n            for h0 in range(H):\n                O = donor_O(l0, h0); fo = fro(O)\n                for h1 in range(H):\n                    w = WA[l1][slice(h1*dh, (h1+1)*dh), :]\n                    Mx[h0, h1] = 100.0 * fro(w @ O) / max(fo * fro(w), 1e-9)\n            MX[(l0, l1, kind)] = Mx\n            log(\"digest\", (l0, l1, kind), int(np.round(Mx.sum()*10)),\n                int(np.round(Mx[0, 0]*10)), int(np.round(Mx[4, 2]*10)))\nfor key, Mx in MX.items():\n    l0, l1, kind = key\n    if (l0, l1, kind) in {(0,1,\"K\"), (0,2,\"K\"), (0,3,\"K\"), (0,1,\"Q\"), (0,1,\"V\")}:\n        G = {\"K\": GOLD, \"Q\": GOLD, \"V\": GOLD}\n        r = rankcorr(Mx, np.array(G[kind][(l0, l1, kind)]).reshape(H, H))\n        log(\"TOPO\", key, \"PASS\" if r > 0.6 else \"FAIL\", f\"rho={r:.2f}\")\n    elif Mx.max()/max(Mx.mean(), 1e-9) <= 1.8:\n        log(\"TOPO\", key, \"PASS (flat)\")\n    else:\n        log(\"TOPO\", key, \"FAIL (unexpected structure)\")\nlog(\"=== exit ===\")\n", "out": "[   0.00s] === start === run13 3.12.13\n[   0.00s] loaded: 40 keys\n[   0.01s] fro[W_fc.0]=51.650 OK\n[   0.01s] fro[W_proj.3]=85.089 OK\n[   0.01s] fro[W_q.2]=37.483 OK\n[   0.01s] fro[W_k.1]=28.602 OK\n[   0.01s] fro[ln1_w.0]=6.724 OK\n[   0.01s] partition regression, worst |d| = 0.005\n== A: composition formula hunt (s-free per table, rel_res, rho) ==\n[   0.30s] K 1 both s=0.884 rel=19.4%\n[   0.30s] K 1 dgain s=0.978 rel=16.0%\n[   0.30s] K 1 plain s=1.102 rel=8.4%\n[   0.30s] K 1 spec s=1.354 rel=11.8%\n[   0.30s] K 1 tgain s=0.884 rel=19.4%\n[   0.30s] K 2 both s=0.960 rel=12.0%\n[   0.30s] K 2 dgain s=0.811 rel=12.9%\n[   0.30s] K 2 plain s=0.900 rel=7.9%\n[   0.30s] K 2 spec s=1.128 rel=22.1%\n[   0.30s] K 2 tgain s=0.960 rel=12.0%\n[   0.30s] K 3 both s=1.080 rel=9.0%\n[   0.30s] K 3 dgain s=0.919 rel=9.8%\n[   0.30s] K 3 plain s=0.972 rel=5.9%\n[   0.30s] K 3 spec s=1.316 rel=30.3%\n[   0.30s] K 3 tgain s=1.080 rel=9.0%\n[   0.30s] BEST K ((3, 'plain'), 0.059477219119039644) NEAR\n[   0.30s] Q 1 both s=1.192 rel=22.8%\n[   0.30s] Q 1 dgain s=1.193 rel=27.1%\n[   0.30s] Q 1 plain s=1.188 rel=26.2%\n[   0.30s] Q 1 spec s=1.900 rel=13.6%\n[   0.30s] Q 1 tgain s=1.192 rel=22.8%\n[   0.30s] Q 2 both s=1.330 rel=32.4%\n[   0.30s] Q 2 dgain s=1.246 rel=23.6%\n[   0.30s] Q 2 plain s=1.248 rel=22.8%\n[   0.30s] Q 2 spec s=2.019 rel=20.5%\n[   0.30s] Q 2 tgain s=1.330 rel=32.4%\n[   0.30s] Q 3 both s=1.086 rel=12.9%\n[   0.30s] Q 3 dgain s=1.057 rel=8.5%\n[   0.30s] Q 3 plain s=1.032 rel=7.1%\n[   0.30s] Q 3 spec s=1.770 rel=29.5%\n[   0.30s] Q 3 tgain s=1.086 rel=12.9%\n[   0.30s] BEST Q ((3, 'plain'), 0.07072511198076924) NEAR\n[   0.30s] V 1 both s=1.027 rel=1.5%\n[   0.30s] V 1 dgain s=1.053 rel=3.9%\n[   0.30s] V 1 plain s=0.997 rel=0.3%\n[   0.30s] V 1 spec s=1.927 rel=27.3%\n[   0.30s] V 1 tgain s=1.027 rel=1.5%\n[   0.30s] V 2 both s=1.019 rel=5.3%\n[   0.30s] V 2 dgain s=1.039 rel=4.7%\n[   0.30s] V 2 plain s=0.994 rel=0.4%\n[   0.30s] V 2 spec s=1.968 rel=30.4%\n[   0.30s] V 2 tgain s=1.019 rel=5.3%\n[   0.30s] V 3 both s=1.014 rel=3.5%\n[   0.30s] V 3 dgain s=1.034 rel=5.7%\n[   0.30s] V 3 plain s=0.994 rel=0.4%\n[   0.30s] V 3 spec s=1.945 rel=27.7%\n[   0.30s] V 3 tgain s=1.014 rel=3.5%\n[   0.30s] BEST V ((1, 'plain'), 0.002770840012889537) CLOSED\nK plain per-target factor G_t: [1.071 1.015 1.152 1.149 1.122 0.932]\ncorr(G_t, zM_t) = -0.558  corr(G_t, nK_t) = 0.053\n== B: L3 readout span energy (baseline sqrt(4/384) = 0.102) ==\nW_fc.3-read vs W_proj.3-write max/mean alignment: 0.358 / 0.078\nL0: span-energy f4 per head = [0.333 0.095 0.168 0.16  0.399 0.112]\nL1: span-energy f4 per head = [0.154 0.102 0.13  0.092 0.115 0.095]\nL2: span-energy f4 per head = [0.108 0.157 0.105 0.102 0.117 0.148]\nL3: span-energy f4 per head = [0.171 0.176 0.201 0.186 0.213 0.249]\n[   0.35s] digest (0, 1, 'K') 5493 194 309\n[   0.35s] digest (0, 1, 'Q') 2643 80 64\n[   0.35s] digest (0, 1, 'V') 2153 43 25\n[   0.35s] digest (0, 2, 'K') 3582 158 232\n[   0.36s] digest (0, 2, 'Q') 2021 56 59\n[   0.36s] digest (0, 2, 'V') 1551 26 27\n[   0.36s] digest (0, 3, 'K') 2420 81 137\n[   0.36s] digest (0, 3, 'Q') 1800 40 39\n[   0.36s] digest (0, 3, 'V') 1505 29 25\n[   0.36s] digest (1, 2, 'K') 2033 67 57\n[   0.36s] digest (1, 2, 'Q') 2176 71 64\n[   0.36s] digest (1, 2, 'V') 1968 49 61\n[   0.36s] digest (1, 3, 'K') 1969 59 51\n[   0.36s] digest (1, 3, 'Q') 1911 55 51\n[   0.36s] digest (1, 3, 'V') 1712 45 50\n[   0.36s] digest (2, 3, 'K') 1912 51 49\n[   0.36s] digest (2, 3, 'Q') 1914 51 53\n[   0.37s] digest (2, 3, 'V') 1756 49 50\n[   0.37s] TOPO (0, 1, 'K') PASS rho=0.96\n[   0.37s] TOPO (0, 1, 'Q') FAIL rho=0.36\n[   0.37s] TOPO (0, 1, 'V') PASS rho=1.00\n[   0.37s] TOPO (0, 2, 'K') PASS rho=0.97\n[   0.37s] TOPO (0, 2, 'Q') PASS (flat)\n[   0.37s] TOPO (0, 2, 'V') PASS (flat)\n[   0.37s] TOPO (0, 3, 'K') PASS rho=0.98\n[   0.37s] TOPO (0, 3, 'Q') PASS (flat)\n[   0.37s] TOPO (0, 3, 'V') PASS (flat)\n[   0.37s] TOPO (1, 2, 'K') PASS (flat)\n[   0.37s] TOPO (1, 2, 'Q') PASS (flat)\n[   0.37s] TOPO (1, 2, 'V') PASS (flat)\n[   0.37s] TOPO (1, 3, 'K') PASS (flat)\n[   0.37s] TOPO (1, 3, 'Q') PASS (flat)\n[   0.37s] TOPO (1, 3, 'V') PASS (flat)\n[   0.37s] TOPO (2, 3, 'K') PASS (flat)\n[   0.37s] TOPO (2, 3, 'Q') PASS (flat)\n[   0.37s] TOPO (2, 3, 'V') PASS (flat)\n[   0.37s] === exit ===\n"}
{"t": 1793708537.8473191, "s": 0.34, "code": "import faulthandler, sys, time, os, glob, traceback\nimport numpy as np\nRUN_TAG = \"run14\"\n_t0 = time.time(); _logf = open(\"runlog.txt\", \"a\", buffering=1)\ndef log(*a):\n    m = f\"[{time.time()-_t0:7.2f}s] \" + \" \".join(map(str, a))\n    print(m, flush=True); _logf.write(m + \"\\n\")\nlog(\"=== start ===\", RUN_TAG, sys.version.split()[0])\nfaulthandler.enable(sys.stderr); faulthandler.dump_traceback_later(120, exit=True)\nclass Tee:\n    def __init__(self, *fs): self.fs = fs\n    def write(self, x):\n        for f in self.fs: f.write(x); f.flush()\n    def flush(self):\n        for f in self.fs: f.flush()\nsys.stdout = Tee(sys.stdout, open(f\"out_{RUN_TAG}.txt\", \"w\"))\nKEYS = [f\"{n}.{l}\" for l in range(4) for n in\n        (\"W_q\",\"W_k\",\"W_v\",\"W_o\",\"W_fc\",\"W_proj\",\"ln1_w\",\"ln1_b\",\"ln2_w\",\"ln2_b\")]\nwith np.load(\"blocks.npz\", allow_pickle=False) as z:\n    T = {k: np.asarray(z[k], np.float32) for k in z.files}\nlog(\"loaded:\", len(T), \"keys\")\nfor k, ref in ((\"W_fc.0\",51.650),(\"W_proj.3\",85.089),(\"W_q.2\",37.483),(\"W_k.1\",28.602),(\"ln1_w.0\",6.724)):\n    n = float(np.linalg.norm(T[k])); log(f\"fro[{k}]={n:.3f}\", \"OK\" if abs(n-ref) < 0.05 else \"MISMATCH\")\n    if abs(n-ref) >= 0.05: raise RuntimeError(\"loader validation failed\")\nL, H, dh, d = 4, 6, 64, 384\nWQ = [T[f\"W_q.{l}\"] for l in range(L)]; WK = [T[f\"W_k.{l}\"] for l in range(L)]\nWV = [T[f\"W_v.{l}\"] for l in range(L)]; WO = [T[f\"W_o.{l}\"] for l in range(L)]\ndef fro(x): return float(np.linalg.norm(x))\ndef rankcorr(a, b):\n    a = np.asarray(a, float).ravel(); b = np.asarray(b, float).ravel()\n    ra = np.empty(a.size); ra[np.argsort(a)] = np.arange(a.size)\n    rb = np.empty(b.size); rb[np.argsort(b)] = np.arange(b.size)\n    return float(np.corrcoef(ra, rb)[0, 1])\nnp.set_printoptions(precision=3, suppress=True, linewidth=200)\nGOLD_N = {\"L0\":[(4.13,4.91,5.35,5.21),(12.46,12.64,9.26,10.20),(6.46,6.83,5.99,5.54),\n                (6.63,6.82,4.88,5.47),(2.17,2.62,8.28,8.94),(15.90,15.96,9.41,10.60)],\n          \"L1\":[(10.56,9.83,12.95,11.17),(14.53,12.80,11.06,10.66),(12.69,11.35,12.12,11.19),\n                (12.70,11.75,11.32,10.14),(12.59,11.51,10.92,9.91),(14.14,12.58,11.23,10.92)],\n          \"L2\":[(15.22,14.53,13.81,13.64),(14.68,14.47,14.68,14.21),(17.26,16.72,12.99,13.00),\n                (15.01,14.61,14.46,14.25),(15.58,15.20,13.47,13.50),(13.84,13.30,15.55,15.08)],\n          \"L3\":[(14.95,14.54,15.59,15.37),(13.43,13.31,15.61,15.27),(14.99,14.47,15.92,16.03),\n                (10.54,10.52,17.86,18.20),(13.65,13.26,16.27,16.26),(15.03,14.81,13.87,14.16)]}\nworst = 0.0\nfor l in range(L):\n    for h in range(H):\n        s = slice(h*dh, (h+1)*dh)\n        got = (fro(WQ[l][s, :]), fro(WK[l][s, :]), fro(WV[l][s, :]), fro(WO[l][:, s]))\n        worst = max(worst, max(abs(a-b) for a, b in zip(got, GOLD_N[f\"L{l}\"][h])))\nlog(\"partition regression, worst |d| =\", round(worst, 4))\nif worst > 0.05: raise RuntimeError(\"convention regression failed\")\ndef donor_O(l, h):\n    s = slice(h*dh, (h+1)*dh)\n    O = WO[l][:, s] @ WV[l][s, :]; assert O.shape == (d, d)\n    return O\n\n# ---- A: donor O-modes vs final readout spans ----\nUw3 = np.linalg.svd(T[\"W_proj.3\"], full_matrices=False)[0][:, :4]      # proj.3 write span\nRd3 = np.linalg.svd(T[\"W_fc.3\"], full_matrices=False)[2][:4, :].T     # fc.3 read span (384,4)\nprint(\"== A: donor O top-modes vs W_proj.3 write span / W_fc.3 read span (random |cos| \u2248 0.041) ==\")\nprint(\"head |   vs proj-write  max/mean |    vs fc-read  max/mean\")\nfor (l0, h0) in [(0, 0), (0, 4), (0, 1), (0, 5), (0, 2), (0, 3)]:\n    O = donor_O(l0, h0)\n    Uo = np.linalg.svd(O, full_matrices=False)[0][:, :2]\n    Cw = np.abs(Uo.T @ Uw3); Cr = np.abs(Uo.T @ Rd3)\n    print(f\"L{l0}H{h0} |        {Cw.max():.3f}/{Cw.mean():.3f} |        {Cr.max():.3f}/{Cr.mean():.3f}\")\n\n# ---- B: write -> read share map, top-4 spans (baseline sqrt(4/384) = 0.102) ----\nspans = {}\nfor lr in (1, 2, 3):\n    Uw = np.linalg.svd(T[f\"W_proj.{lr}\"], full_matrices=False)[0][:, :4]\n    Rd = np.linalg.svd(T[f\"W_fc.{lr}\"],  full_matrices=False)[2][:4, :].T\n    spans[lr] = (Rd, Uw)\nprint(\"== B: write->read shares (rXfc = into W_fc.X top-4 read span; rXpr = into W_proj.X top-4 span) ==\")\nprint(\"writer |  r1fc  r1pr |  r2fc  r2pr |  r3fc  r3pr\")\nr3pr_seed = []\nfor l0 in range(3):\n    for h0 in range(H):\n        O = donor_O(l0, h0); fo = fro(O)\n        vals = []\n        for lr in (1, 2, 3):\n            if l0 < lr:\n                Rd, Uw = spans[lr]\n                a, b = fro(Rd.T @ O)/fo, fro(Uw.T @ O)/fo\n            else: a = b = float(\"nan\")\n            if lr == 3: r3pr_seed.append(b)\n            vals += [a, b]\n        print(f\"L{l0}H{h0}\" + \"\".join(f\" | {'\u00b7' if v != v else f'{v:.3f}'}\" for v in vals))\n    Wp = T[f\"W_proj.{l0}\"]; fw = fro(Wp)\n    vals = []\n    for lr in (1, 2, 3):\n        if l0 < lr:\n            Rd, Uw = spans[lr]\n            a, b = fro(Rd.T @ Wp)/fw, fro(Uw.T @ Wp)/fw\n        else: a = b = float(\"nan\")\n        if lr == 3: r3pr_seed.append(b)\n        vals += [a, b]\n    print(f\"M{l0} \" + \"\".join(f\" | {'\u00b7' if v != v else f'{v:.3f}'}\" for v in vals))\nlog(\"xcheck r3pr vs run13 f4(L0-L2 donors):\",\n    \"OK\" if np.allclose(r3pr_seed[6:24], [0.333, 0.095, 0.168, 0.16, 0.399, 0.112,\n                                          0.154, 0.102, 0.13, 0.092, 0.115, 0.095,\n                                          0.108, 0.157, 0.105, 0.102, 0.117, 0.148], atol=2e-3)\n    else \"DIFF\")\n\n# ---- fixture: digests + TOPO ----\nMX = {}\nfor l0 in range(L-1):\n    for l1 in range(l0+1, L):\n        for kind, WA in ((\"K\", WK), (\"Q\", WQ), (\"V\", WV)):\n            Mx = np.zeros((H, H))\n            for h0 in range(H):\n                O = donor_O(l0, h0); fo = fro(O)\n                for h1 in range(H):\n                    w = WA[l1][slice(h1*dh, (h1+1)*dh), :]\n                    Mx[h0, h1] = 100.0 * fro(w @ O) / max(fo * fro(w), 1e-9)\n            MX[(l0, l1, kind)] = Mx\n            log(\"digest\", (l0, l1, kind), int(np.round(Mx.sum()*10)),\n                int(np.round(Mx[0, 0]*10)), int(np.round(Mx[4, 2]*10)))\nGOLD_CK = {(0,1): np.array([[437,626,672,736,694,527],[136,93,96,91,95,97],[131,159,169,191,180,136],\n                [193,250,274,301,280,206],[429,675,709,762,705,581],[162,153,153,155,160,164]]),\n           (0,2): np.array([[256,121,317,359,369,212],[100,124,94,94,97,92],[125,133,122,124,191,136],\n                [129,100,148,162,166,115],[292,100,363,412,408,256],[125,151,144,120,126,106]]),\n           (0,3): np.array([[154,139,172,121,176,115],[99,100,98,99,95,134],[122,120,115,119,122,116],\n                [100,103,99,97,102,103],[204,145,246,146,246,104],[110,139,109,97,93,157]])}\nGOLD_CQ = {(0,1): np.array([[220,240,215,268,248,232],[173,146,142,132,140,151],[195,136,134,135,139,153],\n                [137,133,139,157,145,136],[185,216,206,257,227,192],[179,166,165,149,169,177]])}\nGOLD_CV = {(0,1): np.array([[83,69,71,73,67,71],[166,158,144,173,168,149],[156,90,102,90,96,91],\n                [83,77,76,76,75,77],[51,49,48,51,46,49],[186,252,223,278,252,237]])}\nfor key, Mx in MX.items():\n    l0, l1, kind = key\n    G = {\"K\": GOLD_CK, \"Q\": GOLD_CQ, \"V\": GOLD_CV}[kind].get((l0, l1))\n    if G is not None:\n        r = rankcorr(Mx, G)\n        log(\"TOPO\", key, \"PASS\" if r > 0.6 else \"FAIL\", f\"rho={r:.2f}\")\n    elif Mx.max()/max(Mx.mean(), 1e-9) <= 1.8:\n        log(\"TOPO\", key, \"PASS (flat)\")\n    else:\n        log(\"TOPO\", key, \"FAIL (unexpected structure)\")\n\nopen(\"METRICS.md\", \"w\").write(\n\"\"\"# exp3 metric dictionary (gold-locked, reverse-engineered; see runlog runs 9-13)\nstorage: W_q/k/v = (H*64, 384), head h = rows h*64:(h+1)*64. W_o = (384, H*64), head h = cols.\nq_h/k_h/v_h = row slices (64x384). o_h = W_o[:, h*64:(h+1)*64] (384x64).\nO_h = o_h @ v_h (384x384 donor map). M_h = q_h.T @ k_h (384x384 QK bilinear).\nnQ/nK/nV/nO = fro(q_h/k_h/v_h/o_h)      [24/24]\nzM = fro(M_h), zOV = fro(O_h)           [24/24]\nsvM = sv(M_h)[:4], svOV = sv(O_h)[:4]   [24/24]\nalphaOV = ||(O+O.T)/2||_F / ||O||_F     [24/24]\nV-comp(l0->l1) = 100*sqrt(384)*||Wv_t@O_d||_F/(||Wv_t||_F*||O_d||_F)   [s=1.0, rel<=0.4%, 3 pairs]\nK-comp: same form, matches within 6-8% (per-target residual G_t, corr(G_t,zM_t) = -0.56)\nopen: Q-comp operator; baseM/baseOV (permutation null rejected ~10-20x); traceOV definition.\ncircuit: L0 donors H0/H4 route K into L1/L2/L3; H1/H5 supply V to L1; >=L2 comp flat;\nfinal readout: W_proj.3 top-4 span (e8%=45%); donor span-energy f4: H0=0.33 H4=0.40 vs 0.10 rand.\n\"\"\")\nlog(\"wrote METRICS.md\")\nlog(\"=== exit ===\")\n", "out": "[   0.00s] === start === run14 3.12.13\n[   0.01s] loaded: 40 keys\n[   0.01s] fro[W_fc.0]=51.650 OK\n[   0.01s] fro[W_proj.3]=85.089 OK\n[   0.01s] fro[W_q.2]=37.483 OK\n[   0.01s] fro[W_k.1]=28.602 OK\n[   0.01s] fro[ln1_w.0]=6.724 OK\n[   0.01s] partition regression, worst |d| = 0.005\n== A: donor O top-modes vs W_proj.3 write span / W_fc.3 read span (random |cos| \u2248 0.041) ==\nhead |   vs proj-write  max/mean |    vs fc-read  max/mean\nL0H0 |        0.378/0.119 |        0.260/0.054\nL0H4 |        0.524/0.102 |        0.243/0.055\nL0H1 |        0.075/0.041 |        0.082/0.022\nL0H5 |        0.092/0.053 |        0.082/0.035\nL0H2 |        0.235/0.094 |        0.142/0.062\nL0H3 |        0.277/0.094 |        0.199/0.078\n== B: write->read shares (rXfc = into W_fc.X top-4 read span; rXpr = into W_proj.X top-4 span) ==\nwriter |  r1fc  r1pr |  r2fc  r2pr |  r3fc  r3pr\nL0H0 | 0.247 | 0.318 | 0.263 | 0.234 | 0.216 | 0.333\nL0H1 | 0.119 | 0.093 | 0.096 | 0.092 | 0.072 | 0.095\nL0H2 | 0.102 | 0.161 | 0.105 | 0.120 | 0.134 | 0.168\nL0H3 | 0.126 | 0.168 | 0.141 | 0.135 | 0.146 | 0.160\nL0H4 | 0.186 | 0.262 | 0.214 | 0.194 | 0.165 | 0.399\nL0H5 | 0.345 | 0.122 | 0.227 |