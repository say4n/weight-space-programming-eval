{"t": 1793705749.8873448, "s": 0.07, "code": "print(\"== keys ==\", sorted(T.keys()))          # run first, every time\n\ndef pick(*names):\n    for n in names:\n        if n in T:\n            return T[n]\n    return None\n\nlnf_w = pick('lnf_w', 'ln_f_w', 'lnf.weight', 'ln_f.weight', 'final_ln_w')\nif lnf_w is None:\n    print(\"final LN: absent from snapshot -> skipping dependent sections\")\n\n# wrap each section body in try/except and print \"[skip:<name>] ...\" instead of crashing\n", "out": "\n[stderr]\nTraceback (most recent call last):\n  File \"<string>\", line 4, in <module>\nNameError: name 'T' is not defined\n"}
{"t": 1793705810.939324, "s": 0.08, "code": "import glob, os\nimport numpy as np\n\ndef _flatten(d, prefix=\"\"):\n    out = {}\n    for k, v in d.items():\n        kk = f\"{prefix}{k}\" if prefix else k\n        if isinstance(v, dict):\n            out.update(_flatten(v, kk + \".\"))\n        elif hasattr(v, \"detach\"):                     # torch tensors\n            out[kk] = v.detach().float().cpu().numpy()\n        else:\n            out[kk] = np.asarray(v, dtype=np.float32)\n    return out\n\ndef load_state():\n    paths  = sorted(glob.glob(\"*.npz\"))\n    paths += sorted(glob.glob(\"*.pt\") + glob.glob(\"*.pth\") +\n                    glob.glob(\"*.ckpt\") + glob.glob(\"*.bin\") + glob.glob(\"*.safetensors\"))\n    for p in paths:\n        try:\n            if p.endswith(\".npz\"):\n                with np.load(p) as z:\n                    return {k: np.asarray(z[k], np.float32) for k in z.files}\n            elif p.endswith(\".safetensors\"):\n                from safetensors.numpy import load_file\n                return _flatten(load_file(p))\n            else:\n                import torch\n                obj = torch.load(p, map_location=\"cpu\")\n                if isinstance(obj, dict) and isinstance(obj.get(\"state_dict\"), dict):\n                    obj = obj[\"state_dict\"]\n                return _flatten(obj)\n        except Exception as e:\n            print(f\"[load-fail {p}] {type(e).__name__}: {e}\")\n    print(\"cwd files:\", sorted(os.listdir(\".\")))       # diagnostic for next run\n    raise SystemExit(\"no loadable checkpoint found\")\n\nT = load_state()\n", "out": ""}
{"t": 1793705884.168263, "s": 0.08, "code": "import faulthandler, sys, time, os, glob, traceback\nimport numpy as np\n\n_t0 = time.time()\n_logf = open(\"runlog.txt\", \"a\", buffering=1)      # line-buffered append; survives hard kills\n\ndef log(*a):\n    m = f\"[{time.time() - _t0:7.2f}s] \" + \" \".join(map(str, a))\n    print(m, flush=True)                          # flush defeats teardown-timeing losses\n    _logf.write(m + \"\\n\")\n\nlog(\"=== start ===\", \"py\", sys.version.split()[0])\nfaulthandler.enable(sys.stderr)\nfaulthandler.dump_traceback_later(120, exit=True) # watchdog: any hang -> full stack dump + exit << 120s\n\ntry:\n    log(\"cwd:\", os.getcwd())\n    log(\"files:\", sorted(os.listdir(\".\")))\n    cands = sorted(glob.glob(\"*.npz\") + glob.glob(\"*.pt\") + glob.glob(\"*.pth\") +\n                   glob.glob(\"*.ckpt\") + glob.glob(\"*.bin\") + glob.glob(\"*.safetensors\"))\n    log(\"checkpoint candidates:\", cands)\n    if not cands:\n        log(\"FATAL: nothing loadable in cwd \u2014 stopping loudly\")\n        raise RuntimeError(\"no checkpoint candidates\")\n\n    # ... actual loading here, one log() per phase; log per-file on failure, never silently pass ...\n    # T = ...  etc.  Then:\n    log(\"loaded keys:\", len(T))\n    log(sorted(T.keys()))\n\nexcept BaseException:\n    log(\"FATAL:\", traceback.format_exc())         # BaseException so SystemExit/KeyboardInterrupt get logged too\n    raise\nfinally:\n    log(\"=== exit ===\")\n", "out": "[   0.00s] === start === py 3.12.13\n[   0.00s] cwd: /Users/sayan/Projects/weight-space-programming/results/exp3/glm-5.3-flash/python_r0/work\n[   0.00s] files: ['blocks.npz', 'runlog.txt']\n[   0.00s] checkpoint candidates: ['blocks.npz']\n[   0.00s] FATAL: Traceback (most recent call last):\n  File \"<string>\", line 31, in <module>\nNameError: name 'T' is not defined\n\n[   0.00s] === exit ===\n\n[stderr]\nTraceback (most recent call last):\n  File \"<string>\", line 31, in <module>\nNameError: name 'T' is not defined\n"}
{"t": 1793705935.005619, "s": 0.07, "code": "# --- persistence probe + last-run continuity (cheap, keep forever) ---\nif os.path.exists(\"runlog.txt\"):\n    prev = open(\"runlog.txt\").read().strip().splitlines()\n    log(f\"runlog persisted from a prior run: {len(prev)} lines, last = {prev[-1] if prev else '-'}\")\n\n# --- loader (npz-specific; filename now known) ---\nKEYS = [f\"{n}.{l}\" for l in range(4) for n in\n        (\"W_q\", \"W_k\", \"W_v\", \"W_o\", \"W_fc\", \"W_proj\", \"ln1_w\", \"ln1_b\", \"ln2_w\", \"ln2_b\")]\nlog(\"loading blocks.npz ...\")\nwith np.load(\"blocks.npz\", allow_pickle=False) as z:\n    T = {k: np.asarray(z[k], np.float32) for k in z.files}\nlog(\"loaded:\", len(T), \"keys\")\nmissing = [k for k in KEYS if k not in T]\nextra   = [k for k in T if k not in KEYS]\nif missing or extra:\n    log(f\"FATAL schema drift vs run 1: missing={missing[:6]} extra={extra[:6]}\")\n    raise RuntimeError(\"schema mismatch\")\nlog(\"schema matches run 1 (40 block tensors)\")\n\n# spot-check norms against run 1's printed table\nfor k, ref in ((\"W_fc.0\", 51.650), (\"W_proj.3\", 85.089), (\"ln1_w.0\", 6.724), (\"W_q.2\", 37.483)):\n    n = float(np.linalg.norm(T[k]))\n    log(f\"fro[{k}] = {n:.3f}  (run1: {ref:.3f})  {'OK' if abs(n - ref) < 0.5 else 'MISMATCH'}\")\n", "out": "\n[stderr]\nTraceback (most recent call last):\n  File \"<string>\", line 5, in <module>\nNameError: name 'os' is not defined. Did you forget to import 'os'?\n"}
{"t": 1793705997.3956869, "s": 0.08, "code": "import faulthandler, sys, time, os, glob, traceback\nimport numpy as np\n\n_t0 = time.time()\n_logf = open(\"runlog.txt\", \"a\", buffering=1)\ndef log(*a):\n    m = f\"[{time.time()-_t0:7.2f}s] \" + \" \".join(map(str, a))\n    print(m, flush=True); _logf.write(m + \"\\n\")\nlog(\"=== start ===\", sys.version.split()[0])\nfaulthandler.enable(sys.stderr)\nfaulthandler.dump_traceback_later(120, exit=True)\n\n# --- persistence probe: did anything survive from previous runs? ---\nif os.path.exists(\"runlog.txt\"):\n    prev = open(\"runlog.txt\").read().strip().splitlines()\n    log(\"runlog prior:\", len(prev), \"lines; last:\", prev[-1] if prev else \"-\")\nelse:\n    log(\"runlog.txt absent (fresh dir)\")\n\n# --- loader (filename confirmed by run 4) ---\nKEYS = [f\"{n}.{l}\" for l in range(4) for n in\n        (\"W_q\",\"W_k\",\"W_v\",\"W_o\",\"W_fc\",\"W_proj\",\"ln1_w\",\"ln1_b\",\"ln2_w\",\"ln2_b\")]\nlog(\"loading blocks.npz\")\nwith np.load(\"blocks.npz\", allow_pickle=False) as z:\n    T = {k: np.asarray(z[k], np.float32) for k in z.files}\nlog(\"loaded:\", len(T), \"keys\")\nmissing = [k for k in KEYS if k not in T]\nextra   = [k for k in T if k not in KEYS]\nlog(\"schema:\", \"OK (40 block tensors)\" if not missing and not extra\n    else f\"DRIFT missing={missing} extra={extra}\")\nif missing or extra:\n    raise RuntimeError(\"schema mismatch vs run 1\")\n\n# --- validation vs run 1's printed norms ---\nREF = {\"W_fc.0\":51.650, \"W_proj.3\":85.089, \"W_q.2\":37.483, \"W_k.1\":28.602, \"ln1_w.0\":6.724}\nok = True\nfor k, ref in REF.items():\n    n = float(np.linalg.norm(T[k])); ok &= abs(n-ref) < 0.05\n    log(f\"fro[{k}]={n:.3f} ref={ref:.3f}\", \"OK\" if ok else \"MISMATCH\")\nlog(\"VALIDATION:\", \"PASSED\" if ok else \"FAILED\")\nlog(\"=== exit ===\")\n\n# ===== PINNED PREAMBLE END \u2014 future runs: only code below may change =====\n", "out": "[   0.00s] === start === 3.12.13\n[   0.00s] runlog prior: 10 lines; last: [   0.00s] === start === 3.12.13\n[   0.00s] loading blocks.npz\n[   0.01s] loaded: 40 keys\n[   0.01s] schema: OK (40 block tensors)\n[   0.01s] fro[W_fc.0]=51.650 ref=51.650 OK\n[   0.01s] fro[W_proj.3]=85.089 ref=85.089 OK\n[   0.01s] fro[W_q.2]=37.483 ref=37.483 OK\n[   0.01s] fro[W_k.1]=28.602 ref=28.602 OK\n[   0.01s] fro[ln1_w.0]=6.724 ref=6.724 OK\n[   0.01s] VALIDATION: PASSED\n[   0.01s] === exit ===\n"}
{"t": 1793706123.3715782, "s": 0.07, "code": "class Tee:\n    def __init__(self, *fs): self.fs = fs\n    def write(self, x):\n        for f in self.fs: f.write(x); f.flush()\n    def flush(self):\n        for f in self.fs: f.flush()\nsys.stdout = Tee(sys.stdout, open(\"out_run7.txt\", \"w\"))\n", "out": "\n[stderr]\nTraceback (most recent call last):\n  File \"<string>\", line 10, in <module>\nNameError: name 'sys' is not defined. Did you forget to import 'sys'?\n"}
{"t": 1793706334.094295, "s": 0.46, "code": "import faulthandler, sys, time, os, glob, traceback\nimport numpy as np\nRUN_TAG = \"run8\"\n_t0 = time.time()\n_logf = open(\"runlog.txt\", \"a\", buffering=1)\ndef log(*a):\n    m = f\"[{time.time()-_t0:7.2f}s] \" + \" \".join(map(str, a))\n    print(m, flush=True); _logf.write(m + \"\\n\")\nlog(\"=== start ===\", RUN_TAG, sys.version.split()[0])\nfaulthandler.enable(sys.stderr)\nfaulthandler.dump_traceback_later(120, exit=True)\n\nclass Tee:\n    def __init__(self, *fs): self.fs = fs\n    def write(self, x):\n        for f in self.fs: f.write(x); f.flush()\n    def flush(self):\n        for f in self.fs: f.flush()\nsys.stdout = Tee(sys.stdout, open(f\"out_{RUN_TAG}.txt\", \"w\"))\n\n# ---- validated loader (run 6, verbatim) ----\nKEYS = [f\"{n}.{l}\" for l in range(4) for n in\n        (\"W_q\",\"W_k\",\"W_v\",\"W_o\",\"W_fc\",\"W_proj\",\"ln1_w\",\"ln1_b\",\"ln2_w\",\"ln2_b\")]\nwith np.load(\"blocks.npz\", allow_pickle=False) as z:\n    T = {k: np.asarray(z[k], np.float32) for k in z.files}\nlog(\"loaded:\", len(T), \"keys\")\nmiss = [k for k in KEYS if k not in T]; extra = [k for k in T if k not in KEYS]\nlog(\"schema:\", \"OK\" if not miss and not extra else f\"DRIFT {miss} {extra}\")\nif miss or extra: raise RuntimeError(\"schema mismatch\")\nfor k, ref in ((\"W_fc.0\",51.650),(\"W_proj.3\",85.089),(\"W_q.2\",37.483),(\"W_k.1\",28.602),(\"ln1_w.0\",6.724)):\n    n = float(np.linalg.norm(T[k]))\n    log(f\"fro[{k}]={n:.3f} ref={ref:.3f}\", \"OK\" if abs(n-ref) < 0.05 else \"MISMATCH\")\n    if abs(n-ref) >= 0.05: raise RuntimeError(\"loader validation failed\")\n\n# ============== ANALYSIS (editable region) ==============\nL, H, dh, d = 4, 6, 64, 384\nWQ = [T[f\"W_q.{l}\"] for l in range(L)]; WK = [T[f\"W_k.{l}\"] for l in range(L)]\nWV = [T[f\"W_v.{l}\"] for l in range(L)]; WO = [T[f\"W_o.{l}\"].T.copy() for l in range(L)]\ndef fro(x): return float(np.linalg.norm(x))\n\nprint(\"== DEFINITIONS ==\")\nprint(\" slices: head h uses [:, h*64:(h+1)*64] (column convention; run 1 may differ, see sv probes)\")\nprint(\" O1 = WV[:,s] @ WO[s]      (d x d, donor output map)     O2 = WO[s] @ WV[:,s]  (64x64)\")\nprint(\" M1 = WQ[:,s] @ WK[:,s].T  (d x d bilinear)              M2 = WQ[:,s].T @ WK[:,s] (64x64)\")\nprint(\" comp(fdef) = 100*||P||_F / (||O1||_F*||W*_t slice||_F), P = (target slice).T @ O1_donor\")\n\nprint(\"== GOLD: tensor norms ==\")\nfor k in sorted(T): print(f\"  {k:10s} {str(T[k].shape):14s} fro={fro(T[k]):9.3f}\")\n\nprint(\"== GOLD: per-head nQ..nO ==\")\nprint(\"head |    nQ    nK    nV    nO\")\nfor l in range(L):\n    for h in range(H):\n        s = slice(h*dh, (h+1)*dh)\n        a, b = WQ[l][:, s], WK[l][:, s]; v, o = WV[l][:, s], WO[l][s, :]\n        print(f\"L{l}H{h} | {fro(a):6.2f} {fro(b):6.2f} {fro(v):6.2f} {fro(o):6.2f}\")\n\ndef sv4(x): return np.linalg.svd(x, compute_uv=False)[:4]\nprint(\"== CONVENTION PROBE: sv top-4 (match against run 1's svM / svOV) ==\")\nprint(\"head | svM1                      | svM2                      | svOV1                     | svOV2\")\nfor l in range(L):\n    for h in range(H):\n        s = slice(h*dh, (h+1)*dh)\n        v = WV[l][:, s]\n        M1 = WQ[l][:, s] @ WK[l][:, s].T;        M2 = WQ[l][:, s].T @ WK[l][:, s]\n        O1 = v @ WO[l][s, :];                    O2 = WO[l][s, :] @ v\n        print(f\"L{l}H{h} | {np.array2string(sv4(M1), precision=3, suppress_small=True):25s}\"\n              f\" | {np.array2string(sv4(M2), precision=3, suppress_small=True):25s}\"\n              f\" | {np.array2string(sv4(O1), precision=3, suppress_small=True):25s}\"\n              f\" | {np.array2string(sv4(O2), precision=3, suppress_small=True):25s}\")\n\nprint(\"== fdef: per-head spectral / effective-rank of O1 ==\")\nprint(\"head |  s1    fro   eff.rk  tr/d\")\nfor l in range(L):\n    for h in range(H):\n        s = slice(h*dh, (h+1)*dh)\n        O1 = WV[l][:, s] @ WO[l][s, :]\n        sv = np.linalg.svd(O1, compute_uv=False)\n        er = (sv.sum()**2) / max((sv**2).sum(), 1e-9)\n        print(f\"L{l}H{h} | {sv[0]:6.3f} {fro(O1):7.3f} {er:7.2f} {float(np.trace(O1))/d:7.3f}\")\n\nprint(\"== fdef: composition matrices (x100, rows=donor heads H0..H5) ==\")\nfor l0 in range(L-1):\n    for l1 in range(l0+1, L):\n        for kind, Wt in ((\"K\", WK), (\"Q\", WQ), (\"V\", WV)):\n            Mx = np.zeros((H, H))\n            for h0 in range(H):\n                s0 = slice(h0*dh, (h0+1)*dh); O1 = WV[l0][:, s0] @ WO[l0][s0, :]\n                for h1 in range(H):\n                    s1 = slice(h1*dh, (h1+1)*dh); w = Wt[l1][:, s1]\n                    P = w.T @ O1\n                    Mx[h0, h1] = 100.0 * fro(P) / max(fro(O1) * fro(w), 1e-9)\n            print(f\" l0=L{l0} -> l1=L{l1} ({kind}-comp):\"); print(np.round(Mx).astype(int))\nlog(\"=== exit ===\")\n", "out": "[   0.00s] === start === run8 3.12.13\n[   0.01s] loaded: 40 keys\n[   0.01s] schema: OK\n[   0.01s] fro[W_fc.0]=51.650 ref=51.650 OK\n[   0.01s] fro[W_proj.3]=85.089 ref=85.089 OK\n[   0.01s] fro[W_q.2]=37.483 ref=37.483 OK\n[   0.01s] fro[W_k.1]=28.602 ref=28.602 OK\n[   0.01s] fro[ln1_w.0]=6.724 ref=6.724 OK\n== DEFINITIONS ==\n slices: head h uses [:, h*64:(h+1)*64] (column convention; run 1 may differ, see sv probes)\n O1 = WV[:,s] @ WO[s]      (d x d, donor output map)     O2 = WO[s] @ WV[:,s]  (64x64)\n M1 = WQ[:,s] @ WK[:,s].T  (d x d bilinear)              M2 = WQ[:,s].T @ WK[:,s] (64x64)\n comp(fdef) = 100*||P||_F / (||O1||_F*||W*_t slice||_F), P = (target slice).T @ O1_donor\n== GOLD: tensor norms ==\n  W_fc.0     (1536, 384)    fro=   51.650\n  W_fc.1     (1536, 384)    fro=   80.261\n  W_fc.2     (1536, 384)    fro=   79.454\n  W_fc.3     (1536, 384)    fro=   78.189\n  W_k.0      (384, 384)     fro=   23.214\n  W_k.1      (384, 384)     fro=   28.602\n  W_k.2      (384, 384)     fro=   36.356\n  W_k.3      (384, 384)     fro=   33.221\n  W_o.0      (384, 384)     fro=   19.600\n  W_o.1      (384, 384)     fro=   26.151\n  W_o.2      (384, 384)     fro=   34.205\n  W_o.3      (384, 384)     fro=   39.017\n  W_proj.0   (384, 1536)    fro=   45.806\n  W_proj.1   (384, 1536)    fro=   75.119\n  W_proj.2   (384, 1536)    fro=   77.477\n  W_proj.3   (384, 1536)    fro=   85.089\n  W_q.0      (384, 384)     fro=   22.704\n  W_q.1      (384, 384)     fro=   31.676\n  W_q.2      (384, 384)     fro=   37.483\n  W_q.3      (384, 384)     fro=   33.940\n  W_v.0      (384, 384)     fro=   18.197\n  W_v.1      (384, 384)     fro=   28.469\n  W_v.2      (384, 384)     fro=   34.746\n  W_v.3      (384, 384)     fro=   38.939\n  ln1_b.0    (384,)         fro=    0.717\n  ln1_b.1    (384,)         fro=    3.033\n  ln1_b.2    (384,)         fro=    2.621\n  ln1_b.3    (384,)         fro=    1.862\n  ln1_w.0    (384,)         fro=    6.724\n  ln1_w.1    (384,)         fro=    9.505\n  ln1_w.2    (384,)         fro=   14.457\n  ln1_w.3    (384,)         fro=   15.105\n  ln2_b.0    (384,)         fro=    1.353\n  ln2_b.1    (384,)         fro=    2.877\n  ln2_b.2    (384,)         fro=    2.911\n  ln2_b.3    (384,)         fro=    2.497\n  ln2_w.0    (384,)         fro=   17.272\n  ln2_w.1    (384,)         fro=   20.054\n  ln2_w.2    (384,)         fro=   25.082\n  ln2_w.3    (384,)         fro=   24.657\n== GOLD: per-head nQ..nO ==\nhead |    nQ    nK    nV    nO\nL0H0 |   9.49   9.51   7.39   5.21\nL0H1 |   9.42   9.04   7.33  10.20\nL0H2 |   9.29   9.74   7.25   5.54\nL0H3 |   9.37  10.12   7.50   5.47\nL0H4 |   9.12   9.30   7.63   8.94\nL0H5 |   8.92   9.11   7.47  10.60\nL1H0 |  13.06  13.76  11.42  11.17\nL1H1 |  12.97  11.93  11.58  10.66\nL1H2 |  13.04  10.26  11.71  11.19\nL1H3 |  13.13  10.19  11.85  10.14\nL1H4 |  12.52  13.15  11.54   9.91\nL1H5 |  12.85  10.20  11.63  10.92\nL2H0 |  15.17  15.20  14.08  13.64\nL2H1 |  15.24  15.17  14.06  14.21\nL2H2 |  15.41  14.13  14.27  13.00\nL2H3 |  15.43  14.24  14.35  14.25\nL2H4 |  15.22  16.03  14.12  13.50\nL2H5 |  15.33  14.18  14.23  15.08\nL3H0