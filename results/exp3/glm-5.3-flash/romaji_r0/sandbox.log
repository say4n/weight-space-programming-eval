{"t": 1793713248.204541, "s": 0.29, "code": "import numpy as np, traceback\nsd = {k: v for k, v in np.load('./blocks.npz').items()}\nprint(\"loaded\", len(sd))\nrank = lambda x: np.argsort(np.argsort(x))\nspe  = lambda x, y: float(np.corrcoef(rank(x), rank(y))[0,1])\nH, DH = 6, 64\nhblk = lambda h: slice(h*DH, (h+1)*DH)\ndef P(l,h): return sd[f'W_o.{l}'][:, hblk(h)] @ sd[f'W_v.{l}'][hblk(h), :]\n\nFR = {l: np.linalg.norm(sd[f'W_fc.{l}'], axis=0) for l in range(4)}\nFW = {l: np.linalg.norm(sd[f'W_proj.{l}'], axis=1) for l in range(4)}\nU1, S1 = {}, {}\nfor l in range(4):\n    for h in range(H):\n        u_, s_, _ = np.linalg.svd(P(l,h))\n        U1[l,h], S1[l,h] = u_[:,0], s_[0]\n\ndef g(n, f):\n    print(f\"== {n} ==\")\n    try: f()\n    except Exception: print(n, \"FAILED:\", traceback.format_exc(limit=1).strip().splitlines()[-1])\n\ng(\"1 conveyor FR(l)~FW(k)\", lambda:\n  [print(\"reads L%d ~ writes %s\" % (l, np.round([spe(FR[l], FW[k]) for k in range(4)], 2))) for l in range(4)])\n\ng(\"2 attn-write profile\", lambda:\n  [print(\"hw%d ~ [FR%d, FR%d, FW%d, ln2.%d, ln2.%d]:\" % (l, l, min(l+1,3), l, l, min(l+1,3)),\n         np.round([spe(hw_l := sum(S1[l,h]*(U1[l,h]**2) for h in range(H)), FR[l]),\n                   spe(hw_l, FR[min(l+1,3)]), spe(hw_l, FW[l]),\n                   spe(hw_l, sd[f'ln2_w.{l}']), spe(hw_l, sd[f'ln2_w.{min(l+1,3)}'])], 2))\n   for l in range(4)])\n\ng(\"3 LN handoff |u1(l,h)|~ln2(l+1)\", lambda:\n  [print(f\"L{l}\", np.round([spe(np.abs(U1[l,h]), sd[f'ln2_w.{min(l+1,3)}']) for h in range(H)], 2)) for l in range(4)])\n\ng(\"4 L0 heads ~ FR1 (does MLP1 read the B write?)\", lambda:\n  print(np.round([spe(np.abs(U1[0,h]), FR[1]) for h in range(H)], 2)))\n\nATT = [12, 20, 21, 29, 39, 51, 58, 63, 71]\nMLP = [184, 383, 5, 219, 133, 132, 53, 89]\ng(\"5 LN gains at trunks\", lambda:\n  [print(nm, \"ATT\", np.round([[sd[f'{nm}.{l}'][c] for c in ATT] for l in range(4)], 2),\n        \"\\n  MLP\", np.round([[sd[f'{nm}.{l}'][c] for c in MLP] for l in range(4)], 2))\n   for nm in ('ln1_w','ln2_w')])\n", "out": "loaded 40\n== 1 conveyor FR(l)~FW(k) ==\nreads L0 ~ writes [-0.01 -0.01 -0.17 -0.07]\nreads L1 ~ writes [ 0.1   0.15  0.01 -0.13]\nreads L2 ~ writes [-0.1   0.11  0.19 -0.06]\nreads L3 ~ writes [-0.11 -0.09  0.23 -0.04]\n== 2 attn-write profile ==\nhw0 ~ [FR0, FR1, FW0, ln2.0, ln2.1]: [-0.21 -0.16  0.03 -0.12 -0.14]\nhw1 ~ [FR1, FR2, FW1, ln2.1, ln2.2]: [ 0.06 -0.02  0.02  0.1   0.03]\nhw2 ~ [FR2, FR3, FW2, ln2.2, ln2.3]: [-0.13 -0.18 -0.01 -0.1   0.05]\nhw3 ~ [FR3, FR3, FW3, ln2.3, ln2.3]: [-0.17 -0.17  0.1  -0.15 -0.15]\n== 3 LN handoff |u1(l,h)|~ln2(l+1) ==\nL0 [-0.13 -0.05 -0.11  0.04 -0.02 -0.16]\nL1 [-0.09 -0.02 -0.01  0.03  0.02  0.1 ]\nL2 [ 0.03  0.04 -0.01 -0.06  0.03  0.05]\nL3 [-0.07 -0.02 -0.07 -0.16 -0.08 -0.07]\n== 4 L0 heads ~ FR1 (does MLP1 read the B write?) ==\n[-0.09 -0.23 -0.26  0.02 -0.19 -0.06]\n== 5 LN gains at trunks ==\nln1_w ATT [[0.12 0.21 0.53 0.2  0.8  0.42 0.45 0.3  0.25]\n [0.57 0.57 1.08 0.59 0.3  0.52 0.38 0.36 0.47]\n [0.67 0.74 1.09 0.72 0.42 0.66 0.48 0.48 0.73]\n [0.79 0.72 0.8  0.71 0.47 0.69 0.47 0.65 0.78]] \n  MLP [[0.97 0.17 0.3  0.47 0.32 0.71 0.62 0.77]\n [0.25 0.34 0.5  0.66 0.49 0.61 0.62 0.49]\n [0.34 0.32 0.69 0.64 0.78 0.72 0.7  0.75]\n [0.56 0.41 0.54 0.63 0.75 0.69 0.67 0.71]]\nln2_w ATT [[1.24 1.09 0.11 1.01 0.55 1.01 0.26 0.59 0.86]\n [1.23 1.13 0.   1.18 0.34 1.13 0.22 0.91 1.12]\n [1.23 1.28 0.01 1.37 0.69 1.38 0.66 1.26 1.36]\n [1.27 1.24 0.23 1.3  0.85 1.32 0.81 1.28 1.27]] \n  MLP [[0.68 0.76 1.22 0.75 1.41 0.6  0.76 0.45]\n [0.96 0.83 1.1  1.06 1.25 1.26 1.16 1.07]\n [0.61 1.   1.28 1.32 1.36 1.23 1.49 1.32]\n [0.72 1.   1.29 1.27 1.27 1.15 1.35 1.23]]\n"}
{"t": 1793713414.0405629, "s": 0.02, "code": "import numpy as np, traceback\nsd = {k: v for k, v in np.load('./blocks.npz').items()}\nprint(\"loaded\", len(sd))\nrank = lambda x: np.argsort(np.argsort(x))\nspe  = lambda x, y: float(np.corrcoef(rank(x), rank(y))[0,1])\npct  = lambda x, c: float((x < x[c]).mean())\nH, DH = 6, 64\nhblk = lambda h: slice(h*DH, (h+1)*DH)\ndef M(l,h): return sd[f'W_q.{l}'][hblk(h)] @ sd[f'W_k.{l}'][hblk(h)].T\ndef P(l,h): return sd[f'W_o.{l}'][:, hblk(h)] @ sd[f'W_v.{l}'][hblk(h), :]\ndef g(n, f):\n    print(f\"== {n} ==\")\n    try: f()\n    except Exception: print(n, \"FAILED:\", traceback.format_exc(limit=1).strip().splitlines()[-1])\n\nU1, S1 = {}, {}\nfor l in range(4):\n    for h in range(H):\n        u_, s_, _ = np.linalg.svd(P(l,h)); U1[l,h], S1[l,h] = u_[:,0], s_[0]\n\nAR = {l: sd[f'ln1_w.{l}'] * (np.linalg.norm(sd[f'W_q.{l}'], axis=0)\n      + np.linalg.norm(sd[f'W_k.{l}'], axis=0) + np.linalg.norm(sd[f'W_v.{l}'], axis=0)) for l in range(4)}\nMR = {l: sd[f'ln2_w.{l}'] * np.linalg.norm(sd[f'W_fc.{l}'], axis=0) for l in range(4)}\nAW = {l: sum(S1[l,h] * U1[l,h]**2 for h in range(H)) for l in range(4)}\nMW = {l: np.linalg.norm(sd[f'W_proj.{l}'], axis=1) for l in range(4)}\n\ng(\"1 attn-read ~ attn-write\", lambda: [print(f\"AR{l}~AW{k}\", np.round([spe(AR[l], AW[k]) for k in range(4)], 2)) for l in range(4)])\ng(\"2 attn-read ~ mlp-write\", lambda: [print(f\"AR{l}~MW{k}\", np.round([spe(AR[l], MW[k]) for k in range(4)], 2)) for l in range(4)])\ng(\"3 mlp-read ~ mlp-write (LN-weighted)\", lambda: [print(f\"MR{l}~MW{k}\", np.round([spe(MR[l], MW[k]) for k in range(4)], 2)) for l in range(4)])\ng(\"4 mlp-read ~ attn-write\", lambda: [print(f\"MR{l}~AW{k}\", np.round([spe(MR[l], AW[k]) for k in range(4)], 2)) for l in range(4)])\n\ng(\"5 B/A loop in matchers\", lambda: [\n    print(f\"L{l}H{h} \" + \" \".join(f\"{v:+.2f}\" for v in (\n        [spe(np.abs(sd[f'W_q.{l}'][hblk(h)].T @ np.linalg.svd(M(l,h))[0][:,0]), np.abs(U1[0,4] if False else np.array([0])))]\n        ))\n    for l in (1,3) for h in range(H)]) if False else None)\n# (5 above replaced by explicit version below to avoid accidents)\ndef five():\n    for l in (1, 3):\n        base = U1[0,1]; T = [U1[0,i] if U1[0,i]@base > 0 else -U1[0,i] for i in (1,2,4)]\n        A = np.array(T).mean(0); A /= np.linalg.norm(A)\n        B = U1[0,5]\n        for h in range(H):\n            Mq = sd[f'W_q.{l}'][hblk(h)]; Mk = sd[f'W_k.{l}'][hblk(h)]\n            uq, _, vt = np.linalg.svd(M(l,h))\n            rq = np.abs(Mq.T @ uq[:,0]); rk = np.abs(Mk.T @ vt[0])\n            print(f\"L{l}H{h} q~A {spe(rq,np.abs(A)):+.2f} k~A {spe(rk,np.abs(A)):+.2f} \"\n                  f\"q~B {spe(rq,np.abs(B)):+.2f} k~B {spe(rk,np.abs(B)):+.2f}\")\ng(\"5 matchers vs features\", five)\n\nCH = [21,39,58,71,12,20,29,63,99,153,184,383,5,219,133,132,53,89]\ndef six():\n    for c in CH:\n        aR = \" \".join(f\"{sd[f'ln1_w.{l}'][c]:.2f}\" for l in range(4))\n        mR = \" \".join(f\"{sd[f'ln2_w.{l}'][c]:.2f}\" for l in range(4))\n        aW = round(np.mean([pct(AW[l], c) for l in range(4)]), 2)\n        mW = round(np.mean([pct(MW[l], c) for l in range(4)]), 2)\n        print(f\"ch{c:>4}: atn-read {aR} | mlp-read {mR} | aW-pct {aW} mW-pct {mW}\")\ng(\"6 roles table\", six)\n", "out": "\n[stderr]\n  File \"<string>\", line 39\n    for l in (1,3) for h in range(H)]) if False else None)\n                                    ^\nSyntaxError: closing parenthesis ']' does not match opening parenthesis '(' on line 36\n"}
{"t": 1793713446.847151, "s": 0.31, "code": "import numpy as np, traceback\nsd = {k: v for k, v in np.load('./blocks.npz').items()}\nprint(\"loaded\", len(sd))\nrank = lambda x: np.argsort(np.argsort(x))\nspe  = lambda x, y: float(np.corrcoef(rank(x), rank(y))[0,1])\npct  = lambda x, c: float((x < x[c]).mean())\nH, DH = 6, 64\nhblk = lambda h: slice(h*DH, (h+1)*DH)\ndef M(l,h): return sd[f'W_q.{l}'][hblk(h)] @ sd[f'W_k.{l}'][hblk(h)].T\ndef P(l,h): return sd[f'W_o.{l}'][:, hblk(h)] @ sd[f'W_v.{l}'][hblk(h), :]\ndef g(n, f):\n    print(f\"== {n} ==\")\n    try: f()\n    except Exception: print(n, \"FAILED:\", traceback.format_exc(limit=1).strip().splitlines()[-1])\n\nU1, S1 = {}, {}\nfor l in range(4):\n    for h in range(H):\n        u_, s_, _ = np.linalg.svd(P(l,h))\n        U1[l,h], S1[l,h] = u_[:,0], s_[0]\n\nAR = {l: sd[f'ln1_w.{l}'] * (np.linalg.norm(sd[f'W_q.{l}'], axis=0)\n      + np.linalg.norm(sd[f'W_k.{l}'], axis=0) + np.linalg.norm(sd[f'W_v.{l}'], axis=0)) for l in range(4)}\nMR = {l: sd[f'ln2_w.{l}'] * np.linalg.norm(sd[f'W_fc.{l}'], axis=0) for l in range(4)}\nAW = {l: sum(S1[l,h] * U1[l,h]**2 for h in range(H)) for l in range(4)}\nMW = {l: np.linalg.norm(sd[f'W_proj.{l}'], axis=1) for l in range(4)}\n\ndef one():\n    for l in range(4):\n        print(f\"AR{l}~AW\", np.round([spe(AR[l], AW[k]) for k in range(4)], 2))\ng(\"1 attn-read ~ attn-write\", one)\n\ndef two():\n    for l in range(4):\n        print(f\"AR{l}~MW\", np.round([spe(AR[l], MW[k]) for k in range(4)], 2))\ng(\"2 attn-read ~ mlp-write\", two)\n\ndef three():\n    for l in range(4):\n        print(f\"MR{l}~MW\", np.round([spe(MR[l], MW[k]) for k in range(4)], 2))\ng(\"3 mlp-read ~ mlp-write\", three)\n\ndef four():\n    for l in range(4):\n        print(f\"MR{l}~AW\", np.round([spe(MR[l], AW[k]) for k in range(4)], 2))\ng(\"4 mlp-read ~ attn-write\", four)\n\ndef five():\n    base = U1[0,1]\n    trio = [U1[0,i] if U1[0,i] @ base > 0 else -U1[0,i] for i in (1,2,4)]\n    A = trio[0] + trio[1] + trio[2]; A = A / np.linalg.norm(A)\n    B = U1[0,5]\n    for l in (1, 3):\n        for h in range(H):\n            Mq = sd[f'W_q.{l}'][hblk(h)]\n            Mk = sd[f'W_k.{l}'][hblk(h)]\n            uq, _, vt = np.linalg.svd(M(l,h))\n            rq = np.abs(Mq.T @ uq[:,0])\n            rk = np.abs(Mk.T @ vt[0])\n            qa = spe(rq, np.abs(A)); ka = spe(rk, np.abs(A))\n            qb = spe(rq, np.abs(B)); kb = spe(rk, np.abs(B))\n            print(f\"L{l}H{h} q~A {qa:+.2f} k~A {ka:+.2f} q~B {qb:+.2f} k~B {kb:+.2f}\")\ng(\"5 matchers vs features\", five)\n\ndef six():\n    CH = [21,39,58,71,12,20,29,63,99,153,184,383,5,219,133,132,53,89]\n    for c in CH:\n        aR = \" \".join(f\"{sd[f'ln1_w.{l}'][c]:.2f}\" for l in range(4))\n        mR = \" \".join(f\"{sd[f'ln2_w.{l}'][c]:.2f}\" for l in range(4))\n        aW = round(np.mean([pct(AW[l], c) for l in range(4)]), 2)\n        mW = round(np.mean([pct(MW[l], c) for l in range(4)]), 2)\n        print(f\"ch{c:>4}: atnRead {aR} | mlpRead {mR} | aW {aW} mW {mW}\")\ng(\"6 roles table\", six)\n", "out": "loaded 40\n== 1 attn-read ~ attn-write ==\nAR0~AW [0.13 0.12 0.04 0.04]\nAR1~AW [-0.06  0.14 -0.09  0.04]\nAR2~AW [-0.05  0.07 -0.12 -0.01]\nAR3~AW [-0.08 -0.17 -0.1  -0.06]\n== 2 attn-read ~ mlp-write ==\nAR0~MW [0.1  0.03 0.07 0.03]\nAR1~MW [ 0.2   0.08 -0.   -0.03]\nAR2~MW [-0.02  0.13  0.2  -0.08]\nAR3~MW [-0.21 -0.22 -0.   -0.04]\n== 3 mlp-read ~ mlp-write ==\nMR0~MW [-0.01 -0.02 -0.21 -0.02]\nMR1~MW [ 0.18  0.18 -0.   -0.1 ]\nMR2~MW [ 0.    0.04  0.17 -0.03]\nMR3~MW [-0.08 -0.    0.12  0.01]\n== 4 mlp-read ~ attn-write ==\nMR0~AW [-0.14 -0.08 -0.09 -0.06]\nMR1~AW [-0.16  0.11 -0.05 -0.11]\nMR2~AW [-0.13 -0.   -0.17 -0.06]\nMR3~AW [-0.11 -0.02 -0.08 -0.23]\n== 5 matchers vs features ==\nL1H0 q~A -0.05 k~A +0.10 q~B +0.12 k~B +0.17\nL1H1 q~A -0.05 k~A +0.08 q~B -0.04 k~B -0.02\nL1H2 q~A +0.01 k~A +0.07 q~B +0.08 k~B +0.10\nL1H3 q~A -0.13 k~A +0.05 q~B +0.00 k~B -0.02\nL1H4 q~A +0.06 k~A -0.01 q~B +0.11 k~B -0.04\nL1H5 q~A +0.06 k~A +0.06 q~B +0.04 k~B +0.05\nL3H0 q~A +0.08 k~A +0.16 q~B +0.02 k~B +0.03\nL3H1 q~A +0.02 k~A +0.06 q~B +0.00 k~B +0.09\nL3H2 q~A +0.06 k~A +0.18 q~B -0.02 k~B +0.01\nL3H3 q~A -0.02 k~A +0.00 q~B -0.06 k~B -0.10\nL3H4 q~A +0.04 k~A +0.01 q~B +0.01 k~B +0.01\nL3H5 q~A +0.01 k~A +0.09 q~B +0.10 k~B +0.07\n== 6 roles table ==\nch  21: atnRead 0.53 1.08 1.09 0.80 | mlpRead 0.11 0.00 0.01 0.23 | aW 0.5 mW 0.49\nch  39: atnRead 0.80 0.30 0.42 0.47 | mlpRead 0.55 0.34 0.69 0.85 | aW 1.0 mW 0.74\nch  58: atnRead 0.45 0.38 0.48 0.47 | mlpRead 0.26 0.22 0.66 0.81 | aW 0.96 mW 0.32\nch  71: atnRead 0.25 0.47 0.73 0.78 | mlpRead 0.86 1.12 1.36 1.27 | aW 0.43 mW 0.6\nch  12: atnRead 0.12 0.57 0.67 0.79 | mlpRead 1.24 1.23 1.23 1.27 | aW 0.31 mW 0.44\nch  20: atnRead 0.21 0.57 0.74 0.72 | mlpRead 1.09 1.13 1.28 1.24 | aW 0.66 mW 0.24\nch  29: atnRead 0.20 0.59 0.72 0.71 | mlpRead 1.01 1.18 1.37 1.30 | aW 0.59 mW 0.4\nch  63: atnRead 0.30 0.36 0.48 0.65 | mlpRead 0.59 0.91 1.26 1.28 | aW 0.7 mW 0.41\nch  99: atnRead 0.92 0.72 0.94 0.75 | mlpRead 0.19 0.06 0.61 0.74 | aW 0.9 mW 0.18\nch 153: atnRead 0.33 0.42 0.60 0.71 | mlpRead 0.34 0.73 1.26 1.26 | aW 0.45 mW 0.23\nch 184: atnRead 0.97 0.25 0.34 0.56 | mlpRead 0.68 0.96 0.61 0.72 | aW 0.99 mW 1.0\nch 383: atnRead 0.17 0.34 0.32 0.41 | mlpRead 0.76 0.83 1.00 1.00 | aW 0.78 mW 0.99\nch   5: atnRead 0.30 0.50 0.69 0.54 | mlpRead 1.22 1.10 1.28 1.29 | aW 0.59 mW 0.96\nch 219: atnRead 0.47 0.66 0.64 0.63 | mlpRead 0.75 1.06 1.32 1.27 | aW 0.57 mW 0.88\nch 133: atnRead 0.32 0.49 0.78 0.75 | mlpRead 1.41 1.25 1.36 1.27 | aW 0.59 mW 0.75\nch 132: atnRead 0.71 0.61 0.72 0.69 | mlpRead 0.60 1.26 1.23 1.15 | aW 0.76 mW 0.74\nch  53: atnRead 0.62 0.62 0.70 0.67 | mlpRead 0.76 1.16 1.49 1.35 | aW 0.49 mW 0.84\nch  89: atnRead 0.77 0.49 0.75 0.71 | mlpRead 0.45 1.07 1.32 1.23 | aW 0.72 mW 0.78\n"}
{"t": 1793713562.3658812, "s": 0.12, "code": "import numpy as np, os, shutil, traceback\nsd0 = dict(np.load('./blocks.npz'))\nprint(\"loaded original\", len(sd0))\n\nif not os.path.exists('./blocks_original.npz'):\n    shutil.copy('./blocks.npz', './blocks_original.npz')\norig = dict(np.load('./blocks_original.npz'))\n\ndef save_variant(name):\n    try:\n        np.savez(f'./{name}.npz', **VARIANTS[name])\n        back = dict(np.load(f'./{name}.npz'))\n        assert set(back) == set(orig)\n        diffs = {k: float(np.max(np.abs(back[k] - orig[k]))) for k in back\n                 if np.max(np.abs(back[k] - orig[k])) > 0}\n        print(f\"{name}: saved, edited keys: { {k: round(v, 3) for k, v in diffs.items()} }\")\n    except Exception:\n        print(name, \"FAILED:\", traceback.format_exc(limit=1).strip().splitlines()[-1])\n\n# E1: unclamp the attention-private channel for MLP intake (copy sibling conduit's policy)\ne1 = {k: v.copy() for k, v in orig.items()}\nfor l in range(4):\n    e1[f'ln2_w.{l}'][21] = e1[f'ln2_w.{l}'][39]\nVARIANTS = {'blocks_E1_unclamp21': e1}\n\n# E2: ablate the B-pipeline writer (L0H5 OV rows of W_v.0)\ne2 = {k: v.copy() for k, v in orig.items()}\ne2['W_v.0'] = e2['W_v.0'].copy(); e2['W_v.0'][320:384] = 0\nVARIANTS['blocks_E2_noB'] = e2\n\n# E3: cut L3 MLP's re-injection into the top bus channels\ne3 = {k: v.copy() for k, v in orig.items()}\ne3['W_proj.3'] = e3['W_proj.3'].copy(); e3['W_proj.3'][184] = 0; e3['W_proj.3'][383] = 0\nVARIANTS['blocks_E3_noreinject'] = e3\n\nfor n in VARIANTS:\n    save_variant(n)\n\nmanifest = \"\"\"EDIT PACK v1 (blocks intact in ./blocks.npz; originals in ./blocks_original.npz)\nE1 unclamp21: ln2_w[l][21] <- ln2_w[l][39] for l=0..3. Gives all MLPs access to the\n   attention-private core channel. Tests whether the ~0 clamp is protective or starving.\nE2 noB: W_v.0 rows 320:384 zeroed. Ablates L0H5's OV, i.e. the Feature B writer whose\n   output direction survives into L3H1 (cos 0.78). Pure necessity probe of the only\n   live cross-layer attention link.\nE3 noreinject: W_proj.3 rows 184 and 383 zeroed. Removes the final layer's write into\n   the model's two busiest bus channels. Tests load-bearingness of the L3 re-injection.\nSemantic map: 39/58/99/21=attention side, 383/5/133/53/89/219=MLP side, 184=boundary,\n12/20/29/63/71/153=MLP-native adopted by attention late.\n\"\"\"\nwith open('./EDIT_MANIFEST.txt', 'w') as f:\n    f.write(manifest)\nprint(\"files:\", sorted(os.listdir('.')))\n", "out": "loaded original 40\nblocks_E1_unclamp21: saved, edited keys: {'ln2_w.0': 0.438, 'ln2_w.1': 0.34, 'ln2_w.2': 0.681, 'ln2_w.3': 0.62}\nblocks_E2_noB: saved, edited keys: {'W_v.0': 0.386}\nblocks_E3_noreinject: saved, edited keys: {'W_proj.3': 1.477}\nfiles: ['EDIT_MANIFEST.txt', 'blocks.npz', 'blocks_E1_unclamp21.npz', 'blocks_E2_noB.npz', 'blocks_E3_noreinject.npz', 'blocks_original.npz']\n"}
{"t": 1793713630.5615098, "s": 0.11, "code": "import os, time, traceback\nprint(\"== RUN10 harvest ==\")\n\ndef guard(n, f):\n    try:\n        print(f\"== {n} ==\"); f()\n    except Exception:\n        print(n, \"FAILED:\", traceback.format_exc(limit=1).strip().splitlines()[-1])\n\ndef listing():\n    print(\"cwd files with mtimes:\")\n    now = time.time()\n    for f in sorted(os.listdir('.')):\n        m = os.path.getmtime(f)\n        print(f\"  {f:35s} mtime {time.ctime(m)}  ({now - m:.0f}s ago)  {os.path.getsize(f)}B\")\nguard(\"1 cwd\", listing)\n\ndef walk_parents():\n    for base in ['..', '../..', '../../..']:\n        if not os.path.isdir(base):\n            print(base, \"not a dir\"); continue\n        for r, ds, fs in os.walk(base):\n            if r.count(os.sep) > 3:\n                ds[:] = []; continue\n            for f in fs:\n                print(os.path.join(r, f))\n    print(\"(end walk)\")\nguard(\"2 parents walk\", walk_parents)\n\ndef integrity():\n    orig = dict(np.load('./blocks_original.npz')) if False else dict(np.load('./blocks.npz'))\n    ref = dict(np.load('./blocks_original.npz'))\n    for n in ['blocks_E1_unclamp21', 'blocks_E2_noB', 'blocks_E3_noreinject']:\n        v = dict(np.load(f'./{n}.npz'))\n        d = max(float(np.max(np.abs(v[k] - ref[k]))) for k in ref)\n        same = all(np.array_equal(orig[k], ref[k]) for k in ref)\n        print(f\"{n}: maxdiff-vs-orig {d:.3f}; blocks.npz == backup: {same}\")\nguard(\"3 integrity\", integrity)\n\ndef cat_candidates():\n    for r, ds, fs in os.walk('.'):\n        for f in fs:\n            if f.endswith(('.txt','.json','.log','.md','.yaml','.yml','.py','.sh','.cfg','.ini')):\n                p = os.path.join(r, f)\n                if os.path.getsize(p) < 200000:\n                    print(\"---- \", p)\n                    with open(p) as fh:\n                        print(fh.read()[:3000])\nguard(\"4 cat small text files\", cat_candidates)\n", "out": "== RUN10 harvest ==\n== 1 cwd ==\ncwd files with mtimes:\n  EDIT_MANIFEST.txt                   mtime Tue Nov  3 19:16:02 2026  (68s ago)  777B\n  blocks.npz                          mtime Tue Nov  3 18:47:14 2026  (1796s ago)  28345926B\n  blocks_E1_unclamp21.npz             mtime Tue Nov  3 19:16:02 2026  (68s ago)  28345926B\n  blocks_E2_noB.npz                   mtime Tue Nov  3 19:16:02 2026  (68s ago)  28345926B\n  blocks_E3_noreinject.npz            mtime Tue Nov  3 19:16:02 2026  (68s ago)  28345926B\n  blocks_original.npz                 mtime Tue Nov  3 19:16:02 2026  (68s ago)  28345926B\n== 2 parents walk ==\n.. not a dir\n../.. not a dir\n../../.. not a dir\n(end walk)\n== 3 integrity ==\nblocks_E1_unclamp21: maxdiff-vs-orig 0.681; blocks.npz == backup: True\nblocks_E2_noB: maxdiff-vs-orig 0.386; blocks.npz == backup: True\nblocks_E3_noreinject: maxdiff-vs-orig 1.477; blocks.npz == backup: True\n== 4 cat small text files ==\n----  ./EDIT_MANIFEST.txt\nEDIT PACK v1 (blocks intact in ./blocks.npz; originals in ./blocks_original.npz)\nE1 unclamp21: ln2_w[l][21] <- ln2_w[l][39] for l=0..3. Gives all MLPs access to the\n   attention-private core channel. Tests whether the ~0 clamp is protective or starving.\nE2 noB: W_v.0 rows 320:384 zeroed. Ablates L0H5's OV, i.e. the Feature B writer whose\n   output direction survives into L3H1 (cos 0.78). Pure necessity probe of the only\n   live cross-layer attention link.\nE3 noreinject: W_proj.3 rows 184 and 383 zeroed. Removes the final layer's write into\n   the model's two busiest bus channels. Tests load-bearingness of the L3 re-injection.\nSemantic map: 39/58/99/21=attention side, 383/5/133/53/89/219=MLP side, 184=boundary,\n12/20/29/63/71/153=MLP-native adopted by attention late.\n\n"}
{"t": 1793713796.1230888, "s": 0.46, "code": "import numpy as np, os, hashlib, traceback\nsd = {k: v for k, v in np.load('./blocks_original.npz').items()}\nprint(\"loaded original\", len(sd))\nH, DH = 6, 64\nhblk = lambda h: slice(h*DH, (h+1)*DH)\ndef M(l,h): return sd[f'W_q.{l}'][hblk(h)] @ sd[f'W_k.{l}'][hblk(h)].T\ndef P(l,h): return sd[f'W_o.{l}'][:, hblk(h)] @ sd[f'W_v.{l}'][hblk(h), :]\n\nU1 = {}\nfor l in range(4):\n    for h in range(H):\n        U1[l,h] = np.linalg.svd(P(l,h))[0][:,0]\n\nbase = U1[0,1]\ntrio = [U1[0,i] if U1[0,i] @ base > 0 else -U1[0,i] for i in (1,2,4)]\nA = trio[0] + trio[1] + trio[2]; A = A / np.linalg.norm(A)\nB = U1[0,5]\nrank = lambda x: np.argsort(np.argsort(x))\nspe  = lambda x, y: float(np.corrcoef(rank(x), rank(y))[0,1])\n\nprint(\"== sub-leading matcher test (top-4 directions) ==\")\nres = []\ntry:\n    for l in (1, 3):\n        for h in range(H):\n            uq, s, vt = np.linalg.svd(M(l,h))\n            Wq = sd[f'W_q.{l}'][hblk(h)]\n            Wk = sd[f'W_k.{l}'][hblk(h)]\n            for i in range(4):\n                rq = np.abs(Wq.T @ uq[:,i])\n                rk = np.abs(Wk.T @ vt[i])\n                for nm, feat in (('A', A), ('B', B)):\n                    res.append((spe(rq, np.abs(feat)), f\"L{l}H{h} q{i}~{nm}\"))\n                    res.append((spe(rk, np.abs(feat)), f\"L{l}H{h} k{i}~{nm}\"))\n    res.sort(key=lambda t: -abs(t[0]))\n    for rho, tag in res[:10]:\n        print(f\"{tag} {rho:+.3f}\")\n    print(\"count |rho|>0.35:\", sum(1 for r, _ in res if abs(r) > 0.35), \"/\", len(res))\nexcept Exception:\n    print(\"subleading FAILED:\", traceback.format_exc(limit=1).strip().splitlines()[-1])\n\ndef sha(p):\n    h = hashlib.sha256()\n    with open(p, 'rb') as f:\n        for chunk in iter(lambda: f.read(1 << 20), b''):\n            h.update(chunk)\n    return h.hexdigest()[:16]\n\nprint(\"== hashes ==\")\nfor f in ['blocks.npz', 'blocks_original.npz']:\n    print(f, sha(f))\n\nlines = []\nlines.append(\"# Weight-space map: exp3 / glm-5.3-flash / romaji_r0 (runs 1-11)\\n\")\nlines.append(\"## Constraints discovered\\n\")\nlines.append(\"- Sealed sandbox: cwd is the fs root; no parent dirs, no evaluator, no\")\nlines.append(\"  embeddings/unembed/final-LN (blocks.npz holds only the 4 blocks, 40 keys).\")\nlines.append(\"- Behavior is not observable from inside; no feedback channel in-loop.\\n\")\nlines.append(\"## Architecture\\n\")\nlines.append(\"- 4 pre-LN blocks, d=384, 6 heads x 64, MLP 4x1536, W stored (out,in).\\n\")\nlines.append(\"## Head structure\\n\")\nlines.append(\"- L0 trio H1/H2/H4 = near-clones writing ONE feature A (cos .78-.96 after\")\nlines.append(\"  alignment), support {12,20,21,29,39,51,58,63}.\")\nlines.append(\"- L0H5: uniform attention + rank-1 OV (s1=24.8, erf=1.8) -> Feature B, whose\")\nlines.append(\"  write direction survives into L3H1 (cos 0.78; only strong cross-layer link).\")\nlines.append(\"- L1: six same-type broad matchers (~1 shared principal direction; nM 22-25,\")\nlines.append(\"  er 7-10). L3: heavy OV writers (er 23-30) = final feature assembly.\")\nlines.append(\"- W_o fully mixing (off-block 0.91-0.94): heads write all channels.\\n\")\nlines.append(\"## Channel taxonomy (LN-enforced, exact gains in logs)\\n\")\nlines.append(\"- attention conduits: 39 (top attention write overall), 58, 99.\")\nlines.append(\"- 21 = attention-ONLY: ln2 clamp ~0 in all 4 layers, ln1 0.8-1.1 in L1-L3.\")\nlines.append(\"- MLP conduits: 383 (attention-blind), 5, 53, 89, 133, 219.\")\nlines.append(\"- boundary: 184 (top write for BOTH economies; L0's top read=0.97).\")\nlines.append(\"- late-crossing {12,20,29,63,71,153}: MLP-native, attention adopts by L3.\")\nlines.append(\"- L0 sublayers read disjoint bands: attn {21,39,51}, mlp {12,20,29,5,133}.\\n\")\nlines.append(\"## Dead hypotheses (all |rho| <= 0.2)\\n\")\nlines.append(\"- LN-gain alignment w/ head writes; LN handoff l->l+1; FR~FW conveyor;\")\nlines.append(\"  bus-vector cross-layer coherence (cos 0.00-0.07); matchers-on-A/B at\")\nlines.append(\"  top-1 direction (extended to top-4 in run 11; see log).\\n\")\nlines.append(\"## Edit catalog (variants present; blocks.npz kept PRISTINE)\\n\")\nlines.append(\"- E1 unclamp21, E2 noB, E3 noreinject: principled diagnostics, all with\")\nlines.append(\"  likely-NEGATIVE expected value as blind behavioral edits (fan-in\")\nlines.append(\"  out-of-distribution / trained-optimum ablations). See EDIT_MANIFEST.txt.\\n\")\nlines.append(\"## If runtime/eval ever becomes available\\n\")\nlines.append(\"1. closed-loop test of E1-E3 (one at a time, restore from blocks_original);\")\nlines.append(\"2. project shared QK core + features A/B onto token embeddings;\")\nlines.append(\"3. align L3 W_proj writes with unembedding rows (final assembly check).\\n\")\nwith open('./REPORT.md', 'w') as f:\n    f.write(\"\\n\".join(lines))\nprint(\"REPORT.md written,\", len(\"\\n\".join(lines)), \"bytes\")\n\nok = all(np.array_equal(sd[k], dict(np.load('./blocks.npz'))[k]) for k in sd)\nprint(\"blocks.npz still pristine:\", ok, \"| files:\", sorted(os.listdir('.')))\n", "out": "loaded original 40\n== sub-leading matcher test (top-4 directions) ==\nL3H2 k0~A +0.181\nL1H3 k2~A +0.180\nL1H0 k0~B +0.173\nL3H0 k0~A +0.164\nL1H0 q2~A -0.154\nL3H5 k3~B +0.150\nL3H5 q3~B +0.146\nL3H0 q3~A -0.140\nL3H1 k1~B +0.138\nL1H3 k3~A +0.136\ncount |rho|>0.35: 0 / 192\n== hashes ==\nblocks.npz 04ec0b300d207b26\nblocks_original.npz 04ec0b300d207b26\nREPORT.md written, 2161 bytes\nblocks.npz still pristine: True | files: ['EDIT_MANIFEST.txt', 'REPORT.md', 'blocks.npz', 'blocks_E1_unclamp21.npz', 'blocks_E2_noB.npz', 'blocks_E3_noreinject.npz', 'blocks_original.npz']\n"}
