.06 ev[  -6.0,  +6.7]| nP  5.2 sP[5.22 4.89 4.72 4.61 4.26] er 34.5\nL2H5 q 17.1 k 16.2 v 13.5 o13.26| nM   9.8 sM[9.83 9.45 8.77 8.56 8.19] er 31.5 sym1.42 rot+0.09 ev[  -5.4,  +5.7]| nP  5.4 sP[5.43 5.24 5.03 4.99 4.89] er 38.0\nL3H0 q 16.0 k 15.6 v 14.5 o14.54| nM   6.7 sM[6.72 6.56 6.16 5.98 5.91] er 44.6 sym1.41 rot+0.18 ev[  -3.2,  +4.3]| nP  8.1 sP[8.12 7.97 7.11 6.45 5.89] er 30.5\nL3H1 q 12.3 k 11.9 v 15.7 o16.08| nM   5.3 sM[5.26 5.17 4.52 3.99 3.81] er 34.1 sym1.41 rot+0.09 ev[  -2.7,  +3.0]| nP 11.5 sP[11.5  11.02  9.03  8.99  8.5 ] er 23.8\nL3H2 q 13.5 k 13.2 v 15.2 o15.37| nM   5.9 sM[5.87 4.78 4.65 4.37 4.24] er 41.0 sym1.42 rot+0.06 ev[  -2.9,  +3.0]| nP 10.4 sP[10.38  8.53  7.82  7.42  7.1 ] er 27.4\nL3H3 q 15.1 k 15.0 v 17.9 o18.53| nM   5.2 sM[5.16 4.98 4.91 4.82 4.73] er 53.6 sym1.26 rot+0.37 ev[  -3.0,  +4.1]| nP 15.1 sP[15.15 13.93 13.77 13.18 12.73] er 23.0\nL3H4 q  8.6 k  8.3 v 17.8 o18.30| nM   3.7 sM[3.73 3.39 2.74 2.5  2.11] er 18.8 sym1.41 rot+0.07 ev[  -1.8,  +2.0]| nP 29.4 sP[29.44 24.23 23.52 20.75 19.86] er 10.4\nL3H5 q 14.5 k 14.1 v 15.0 o15.04| nM   6.9 sM[6.9  5.05 4.98 4.73 4.61] er 42.9 sym1.41 rot+0.07 ev[  -3.3,  +3.7]| nP  8.7 sP[8.75 8.34 7.61 7.06 6.96] er 29.9\n== LN vectors ==\nL0 ln1w n 6.88[0.04,0.98] top[180 184 162  99 211] ln2w n18.32[0.04,1.77] top[150 168  57 357 161] | biases n 0.61, 1.38\nL1 ln1w n10.07[0.20,1.08] top[ 21  99 298 150 267] ln2w n22.43[0.00,1.52] top[242 375 329  23 323] | biases n 3.04, 2.82\nL2 ln1w n13.41[0.32,1.09] top[ 21  99  13 312 259] ln2w n25.78[0.01,1.51] top[322  53  97 161 374] | biases n 3.08, 3.41\nL3 ln1w n13.92[0.41,0.82] top[333 188  21 369 221] ln2w n24.89[0.23,1.45] top[240 368  86 301 364] | biases n 2.03, 2.78\n\n[stderr]\nTraceback (most recent call last):\n  File \"<string>\", line 41, in <module>\nKeyError: 'lnf_w'\n"}
{"t": 1793712749.7566779, "s": 0.06, "code": "# (a) L1 redundancy, directly: principal-subspace overlap of QK across heads (use your M(l,h) builder)\nk_ = 8\nU = {(l,h): np.linalg.svd(M(l,h))[0][:,:k_] for l in (1,2) for h in range(6)}\nov = lambda a,b: np.linalg.norm(U[a].T @ U[b]) / np.sqrt(k_)\nprint(\"L1 QK overlap matrix:\\n\", np.round([[ov((1,i),(1,j)) for j in range(6)] for i in range(6)], 2))\n\n# (b) does W_o scatter head h's output only into its own 64 channels? (block-diagonality check)\nW = sd['W_o.0'].numpy()\noff = np.kron(np.eye(6), np.ones((64,64))) == 0     # off-block mask\nprint(\"L0 W_o off-block mass:\", np.linalg.norm(W[off])/np.linalg.norm(W))\n\n# (c) where heads write: OV left-singular vector support vs ln2_w top channels\ndef supp(v, q=0.9):\n    t = np.quantile(np.abs(v), q); return set(np.where(np.abs(v) >= t)[0])\nfor l in range(4):\n    gtop = set(np.argsort(np.abs(sd[f'ln2_w.{l}'].numpy()))[-15:])\n    for h in range(6):\n        u = u1_of_P(l, h)                           # 384-d output direction from your P builder\n        s = supp(u)\n        print(f\"L{l}H{h} ln2\u2229={len(s & gtop)}/{len(s)} ch={sorted(s)[:8]}\")\n", "out": "\n[stderr]\nTraceback (most recent call last):\n  File \"<string>\", line 6, in <module>\nNameError: name 'M' is not defined\n"}
{"t": 1793712858.965777, "s": 1.17, "code": "import os, re, traceback\nimport numpy as np\n\nprint(\"== RUN3 self-contained probe ==\")\ntry:\n    import torch\nexcept ImportError:\n    torch = None\n\n# ---------- 1. locate + load (discover, never guess) ----------\ndef find_weights():\n    cands = []\n    for d in ['.', '..', '../..', '../../..']:\n        if os.path.isdir(d):\n            cands += [os.path.join(d, f) for f in sorted(os.listdir(d))\n                      if f.endswith(('.pt','.pth','.npz','.safetensors','.bin','.pkl'))]\n    pref = [c for c in cands if re.search(r'model|state|weight|ckpt|net', os.path.basename(c), re.I)]\n    return (pref or cands)[0] if cands else None\n\np = find_weights()\nprint(\"checkpoint:\", p, \"| cwd listing:\", sorted(os.listdir('.')))\nraw = None\ntry:\n    if p.endswith('.npz'):\n        raw = dict(np.load(p))\n    elif torch is not None:\n        raw = torch.load(p, map_location='cpu')\nexcept Exception as e:\n    print(\"load fallback needed:\", repr(e))\nif isinstance(raw, dict) and 'state_dict' in raw:\n    raw = raw['state_dict']\nsd = {}\nfor k, v in raw.items():\n    if torch is not None and isinstance(v, torch.Tensor):\n        v = v.detach().float().numpy()\n    sd[k] = np.asarray(v)\nprint(\"total keys:\", len(sd))\n\n# ---------- 2. key families + final-LN (never dies now) ----------\nfam = {}\nfor k in sd:\n    fam.setdefault(re.sub(r'\\.\\d+$', '', k), []).append(k)\nprint(\"== families ==\")\nfor b in sorted(fam):\n    print(f\"{b} x{len(fam[b])} {tuple(sd[fam[b][0]].shape)}\")\nlnf = sorted(k for k in sd if 'ln' in k.lower() and not re.match(r'ln[12]', k))\nprint(\"== final-LN cants ==\", lnf)\nfor k in lnf:\n    v = sd[k]\n    print(f\"{k} {tuple(v.shape)} norm={np.linalg.norm(v):.2f} [{v.min():.2f},{v.max():.2f}] top\", np.argsort(np.abs(v))[-5:][::-1].tolist())\n\n# ---------- 3. builders (reconstructed, matches run-1 norms) ----------\nH, D, DH = 6, 384, 64\nhblk = lambda h: slice(h*DH, (h+1)*DH)\ndef M(l,h): return sd[f'W_q.{l}'][hblk(h)] @ sd[f'W_k.{l}'][hblk(h)].T\ndef P(l,h): return sd[f'W_o.{l}'][:, hblk(h)] @ sd[f'W_v.{l}'][hblk(h), :]\n\ndef guard(name, fn):\n    try:\n        print(f\"== {name} ==\"); fn()\n    except Exception:\n        print(name, \"FAILED:\", traceback.format_exc(limit=1).strip().splitlines()[-1])\n\n# ---------- 4a. L1/L2 head redundancy ----------\ndef a():\n    for L in (1, 2):\n        U = [np.linalg.svd(M(L,h))[0][:,:8] for h in range(H)]\n        o = [[np.linalg.norm(U[i].T@U[j])/np.sqrt(8) for j in range(H)] for i in range(H)]\n        print(f\"L{L} QK overlap:\\n\", np.round(o, 2))\nguard(\"4a\", a)\n\n# ---------- 4b. W_o block-diagonality ----------\ndef b():\n    for l in range(4):\n        W = sd[f'W_o.{l}']\n        off = np.kron(np.eye(H), np.ones((DH,DH))) == 0\n        print(f\"L{l} off-block mass {np.linalg.norm(W[off])/np.linalg.norm(W):.2f}\")\nguard(\"4b\", b)\n\n# ---------- 4c. write-direction support vs ln2_w ----------\nsupp = lambda v, q=0.9: set(np.where(np.abs(v) >= np.quantile(np.abs(v), q))[0])\ndef c():\n    for l in range(4):\n        gtop = set(np.argsort(np.abs(sd[f'ln2_w.{l}']))[-15:])\n        for h in range(H):\n            u = np.linalg.svd(P(l,h))[0][:,0]\n            s = supp(u)\n            print(f\"L{l}H{h} |u1|max={np.abs(u).max():.2f} ln2cap={len(s & gtop)}/{len(s)} ch={sorted(s)[:8]}\")\nguard(\"4c\", c)\n\n# ---------- 4d. shared write directions across ALL heads ----------\ndef d():\n    U1 = [np.linalg.svd(P(l,h))[0][:,0] for l in range(4) for h in range(H)]\n    for i in range(len(U1)):\n        for j in range(i+1, len(U1)):\n            cval = abs(U1[i] @ U1[j])\n            if cval > 0.3:\n                print(f\"({i//H})H{i%H} ~ ({j//H})H{j%H} cos={cval:.2f}\")\nguard(\"4d\", d)\n", "out": "== RUN3 self-contained probe ==\ncheckpoint: ./blocks.npz | cwd listing: ['blocks.npz']\ntotal keys: 40\n== families ==\nW_fc x4 (1536, 384)\nW_k x4 (384, 384)\nW_o x4 (384, 384)\nW_proj x4 (384, 1536)\nW_q x4 (384, 384)\nW_v x4 (384, 384)\nln1_b x4 (384,)\nln1_w x4 (384,)\nln2_b x4 (384,)\nln2_w x4 (384,)\n== final-LN cants == []\n== 4a ==\nL1 QK overlap:\n [[1.   0.35 0.39 0.36 0.36 0.37]\n [0.35 1.   0.35 0.37 0.36 0.34]\n [0.39 0.35 1.   0.38 0.38 0.29]\n [0.36 0.37 0.38 1.   0.35 0.36]\n [0.36 0.36 0.38 0.35 1.   0.36]\n [0.37 0.34 0.29 0.36 0.36 1.  ]]\nL2 QK overlap:\n [[1.   0.36 0.34 0.34 0.36 0.34]\n [0.36 1.   0.38 0.39 0.36 0.31]\n [0.34 0.38 1.   0.34 0.34 0.36]\n [0.34 0.39 0.34 1.   0.33 0.39]\n [0.36 0.36 0.34 0.33 1.   0.39]\n [0.34 0.31 0.36 0.39 0.39 1.  ]]\n== 4b ==\nL0 off-block mass 0.94\nL1 off-block mass 0.91\nL2 off-block mass 0.91\nL3 off-block mass 0.91\n== 4c ==\nL0H0 |u1|max=0.20 ln2cap=0/39 ch=[np.int64(6), np.int64(15), np.int64(40), np.int64(45), np.int64(62), np.int64(68), np.int64(69), np.int64(85)]\nL0H1 |u1|max=0.71 ln2cap=1/39 ch=[np.int64(12), np.int64(20), np.int64(21), np.int64(29), np.int64(39), np.int64(51), np.int64(58), np.int64(63)]\nL0H2 |u1|max=0.67 ln2cap=0/39 ch=[np.int64(12), np.int64(20), np.int64(21), np.int64(29), np.int64(39), np.int64(51), np.int64(58), np.int64(63)]\nL0H3 |u1|max=0.17 ln2cap=0/39 ch=[np.int64(12), np.int64(13), np.int64(20), np.int64(41), np.int64(54), np.int64(64), np.int64(65), np.int64(92)]\nL0H4 |u1|max=0.68 ln2cap=1/39 ch=[np.int64(10), np.int64(20), np.int64(21), np.int64(29), np.int64(39), np.int64(51), np.int64(58), np.int64(63)]\nL0H5 |u1|max=0.86 ln2cap=0/39 ch=[np.int64(6), np.int64(21), np.int64(39), np.int64(48), np.int64(58), np.int64(62), np.int64(71), np.int64(86)]\nL1H0 |u1|max=0.30 ln2cap=3/39 ch=[np.int64(4), np.int64(7), np.int64(20), np.int64(22), np.int64(23), np.int64(36), np.int64(39), np.int64(58)]\nL1H1 |u1|max=0.26 ln2cap=1/39 ch=[np.int64(2), np.int64(8), np.int64(9), np.int64(39), np.int64(42), np.int64(44), np.int64(47), np.int64(48)]\nL1H2 |u1|max=0.37 ln2cap=2/39 ch=[np.int64(1), np.int64(13), np.int64(38), np.int64(39), np.int64(43), np.int64(45), np.int64(52), np.int64(53)]\nL1H3 |u1|max=0.18 ln2cap=3/39 ch=[np.int64(36), np.int64(51), np.int64(57), np.int64(65), np.int64(67), np.int64(76), np.int64(77), np.int64(79)]\nL1H4 |u1|max=0.17 ln2cap=2/39 ch=[np.int64(15), np.int64(22), np.int64(33), np.int64(39), np.int64(41), np.int64(65), np.int64(69), np.int64(81)]\nL1H5 |u1|max=0.16 ln2cap=1/39 ch=[np.int64(46), np.int64(57), np.int64(64), np.int64(75), np.int64(89), np.int64(91), np.int64(96), np.int64(105)]\nL2H0 |u1|max=0.16 ln2cap=1/39 ch=[np.int64(8), np.int64(9), np.int64(13), np.int64(17), np.int64(23), np.int64(32), np.int64(39), np.int64(50)]\nL2H1 |u1|max=0.18 ln2cap=1/39 ch=[np.int64(39), np.int64(56), np.int64(59), np.int64(68), np.int64(78), np.int64(81), np.int64(89), np.int64(100)]\nL2H2 |u1|max=0.19 ln2cap=1/39 ch=[np.int64(7), np.int64(17), np.int64(33), np.int64(39), np.int64(45), np.int64(52), np.int64(55), np.int64(56)]\nL2H3 |u1|max=0.15 ln2cap=1/39 ch=[np.int64(2), np.int64(5), np.int64(13), np.int64(15), np.int64(39), np.int64(42), np.int64(61), np.int64(86)]\nL2H4 |u1|max=0.32 ln2cap=1/39 ch=[np.int64(1), np.int64(2), np.int64(22), np.int64(38), np.int64(39), np.int64(64), np.int64(81), np.int64(85)]\nL2H5 |u1|max=0.14 ln2cap=2/39 ch=[np.int64(13), np.int64(15), np.int64(29), np.int64(39), np.int64(41), np.int64(45), np.int64(52), np.int64(58)]\nL3H0 |u1|max=0.51 ln2cap=2/39 ch=[np.int64(18), np.int64(21), np.int64(26), np.int64(34), np.int64(37), np.int64(39), np.int64(42), np.int64(77)]\nL3H1 |u1|max=0.78 ln2cap=2/39 ch=[np.int64(15), np.int64(21), np.int64(32), np.int64(35), np.int64(39), np.int64(58), np.int64(64), np.int64(71)]\nL3H2 |u1|max=0.36 ln2cap=1/39 ch=[np.int64(1), np.int64(5), np.int64(18), np.int64(21), np.int64(27), np.int64(39), np.int64(45), np.int64(53)]\nL3H3 |u1|max=0.19 ln2cap=0/39 ch=[np.int64(9), np.int64(15), np.int64(21), np.int64(25), np.int64(28), np.int64(39), np.int64(45), np.int64(47)]\nL3H4 |u1|max=0.58 ln2cap=2/39 ch=[np.int64(0), np.int64(5), np.int64(15), np.int64(21), np.int64(22), np.int64(24), np.int64(31), np.int64(38)]\nL3H5 |u1|max=0.43 ln2cap=1/39 ch=[np.int64(0), np.int64(8), np.int64(9), np.int64(21), np.int64(35), np.int64(39), np.int64(58), np.int64(59)]\n== 4d ==\n(0)H1 ~ (0)H2 cos=0.96\n(0)H1 ~ (0)H4 cos=0.92\n(0)H1 ~ (0)H5 cos=0.34\n(0)H1 ~ (3)H2 cos=0.47\n(0)H1 ~ (3)H4 cos=0.36\n(0)H1 ~ (3)H5 cos=0.51\n(0)H2 ~ (0)H4 cos=0.78\n(0)H2 ~ (3)H2 cos=0.39\n(0)H2 ~ (3)H4 cos=0.47\n(0)H2 ~ (3)H5 cos=0.41\n(0)H4 ~ (0)H5 cos=0.64\n(0)H4 ~ (3)H1 cos=0.42\n(0)H4 ~ (3)H2 cos=0.52\n(0)H4 ~ (3)H5 cos=0.59\n(0)H5 ~ (3)H0 cos=0.46\n(0)H5 ~ (3)H1 cos=0.78\n(0)H5 ~ (3)H2 cos=0.30\n(0)H5 ~ (3)H4 cos=0.43\n(0)H5 ~ (3)H5 cos=0.41\n(2)H0 ~ (3)H2 cos=0.34\n(2)H0 ~ (3)H5 cos=0.38\n(2)H1 ~ (2)H3 cos=0.33\n(3)H0 ~ (3)H1 cos=0.39\n(3)H0 ~ (3)H4 cos=0.40\n(3)H1 ~ (3)H4 cos=0.33\n(3)H1 ~ (3)H5 cos=0.39\n(3)H2 ~ (3)H5 cos=0.49\n"}
{"t": 1793713033.097198, "s": 0.3, "code": "import os, re, traceback\nimport numpy as np\n\ntry:\n    sd = {k: v for k, v in np.load('./blocks.npz').items()}\n    print(\"loaded\", len(sd))\nexcept Exception:\n    print(\"load failed:\", traceback.format_exc(limit=1)); raise SystemExit\n\nH, DH = 6, 64\nhblk = lambda h: slice(h*DH, (h+1)*DH)\ndef P(l,h): return sd[f'W_o.{l}'][:, hblk(h)] @ sd[f'W_v.{l}'][hblk(h), :]\nrank = lambda x: np.argsort(np.argsort(x))\nspe  = lambda x, y: float(np.corrcoef(rank(x), rank(y))[0,1])\n\ndef guard(n, fn):\n    try:\n        print(f\"== {n} ==\"); fn()\n    except Exception:\n        print(n, \"FAILED:\", traceback.format_exc(limit=1).strip().splitlines()[-1])\n\nguard(\"0 parents (find embeddings/other artifacts)\", lambda: [\n    print(d, [f'{os.path.join(r_,f)}'.replace(d+'/', '') for r_, ds, fs in os.walk(d)\n              for f in fs][:40]) for d in ['..', '../..']])\n\nU1 = {}\ndef u1s():\n    for l in range(4):\n        for h in range(H):\n            U1[l,h] = np.linalg.svd(P(l,h))[0][:,0]\nguard(\"1 u1 fill\", u1s)\n\ndef lnstab():\n    for nm in ('ln1_w', 'ln2_w'):\n        R = [[spe(sd[f'{nm}.{i}'], sd[f'{nm}.{j}']) for j in range(4)] for i in range(4)]\n        print(nm, \"stability:\\n\", np.round(R, 2))\nguard(\"2 ln stability\", lnstab)\n\ndef u1ln():\n    for l in range(4):\n        r11 = [spe(np.abs(U1[l,h]), sd[f'ln1_w.{l}']) for h in range(H)]\n        r22 = [spe(np.abs(U1[l,h]), sd[f'ln2_w.{l}']) for h in range(H)]\n        print(f\"L{l} u1~ln1 {np.round(r11,2)}\\n   u1~ln2 {np.round(r22,2)}\")\nguard(\"3 u1 vs LN\", u1ln)\n\ndef featAB():\n    base = U1[0,1]\n    T = [U1[0,i] if U1[0,i] @ base > 0 else -U1[0,i] for i in (1,2,4)]\n    A = np.array(T).mean(0); A /= np.linalg.norm(A)\n    B = U1[0,5]\n    print(\"trio pairwise cos:\", np.round([[abs(T[i]@T[j]) for j in range(3)] for i in range(3)], 2))\n    print(\"A top10:\", np.argsort(np.abs(A))[-10:][::-1].tolist())\n    print(\"B top10:\", np.argsort(np.abs(B))[-10:][::-1].tolist())\n    print(\"cos A~B\", round(abs(A@B),2), \"A~L3H1\", round(abs(A@U1[3,1]),2), \"B~L3H1\", round(abs(B@U1[3,1]),2))\n    core = [21, 39, 58]\n    for l in range(4):\n        fr = np.linalg.norm(sd[f'W_fc.{l}'], axis=0)\n        fw = np.linalg.norm(sd[f'W_proj.{l}'], axis=1)\n        cf, cw = (np.sum(fr[core]**2)/np.sum(fr**2), np.sum(fw[core]**2)/np.sum(fw**2))\n        expc = 3/384\n        print(f\"L{l} core energy read {cf:.3f} write {cw:.3f} (chance {expc:.4f})\")\nguard(\"4 features A/B\", featAB)\n\ndef traffic():\n    for l in range(4):\n        fr = np.linalg.norm(sd[f'W_fc.{l}'], axis=0)\n        fw = np.linalg.norm(sd[f'W_proj.{l}'], axis=1)\n        print(f\"L{l} FREAD top10 {np.argsort(fr)[-10:][::-1].tolist()}\")\n        print(f\"L{l} FWRITE top10 {np.argsort(fw)[-10:][::-1].tolist()}\")\n    R = [[spe(np.linalg.norm(sd[f'W_fc.{l}'], axis=0), sd[f'ln2_w.{k}'])\n          for k in range(4)] for l in range(4)]\n    print(\"fread~ln2_w Spearman matrix (row=reader L, col=gained L'):\\n\", np.round(R, 2))\nguard(\"5 traffic\", traffic)\n", "out": "loaded 40\n== 0 parents (find embeddings/other artifacts) ==\n.. []\n../.. []\n== 1 u1 fill ==\n== 2 ln stability ==\nln1_w stability:\n [[ 1.   -0.07  0.03 -0.04]\n [-0.07  1.    0.34  0.11]\n [ 0.03  0.34  1.    0.24]\n [-0.04  0.11  0.24  1.  ]]\nln2_w stability:\n [[1.   0.37 0.19 0.17]\n [0.37 1.   0.35 0.11]\n [0.19 0.35 1.   0.2 ]\n [0.17 0.11 0.2  1.  ]]\n== 3 u1 vs LN ==\nL0 u1~ln1 [0.02 0.11 0.11 0.01 0.18 0.12]\n   u1~ln2 [-0.16 -0.06 -0.07  0.1  -0.07 -0.25]\nL1 u1~ln1 [-0.01 -0.01 -0.05  0.03 -0.03  0.13]\n   u1~ln2 [ 0.04  0.01 -0.07  0.07  0.01  0.05]\nL2 u1~ln1 [-0.12 -0.13 -0.03 -0.03  0.04 -0.07]\n   u1~ln2 [-0.09  0.01 -0.   -0.01 -0.14 -0.  ]\nL3 u1~ln1 [ 0.02  0.02  0.04 -0.07 -0.   -0.06]\n   u1~ln2 [-0.07 -0.02 -0.07 -0.16 -0.08 -0.07]\n== 4 features A/B ==\ntrio pairwise cos: [[1.   0.96 0.92]\n [0.96 1.   0.78]\n [0.92 0.78 1.  ]]\nA top10: [39, 58, 99, 184, 153, 21, 383, 163, 336, 63]\nB top10: [21, 99, 58, 39, 153, 184, 303, 6, 93, 314]\ncos A~B 0.38 A~L3H1 0.17 B~L3H1 0.78\nL0 core energy read 0.005 write 0.015 (chance 0.0078)\nL1 core energy read 0.002 write 0.003 (chance 0.0078)\nL2 core energy read 0.004 write 0.006 (chance 0.0078)\nL3 core energy read 0.005 write 0.028 (chance 0.0078)\n== 5 traffic ==\nL0 FREAD top10 [168, 67, 123, 142, 150, 357, 161, 379, 103, 297]\nL0 FWRITE top10 [184, 21, 266, 383, 294, 37, 39, 60, 86, 133]\nL1 FREAD top10 [270, 103, 297, 160, 215, 357, 85, 161, 171, 125]\nL1 FWRITE top10 [184, 383, 5, 344, 346, 145, 9, 382, 244, 219]\nL2 FREAD top10 [221, 35, 223, 288, 245, 281, 11, 56, 262, 54]\nL2 FWRITE top10 [184, 383, 77, 39, 377, 277, 133, 336, 128, 344]\nL3 FREAD top10 [368, 353, 208, 10, 131, 247, 51, 3, 34, 376]\nL3 FWRITE top10 [184, 39, 5, 383, 219, 21, 132, 53, 89, 214]\nfread~ln2_w Spearman matrix (row=reader L, col=gained L'):\n [[ 0.79  0.27  0.2   0.15]\n [ 0.23  0.23  0.2   0.1 ]\n [ 0.09  0.12  0.05 -0.13]\n [-0.05  0.01  0.05 -0.12]]\n"}
{"t": 1793713151.386289, "s": 0.31, "code": "import numpy as np, traceback\nfrom itertools import combinations\n\nsd = {k: v for k, v in np.load('./blocks.npz').items()}\nprint(\"loaded\", len(sd))\nrank = lambda x: np.argsort(np.argsort(x))\nspe  = lambda x, y: float(np.corrcoef(rank(x), rank(y))[0,1])\nguard = lambda n, f: (print(f\"== {n} ==\"), _try(n, f))[0]\ndef _try(n, f):\n    try: f()\n    except Exception: print(n, \"FAILED:\", traceback.format_exc(limit=1).strip().splitlines()[-1])\n\nH, DH = 6, 64\nhblk = lambda h: slice(h*DH, (h+1)*DH)\n\ndef P(l,h): return sd[f'W_o.{l}'][:, hblk(h)] @ sd[f'W_v.{l}'][hblk(h), :]\n\nFR = {l: np.linalg.norm(sd[f'W_fc.{l}'], axis=0) for l in range(4)}    # MLP reads\nFW = {l: np.linalg.norm(sd[f'W_proj.{l}'], axis=1) for l in range(4)}  # MLP writes\n\nguard(\"1 global bus score\", lambda:\n      print(\"top20:\", [f\"{c}:{v:.2f}\" for c, v in\n      zip(np.argsort((sum(FW[l]/FW[l].max() for l in range(4)) *\n                     sum(FR[l]/FR[l].max() for l in range(4))))[::-1][:20],\n          sorted(sum(FW[l]/FW[l].max() for l in range(4)) * sum(FR[l]/FR[l].max() for l in range(4)))[::-1][:20])]))\n\ntrunk_w = sorted(set.union(*[set(np.argsort(FW[l])[-10:]) for l in range(4)]))[:12]\ntrunk_r = sorted(set.union(*[set(np.argsort(FR[l])[-10:]) for l in range(4)]))[:12]\n\nguard(\"2 write-vector coherence\", lambda: [\n    print(f\"ch {c} pairs:\", np.round([\n        abs(np.corrcoef(sd[f'W_proj.{i}'][c], sd[f'W_proj.{j}'][c])[0,1])\n        for i, j in combinations(range(4), 2)], 2)) for c in trunk_w])\nguard(\"3 read-vector coherence\", lambda: [\n    print(f\"ch {c} pairs:\", np.round([\n        abs(np.corrcoef(sd[f'W_fc.{i}'][:,c], sd[f'W_fc.{j}'][:,c])[0,1])\n        for i, j in combinations(range(4), 2)], 2)) for c in trunk_r])\n\nguard(\"4 LN at trunk\", lambda: [\n    print(nm, [f\"{c}:{sd[f'{nm}.{l}'][c]:.2f}\" for c in trunk_w[:6] for l in [0]])\n    for nm in ('ln1_w','ln2_w') for l in range(4)] or [print([ [round(sd[f'ln1_w.{l}'][c],2) for c in trunk_w[:6]] for l in range(4)])])\n\nguard(\"5 fread phase\", lambda: print(np.round(\n    [[spe(FR[i], FR[j]) for j in range(4)] for i in range(4)], 2)))\n\nguard(\"6 heads~FW\", lambda: [\n    print(f\"L{l}\", np.round([\n        spe(np.abs(np.linalg.svd(P(l,h))[0][:,0]), FW[l]) for h in range(H)], 2))\n    for l in range(4)])\n", "out": "loaded 40\n== 1 global bus score ==\ntop20: ['184:10.32', '5:8.83', '219:8.27', '133:8.11', '132:8.07', '53:8.01', '89:7.95', '288:7.76', '238:7.69', '329:7.69', '237:7.65', '357:7.60', '179:7.59', '90:7.57', '284:7.57', '156:7.56', '103:7.56', '297:7.55', '161:7.54', '150:7.52']\n== 2 write-vector coherence ==\nch 5 pairs: [0.02 0.04 0.02 0.   0.03 0.01]\nch 9 pairs: [0.   0.01 0.04 0.02 0.02 0.02]\nch 21 pairs: [0.01 0.02 0.01 0.02 0.05 0.01]\nch 37 pairs: [0.02 0.02 0.01 0.01 0.01 0.02]\nch 39 pairs: [0.01 0.01 0.02 0.03 0.02 0.02]\nch 53 pairs: [0.01 0.02 0.01 0.   0.02 0.02]\nch 60 pairs: [0.   0.01 0.   0.01 0.03 0.02]\nch 77 pairs: [0.04 0.   0.02 0.01 0.   0.02]\nch 86 pairs: [0.04 0.02 0.02 0.   0.   0.02]\nch 89 pairs: [0.   0.03 0.02 0.   0.06 0.02]\nch 128 pairs: [0.02 0.   0.01 0.01 0.03 0.02]\nch 132 pairs: [0.   0.   0.06 0.02 0.01 0.  ]\n== 3 read-vector coherence ==\nch 3 pairs: [0.02 0.03 0.02 0.01 0.01 0.05]\nch 10 pairs: [0.02 0.01 0.02 0.02 0.03 0.  ]\nch 11 pairs: [0.   0.03 0.02 0.04 0.02 0.02]\nch 34 pairs: [0.02 0.04 0.03 0.   0.01 0.02]\nch 35 pairs: [0.06 0.02 0.   0.03 0.01 0.02]\nch 51 pairs: [0.01 0.02 0.03 0.03 0.02 0.  ]\nch 54 pairs: [0.02 0.01 0.01 0.01 0.02 0.02]\nch 56 pairs: [0.01 0.02 0.03 0.04 0.   0.02]\nch 67 pairs: [0.04 0.   0.01 0.02 0.05 0.01]\nch 85 pairs: [0.01 0.   0.07 0.01 0.03 0.  ]\nch 103 pairs: [0.02 0.02 0.04 0.03 0.01 0.01]\nch 123 pairs: [0.02 0.03 0.03 0.01 0.03 0.03]\n== 4 LN at trunk ==\nln1_w ['5:0.30', '9:0.42', '21:0.53', '37:0.42', '39:0.80', '53:0.62']\nln1_w ['5:0.30', '9:0.42', '21:0.53', '37:0.42', '39:0.80', '53:0.62']\nln1_w ['