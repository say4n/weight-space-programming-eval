{"t": 1793712510.705759, "s": 0.58, "code": "import numpy as np\nnp.set_printoptions(precision=3, suppress=True, linewidth=250)\nd=384; L=4; H=6\n\ndef er(s):\n    p=np.asarray(s,float)**2\n    return float((p.sum()**2)/((p**2).sum()+1e-12))\n\ndef topp(A,r):\n    U,S,Vt=np.linalg.svd(A,full_matrices=False)\n    return U[:,:r],Vt[:r].T,S\n\ndef rg(Ua,Ub):\n    return float(np.linalg.norm(Ua.T@Ub)**2*d/(Ua.shape[1]*Ub.shape[1]+1e-9))\n\nprint(\"== keys ==\")\nfor k in sorted(W.keys()):\n    print(k, W[k].shape, \"norm=%.2f\"%np.linalg.norm(W[k]))\n\ninfo={}\nprint(\"== per head: q/k/v/o norms | M=Qkform: nM, sM top5, effrank, sym=||M-Mt||/||M||, rot=|u1.v1|, evrange sym part | P=OV: nP, sP top5, effrank ==\")\nfor l in range(L):\n    for j in range(H):\n        b=slice(64*j,64*j+64)\n        Q=W[f\"W_q.{l}\"][b,:];K=W[f\"W_k.{l}\"][b,:];V=W[f\"W_v.{l}\"][b,:];O=W[f\"W_o.{l}\"][:,b]\n        M=Q.T@K; P=O@V\n        UM,VM,SM=topp(M,8); UP,VP,SP=topp(P,16)\n        sym=np.linalg.norm(M-M.T)/(np.linalg.norm(M)+1e-12)\n        rot=float(np.dot(UM[:,0],VM[:,0]))\n        ev=np.linalg.eigvalsh((M+M.T)*.5)\n        info[(l,j)]=dict(Q=Q,K=K,V=V,M=M,P=P,UP=UP,VP=VP,sM=SM,sP=SP)\n        print(f\"L{l}H{j} q{np.linalg.norm(Q):5.1f} k{np.linalg.norm(K):5.1f} v{np.linalg.norm(V):5.1f} o{np.linalg.norm(O):5.2f}| nM{SM[0]:6.1f} sM{np.round(SM[:5],2)} er{er(SM):5.1f} sym{sym:4.2f} rot{rot:+5.2f} ev[{ev[0]:+6.1f},{ev[-1]:+6.1f}]| nP{SP[0]:5.1f} sP{np.round(SP[:5],2)} er{er(SP):5.1f}\")\n\nprint(\"== LN vectors ==\")\nfor l in range(L):\n    a1=W[f\"ln1_w.{l}\"];b1=W[f\"ln1_b.{l}\"];a2=W[f\"ln2_w.{l}\"];b2=W[f\"ln2_b.{l}\"]\n    print(f\"L{l} ln1w n{np.linalg.norm(a1):5.2f}[{a1.min():.2f},{a1.max():.2f}] top{np.argsort(a1)[-5:][::-1]} ln2w n{np.linalg.norm(a2):5.2f}[{a2.min():.2f},{a2.max():.2f}] top{np.argsort(a2)[-5:][::-1]} | biases n{np.linalg.norm(b1):5.2f},{np.linalg.norm(b2):5.2f}\")\na=W[\"lnf_w\"];bb=W[\"lnf_b\"]\nprint(f\"lnf_w n{np.linalg.norm(a):5.2f}[{a.min():.2f},{a.max():.2f}] top{np.argsort(a)[-5:][::-1]} lnf_b n{np.linalg.norm(bb):5.2f}\")\nprint(\"== MLP spectra ==\")\nfor l in range(L):\n    F=W[f\"W_fc.{l}\"];R=W[f\"W_proj.{l}\"]\n    Sf=np.linalg.svd(F,compute_uv=False);Sr=np.linalg.svd(R,compute_uv=False)\n    print(f\"L{l} fc s{np.round(Sf[:5],2)} er{er(Sf):5.0f} | proj s{np.round(Sr[:5],2)} er{er(Sr):5.0f}\")\n\nnames=[(l,j) for l in range(L) for j in range(H)]\ndef grid(key,r):\n    print(f\"== relgain grid {key}{r} (A rows x B rows; baseline 1.0) ==\")\n    Vs=[topp(info[n][key],r)[0] for n in names]\n    for i,na in enumerate(names):\n        print(f\"L{na[0]}H{na[1]} \"+\" \".join(f\"{rg(Vs[i],Vs[k]):4.1f}\" for k in range(24)))\ngrid('UP',16)\ngrid('VM',8)\n\nprint(\"== composition: B q/k rowspace(top32) vs earlier head OV output space(top16), relgain ==\")\nfor l in range(1,L):\n    for j in range(H):\n        _,Vq,_=np.linalg.svd(info[(l,j)]['Q'],full_matrices=False); Rq=Vq.T[:,:32]\n        _,Vk,_=np.linalg.svd(info[(l,j)]['K'],full_matrices=False); Rk=Vk.T[:,:32]\n        rows=[]\n        for la in range(l):\n            for ja in range(H):\n                Oa=info[(la,ja)]['UP']\n                q=rg(Rq,Oa);k=rg(Rk,Oa)\n                rows.append((max(q,k),f\"L{la}H{ja}\"+(\"q\" if q>=k else \"k\")+f\"{max(q,k):.1f}\"))\n            Oa=topp(W[f\"W_proj.{la}\"],16)[0]\n            q=rg(Rq,Oa);k=rg(Rk,Oa)\n            rows.append((max(q,k),f\"m{la}\"+(\"q\" if q>=k else \"k\")+f\"{max(q,k):.1f}\"))\n        rows.sort(key=lambda x:-x[0])\n        print(f\"L{l}H{j} \"+\" \".join(r[1] for r in rows[:3]))\n\n_,Vf,_=np.linalg.svd(W[\"W_fc.0\"],full_matrices=False); Rf=Vf.T[:,:32]\nprint(\"== L0 q/k rowspace vs W_fc.0 rowspace(top32), relgain ==\")\nfor j in range(6):\n    _,Vq,_=np.linalg.svd(info[(0,j)]['Q'],full_matrices=False); Rq=Vq.T[:,:32]\n    _,Vk,_=np.linalg.svd(info[(0,j)]['K'],full_matrices=False); Rk=Vk.T[:,:32]\n    print(f\"L0H{j} q{rg(Rq,Rf):5.1f} k{rg(Rk,Rf):5.1f}\")\n", "out": "== keys ==\nW_fc.0 (1536, 384) norm=55.38\nW_fc.1 (1536, 384) norm=80.38\nW_fc.2 (1536, 384) norm=79.83\nW_fc.3 (1536, 384) norm=78.26\nW_k.0 (384, 384) norm=18.52\nW_k.1 (384, 384) norm=34.89\nW_k.2 (384, 384) norm=36.75\nW_k.3 (384, 384) norm=32.46\nW_o.0 (384, 384) norm=16.55\nW_o.1 (384, 384) norm=28.48\nW_o.2 (384, 384) norm=32.43\nW_o.3 (384, 384) norm=40.13\nW_proj.0 (384, 1536) norm=50.01\nW_proj.1 (384, 1536) norm=77.38\nW_proj.2 (384, 1536) norm=78.05\nW_proj.3 (384, 1536) norm=85.12\nW_q.0 (384, 384) norm=17.67\nW_q.1 (384, 384) norm=38.93\nW_q.2 (384, 384) norm=38.90\nW_q.3 (384, 384) norm=33.24\nW_v.0 (384, 384) norm=14.94\nW_v.1 (384, 384) norm=28.74\nW_v.2 (384, 384) norm=33.18\nW_v.3 (384, 384) norm=39.42\nln1_b.0 (384,) norm=0.61\nln1_b.1 (384,) norm=3.04\nln1_b.2 (384,) norm=3.08\nln1_b.3 (384,) norm=2.03\nln1_w.0 (384,) norm=6.88\nln1_w.1 (384,) norm=10.07\nln1_w.2 (384,) norm=13.41\nln1_w.3 (384,) norm=13.92\nln2_b.0 (384,) norm=1.38\nln2_b.1 (384,) norm=2.82\nln2_b.2 (384,) norm=3.41\nln2_b.3 (384,) norm=2.78\nln2_w.0 (384,) norm=18.32\nln2_w.1 (384,) norm=22.43\nln2_w.2 (384,) norm=25.78\nln2_w.3 (384,) norm=24.89\n== per head: q/k/v/o norms | M=Qkform: nM, sM top5, effrank, sym=||M-Mt||/||M||, rot=|u1.v1|, evrange sym part | P=OV: nP, sP top5, effrank ==\nL0H0 q  7.1 k  7.4 v  5.9 o 6.13| nM   6.8 sM[6.83 4.9  2.94 2.29 2.23] er  5.1 sym1.38 rot+0.14 ev[  -3.4,  +4.0]| nP  3.6 sP[3.61 3.39 2.88 2.31 2.13] er  8.4\nL0H1 q  4.5 k  4.9 v  4.3 o 4.82| nM   6.7 sM[6.7  2.48 1.75 1.   0.73] er  1.6 sym1.27 rot-0.43 ev[  -4.8,  +1.9]| nP  5.7 sP[5.72 3.36 1.15 0.54 0.44] er  1.9\nL0H2 q  4.1 k  4.4 v  4.0 o 4.36| nM   4.3 sM[4.35 1.46 1.26 1.06 0.57] er  1.8 sym1.27 rot-0.42 ev[  -3.1,  +1.3]| nP  3.9 sP[3.94 2.36 1.01 0.52 0.5 ] er  2.1\nL0H3 q 14.1 k 14.7 v  8.3 o 9.44| nM   8.9 sM[8.91 8.74 8.56 8.51 8.24] er 23.0 sym1.50 rot+0.69 ev[  -3.8,  +7.2]| nP  4.4 sP[4.43 3.91 3.68 3.6  3.6 ] er 18.5\nL0H4 q  4.2 k  4.6 v  3.7 o 3.66| nM   4.1 sM[4.08 1.81 1.48 0.99 0.81] er  2