{"n": 1, "code": "import numpy as np\nnp.set_printoptions(precision=2, suppress=True, linewidth=250)\nL, H = 4, 6\n\ndef f64(a):\n    return np.asarray(a, dtype=np.float64)\n\ndef rms(a):\n    a = f64(a)\n    return float(np.sqrt((a * a).mean()))\n\ninit = {'W_q': .02, 'W_k': .02, 'W_v': .02, 'W_o': .007071, 'W_fc': .02, 'W_proj': .007071}\nprint(\"== block rms / init ratio ==\")\nfor l in range(L):\n    parts = [\"%s %.2f\" % (n, rms(W['%s.%d' % (n, l)]) / init[n]) for n in ('W_q', 'W_k', 'W_v', 'W_o', 'W_fc', 'W_proj')]\n    print(\"L%d  \" % l + \"   \".join(parts))\n\nprint(\"\\n== LN gains ==\")\nfor l in range(L):\n    for pre in ('ln1_w', 'ln2_w'):\n        g = f64(W['%s.%d' % (pre, l)])\n        idx = np.argsort(-np.abs(g))[:4]\n        tops = [(int(i), round(float(g[i]), 2)) for i in idx]\n        print(\"L%d %s: min %.2f max %.2f std %.3f  top %s\" % (l, pre, g.min(), g.max(), g.std(), tops))\n\nhh = ['L%dH%d' % (l, h) for l in range(L) for h in range(H)]\novf = []; qkf = []; headrows = []\nfor l in range(L):\n    for h in range(H):\n        s = slice(h * 64, (h + 1) * 64)\n        Wq = f64(W['W_q.%d' % l][s]); Wk = f64(W['W_k.%d' % l][s])\n        Wv = f64(W['W_v.%d' % l][s]); Wo = f64(W['W_o.%d' % l][:, s])\n        ovf.append((Wo @ Wv).ravel()); qkf.append((Wq.T @ Wk).ravel())\n        P = Wv @ Wo                      # 64x64: nonzero eigvals of OV map M = Wo@Wv\n        syP = float(np.linalg.norm(P - P.T) / np.linalg.norm(P))\n        ep = np.linalg.eigvalsh((P + P.T) / 2)\n        posP = float((ep > 0).mean())\n        C = Wq.T @ Wk                    # 384x384 QK bilinear form\n        nC = float(np.linalg.norm(C))\n        syC = float(np.linalg.norm((C + C.T) / 2) / nC)\n        ec = np.linalg.eigvalsh((C + C.T) / 2)\n        posC = float((ec > 0).mean())\n        headrows.append(\"%s | %.2f %.2f %.2f %.2f | sy%.2f %+.3f %+.3f pz%.2f | %.1f sy%.2f %+.1f %+.1f pz%.2f\"\n                        % (hh[6 * l + h], rms(Wq) / .02, rms(Wk) / .02, rms(Wv) / .02, rms(Wo) / .007071,\n                           syP, ep[-1], ep[0], posP, nC, syC, ec[-1], ec[0], posC))\nprint(\"\\n== heads: qr kr vr or (rms/init) | P(Wv*Wo): sym, eigMax, eigMin, posFrac | C(Wq^T Wk): n, symFrac, eigMax, eigMin, posFrac ==\")\nfor r in headrows:\n    print(r)\n\ndef cosmat(rows):\n    X = np.stack(rows)\n    X = X / (np.linalg.norm(X, axis=1, keepdims=True) + 1e-12)\n    return X @ X.T\n\nprint(\"\\n== OV-matrix cosine, order L0H0..L0H5,L1H0.. ==\"); print(np.round(cosmat(ovf), 2))\nprint(\"\\n== QK-matrix cosine, same order ==\"); print(np.round(cosmat(qkf), 2))\n\nprint(\"\\n== MLP ==\")\nfor l in range(L):\n    U = f64(W['W_fc.%d' % l]); Vd = f64(W['W_proj.%d' % l])\n    su = np.linalg.svd(U, compute_uv=False); sv = np.linalg.svd(Vd, compute_uv=False)\n    G = Vd @ U\n    nG = float(np.linalg.norm(G)); syG = float(np.linalg.norm((G + G.T) / 2) / nG)\n    eg = np.linalg.eigvalsh((G + G.T) / 2)\n    print(\"L%d Wfc sv %.1f %.1f %.1f %.1f | Wproj sv %.1f %.1f %.1f %.1f | proj@fc n %.0f sy %.2f eig %+.1f %+.1f %+.1f %+.1f\"\n          % (l, su[0], su[1], su[5], su[-1], sv[0], sv[1], sv[5], sv[-1], nG, syG, eg[-1], eg[-2], eg[1], eg[0]))\n", "out": "== block rms / init ratio ==\nL0  W_q 2.30   W_k 2.41   W_v 1.94   W_o 6.09   W_fc 3.61   W_proj 9.21\nL1  W_q 5.07   W_k 4.54   W_v 3.74   W_o 10.49   W_fc 5.23   W_proj 14.25\nL2  W_q 5.07   W_k 4.79   W_v 4.32   W_o 11.95   W_fc 5.20   W_proj 14.37\nL3  W_q 4.33   W_k 4.23   W_v 5.13   W_o 14.78   W_fc 5.10   W_proj 15.67\n\n== LN gains ==\nL0 ln1_w: min 0.04 max 0.98 std 0.188  top [(180, 0.98), (184, 0.97), (162, 0.97), (99, 0.92)]\nL0 ln2_w: min 0.04 max 1.77 std 0.338  top [(150, 1.77), (168, 1.77), (57, 1.75), (357, 1.69)]\nL1 ln1_w: min 0.20 max 1.08 std 0.089  top [(21, 1.08), (99, 0.72), (298, 0.71), (150, 0.7)]\nL1 ln2_w: min 0.00 max 1.52 std 0.174  top [(242, 1.52), (375, 1.43), (329, 1.42), (23, 1.41)]\nL2 ln1_w: min 0.32 max 1.09 std 0.069  top [(21, 1.09), (99, 0.94), (13, 0.82), (312, 0.8)]\nL2 ln2_w: min 0.01 max 1.51 std 0.115  top [(322, 1.51), (53, 1.49), (97, 1.48), (161, 1.48)]\nL3 ln1_w: min 0.41 max 0.82 std 0.049  top [(333, 0.82), (188, 0.81), (21, 0.8), (369, 0.8)]\nL3 ln2_w: min 0.23 max 1.45 std 0.089  top [(240, 1.45), (368, 1.45), (86, 1.43), (301, 1.43)]\n\n== heads: qr kr vr or (rms/init) | P(Wv*Wo): sym, eigMax, eigMin, posFrac | C(Wq^T Wk): n, symFrac, eigMax, eigMin, posFrac ==\nL0H0 | 2.28 2.36 1.89 5.53 | sy1.37 +0.338 -0.459 pz0.47 | 11.1 sy0.73 +4.0 -3.4 pz0.51\nL0H1 | 1.43 1.57 1.38 4.35 | sy0.80 +1.831 -0.563 pz0.44 | 7.6 sy0.77 +1.9 -4.8 pz0.50\nL0H2 | 1.30 1.39 1.28 3.93 | sy0.90 +1.269 -0.327 pz0.41 | 5.1 sy0.77 +1.3 -3.1 pz0.50\nL0H3 | 4.51 4.68 2.63 8.52 | sy1.43 +0.707 -0.830 pz0.41 | 34.4 sy0.66 +7.2 -3.8 pz0.50\nL0H4 | 1.34 1.47 1.18 3.30 | sy1.05 +0.686 -0.261 pz0.42 | 5.1 sy0.75 +1.4 -2.7 pz0.50\nL0H5 | 0.84 0.94 2.70 8.63 | sy1.54 +2.786 -2.649 pz0.48 | 1.7 sy0.72 +0.6 -0.8 pz0.50\nL1H0 | 5.30 4.77 3.75 10.56 | sy0.99 +0.498 -2.441 pz0.31 | 52.8 sy0.73 +12.9 -13.8 pz0.50\nL1H1 | 5.11 4.57 3.58 10.29 | sy1.01 +0.415 -2.407 pz0.30 | 48.3 sy0.73 +12.1 -13.6 pz0.50\nL1H2 | 4.97 4.51 3.74 10.27 | sy0.90 +0.557 -2.686 pz0.28 | 45.7 sy0.73 +11.2 -13.0 pz0.50\nL1H3 | 5.02 4.45 3.76 10.72 | sy0.91 +0.405 -2.824 pz0.27 | 45.9 sy0.72 +12.3 -13.7 pz0.50\nL1H4 | 4.85 4.35 4.06 10.93 | sy0.90 +1.303 -3.325 pz0.25 | 42.4 sy0.73 +10.9 -10.8 pz0.50\nL1H5 | 5.15 4.60 3.53 10.14 | sy0.99 +0.555 -2.378 pz0.30 | 49.0 sy0.73 +11.9 -14.8 pz0.50\nL2H0 | 4.62 4.33 4.16 11.45 | sy1.19 +1.229 -2.898 pz0.38 | 26.8 sy0.70 +5.4 -4.6 pz0.50\nL2H1 | 5.36 5.08 4.42 12.16 | sy1.08 +0.704 -2.896 pz0.22 | 36.4 sy0.71 +5.3 -5.0 pz0.50\nL2H2 | 4.81 4.62 4.48 12.28 | sy1.09 +0.841 -3.798 pz0.28 | 28.9 sy0.71 +4.2 -4.2 pz0.51\nL2H3 | 4.69 4.42 4.56 12.48 | sy1.09 +0.893 -3.551 pz0.28 | 27.3 sy0.71 +4.1 -3.6 pz0.50\nL2H4 | 5.38 5.03 3.95 11.30 | sy0.95 +0.470 -2.665 pz0.20 | 36.8 sy0.70 +6.7 -6.0 pz0.50\nL2H5 | 5.46 5.17 4.32 11.96 | sy1.02 +0.