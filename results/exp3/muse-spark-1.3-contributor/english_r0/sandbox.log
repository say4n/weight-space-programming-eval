{"t": 1793708611.972929, "s": 0.08, "code": "import os\nimport pathlib\n\nprint(\"CWD:\", os.getcwd())\n\nfor d in [\".\", \"..\", \"../..\"]:\n    p = pathlib.Path(d).resolve()\n    print(f\"\\n=== {d} -> {p} ===\")\n    try:\n        items = sorted(p.iterdir(), key=lambda x: x.name)\n        for entry in items:\n            if entry.is_dir():\n                print(f\"{entry.name}/ [DIR]\")\n            else:\n                try:\n                    sz = entry.stat().st_size\n                except Exception:\n                    sz = -1\n                print(f\"{entry.name} {sz} bytes\")\n    except Exception as e:\n        print(\"list error:\", e)\n\nprint(\"\\n--- task/doc files ---\")\nfor pat in [\"*.md\", \"*.txt\", \"*.json\", \"*.py\"]:\n    print(f\"pattern {pat}:\")\n    for base in [\".\", \"..\"]:\n        for f in sorted(pathlib.Path(base).glob(pat)):\n            print(f\"  {f.resolve()}\")\n", "out": "CWD: /Users/sayan/Projects/weight-space-programming/results/exp3/muse-spark-1.3-contributor/english_r0/work\n\n=== . -> /Users/sayan/Projects/weight-space-programming/results/exp3/muse-spark-1.3-contributor/english_r0/work ===\nblocks.npz 28345926 bytes\n\n=== .. -> /Users/sayan/Projects/weight-space-programming/results/exp3/muse-spark-1.3-contributor/english_r0 ===\nlist error: [Errno 1] Operation not permitted: '/Users/sayan/Projects/weight-space-programming/results/exp3/muse-spark-1.3-contributor/english_r0'\n\n=== ../.. -> /Users/sayan/Projects/weight-space-programming/results/exp3/muse-spark-1.3-contributor ===\nlist error: [Errno 1] Operation not permitted: '/Users/sayan/Projects/weight-space-programming/results/exp3/muse-spark-1.3-contributor'\n\n--- task/doc files ---\npattern *.md:\n\n[stderr]\nTraceback (most recent call last):\n  File \"<string>\", line 30, in <module>\n  File \"/Users/sayan/.local/share/uv/python/cpython-3.12.13-macos-aarch64-none/lib/python3.12/pathlib.py\", line 1094, in glob\n    for p in selector.select_from(self):\n             ^^^^^^^^^^^^^^^^^^^^^^^^^^\n  File \"/Users/sayan/.local/share/uv/python/cpython-3.12.13-macos-aarch64-none/lib/python3.12/pathlib.py\", line 169, in select_from\n    if not parent_path.is_dir():\n           ^^^^^^^^^^^^^^^^^^^^\n  File \"/Users/sayan/.local/share/uv/python/cpython-3.12.13-macos-aarch64-none/lib/python3.12/pathlib.py\", line 875, in is_dir\n    return S_ISDIR(self.stat().st_mode)\n                   ^^^^^^^^^^^\n  File \"/Users/sayan/.local/share/uv/python/cpython-3.12.13-macos-aarch64-none/lib/python3.12/pathlib.py\", line 840, in stat\n    return os.stat(self, follow_symlinks=follow_symlinks)\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\nPermissionError: [Errno 1] Operation not permitted: '..'\n"}
{"t": 1793708640.46754, "s": 0.19, "code": "import numpy as np\n\ndata = np.load(\"blocks.npz\", allow_pickle=True)\nkeys = sorted(list(data.files), key=lambda k: (k.split('.')[-1], k))\nprint(\"n_keys:\", len(keys))\nprint(keys)\n\ndef stats(a):\n    a = a.astype(np.float64).ravel()\n    pct = np.percentile(a, [0.1, 1, 5, 25, 50, 75, 95, 99, 99.9])\n    return {\n        \"p0.1\": pct[0], \"p1\": pct[1], \"p5\": pct[2],\n        \"p25\": pct[3], \"med\": pct[4], \"p75\": pct[5],\n        \"p95\": pct[6], \"p99\": pct[7], \"p99.9\": pct[8],\n        \"frac_lt0.01\": float(np.mean(np.abs(a) < 0.01)),\n        \"frac_gt0.5\": float(np.mean(np.abs(a) > 0.5)),\n        \"frac_gt1.0\": float(np.mean(np.abs(a) > 1.0)),\n        \"nan\": int(np.isnan(a).sum()),\n        \"inf\": int(np.isinf(a).sum()),\n    }\n\nfor k in keys:\n    a = data[k]\n    s = stats(a)\n    print(f\"\\n{k} shape={a.shape} dtype={a.dtype}\")\n    print(f\"  p0.1={s['p0.1']:.4f} p1={s['p1']:.4f} p5={s['p5']:.4f} p25={s['p25']:.4f} med={s['med']:.5f} p75={s['p75']:.4f} p95={s['p95']:.4f} p99={s['p99']:.4f} p99.9={s['p99.9']:.4f}\")\n    print(f\"  |x|<0.01:{s['frac_lt0.01']:.4f} |x|>0.5:{s['frac_gt0.5']:.5f} |x|>1.0:{s['frac_gt1.0']:.6f} nan:{s['nan']} inf:{s['inf']}\")\n\n    # outlier rows/cols for 2D\n    if a.ndim == 2:\n        # assume Linear weight (out,in)\n        row_norm = np.sqrt((a.astype(np.float64)**2).sum(axis=1))\n        col_norm = np.sqrt((a.astype(np.float64)**2).sum(axis=0))\n        for name, v in [(\"row\", row_norm), (\"col\", col_norm)]:\n            med = np.median(v)\n            mx = v.max()\n            p99 = np.percentile(v, 99)\n            print(f\"  {name}_norm med={med:.3f} p99={p99:.3f} max={mx:.3f} max/med={mx/(med+1e-12):.2f}\")\n    if a.ndim == 1 and (\"_w\" in k):\n        # LayerNorm scale: dead / negative\n        af = a.astype(np.float64)\n        print(f\"  LN_w mean={af.mean():.4f} frac<0.1:{np.mean(af<0.1):.4f} frac<0.5:{np.mean(af<0.5):.4f} frac<0:{np.mean(af<0):.5f} frac>1.0:{np.mean(af>1.0):.4f}\")\n", "out": "n_keys: 40\n['W_fc.0', 'W_k.0', 'W_o.0', 'W_proj.0', 'W_q.0', 'W_v.0', 'ln1_b.0', 'ln1_w.0', 'ln2_b.0', 'ln2_w.0', 'W_fc.1', 'W_k.1', 'W_o.1', 'W_proj.1', 'W_q.1', 'W_v.1', 'ln1_b.1', 'ln1_w.1', 'ln2_b.1', 'ln2_w.1', 'W_fc.2', 'W_k.2', 'W_o.2', 'W_proj.2', 'W_q.2', 'W_v.2', 'ln1_b.2', 'ln1_w.2', 'ln2_b.2', 'ln2_w.2', 'W_fc.3', 'W_k.3', 'W_o.3', 'W_proj.3', 'W_q.3', 'W_v.3', 'ln1_b.3', 'ln1_w.3', 'ln2_b.3', 'ln2_w.3']\n\nW_fc.0 shape=(1536, 384) dtype=float32\n  p0.1=-0.3670 p1=-0.2070 p5=-0.0881 p25=-0.0191 med=-0.00035 p75=0.0182 p95=0.0793 p99=0.1958 p99.9=0.3602\n  |x|<0.01:0.2909 |x|>0.5:0.00025 |x|>1.0:0.000000 nan:0 inf:0\n  row_norm med=0.423 p99=3.524 max=4.422 max/med=10.45\n  col_norm med=2.264 p99=3.274 max=3.745 max/med=1.65\n\nW_k.0 shape=(384, 384) dtype=float32\n  p0.1=-0.5318 p1=-0.2808 p5=-0.0920 p25=-0.0205 med=-0.00006 p75=0.0205 p95=0.0906 p99=0.2764 p99.9=0.5297\n  |x|<0.01:0.2705 |x|>0.5:0.00276 |x|>1.0:0.000000 nan:0 inf:0\n  row_norm med=0.502 p99=4.073 max=4.190 max/med=8.34\n  col_norm med=1.345 p99=2.566 max=3.229 max/med=2.40\n\nW_o.0 shape=(384, 384) dtype=float32\n  p0.1=-0.2820 p1=-0.1130 p5=-0.0460 p25=-0.0130 med=-0.00008 p75=0.0128 p95=0.0458 p99=0.1122 p99.9=0.2909\n  |x|<0.01:0.4064 |x|>0.5:0.00099 |x|>1.0:0.000007 nan:0 inf:0\n  row_norm med=0.641 p99=2.821 max=6.490 max/med=10.13\n  col_norm med=0.346 p99=1.768 max=2.026 max/med=5.85\n\nW_proj.0 shape=(384, 1536) dtype=float32\n  p0.1=-0.2799 p1=-0.1724 p5=-0.0775 p25=-0.0105 med=-0.00007 p75=0.0103 p95=0.0762 p99=0.1738 p99.9=0.2999\n  |x|<0.01:0.4855 |x|>0.5:0.00018 |x|>1.0:0.000019 nan:0 inf:0\n  row_norm med=1.959 p99=2.494 max=7.285 max/med=3.72\n  col_norm med=0.237 p99=2.465 max=4.795 max/med=20.21\n\nW_q.0 shape=(384, 384) dtype=float32\n  p0.1=-0.5552 p1=-0.3038 p5=-0.0961 p25=-0.0167 med=0.00017 p75=0.0170 p95=0.0969 p99=0.3042 p99.9=0.5724\n  |x|<0.01:0.3247 |x|>0.5:0.00383 |x|>1.0:0.000007 nan:0 inf:0\n  row