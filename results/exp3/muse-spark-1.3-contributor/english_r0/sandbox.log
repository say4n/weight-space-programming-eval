{"t": 1793708700.395252, "s": 0.32, "code": "import numpy as np\n\ndata = np.load(\"blocks.npz\", allow_pickle=True)\n\ndef svd_stats(a, name):\n    af = a.astype(np.float64)\n    # economy SVD values only\n    s = np.linalg.svd(af, compute_uv=False)\n    fro2 = float((af**2).sum())\n    spec = float(s[0])\n    stable = fro2 / (spec**2 + 1e-20)\n    return spec, stable, s\n\nfor L in range(4):\n    print(f\"\\n== LAYER {L} ==\")\n    for key in [f\"W_q.{L}\", f\"W_k.{L}\", f\"W_v.{L}\", f\"W_o.{L}\", f\"W_fc.{L}\", f\"W_proj.{L}\"]:\n        a = data[key]\n        spec, stable, s = svd_stats(a, key)\n        fro = float(np.sqrt((a.astype(np.float64)**2).sum()))\n        # top5 and tail\n        top5 = \", \".join(f\"{v:.2f}\" for v in s[:5])\n        med = float(np.median(s))\n        print(f\"{key} {a.shape} fro={fro:.1f} spec={spec:.2f} stable_rank={stable:.1f} s_med={med:.2f} s0/s1={s[0]/(s[1]+1e-12):.2f} s0/med={s[0]/(med+1e-12):.2f} top5=[{top5}]\")\n\nprint(\"\\n== EFFECTIVE CIRCUITS (384x384) ==\")\nfor L in range(4):\n    Wq = data[f\"W_q.{L}\"].astype(np.float64)\n    Wk = data[f\"W_k.{L}\"].astype(np.float64)\n    Wv = data[f\"W_v.{L}\"].astype(np.float64)\n    Wo = data[f\"W_o.{L}\"].astype(np.float64)\n    Wfc = data[f\"W_fc.{L}\"].astype(np.float64)   # (1536,384)\n    Wproj = data[f\"W_proj.{L}\"].astype(np.float64) # (384,1536)\n    # y = W x convention: Q=Wq x, K=Wk x => bilinear Wq.T @ Wk\n    M_qk = Wq.T @ Wk\n    M_vo = Wo @ Wv\n    M_mlp = Wproj @ Wfc\n    for nm, M in [(\"QK\", M_qk), (\"VO\", M_vo), (\"MLP\", M_mlp)]:\n        fro = float(np.sqrt((M**2).sum()))\n        spec = float(np.linalg.svd(M, compute_uv=False)[0])\n        # symmetry for QK\n        asym = float(np.sqrt(((M-M.T)**2).sum())/( (M**2).sum()+1e-20))\n        print(f\"L{L} {nm} fro={fro:.1f} spec={spec:.2f} stable={fro**2/(spec**2+1e-20):.1f} asym={asym:.3f}\")\n", "out": "\n== LAYER 0 ==\nW_q.0 (384, 384) fro=32.3 spec=8.25 stable_rank=15.3 s_med=0.30 s0/s1=1.00 s0/med=27.15 top5=[8.25, 8.22, 7.96, 7.82, 7.68]\nW_k.0 (384, 384) fro=30.4 spec=7.65 stable_rank=15.8 s_med=0.35 s0/s1=1.03 s0/med=21.71 top5=[7.65, 7.44, 7.33, 6.91, 6.83]\nW_v.0 (384, 384) fro=14.8 spec=4.34 stable_rank=11.7 s_med=0.31 s0/s1=1.23 s0/med=14.07 top5=[4.34, 3.53, 3.27, 3.17, 2.98]\nW_o.0 (384, 384) fro=16.4 spec=7.10 stable_rank=5.3 s_med=0.16 s0/s1=1.08 s0/med=44.79 top5=[7.10, 6.61, 4.27, 2.77, 2.50]\nW_fc.0 (1536, 384) fro=46.2 spec=18.18 stable_rank=6.5 s_med=0.83 s0/s1=1.65 s0/med=21.77 top5=[18.18, 11.02, 8.74, 7.45, 7.21]\nW_proj.0 (384, 1536) fro=39.3 spec=9.83 stable_rank=16.0 s_med=0.65 s0/s1=1.34 s0/med=15.11 top5=[9.83, 7.35, 6.27, 5.87, 5.80]\n\n== LAYER 1 ==\nW_q.1 (384, 384) fro=32.3 spec=9.90 stable_rank=10.6 s_med=0.39 s0/s1=1.27 s0/med=25.59 top5=[9.90, 7.80, 6.70, 5.95, 5.67]\nW_k.1 (384, 384) fro=29.3 spec=13.31 stable_rank=4.8 s_med=0.37 s0/s1=1.34 s0/med=36.01 top5=[13.31, 9.93, 5.90, 5.68, 5.05]\nW_v.1 (384, 384) fro=27.4 spec=5.28 stable_rank=26.8 s_med=0.44 s0/s1=1.06 s0/med=12.12 top5=[5.28, 4.97, 4.87, 4.73, 4.67]\nW_o.1 (384, 384) fro=25.9 spec=4.97 stable_rank=27.3 s_med=0.47 s0/s1=1.53 s0/med=10.54 top5=[4.97, 3.24, 3.16, 3.11, 3.06]\nW_fc.1 (1536, 384) fro=79.1 spec=21.49 stable_rank=13.6 s_med=1.33 s0/s1=1.64 s0/med=16.20 top5=[21.49, 13.13, 12.80, 12.62, 12.33]\nW_proj.1 (384, 1536) fro=75.7 spec=8.19 stable_rank=85.4 s_med=3.59 s0/s1=1.04 s0/med=2.28 top5=[8.19, 7.89, 7.20, 7.00, 6.67]\n\n== LAYER 2 ==\nW_q.2 (384, 384) fro=39.3 spec=5.80 stable_rank=46.1 s_med=1.37 s0/s1=1.12 s0/med=4.22 top5=[5.80, 5.20, 4.81, 4.62, 4.60]\nW_k.2 (384, 384) fro=37.8 spec=10.66 stable_rank=12.5 s_med=1.25 s0/s1=1.24 s0/med=8.54 top5=[10.66, 8.62, 4.99, 4.39, 4.24]\nW_v.2 (384, 384) fro=33.3 spec=3.71 stable_rank=80.8 s_med=1.24 s0/s1=1.02 s0/med=2.98 top5=[3.71, 3.62, 3.58, 3.53, 3.50]\nW_o.2 (384, 384) fro=32.8 spec=4.10 stable_rank=64.1 s_med=1.30 s0/s1=1.03 s0/med=3.16 top5=[4.10, 3.97, 3.56, 3.38, 3.36]\nW_fc.2 (1536, 384) fro=79.0 spec=15.36 stable_rank=26.4 s_med=3.44 s0/s1=1.92 s0/med=4.47 top5=[15.36, 8.02, 7.89, 7.72, 7.60]\nW_proj.2 (384, 1536) fro=76.8 spec=9.40 stable_rank=66.8 s_med=3.41 s0/s1=1.02 s0/med=2.76 top5=[9.40, 9.19, 8.72, 8.47, 8.04]\n\n== LAYER 3 ==\nW_q.3 (384, 384) fro=32.9 spec=4.56 stable_rank=52.2 s_med=1.20 s0/s1=1.08 s0/med=3.80 top5=[4.56, 4.24, 4.01, 3.92, 3.85]\nW_k.3 (384, 384) fro=32.2 spec=6.09 stable_rank=28.0 s_med=1.24 s0/s1=1.24 s0/med=4.92 top5=[6.09, 4.90, 4.20, 3.46, 3.35]\nW_v.3 (384, 384) fro=39.8 spec=5.06 stable_rank=61.9 s_med=1.39 s0/s1=1.03 s0/med=3.65 top5=[5.06, 4.90, 4.85, 4.77, 4.67]\nW_o.3 (384, 384) fro=40.5 spec=9.57 stable_rank=17.9 s_med=1.26 s0/s1=1.09 s0/med=7.59 top5=[9.57, 8.76, 5.34, 5.14, 4.92]\nW_fc.3 (1536, 384) fro=77.8 spec=14.16 stable_rank=30.2 s_med=3.58 s0/s1=1.74 s0/med=3.96 top5=[14.16, 8.12, 7.92, 7.33, 7.15]\nW_proj.3 (384, 1536) fro=82.4 spec=26.31 stable_rank=9.8 s_med=0.80 s0/s1=1.27 s0/med=32.99 top5=[26.31, 20.68, 19.70, 19.26, 18.59]\n\n== EFFECTIVE CIRCUITS (384x384) ==\nL0 QK fro=183.1 spec=59.81 stable=9.4 asym=0.008\nL0 VO fro=39.6 spec=26.56 stable=2.2 asym=0.035\nL0 MLP fro=191.0 spec=129.79 stable=2.2 asym=0.007\nL1 QK fro=147.4 spec=106.45 stable=1.9 asym=0.009\nL1 VO fro=54.8 spec=14.24 stable=14.8 asym=0.025\nL1 MLP fro=162.1 spec=70.51 stable=5.3 asym=0.008\nL2 QK fro=98.2 spec=38.53 stable=6.5 asym=0.015\nL2 VO fro=60.5 spec=9.43 stable=41.2 asym=0.022\nL2 MLP fro=157.4 spec=51.54 stable=9.3 asym=0.008\nL3 QK fro=65.3 spec=17.51 stable=13.9 asym=0.020\nL3 VO fro=109.7 spec=34.11 stable=10.3 asym=0.012\nL3 MLP fro=181.6 spec=103.73 stable=3.1 asym=0.007\n"}
{"t": 1793708726.5479062, "s": 0.13, "code": "import numpy as np\ndata = np.load(\"blocks.npz\", allow_pickle=True)\n\ndef sym_ratio(A):\n    Af = A.astype(np.float64)\n    return float(np.sqrt(((Af-Af.T)**2).sum() / ((Af**2).sum()+1e-20)))\n\ndef cos_sim(A,B):\n    Af = A.astype(np.float64).ravel(); Bf = B.astype(np.float64).ravel()\n    return float((Af*Bf).sum() / np.sqrt((Af**2).sum()*(Bf**2).sum()+1e-20))\n\nfor L in range(4):\n    print(f\"\\n== LAYER {L} ==\")\n    Wq = data[f\"W_q.{L}\"].astype(np.float64)\n    Wk = data[f\"W_k.{L}\"].astype(np.float64)\n    Wv = data[f\"W_v.{L}\"].astype(np.float64)\n    Wo = data[f\"W_o.{L}\"].astype(np.float64)\n    Wfc = data[f\"W_fc.{L}\"].astype(np.float64)   # (1536,384)\n    Wproj = data[f\"W_proj.{L}\"].astype(np.float64) # (384,1536)\n    for nm, W in [(\"Wq\",Wq),(\"Wk\",Wk),(\"Wv\",Wv),(\"Wo\",Wo)]:\n        print(f\" {nm} sym={sym_ratio(W):.4f}\")\n    print(f\" cos(Wq,Wk)={cos_sim(Wq,Wk):.4f} cos(Wq,Wk.T)={cos_sim(Wq,Wk.T):.4f} |Wq-Wk|/|Wq|={np.sqrt(((Wq-Wk)**2).sum()/(Wq**2).sum()):.4f}\")\n    print(f\" cos(Wo,Wv)={cos_sim(Wo,Wv):.4f} cos(Wo,Wv.T)={cos_sim(Wo,Wv.T):.4f} |Wo-WvT|/|Wo|={np.sqrt(((Wo-Wv.T)**2).sum()/(Wo**2).sum()):.4f}\")\n    print(f\" cos(Wproj,Wfc.T)={cos_sim(Wproj,Wfc.T):.4f} |Wproj-WfcT|/|Wproj|={np.sqrt(((Wproj-Wfc.T)**2).sum()/(Wproj**2).sum()):.4f}\")\n    # effective eigenspectra (symmetric so eigh)\n    M_qk = Wq.T @ Wk\n    M_vo = Wo @ Wv\n    M_mlp = Wproj @ Wfc\n    for nm, M in [(\"QK\",M_qk),(\"VO\",M_vo),(\"MLP\",M_mlp)]:\n        # symmetrize tiny asym\n        Ms = (M+M.T)/2\n        ev = np.linalg.eigvalsh(Ms)\n        evs = np.sort(ev)[::-1]\n        print(f\" {nm} eig top5={[f'{v:.1f}' for v in evs[:5]]} bottom5={[f'{v:.1f}' for v in evs[-5:]]} trace={ev.sum():.1f} pos_frac={(ev>0).mean():.3f} max_neg={ev.min():.1f}\")\n", "out": "\n== LAYER 0 ==\n Wq sym=1.4150\n Wk sym=1.4102\n Wv sym=1.4109\n Wo sym=1.4127\n cos(Wq,Wk)=0.0164 cos(Wq,Wk.T)=0.0045 |Wq-Wk|/|Wq|=1.3619\n cos(Wo,Wv)=-0.0016 cos(Wo,Wv.T)=-0.0357 |Wo-WvT|/|Wo|=1.3733\n cos(Wproj,Wfc.T)=0.0467 |Wproj-WfcT|/|Wproj|=1.5081\n QK eig top5=['42.0', '38.8', '36.1', '29.3', '28.1'] bottom5=['-23.0', '-26.3', '-37.2', '-43.6', '-45.1'] trace=16.1 pos_frac=0.484 max_neg=-45.1\n VO eig top5=['12.1', '10.9', '5.3', '3.4', '3.0'] bottom5=['-3.5', '-4.4', '-4.9', '-8.3', '-14.6'] trace=-8.7 pos_frac=0.484 max_neg=-14.6\n MLP eig top5=['73.6', '26.9', '20.6', '17.8', '16.9'] bottom5=['-16.5', '-17.2', '-18.0', '-22.1', '-56.8'] trace=84.9 pos_frac=0.474 max_neg=-56.8\n\n== LAYER 1 ==\n Wq sym=1.4154\n Wk sym=1.4090\n Wv sym=1.4116\n Wo sym=1.4154\n cos(Wq,Wk)=-0.2777 cos(Wq,Wk.T)=0.0008 |Wq-Wk|/|Wq|=1.5239\n cos(Wo,Wv)=-0.0012 cos(Wo,Wv.T)=-0.2089 |Wo-WvT|/|Wo|=1.5982\n cos(Wproj,Wfc.T)=-0.0594 |Wproj-WfcT|/|Wproj|=1.4888\n QK eig top5=['57.2', '34.9', '15.4', '8.0', '4.6'] bottom5=['-16.8', '-18.2', '-22.4', '-29.3', '-49.5'] trace=-262.4 pos_frac=0.477 max_neg=-49.5\n VO eig top5=['6.1', '5.5', '5.4', '4.4', '4.1'] bottom5=['-6.3', '-6.6', '-6.8', '-7.2', '-8.7'] trace=-148.1 pos_frac=0.453 max_neg=-8.7\n MLP eig top5=['39.8', '16.1', '12.8', '12.0', '11.4'] bottom5=['-16.6', '-17.8', '-18.6', '-19.7', '-31.7'] trace=-356.1 pos_frac=0.406 max_neg=-31.7\n\n== LAYER 2 ==\n Wq sym=1.4150\n Wk sym=1.4185\n Wv sym=1.4113\n Wo sym=1.4116\n cos(Wq,Wk)=-0.0231 cos(Wq,Wk.T)=0.0000 |Wq-Wk|/|Wq|=1.4021\n cos(Wo,Wv)=0.0015 cos(Wo,Wv.T)=-0.2718 |Wo-WvT|/|Wo|=1.6062\n cos(Wproj,Wfc.T)=-0.1103 |Wproj-WfcT|/|Wproj|=1.5110\n QK eig top5=['21.7', '15.3', '12.7', '11.0', '9.1'] bottom5=['-7.7', '-8.0', '-10.0', '-12.4', '-14.4'] trace=-34.3 pos_frac=0.484 max_neg=-14.4\n VO eig top5=['4.0', '3.5', '3.3', '3.2', '3.1'] bottom5=['-6.1', '-6.2', '-6.3', '-6.6', '-6.8'] trace=-297.3 pos_frac=0.427 max_neg=-6.8\n MLP eig top5=['26.1', '7.5', '7.3', '7.2', '7.1'] bottom5=['-17.3', '-17.5', '-18.0', '-20.1', '-27.0'] trace=-669.3 pos_frac=0.435 max_neg=-27.0\n\n== LAYER 3 ==\n Wq sym=1.4137\n Wk sym=1.4104\n Wv sym=1.4154\n Wo sym=1.4091\n cos(Wq,Wk)=0.1471 cos(Wq,Wk.T)=-0.0021 |Wq-Wk|/|Wq|=1.2915\n cos(Wo,Wv)=-0.0010 cos(Wo,Wv.T)=-0.2139 |Wo-WvT|/|Wo|=1.5454\n cos(Wproj,Wfc.T)=-0.1125 |Wproj-WfcT|/|Wproj|=1.4503\n QK eig top5=['11.3', '9.6', '8.6', '7.7', '7.5'] bottom5=['-4.5', '-4.8', '-4.9', '-6.2', '-6.5'] trace=156.1 pos_frac=0.518 max_neg=-6.5\n VO eig top5=['16.5', '9.5', '7.5', '7.3', '7.0'] bottom5=['-14.5', '-15.7', '-16.0', '-17.3', '-19.2'] trace=-344.3 pos_frac=0.451 max_neg=-19.2\n MLP eig top5=['58.4', '24.0', '20.7', '17.5', '13.2'] bottom5=['-19.9', '-20.3', '-21.3', '-21.8', '-47.6'] trace=-721.0 pos_frac=0.240 max_neg=-47.6\n"}
{"t": 1793708755.1866722, "s": 0.14, "code": "import numpy as np\ndata = np.load(\"blocks.npz\", allow_pickle=True)\n\ndef asym(M):\n    return float(np.sqrt(((M-M.T)**2).sum() / ((M**2).sum()+1e-20)))\n\ndef cos_AB(A,B):\n    return float((A*B).sum()/np.sqrt((A**2).sum()*(B**2).sum()+1e-20))\n\nfor L in [0,1]:\n    for kind in [\"QK\",\"VO\",\"MLP\"]:\n        if kind==\"QK\":\n            Wq = data[f\"W_q.{L}\"].astype(np.float64)\n            Wk = data[f\"W_k.{L}\"].astype(np.float64)\n            M = Wq.T @ Wk\n            # random baseline same std\n            Rq = np.random.randn(*Wq.shape)*Wq.std()\n            Rk = np.random.randn(*Wk.shape)*Wk.std()\n            Mr = Rq.T @ Rk\n        elif kind==\"VO\":\n            Wo = data[f\"W_o.{L}\"].astype(np.float64)\n            Wv = data[f\"W_v.{L}\"].astype(np.float64)\n            M = Wo @ Wv\n            Ro = np.random.randn(*Wo.shape)*Wo.std()\n            Rv = np.random.randn(*Wv.shape)*Wv.std()\n            Mr = Ro @ Rv\n        else:\n            Wproj = data[f\"W_proj.{L}\"].astype(np.float64)\n            Wfc = data[f\"W_fc.{L}\"].astype(np.float64)\n            M = Wproj @ Wfc\n            Rp = np.random.randn(*Wproj.shape)*Wproj.std()\n            Rf = np.random.randn(*Wfc.shape)*Wfc.std()\n            Mr = Rp @ Rf\n        print(f\"L{L} {kind} real asym={asym(M):.4f} cos(M,M.T)={cos_AB(M,M.T):.4f} fro={np.sqrt((M**2).sum()):.1f} | rand asym={asym(Mr):.4f} cosr={cos_AB(Mr,Mr.T):.4f} fror={np.sqrt((Mr**2).sum()):.1f}\")\n        # max entry check\n        print(f\"  real M[0,:5]={M[0,:5].round(2)} M.T[0,:5]={M.T[0,:5].round(2)}\")\n", "out": "L0 QK real asym=1.4349 cos(M,M.T)=-0.0295 fro=183.1 | rand asym=1.4084 cosr=0.0082 fror=50.0\n  real M[0,:5]=[ 0.52  0.69 -0.92 -0.81  0.37] M.T[0,:5]=[ 0.52  0.04 -0.39  1.42 -0.78]\nL0 VO real asym=1.4040 cos(M,M.T)=0.0144 fro=39.6 | rand asym=1.4100 cosr=0.0060 fror=12.4\n  real M[0,:5]=[-0.05 -0.05 -0.09 -0.06 -0.01] M.T[0,:5]=[-0.05  0.03 -0.03 -0.03  0.02]\nL0 MLP real asym=1.3801 cos(M,M.T)=0.0477 fro=191.0 | rand asym=1.4125 cosr=0.0025 fror=46.5\n  real M[0,:5]=[-0.9  -0.31 -0.01  0.28 -0.23] M.T[0,:5]=[-0.9  -0.39  0.24  0.64  0.32]\nL1 QK real asym=1.3388 cos(M,M.T)=0.1038 fro=147.4 | rand asym=1.4083 cosr=0.0083 fror=47.9\n  real M[0,:5]=[-0.71 -0.29 -0.52  0.16  0.03] M.T[0,:5]=[-0.71  0.   -0.55  0.17 -0.31]\nL1 VO real asym=1.3543 cos(M,M.T)=0.0830 fro=54.8 | rand asym=1.4073 cosr=0.0097 fror=36.2\n  real M[0,:5]=[-0.51  0.14  0.02 -0.19  0.02] M.T[0,:5]=[-0.51  0.09 -0.14 -0.01  0.01]\nL1 MLP real asym=1.3552 cos(M,M.T)=0.0817 fro=162.1 | rand asym=1.4127 cosr=0.0021 fror=152.6\n  real M[0,:5]=[-1.73  0.43  0.41 -0.25  0.01] M.T[0,:5]=[-1.73 -0.23  0.54 -0.37  0.07]\n"}
{"t": 1793708794.948757, "s": 0.18, "code": "import numpy as np\ndata = np.load(\"blocks.npz\", allow_pickle=True)\n\ndef gram_cos(A,B):\n    # A,B same shape: compare output Grams A@A.T vs B@B.T and input Grams A.T@A vs B.T@B\n    Ao = A.astype(np.float64); Bo = B.astype(np.float64)\n    Go = Ao @ Ao.T; Gp = Bo @ Bo.T\n    Gi = Ao.T @ Ao; Gj = Bo.T @ Bo\n    def cos(X,Y):\n        return float((X*Y).sum()/np.sqrt((X**2).sum()*(Y**2).sum()+1e-20))\n    return cos(Go,Gp), cos(Gi,Gj)\n\nprint(\"=== Gram alignment (out,in) ===\")\nfor L in range(4):\n    Wq = data[f\"W_q.{L}\"]; Wk = data[f\"W_k.{L}\"]\n    Wv = data[f\"W_v.{L}\"]; Wo = data[f\"W_o.{L}\"]\n    Wfc = data[f\"W_fc.{L}\"]; Wproj = data[f\"W_proj.{L}\"]\n    co, ci = gram_cos(Wq,Wk)\n    print(f\"L{L} Q-K out Gram cos={co:.4f} in Gram cos={ci:.4f}\")\n    co2, ci2 = gram_cos(Wo.T, Wv)  # O_in (384) vs V_out? Wo.T (384,384) vs Wv (384,384)\n    # for VO: need Wo_in = Wo.T@Wo vs V_out = Wv@Wv.T -> use custom\n    Wo64 = Wo.astype(np.float64); Wv64 = Wv.astype(np.float64)\n    Go_in = Wo64.T @ Wo64; Gv_out = Wv64 @ Wv64.T\n    c_vo = float((Go_in*Gv_out).sum()/np.sqrt((Go_in**2).sum()*(Gv_out**2).sum()+1e-20))\n    print(f\"   V-O overlap (Wo_in vs Wv_out)={c_vo:.4f}\")\n    # MLP intermediate 1536x1536\n    Pf = Wproj.astype(np.float64); Ff = Wfc.astype(np.float64)\n    Gp_inter = Pf.T @ Pf  # 1536\n    Gf_inter = Ff @ Ff.T  # 1536\n    c_mlp = float((Gp_inter*Gf_inter).sum()/np.sqrt((Gp_inter**2).sum()*(Gf_inter**2).sum()+1e-20))\n    print(f\"   MLP inter Gram cos={c_mlp:.4f}\")\n\nprint(\"\\n=== Cross-layer cos sim ===\")\nfor name in [\"W_q\",\"W_k\",\"W_v\",\"W_o\",\"W_fc\",\"W_proj\",\"ln1_w\",\"ln2_w\"]:\n    print(f\"-- {name} --\")\n    for i in range(4):\n        for j in range(i+1,4):\n            a = data[f\"{name}.{i}\"].astype(np.float64).ravel()\n            b = data[f\"{name}.{j}\"].astype(np.float64).ravel()\n            c = float((a*b).sum()/np.sqrt((a**2).sum()*(b**2).sum()+1e-20))\n            print(f\"  {i}-{j}: {c:.4f}\", end=\" \")\n        print()\n\nprint(\"\\n=== Head norms assuming 6 heads, d=64 (out split for QKV, in split for O) ===\")\nnH=6; dh=64\nfor L in range(4):\n    print(f\"Layer {L}:\")\n    for nm in [\"W_q\",\"W_k\",\"W_v\"]:\n        W = data[f\"{nm}.{L}\"].astype(np.float64)  # (384,384) out,in\n        Wr = W.reshape(nH,dh,384)\n        fros = [float(np.sqrt((Wr[h]**2).sum())) for h in range(nH)]\n        print(f\" {nm} per-head fro: {[f'{v:.1f}' for v in fros]}\")\n    Wo = data[f\"W_o.{L}\"].astype(np.float64)  # (384,384) out,in_split?\n    Wor = Wo.reshape(384,nH,dh)\n    fros = [float(np.sqrt((Wor[:,h,:]**2).sum())) for h in range(nH)]\n    print(f\" W_o per-head-in fro: {[f'{v:.1f}' for v in fros]}\")\n", "out": "=== Gram alignment (out,in) ===\nL0 Q-K out Gram cos=0.9240 in Gram cos=0.8236\n   V-O overlap (Wo_in vs Wv_out)=0.6028\n   MLP inter Gram cos=0.4704\nL1 Q-K out Gram cos=0.5718 in Gram cos=0.2256\n   V-O overlap (Wo_in vs Wv_out)=0.4786\n   MLP inter Gram cos=0.0931\nL2 Q-K out Gram cos=0.4436 in Gram cos=0.3166\n   V-O overlap (Wo_in vs Wv_out)=0.5360\n   MLP inter Gram cos=0.1367\nL3 Q-K out Gram cos=0.5627 in Gram cos=0.4597\n   V-O overlap (Wo_in vs Wv_out)=0.5261\n   MLP inter Gram cos=0.0568\n\n=== Cross-layer cos sim ===\n-- W_q --\n  0-1: -0.0070   0-2: 0.0016   0-3: 0.0011 \n  1-2: 0.0019   1-3: 0.0003 \n  2-3: 0.0020 \n\n-- W_k --\n  0-1: 0.0015   0-2: 0.0002   0-3: -0.0060 \n  1-2: 0.0006   1-3: 0.0012 \n  2-3: 0.0072 \n\n-- W_v --\n  0-1: 0.0034   0-2: -0.0020   0-3: -0.0050 \n  1-2: -0.0025   1-3: 0.0034 \n  2-3: 0.0024 \n\n-- W_o --\n  0-1: -0.0038   0-2: -0.0001   0-3: -0.0086 \n  1-2: 0.0001   1-3: 0.0029 \n  2-3: 0.0022 \n\n-- W_fc --\n  0-1: 0.0231   0-2: 0.0131   0-3: 0.0093 \n  1-2: 0.0318   1-3: 0.0157 \n  2-3: 0.0217 \n\n-- W_proj --\n  0-1: 0.0008   0-2: 0.0014   0-3: 0.0011 \n  1-2: 0.0039   1-3: 0.0017 \n  2-3: 0.0003 \n\n-- ln1_w --\n  0-1: 0.6818   0-2: 0.6871   0-3: 0.6917 \n  1-2: 0.9748   1-3: 0.9743 \n  2-3: 0.9954 \n\n-- ln2_w --\n  0-1: 0.9456   0-2: 0.9301   0-3: 0.9286 \n  1-2: 0.9883   1-3: 0.9854 \n  2-3: 0.9979 \n\n\n=== Head norms assuming 6 heads, d=64 (out split for QKV, in split for O) ===\nLayer 0:\n W_q per-head fro: ['3.3', '3.1', '30.8', '6.8', '4.0', '3.2']\n W_k per-head fro: ['4.2', '3.7', '28.3', '7.2', '5.0', '3.8']\n W_v per-head fro: ['6.0', '5.4', '7.8', '5.4', '5.2', '6.1']\n W_o per-head-in fro: ['6.7', '6.0', '8.9', '5.0', '5.6', '7.2']\nLayer 1:\n W_q per-head fro: ['10.7', '13.3', '14.5', '13.4', '13.5', '13.5']\n W_k per-head fro: ['9.8', '12.1', '13.1', '12.2', '12.1', '12.1']\n W_v per-head fro: ['11.2', '11.7', '10.7', '10.9', '11.1', '11.4']\n W_o per-head-in fro: ['10.0', '11.3', '10.3', '9.9', '10.8', '11.1']\nLayer 2:\n W_q per-head fro: ['16.8', '16.0', '14.0', '16.1', '16.9', '16.4']\n W_k per-head fro: ['16.2', '15.3', '13.2', '15.6', '16.2', '15.8']\n W_v per-head fro: ['13.1', '13.8', '14.6', '13.5', '13.2', '13.3']\n W_o per-head-in fro: ['12.9', '13.5', '14.2', '13.4', '13.1', '13.2']\nLayer 3:\n W_q per-head fro: ['15.7', '14.2', '12.7', '13.3', '14.4', '9.5']\n W_k per-head fro: ['15.3', '14.2', '12.4', '13.1', '13.9', '9.2']\n W_v per-head fro: ['14.9', '17.9', '15.5', '15.7', '15.2', '18.0']\n W_o per-head-in fro: ['14.9', '18.3', '15.6', '16.1', '15.3', '18.5']\n"}
{"t": 1793708818.077294, "s": 0.09, "code": "import numpy as np\ndata = np.load(\"blocks.npz\", allow_pickle=True)\n\ndef head_conc(W, nH):\n    # W (384,384) out split\n    dh = 384//nH\n    Wr = W.reshape(nH, dh, 384)\n    fros = np.array([np.sqrt((Wr[h]**2).sum()) for h in range(nH)])\n    p = fros/fros.sum()\n    hhi = (p**2).sum()  # 1/nH uniform, 1.0 single\n    return fros, float(fros.max()/ (np.median(fros)+1e-12)), float(hhi)\n\nprint(\"=== L0 Q/K concentration vs nH ===\")\nfor nH in [3,4,6,8,12,16,24]:\n    if 384 % nH != 0: continue\n    Wq = data[\"W_q.0\"]; Wk = data[\"W_k.0\"]\n    fq, r_q, h_q = head_conc(Wq, nH)\n    fk, r_k, h_k = head_conc(Wk, nH)\n    print(f\"nH={nH:2d} Q max/med={r_q:.2f} HHI={h_q:.3f} fros={[f'{v:.1f}' for v in fq]}\")\n    print(f\"      K max/med={r_k:.2f} HHI={h_k:.3f} fros={[f'{v:.1f}' for v in fk]}\")\n\nprint(\"\\n=== LN top dims ===\")\nfor L in range(4):\n    for nm in [\"ln1_w\",\"ln2_w\"]:\n        v = data[f\"{nm}.{L}\"].astype(np.float64)\n        idx = np.argsort(v)[-10:][::-1]\n        print(f\"{nm}.{L} top10 idx={list(idx)} vals={[f'{v[i]:.2f}' for i in idx]}\")\n\nprint(\"\\n=== Overlap L1-L3 ===\")\nfor nm in [\"ln1_w\",\"ln2_w\"]:\n    for L in [1,2,3]:\n        v = data[f\"{nm}.{L}\"].astype(np.float64)\n        print(f\"{nm}.{L} mean={v.mean():.3f} std={v.std():.3f}\")\n    # jaccard top20\n    tops = []\n    for L in [1,2,3]:\n        v = data[f\"{nm}.{L}\"].astype(np.float64)\n        tops.append(set(np.argsort(v)[-20:]))\n    print(f\"{nm} jaccard 1-2={len(tops[0]&tops[1])/len(tops[0]|tops[1]):.3f} 1-3={len(tops[0]&tops[2])/len(tops[0]|tops[2]):.3f} 2-3={len(tops[1]&tops[2])/len(tops[1]|tops[2]):.3f}\")\n\nprint(\"\\n=== W_k col outlier vs LN? ===\")\nfor L in [1,2,3]:\n    _, cn = (lambda a: (np.sqrt((a.astype(np.float64)**2).sum(axis=0)), None))(data[f\"W_k.{L}\"])\n    # actually col norms\n    a = data[f\"W_k.{L}\"].astype(np.float64)\n    cn = np.sqrt((a**2).sum(axis=0))\n    idx = np.argsort(cn)[-5:][::-1]\n    ln1 = data[f\"ln1_w.{L}\"].astype(np.float64)\n    print(f\"L{L} k-col top {list(idx)} norms {[f'{cn[i]:.1f}' for i in idx]} ln1w at same {[f'{ln1[i]:.2f}' for i in idx]} ln1 mean {ln1.mean():.2f}\")\n", "out": "=== L0 Q/K concentration vs nH ===\nnH= 3 Q max/med=6.20 HHI=0.615 fros=['4.5', '31.6', '5.1']\n      K max/med=4.65 HHI=0.548 fros=['5.6', '29.2', '6.3']\nnH= 4 Q max/med=5.29 HHI=0.482 fros=['3.9', '30.9', '7.3', '4.4']\n      K max/med=4.27 HHI=0.425 fros=['4.9', '28.4', '8.0', '5.4']\nnH= 6 Q max/med=8.47 HHI=0.398 fros=['3.3', '3.1', '30.8', '6.8', '4.0', '3.2']\n      K max/med=6.17 HHI=0.339 fros=['4.2', '3.7', '28.3', '7.2', '5.0', '3.8']\nnH= 8 Q max/med=6.89 HHI=0.252 fros=['3.0', '2.6', '15.9', '26.5', '5.9', '4.3', '3.3', '2.8']\n      K max/med=5.35 HHI=0.221 fros=['3.7', '3.2', '14.7', '24.3', '6.2', '4.9', '4.2', '3.3']\nnH=12 Q max/med=8.50 HHI=0.199 fros=['2.1', '2.5', '2.1', '2.3', '21.8', '21.8', '4.7', '4.9', '2.6', '3.0', '2.0', '2.4']\n      K max/med=6.23 HHI=0.170 fros=['2.7', '3.2', '2.5', '2.7', '19.9', '20.1', '5.1', '5.2', '3.3', '3.8', '2.5', '2.9']\nnH=16 Q max/med=8.05 HHI=0.141 fros=['1.8', '2.3', '1.8', '1.8', '2.0', '15.8', '18.8', '18.6', '4.0', '4.3', '3.7', '2.3', '2.4', '2.4', '1.8', '2.2']\n      K max/med=5.96 HHI=0.121 fros=['2.3', '2.9', '2.3', '2.2', '2.3', '14.5', '17.1', '17.3', '4.2', '4.6', '4.0', '2.9', '3.1', '2.8', '2.1', '2.6']\nnH=24 Q max/med=8.24 HHI=0.100 fros=['1.5', '1.5', '2.1', '1.5', '1.5', '1.5', '1.7', '1.5', '15.8', '15.1', '15.3', '15.4', '3.4', '3.2', '3.5', '3.5', '1.7', '1.9', '1.9', '2.3', '1.4', '1.4', '2.0', '1.4']\n      K max/med=6.08 HHI=0.085 fros=['1.9', '1.9', '2.5', '1.9', '1.8', '1.8', '2.0', '1.8', '14.4', '13.7', '14.2', '14.3', '3.6', '3.6', '3.7', '3.7', '2.2', '2.5', '2.5', '2.8', '1.8', '1.7', '2.3', '1.7']\n\n=== LN top dims ===\nln1_w.0 top10 idx=[np.int64(162), np.int64(60), np.int64(223), np.int64(311), np.int64(239), np.int64(300), np.int64(35), np.int64(180), np.int64(136), np.int64(59)] vals=['1.03', '0.98', '0.98', '0.94', '0.94', '0.94', '0.94', '0.93', '0.90', '0.89']\nln2_w.0 top10 idx=[np.int64(161), np.int64(164), np.int64(155), np.int64(348), np.int64(376), np.int64(200), np.int64(23), np.int64(379), np.int64(220), np.int64(292)] vals=['1.51', '1.51', '1.45', '1.42', '1.40', '1.40', '1.40', '1.38', '1.38', '1.37']\nln1_w.1 top10 idx=[np.int64(222), np.int64(72), np.int64(78), np.int64(302), np.int64(118), np.int64(351), np.int64(111), np.int64(200), np.int64(328), np.int64(42)] vals=['1.12', '0.80', '0.78', '0.77', '0.71', '0.70', '0.69', '0.68', '0.66', '0.66']\nln2_w.1 top10 idx=[np.int64(375), np.int64(186), np.int64(198), np.int64(14), np.int64(53), np.int64(131), np.int64(346), np.int64(361), np.int64(280), np.int64(290)] vals=['1.49', '1.41', '1.37', '1.35', '1.35', '1.34', '1.33', '1.33', '1.33', '1.32']\nln1_w.2 top10 idx=[np.int64(222), np.int64(78), np.int64(330), np.int64(65), np.int64(94), np.int64(250), np.int64(117), np.int64(126), np.int64(321), np.int64(238)] vals=['1.01', '0.91', '0.83', '0.82', '0.82', '0.81', '0.81', '0.81', '0.81', '0.81']\nln2_w.2 top10 idx=[np.int64(264), np.int64(282), np.int64(52), np.int64(383), np.int64(212), np.int64(35), np.int64(30), np.int64(338), np.int64(106), np.int64(7)] vals=['1.47', '1.46', '1.46', '1.46', '1.45', '1.44', '1.44', '1.44', '1.44', '1.44']\nln1_w.3 top10 idx=[np.int64(344), np.int64(177), np.int64(24), np.int64(58), np.int64(27), np.int64(309), np.int64(258), np.int64(216), np.int64(232), np.int64(274)] vals=['0.87', '0.86', '0.85', '0.84', '0.84', '0.84', '0.84', '0.84', '0.84', '0.84']\nln2_w.3 top10 idx=[np.int64(5), np.int64(112), np.int64(176), np.int64(354), np.int64(220), np.int64(226), np.int64(60), np.int64(160), np.int64(382), np.int64(329)] vals=['1.43', '1.42', '1.42', '1.41', '1.40', '1.40', '1.40', '1.39', '1.39', '1.39']\n\n=== Overlap L1-L3 ===\nln1_w.1 mean=0.458 std=0.102\nln1_w.2 mean=0.705 std=0.075\nln1_w.3 mean=0.755 std=0.054\nln1_w jaccard 1-2=0.081 1-3=0.026 2-3=0.026\nln2_w.1 mean=1.043 std=0.200\nln2_w.2 mean=1.312 std=0.126\nln2_w.3 mean=1.278 std=0.081\nln2_w jaccard 1-2=0.053 1-3=0.053 2-3=0.053\n\n=== W_k col outlier vs LN? ===\nL1 k-col top [np.int64(222), np.int64(72), np.int64(78), np.int64(254), np.int64(273)] norms ['9.3', '8.4', '8.0', '4.0', '4.0'] ln1w at same ['1.12', '0.80', '0.78', '0.34', '0.46'] ln1 mean 0.46\nL2 k-col top [np.int64(222), np.int64(78), np.int64(72), np.int64(360), np.int64(254)] norms ['8.9', '8.7', '4.4', '3.0', '2.7'] ln1w at same ['1.01', '0.91', '0.39', '0.21', '0.47'] ln1 mean 0.71\nL3 k-col top [np.int64(222), np.int64(78), np.int64(136), np.int64(360), np.int64(382)] norms ['5.2', '5.0', '2.0', '1.9', '1.8'] ln1w at same ['0.83', '0.76', '0.65', '0.29', '0.67'] ln1 mean 0.75\n"}
{"t": 1793708842.871318, "s": 0.09, "code": "import numpy as np\ndata = np.load(\"blocks.npz\", allow_pickle=True)\n\nprint(\"=== Effective gain ln1w * col_norm (top5) ===\")\nfor L in [0,1,2,3]:\n    ln1 = data[f\"ln1_w.{L}\"].astype(np.float64)\n    for nm in [\"W_q\",\"W_k\",\"W_v\"]:\n        W = data[f\"{nm}.{L}\"].astype(np.float64)\n        cn = np.sqrt((W**2).sum(axis=0))\n        gain = ln1 * cn\n        idx = np.argsort(gain)[-5:][::-1]\n        print(f\"L{L} {nm} gain top {list(idx)} vals {[f'{gain[i]:.2f}' for i in idx]} (ln {[f'{ln1[i]:.2f}' for i in idx]} cn {[f'{cn[i]:.2f}' for i in idx]})\")\n    # MLP: ln2 * fc col\n    ln2 = data[f\"ln2_w.{L}\"].astype(np.float64)\n    Wfc = data[f\"W_fc.{L}\"].astype(np.float64)\n    cnfc = np.sqrt((Wfc**2).sum(axis=0))\n    gain = ln2 * cnfc\n    idx = np.argsort(gain)[-5:][::-1]\n    print(f\"L{L} W_fc gain top {list(idx)} vals {[f'{gain[i]:.2f}' for i in idx]}\")\n\nprint(\"\\n=== L3 head suppression size ===\")\nfor nH in [6,12,8,4,3]:\n    dh = 384//nH\n    for nm in [\"W_q\",\"W_k\"]:\n        W = data[f\"{nm}.3\"].astype(np.float64)\n        Wr = W.reshape(nH,dh,384)\n        fros = np.array([np.sqrt((Wr[h]**2).sum()) for h in range(nH)])\n        print(f\"nH={nH} {nm}.3 fros={[f'{v:.1f}' for v in fros]}\")\n    print(\"---\")\n\nprint(\"\\n=== L0 head2 details: rows 128-191 ===\")\nfor nm in [\"W_q\",\"W_k\"]:\n    W = data[f\"{nm}.0\"].astype(np.float64)\n    sub = W[128:192,:]  # 64x384\n    print(f\"{nm}.0 head block fro={np.sqrt((sub**2).sum()):.1f} rest fro={np.sqrt((W**2).sum() - (sub**2).sum()):.1f}\")\n    # within-block row norms\n    rn = np.sqrt((sub**2).sum(axis=1))\n    print(f\"  rows 128-191 norms med={np.median(rn):.2f} max={rn.max():.2f} min={rn.min():.2f}\")\n", "out": "=== Effective gain ln1w * col_norm (top5) ===\nL0 W_q gain top [np.int64(60), np.int64(4), np.int64(72), np.int64(162), np.int64(222)] vals ['1.94', '1.92', '1.92', '1.81', '1.72'] (ln ['0.98', '0.87', '0.71', '1.03', '0.84'] cn ['1.97', '2.22', '2.72', '1.75', '2.06'])\nL0 W_k gain top [np.int64(162), np.int64(60), np.int64(35), np.int64(223), np.int64(180)] vals ['3.34', '2.86', '2.77', '2.65', '2.29'] (ln ['1.03', '0.98', '0.94', '0.98', '0.93'] cn ['3.23', '2.91', '2.96', '2.70', '2.46'])\nL0 W_v gain top [np.int64(162), np.int64(223), np.int64(300), np.int64(311), np.int64(60)] vals ['1.34', '1.28', '1.16', '1.13', '1.02'] (ln ['1.03', '0.98', '0.94', '0.94', '0.98'] cn ['1.30', '1.30', '1.24', '1.19', '1.04'])\nL0 W_fc gain top [np.int64(164), np.int64(306), np.int64(155), np.int64(291), np.int64(379)] vals ['5.50', '4.77', '4.38', '4.33', '4.32']\nL1 W_q gain top [np.int64(179), np.int64(302), np.int64(351), np.int64(114), np.int64(42)] vals ['1.63', '1.43', '1.34', '1.21', '1.18'] (ln ['0.66', '0.77', '0.70', '0.43', '0.66'] cn ['2.48', '1.87', '1.91', '2.79', '1.79'])\nL1 W_k gain top [np.int64(222), np.int64(72), np.int64(78), np.int64(273), np.int64(254)] vals ['10.41', '6.75', '6.22', '1.82', '1.35'] (ln ['1.12', '0.80', '0.78', '0.46', '0.34'] cn ['9.26', '8.44', '7.97', '3.95', '3.97'])\nL1 W_v gain top [np.int64(70), np.int64(351), np.int64(134), np.int64(118), np.int64(98)] vals ['1.09', '1.03', '1.02', '0.99', '0.99'] (ln ['0.62', '0.70', '0.58', '0.71', '0.62'] cn ['1.76', '1.48', '1.77', '1.39', '1.60'])\nL1 W_fc gain top [np.int64(198), np.int64(375), np.int64(361), np.int64(131), np.int64(70)] vals ['5.95', '5.89', '5.72', '5.70', '5.68']\nL2 W_q gain top [np.int64(101), np.int64(126), np.int64(173), np.int64(321), np.int64(117)] vals ['1.76', '1.72', '1.69', '1.69', '1.69'] (ln ['0.79', '0.81', '0.79', '0.81', '0.81'] cn ['2.24', '2.12', '2.13', '2.08', '2.07'])\nL2 W_k gain top [np.int64(222), np.int64(78), np.int64(72), np.int64(94), np.int64(321)] vals ['9.01', '7.90', '1.71', '1.59', '1.48'] (ln ['1.01', '0.91', '0.39', '0.82', '0.81'] cn ['8.88', '8.72', '4.42', '1.94', '1.82'])\nL2 W_v gain top [np.int64(65), np.int64(330), np.int64(117), np.int64(94), np.int64(49)] vals ['1.50', '1.49', '1.48', '1.47', '1.47'] (ln ['0.82', '0.83', '0.81', '0.82', '0.80'] cn ['1.84', '1.81', '1.83', '1.80', '1.84'])\nL2 W_fc gain top [np.int64(282), np.int64(264), np.int64(198), np.int64(338), np.int64(180)] vals ['6.16', '5.97', '5.97', '5.92', '5.87']\nL3 W_q gain top [np.int64(367), np.int64(201), np.int64(99), np.int64(344), np.int64(187)] vals ['1.46', '1.46', '1.45', '1.45', '1.44'] (ln ['0.78', '0.81', '0.80', '0.87', '0.82'] cn ['1.88', '1.79', '1.81', '1.66', '1.77'])\nL3 W_k gain top [np.int64(222), np.int64(78), np.int64(98), np.int64(178), np.int64(187)] vals ['4.31', '3.81', '1.41', '1.41', '1.39'] (ln ['0.83', '0.76', '0.80', '0.82', '0.82'] cn ['5.21', '5.00', '1.76', '1.72', '1.70'])\nL3 W_v gain top [np.int64(344), np.int64(74), np.int64(328), np.int64(232), np.int64(300)] vals ['1.95', '1.91', '1.91', '1.90', '1.89'] (ln ['0.87', '0.83', '0.82', '0.84', '0.82'] cn ['2.24', '2.30', '2.33', '2.26', '2.31'])\nL3 W_fc gain top [np.int64(96), np.int64(27), np.int64(276), np.int64(182), np.int64(176)] vals ['5.69', '5.69', '5.59', '5.57', '5.56']\n\n=== L3 head suppression size ===\nnH=6 W_q.3 fros=['15.7', '14.2', '12.7', '13.3', '14.4', '9.5']\nnH=6 W_k.3 fros=['15.3', '14.2', '12.4', '13.1', '13.9', '9.2']\n---\nnH=12 W_q.3 fros=['11.2', '11.1', '10.0', '10.1', '9.0', '9.0', '9.4', '9.4', '10.2', '10.1', '6.7', '6.7']\nnH=12 W_k.3 fros=['10.9', '10.7', '10.1', '10.0', '8.8', '8.8', '9.2', '9.3', '9.9', '9.8', '6.6', '6.5']\n---\nnH=8 W_q.3 fros=['13.7', '12.7', '11.9', '11.1', '11.5', '12.2', '11.1', '8.3']\nnH=8 W_k.3 fros=['13.3', '12.6', '11.7', '10.8', '11.3', '11.8', '10.8', '8.0']\n---\nnH=4 W_q.3 fros=['18.7', '16.2', '16.7', '13.9']\nnH=4 W_k.3 fros=['18.3', '16.0', '16.4', '13.4']\n---\nnH=3 W_q.3 fros=['21.2', '18.4', '17.2']\nnH=3 W_k.3 fros=['20.8', '18.0', '16.7']\n---\n\n=== L0 head2 details: rows 128-191 ===\nW_q.0 head block fro=30.8 rest fro=9.6\n  rows 128-191 norms med=3.81 max=4.67 min=2.91\nW_k.0 head block fro=28.3 rest fro=11.1\n  rows 128-191 norms med=3.50 max=4.19 min=2.54\n"}
{"t": 1793708874.353729, "s": 0.08, "code": "import numpy as np, os, sys\nprint(\"python\", sys.version.split()[0], \"numpy\", np.__version__)\nprint(\"cwd\", os.getcwd())\nprint(\"files\", os.listdir(\".\"))\n# env keys only, no values (avoid secrets)\nprint(\"env keys\", sorted(os.environ.keys())[:50])\n\ndata = np.load(\"blocks.npz\", allow_pickle=True)\n\nprint(\"\\n=== MLP dead intermediate L0 vs L1 ===\")\nfor L in [0,1,3]:\n    fc = data[f\"W_fc.{L}\"].astype(np.float64)\n    proj = data[f\"W_proj.{L}\"].astype(np.float64)\n    rn_fc = np.sqrt((fc**2).sum(axis=1))\n    cn_proj = np.sqrt((proj**2).sum(axis=0))\n    score = rn_fc + cn_proj  # both 1536, same neuron\n    idx_s = np.argsort(score)\n    print(f\"L{L} bottom10 inter idx {list(idx_s[:10])} scores {[f'{score[i]:.2f}' for i in idx_s[:10]]}\")\n    print(f\"   top10 {list(idx_s[-10:][::-1])} scores {[f'{score[i]:.2f}' for i in idx_s[-10:][::-1]]}\")\n\nprint(\"\\n=== Per-head QK/VO strength (6 heads) ===\")\nfor L in range(4):\n    Wq = data[f\"W_q.{L}\"].astype(np.float64).reshape(6,64,384)\n    Wk = data[f\"W_k.{L}\"].astype(np.float64).reshape(6,64,384)\n    Wv = data[f\"W_v.{L}\"].astype(np.float64).reshape(6,64,384)\n    Wo = data[f\"W_o.{L}\"].astype(np.float64).reshape(384,6,64)  # out, head, d\n    qk_fro=[]; vo_fro=[]\n    for h in range(6):\n        Mqk = Wq[h].T @ Wk[h]  # 384x384 per head? actually 384x384? Wq[h] (64,384) -> T (384,64) @ (64,384) =384x384\n        Mvo = Wo[:,h,:] @ Wv[h]  # (384,64)@(64,384)=384x384\n        qk_fro.append(float(np.sqrt((Mqk**2).sum())))\n        vo_fro.append(float(np.sqrt((Mvo**2).sum())))\n    print(f\"L{L} QK per-head {[f'{v:.1f}' for v in qk_fro]} sum={sum(qk_fro):.1f}\")\n    print(f\"    VO per-head {[f'{v:.1f}' for v in vo_fro]} sum={sum(vo_fro):.1f}\")\n\nprint(\"\\n=== LN bias ===\")\nfor L in range(4):\n    for nm in [\"ln1_b\",\"ln2_b\"]:\n        b = data[f\"{nm}.{L}\"].astype(np.float64)\n        print(f\"{nm}.{L} mean={b.mean():.4f} std={b.std():.4f} max={b.max():.3f} min={b.min():.3f} |b|>0.5 frac={(np.abs(b)>0.5).mean():.4f}\")\n", "out": "python 3.12.13 numpy 2.5.4\ncwd /Users/sayan/Projects/weight-space-programming/results/exp3/muse-spark-1.3-contributor/english_r0/work\nfiles ['blocks.npz']\nenv keys ['HOME', 'LANG', 'MPLBACKEND', 'OMP_NUM_THREADS', 'PATH', 'PYTHONHASHSEED', 'TOKENIZERS_PARALLELISM', '__CF_USER_TEXT_ENCODING']\n\n=== MLP dead intermediate L0 vs L1 ===\nL0 bottom10 inter idx [np.int64(68), np.int64(797), np.int64(425), np.int64(39), np.int64(834), np.int64(845), np.int64(174), np.int64(951), np.int64(384), np.int64(540)] scores ['0.46', '0.48', '0.48', '0.48', '0.49', '0.49', '0.49', '0.49', '0.50', '0.50']\n   top10 [np.int64(98), np.int64(1140), np.int64(461), np.int64(1132), np.int64(827), np.int64(1115), np.int64(468), np.int64(477), np.int64(1214), np.int64(100)] scores ['8.76', '7.33', '7.12', '6.87', '6.46', '6.37', '6.34', '6.31', '6.24', '6.18']\nL1 bottom10 inter idx [np.int64(1040), np.int64(1237), np.int64(129), np.int64(265), np.int64(636), np.int64(1310), np.int64(826), np.int64(1296), np.int64(415), np.int64(881)] scores ['0.59', '0.62', '0.62', '0.64', '0.64', '0.72', '2.45', '2.87', '3.05', '3.12']\n   top10 [np.int64(225), np.int64(1053), np.int64(197), np.int64(1451), np.int64(733), np.int64(1454), np.int64(964), np.int64(302), np.int64(777), np.int64(773)] scores ['5.72', '5.72', '5.60', '5.28', '5.28', '5.08', '5.08', '5.08', '5.07', '5.04']\nL3 bottom10 inter idx [np.int64(263), np.int64(419), np.int64(705), np.int64(1417), np.int64(848), np.int64(527), np.int64(21), np.int64(699), np.int64(148), np.int64(583)] scores ['3.26', '3.33', '3.34', '3.35', '3.37', '3.37', '3.37', '3.38', '3.39', '3.41']\n   top10 [np.int64(1473), np.int64(254), np.int64(655), np.int64(800), np.int64(977), np.int64(356), np.int64(1084), np.int64(480), np.int64(1123), np.int64(613)] scores ['7.14', '6.40', '5.67', '5.49', '5.41', '5.38', '5.37', '5.23', '5.18', '5.17']\n\n=== Per-head QK/VO strength (6 heads) ===\nL0 QK per-head ['3.0', '1.8', '182.4', '11.4', '6.6', '2.6'] sum=207.9\n    VO per-head ['12.9', '10.1', '13.2', '7.3', '7.3', '13.0'] sum=63.9\nL1 QK per-head ['23.7', '35.5', '41.8', '36.8', '37.4', '36.2'] sum=211.4\n    VO per-head ['21.7', '22.2', '19.5', '21.4', '22.1', '22.5'] sum=129.4\nL2 QK per-head ['38.6', '33.1', '25.2', '32.8', '36.8', '35.4'] sum=201.9\n    VO per-head ['22.8', '24.8', '28.7', '24.5', '23.3', '23.3'] sum=147.5\nL3 QK per-head ['31.2', '25.8', '21.0', '22.3', '26.0', '11.9'] sum=138.3\n    VO per-head ['29.7', '53.4', '35.2', '36.0', '31.8', '59.3'] sum=245.4\n\n=== LN bias ===\nln1_b.0 mean=0.0008 std=0.0287 max=0.091 min=-0.096 |b|>0.5 frac=0.0000\nln2_b.0 mean=0.0022 std=0.0683 max=0.333 min=-0.499 |b|>0.5 frac=0.0000\nln1_b.1 mean=-0.0050 std=0.1672 max=1.154 min=-1.471 |b|>0.5 frac=0.0260\nln2_b.1 mean=0.0005 std=0.1364 max=0.369 min=-0.360 |b|>0.5 frac=0.0000\nln1_b.2 mean=-0.0010 std=0.1525 max=1.053 min=-1.382 |b|>0.5 frac=0.0182\nln2_b.2 mean=0.0050 std=0.1537 max=0.389 min=-0.376 |b|>0.5 frac=0.0000\nln1_b.3 mean=0.0121 std=0.0849 max=0.650 min=-0.607 |b|>0.5 frac=0.0078\nln2_b.3 mean=0.0043 std=0.1276 max=0.307 min=-0.673 |b|>0.5 frac=0.0026\n"}
{"t": 1793708894.69852, "s": 0.08, "code": "import numpy as np\ndata = np.load(\"blocks.npz\", allow_pickle=True)\n\nprint(\"=== Dead MLP counts ===\")\nfor L in range(4):\n    fc = data[f\"W_fc.{L}\"].astype(np.float64)\n    proj = data[f\"W_proj.{L}\"].astype(np.float64)\n    rn = np.sqrt((fc**2).sum(axis=1))\n    cn = np.sqrt((proj**2).sum(axis=0))\n    score = rn+cn\n    for thr in [1.0,1.5,2.0]:\n        print(f\"L{L} score<{thr}: {(score<thr).sum()}/1536={(score<thr).mean()*100:.2f}%\", end=\" | \")\n    print(f\"med={np.median(score):.2f}\")\n\nprint(\"\\n=== Output outlier vs Input outlier overlap ===\")\nfor L in [0,1,3]:\n    Wo = data[f\"W_o.{L}\"].astype(np.float64)\n    Wk = data[f\"W_k.{L}\"].astype(np.float64)\n    Wproj = data[f\"W_proj.{L}\"].astype(np.float64)\n    rn_o = np.sqrt((Wo**2).sum(axis=1))  # output residual 384\n    cn_k = np.sqrt((Wk**2).sum(axis=0))  # input residual 384 (K)\n    rn_p = np.sqrt((Wproj**2).sum(axis=1))\n    top_o = set(np.argsort(rn_o)[-10:])\n    top_k = set(np.argsort(cn_k)[-10:])\n    top_p = set(np.argsort(rn_p)[-10:])\n    print(f\"L{L} top10 O rows {sorted(top_o)}\")\n    print(f\"    top10 K cols {sorted(top_k)} inter O&K={sorted(top_o&top_k)} jacc={len(top_o&top_k)/len(top_o|top_k):.3f}\")\n    print(f\"    top10 Proj rows {sorted(top_p)} inter O&Proj={sorted(top_o&top_p)}\")\n\nprint(\"\\n=== L1 6 dead MLP indices ===\")\nfc1 = data[\"W_fc.1\"].astype(np.float64); pr1 = data[\"W_proj.1\"].astype(np.float64)\nrn1 = np.sqrt((fc1**2).sum(axis=1)); cn1 = np.sqrt((pr1**2).sum(axis=0))\nscore1 = rn1+cn1\ndead1 = np.where(score1<1.0)[0]\nprint(\"dead\", list(dead1))\nprint(\"rn\", [f\"{rn1[i]:.3f}\" for i in dead1])\nprint(\"cn\", [f\"{cn1[i]:.3f}\" for i in dead1])\n", "out": "=== Dead MLP counts ===\nL0 score<1.0: 1078/1536=70.18% | L0 score<1.5: 1123/1536=73.11% | L0 score<2.0: 1139/1536=74.15% | med=0.66\nL1 score<1.0: 6/1536=0.39% | L1 score<1.5: 6/1536=0.39% | L1 score<2.0: 6/1536=0.39% | med=3.93\nL2 score<1.0: 0/1536=0.00% | L2 score<1.5: 0/1536=0.00% | L2 score<2.0: 0/1536=0.00% | med=3.97\nL3 score<1.0: 0/1536=0.00% | L3 score<1.5: 0/1536=0.00% | L3 score<2.0: 0/1536=0.00% | med=4.04\n\n=== Output outlier vs Input outlier overlap ===\nL0 top10 O rows [np.int64(25), np.int64(72), np.int64(78), np.int64(103), np.int64(114), np.int64(197), np.int64(222), np.int64(254), np.int64(273), np.int64(360)]\n    top10 K cols [np.int64(35), np.int64(60), np.int64(162), np.int64(170), np.int64(204), np.int64(223), np.int64(283), np.int64(299), np.int64(342), np.int64(366)] inter O&K=[] jacc=0.000\n    top10 Proj rows [np.int64(60), np.int64(61), np.int64(103), np.int64(137), np.int64(169), np.int64(222), np.int64(226), np.int64(249), np.int64(292), np.int64(360)] inter O&Proj=[np.int64(103), np.int64(222), np.int64(360)]\nL1 top10 O rows [np.int64(5), np.int64(81), np.int64(99), np.int64(103), np.int64(197), np.int64(273), np.int64(292), np.int64(307), np.int64(360), np.int64(373)]\n    top10 K cols [np.int64(25), np.int64(72), np.int64(78), np.int64(136), np.int64(197), np.int64(200), np.int64(222), np.int64(254), np.int64(273), np.int64(360)] inter O&K=[np.int64(197), np.int64(273), np.int64(360)] jacc=0.176\n    top10 Proj rows [np.int64(44), np.int64(94), np.int64(103), np.int64(116), np.int64(169), np.int64(249), np.int64(287), np.int64(302), np.int64(360), np.int64(374)] inter O&Proj=[np.int64(103), np.int64(360)]\nL3 top10 O rows [np.int64(25), np.int64(72), np.int64(78), np.int64(103), np.int64(207), np.int64(222), np.int64(224), np.int64(249), np.int64(254), np.int64(360)]\n    top10 K cols [np.int64(72), np.int64(78), np.int64(123), np.int64(136), np.int64(197), np.int64(217), np.int64(222), np.int64(254), np.int64(360), np.int64(382)] inter O&K=[np.int64(72), np.int64(78), np.int64(222), np.int64(254), np.int64(360)] jacc=0.333\n    top10 Proj rows [np.int64(103), np.int64(124), np.int64(184), np.int64(222), np.int64(226), np.int64(249), np.int64(292), np.int64(302), np.int64(327), np.int64(360)] inter O&Proj=[np.int64(103), np.int64(222), np.int64(249), np.int64(360)]\n\n=== L1 6 dead MLP indices ===\ndead [np.int64(129), np.int64(265), np.int64(636), np.int64(1040), np.int64(1237), np.int64(1310)]\nrn ['0.395', '0.416', '0.400', '0.391', '0.394', '0.439']\ncn ['0.230', '0.224', '0.244', '0.199', '0.229', '0.277']\n"}
