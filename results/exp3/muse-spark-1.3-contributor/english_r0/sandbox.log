{"t": 1793708673.8989692, "s": 0.11, "code": "import numpy as np\n\ndata = np.load(\"blocks.npz\", allow_pickle=True)\n\ndef norms(a):\n    af = a.astype(np.float64)\n    rn = np.sqrt((af**2).sum(axis=1))\n    cn = np.sqrt((af**2).sum(axis=0))\n    return rn, cn\n\ndef corr(x, y):\n    x = x.astype(np.float64); y = y.astype(np.float64)\n    xm = x - x.mean(); ym = y - y.mean()\n    return float((xm*ym).sum() / np.sqrt((xm**2).sum()*(ym**2).sum() + 1e-20))\n\ndef top(v, k=5):\n    idx = np.argsort(v)[-k:][::-1]\n    return [(int(i), float(v[i])) for i in idx]\n\ndef bottom(v, k=5):\n    idx = np.argsort(v)[:k]\n    return [(int(i), float(v[i])) for i in idx]\n\nfor L in range(4):\n    print(f\"\\n===== LAYER {L} =====\")\n    fc = data[f\"W_fc.{L}\"]      # (1536,384)\n    proj = data[f\"W_proj.{L}\"]  # (384,1536)\n    rn_fc, cn_fc = norms(fc)\n    rn_proj, cn_proj = norms(proj)\n    print(f\"MLP orient test: corr(rn_fc(1536),cn_proj(1536))={corr(rn_fc, cn_proj):.4f} corr(cn_fc(384),rn_proj(384))={corr(cn_fc, rn_proj):.4f}\")\n    print(f\" fc row med={np.median(rn_fc):.3f} top rows={top(rn_fc,3)} bottom rows={bottom(rn_fc,3)}\")\n    print(f\" proj col med={np.median(cn_proj):.3f} top cols={top(cn_proj,3)} bottom cols={bottom(cn_proj,3)}\")\n    # do dead fc rows correspond to dead proj cols?\n    dead_thr = np.percentile(rn_fc, 20)\n    dead_idx = np.where(rn_fc < dead_thr)[0]\n    print(f\" fc dead thr20%={dead_thr:.3f} proj_col_on_dead_med={np.median(cn_proj[dead_idx]):.3f} vs overall med={np.median(cn_proj):.3f}\")\n    # LN2 vs MLP input?\n    ln2w = data[f\"ln2_w.{L}\"].astype(np.float64)\n    print(f\" ln2w corr cn_fc={corr(ln2w, cn_fc):.4f} corr rn_proj={corr(ln2w, rn_proj):.4f} corr rn_fc={corr(np.repeat(0,1536), np.zeros(1536)) if False else 0:.4f}\")\n    # actually ln2 is 384-dim, compare to 384-dim sides\n    print(f\" ln2w(384) vs cn_fc(384): {corr(ln2w, cn_fc):.4f} vs rn_proj(384): {corr(ln2w, rn_proj):.4f}\")\n\n    for name in [\"W_q\", \"W_k\", \"W_v\", \"W_o\"]:\n        a = data[f\"{name}.{L}\"]\n        rn, cn = norms(a)\n        print(f\" {name} rn_med={np.median(rn):.3f} cn_med={np.median(cn):.3f} top_r={top(rn,2)} top_c={top(cn,2)}\")\n    ln1w = data[f\"ln1_w.{L}\"].astype(np.float64)\n    for name in [\"W_q\", \"W_k\", \"W_v\", \"W_fc\"]:\n        a = data[f\"{name}.{L}\"]\n        rn, cn = norms(a)\n        # ln1 is 384-dim, both rn/cn are 384 for qkv, but fc has 384 on one side\n        if a.shape[0]==384 and a.shape[1]==384:\n            print(f\"  ln1w vs {name} rn:{corr(ln1w, rn):.4f} cn:{corr(ln1w, cn):.4f}\")\n        else:\n            # fc (1536,384): 384 side is cn\n            print(f\"  ln1w vs {name} cn384:{corr(ln1w, cn_fc):.4f} rn384??\")\n\n# outlier channel check L3\nprint(\"\\n===== OUTLIER CHANNEL L3 =====\")\nrn_proj3, cn_proj3 = norms(data[\"W_proj.3\"])\nrn_o3, cn_o3 = norms(data[\"W_o.3\"])\nprint(\"proj3 top rows:\", top(rn_proj3,5))\nprint(\"o3 top rows:\", top(rn_o3,5))\nprint(\"proj3 row norms full sort top10 idx:\", [int(i) for i in np.argsort(rn_proj3)[-10:][::-1]])\nprint(\"o3 row norms top10 idx:\", [int(i) for i in np.argsort(rn_o3)[-10:][::-1]])\n# k outlier cols L1 L2\nfor L in [1,2,3]:\n    _, cn = norms(data[f\"W_k.{L}\"])\n    print(f\"W_k.{L} top cols:\", top(cn,5))\n", "out": "\n===== LAYER 0 =====\nMLP orient test: corr(rn_fc(1536),cn_proj(1536))=0.9611 corr(cn_fc(384),rn_proj(384))=-0.1337\n fc row med=0.423 top rows=[(1140, 4.421904117403338), (461, 4.259496916600624), (1115, 4.103671268164319)] bottom rows=[(68, 0.326577286743169), (797, 0.335474482066447), (1316, 0.3359460701184458)]\n proj col med=0.237 top cols=[(98, 4.795393493174692), (1132, 3.3526856515622616), (1140, 2.9047792700658546)] bottom cols=[(68, 0.13180536989360142), (951, 0.13311764477262894), (1287, 0.13407558422753973)]\n fc dead thr20%=0.384 proj_col_on_dead_med=0.179 vs overall med=0.237\n ln2w corr cn_fc=0.7457 corr rn_proj=0.0060 corr rn_fc=0.0000\n ln2w(384) vs cn_fc(384): 0.7457 vs rn_proj(384): 0.0060\n W_q rn_med=0.405 cn_med=1.439 top_r=[(162, 4.674119210277987), (133, 4.563427572411767)] top_c=[(93, 2.7993269509512366), (128, 2.7593179289071457)]\n W_k rn_med=0.502 cn_med=1.345 top_r=[(144, 4.190005220796308), (176, 4.156140423891323)] top_c=[(162, 3.228564426794573), (35, 2.960322280050428)]\n W_v rn_med=0.454 cn_med=0.754 top_r=[(221, 2.0487882205229466), (233, 2.0364955331711907)] top_c=[(223, 1.3041247630796646), (162, 1.2963074443928053)]\n W_o rn_med=0.641 cn_med=0.346 top_r=[(222, 6.489661427780142), (78, 5.197288319725023)] top_c=[(221, 2.025925664911435), (233, 1.884071739530675)]\n  ln1w vs W_q rn:0.0399 cn:0.3170\n  ln1w vs W_k rn:0.0352 cn:0.5839\n  ln1w vs W_v rn:0.1188 cn:0.2104\n  ln1w vs W_fc cn384:-0.3746 rn384??\n\n===== LAYER 1 =====\nMLP orient test: corr(rn_fc(1536),cn_proj(1536))=0.9481 corr(cn_fc(384),rn_proj(384))=0.3798\n fc row med=2.004 top rows=[(1053, 3.371096757264855), (225, 3.3641691509733507), (197, 3.00345579079211)] bottom rows=[(1040, 0.39134477089176106), (1237, 0.3943238072798976), (129, 0.3945775077472071)]\n proj col med=1.922 top cols=[(733, 2.675587888169543), (1451, 2.6551563346270415), (197, 2.5994140620359385)] bottom cols=[(1040, 0.1985916617160135), (265, 0.22420108434661884), (1237, 0.22935967654493403)]\n fc dead thr20%=1.882 proj_col_on_dead_med=1.781 vs overall med=1.922\n ln2w corr cn_fc=0.7348 corr rn_proj=0.3841 corr rn_fc=0.0000\n ln2w(384) vs cn_fc(384): 0.7348 vs rn_proj(384): 0.3841\n W_q rn_med=1.665 cn_med=1.618 top_r=[(151, 2.2058356097587515), (164, 2.1930108255897007)] top_c=[(114, 2.793890612246104), (179, 2.4802891266508715)]\n W_k rn_med=1.499 cn_med=1.221 top_r=[(164, 1.9164232589966812), (139, 1.91504646567401)] top_c=[(222, 9.25918478307822), (72, 8.438712489920919)]\n W_v rn_med=1.418 cn_med=1.409 top_r=[(352, 2.0210689180268075), (208, 1.9690188011084993)] top_c=[(101, 1.7896052413953687), (81, 1.7774502659000357)]\n W_o rn_med=1.301 cn_med=1.388 top_r=[(360, 3.565061787876895), (103, 3.3507279367729432)] top_c=[(352, 1.8621717721573854), (318, 1.8299165768498569)]\n  ln1w vs W_q rn:-0.0885 cn:-0.1850\n  ln1w vs W_k rn:-0.1003 cn:0.3010\n  ln1w vs W_v rn:0.0203 cn:-0.1432\n  ln1w vs W_fc cn384:-0.0489 rn384??\n\n===== LAYER 2 =====\nMLP orient test: corr(rn_fc(1536),cn_proj(1536))=0.8791 corr(cn_fc(384),rn_proj(384))=0.1638\n fc row med=2.010 top rows=[(823, 2.482523172444718), (730, 2.4234927436075915), (1125, 2.381543448956091)] bottom rows=[(585, 1.7220658335508379), (156, 1.7524369272952454), (364, 1.7717883928367273)]\n proj col med=1.957 top cols=[(730, 2.446537386248151), (986, 2.4037443531286504), (298, 2.387255495994709)] bottom cols=[(585, 1.550498181194976), (1499, 1.5596934232616164), (364, 1.573401624685634)]\n fc dead thr20%=1.959 proj_col_on_dead_med=1.828 vs overall med=1.957\n ln2w corr cn_fc=0.6206 corr rn_proj=0.3471 corr rn_fc=0.0000\n ln2w(384) vs cn_fc(384): 0.6206 vs rn_proj(384): 0.3471\n W_q rn_med=2.031 cn_med=2.002 top_r=[(3, 2.283181823462081), (290, 2.263562507310242)] top_c=[(322, 2.240882677226247), (101, 2.236595204525162)]\n W_k rn_med=1.954 cn_med=1.799 top_r=[(3, 2.1913970223700567), (48, 2.18385183215344)] top_c=[(222, 8.883019808000338), (78, 8.719848318448939)]\n W_v rn_med=1.689 cn_med=1.720 top_r=[(159, 1.9711178702791552), (153, 1.9562679173481345)] top_c=[(192, 1.9019798521180646), (18, 1.8794436575670987)]\n W_o rn_med=1.654 cn_med=1.666 top_r=[(103, 3.337562995089005), (72, 3.191823416500988)] top_c=[(174, 1.911977284707025), (159, 1.894378537552736)]\n  ln1w vs W_q rn:-0.0501 cn:0.0880\n  ln1w vs W_k rn:-0.0252 cn:0.0578\n  ln1w vs W_v rn:-0.0278 cn:0.4844\n  ln1w vs W_fc cn384:0.4590 rn384??\n\n===== LAYER 3 =====\nMLP orient test: corr(rn_fc(1536),cn_proj(1536))=0.6717 corr(cn_fc(384),rn_proj(384))=-0.5437\n fc row med=1.976 top rows=[(613, 3.1298409589174145), (94, 2.4877898470201703), (977, 2.481939644453608)] bottom rows=[(537, 1.7762618425828283), (419, 1.803114106444672), (21, 1.