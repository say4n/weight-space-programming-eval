{"t": 1793709382.498215, "s": 0.07, "code": "import numpy as np\nd=np.load(\"blocks.npz\")\nfor i in range(4):\n    Wfc=d[f\"W_fc.{i}\"]  # 1536x384\n    Wproj=d[f\"W_proj.{i}\"]  # 384x1536\n    fc_rown=np.linalg.norm(Wfc,axis=1)\n    # proj col norms overall, and proj row103/col?\n    proj_coln=np.linalg.norm(Wproj,axis=0)  # per hidden\n    # top hidden by fc_rown and proj_coln\n    top_fc=np.argsort(fc_rown)[-10:][::-1]\n    top_proj=np.argsort(proj_coln)[-10:][::-1]\n    print(f\"L{i} top_fc_rows {top_fc.tolist()} norms {[f'{fc_rown[j]:.2f}' for j in top_fc]}\")\n    print(f\"L{i} top_proj_cols(hidden) {top_proj.tolist()} norms {[f'{proj_coln[j]:.2f}' for j in top_proj]}\")\n    # overlap?\n    print(f\" overlap {set(top_fc.tolist()) & set(top_proj.tolist())}\")\n    # row103 contributors\n    row103=np.abs(Wproj[103])\n    top103=np.argsort(row103)[-10:][::-1]\n    print(f\"L{i} row103 top hidden {top103.tolist()} vals {[f'{Wproj[103,j]:+.3f}' for j in top103]}\")\n    # row222 contributors for Wo? different, but for proj row222\n    row222=np.abs(Wproj[222])\n    top222=np.argsort(row222)[-10:][::-1]\n    print(f\"L{i} proj row222 top hidden {top222.tolist()} vals {[f'{Wproj[222,j]:+.3f}' for j in top222]}\")\n", "out": "L0 top_fc_rows [1140, 461, 1115, 827, 468, 98, 1214, 1181, 1456, 477] norms ['4.42', '4.26', '4.10', '4.04', '4.01', '3.96', '3.95', '3.66', '3.65', '3.65']\nL0 top_proj_cols(hidden) [98, 1132, 1140, 461, 100, 477, 1129, 1383, 1054, 1170] norms ['4.80', '3.35', '2.90', '2.86', '2.82', '2.65', '2.64', '2.62', '2.55', '2.55']\n overlap {477, 98, 1140, 461}\nL0 row103 top hidden [1038, 1323, 159, 829, 147, 89, 176, 1360, 1501, 941] vals ['+1.136', '+1.135', '+1.127', '+1.122', '+1.119', '+1.115', '+1.114', '+1.096', '+1.078', '+1.061']\nL0 proj row222 top hidden [701, 159, 1323, 176, 147, 941, 1038, 1501, 1360, 829] vals ['+0.900', '+0.820', '+0.796', '+0.775', '+0.762', '+0.759', '+0.759', '+0.755', '+0.747', '+0.741']\nL1 top_fc_rows [1053, 22