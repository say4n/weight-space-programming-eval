{"t": 1793709150.932359, "s": 0.08, "code": "import os\n# wsp_link tricks\nfor fn in [os.readlink, os.lstat]:\n    try:\n        print(fn.__name__, fn(\"/tmp/wsp_link\"))\n    except Exception as e:\n        print(fn.__name__, \"fail\", repr(e))\nfor p in [\"/tmp/wsp_link\", \"/tmp/wsp_link/\", \"/tmp/wsp_link/blocks.npz\"]:\n    for op in [\"listdir\",\"open\"]:\n        try:\n            if op==\"listdir\":\n                print(\"listdir\", p, os.listdir(p)[:50])\n            else:\n                print(\"open\", p, open(p,\"rb\").read(200)[:200])\n        except Exception as e:\n            print(op, p, \"fail\", repr(e))\n# try /tmp py files\nfor f in [\"dbg.py\",\"rollout_test.py\",\"rollout_test2.py\",\"cmp.log\",\"ks4.log\",\"ksp.log\",\"t.json\",\"s9.html\"]:\n    p=f\"/tmp/{f}\"\n    try:\n        txt=open(p).read()\n        print(f\"\\n=== {f} len={len(txt)} ===\")\n        print(txt[:6000])\n    except Exception as e:\n        print(f, \"fail\", repr(e))\n# list interesting dirs\nfor d in [\"audit_repo\",\"alpha_0.25\",\"kt\",\"mt\",\"chainc\"]:\n    try:\n        print(f\"\\nDIR /tmp/{d}:\", sorted(os.listdir(f\"/tmp/{d}\"))[:50])\n    except Exception as e:\n        print(f\"dir {d} fail\", repr(e))\n", "out": "readlink /Users/sayan/Projects/weight-space-programming/wsp\nlstat os.stat_result(st_mode=41453, st_ino=67899092, st_dev=16777231, st_nlink=1, st_uid=501, st_gid=0, st_size=50, st_atime=1793708026, st_mtime=1793708026, st_ctime=1793708026)\nlistdir /tmp/wsp_link fail PermissionError(1, 'Operation not permitted')\nopen /tmp/wsp_link fail PermissionError(1, 'Operation not permitted')\nlistdir /tmp/wsp_link/ fail PermissionError(1, 'Operation not permitted')\nopen /tmp/wsp_link/ fail PermissionError(1, 'Operation not permitted')\nlistdir /tmp/wsp_link/blocks.npz fail FileNotFoundError(2, 'No such file or directory')\nopen /tmp/wsp_link/blocks.npz fail FileNotFoundError(2, 'No such file or directory')\n\n=== dbg.py len=3875 ===\nimport numpy as np\nimport jax, jax.numpy as jnp\nfrom kinetix.environment.env import make_kinetix_env\nfrom kinetix.environment.spaces import ActionType, ObservationType\nfrom kinetix.util.saving import load_from_json_file\n\nNPZ_ACTOR = {\n    \"params/Dense_0/kernel\": \"embed.W\", \"params/Dense_0/bias\": \"embed.b\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_0/Dense_0/kernel\": \"actor0.W\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_0/Dense_0/bias\": \"actor0.b\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_1/Dense_0/kernel\": \"actor1.W\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_1/Dense_0/bias\": \"actor1.b\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_2/Dense_0/kernel\": \"actor2.W\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_2/Dense_0/bias\": \"actor2.b\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_3/Dense_0/kernel\": \"actor3.W\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_3/Dense_0/bias\": \"actor3.b\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_4/Dense_0/kernel\": \"actor4.W\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_4/Dense_0/bias\": \"actor4.b\",\n    \"params/GeneralActorCriticRNN_0/Dense_0/kernel\": \"actor_head.W\",\n    \"params/GeneralActorCriticRNN_0/Dense_0/bias\": \"actor_head.b\",\n}\ndef load_actor(path):\n    d = np.load(path)\n    t = {}\n    for npz_name, name in NPZ_ACTOR.items():\n        t[name] = jnp.asarray(d[npz_name], dtype=jnp.float32)\n    return t\n\ndef forward(t, x):\n    h = jnp.maximum(0.0, x @ t['embed.W'] + t['embed.b'])\n    for k in range(5):\n        h = jnp.tanh(h @ t[f'actor{k}.W'] + t[f'actor{k}.b'])\n    return h @ t['actor_head.W'] + t['actor_head.b']\n\ndef sample_action(rng, logits):\n    rngs = jax.random.split(rng, 6)\n    return jnp.stack([jax.random.categorical(rngs[0], logits[0:3]),\n                      jax.random.categorical(rngs[1], logits[3:6]),\n                      jax.random.categorical(rngs[2], logits[6:9]),\n                      jax.random.categorical(rngs[3], logits[9:12]),\n                      jax.random.categorical(rngs[4], logits[12:14]),\n                      jax.random.categorical(rngs[5], logits[14:16])])\n\nstate, static_env_params, env_params = load_from_json_file('l/h2_car_ramp')\nenv = make_kinetix_env(ActionType.MULTI_DISCRETE, ObservationType.SYMBOLIC_FLAT, lambda rng: state, env_params, static_env_params, auto_reset=False)\nt = load_actor('upstream/exp4_fix_car/networks/ppo_final_seed0.npz')\nmax_steps = int(env_params.max_timesteps)\n\ndef rollout(rng):\n    obs, state0 = env.reset(rng, env_params)\n    def step(carry, _):\n        rng, state, obs = carry\n        rng, rng_action, rng_step = jax.random.split(rng, 3)\n        logits = forward(t, obs)\n        action = sample_action(rng_action, logits)\n        obs2, state2, reward, done, info = env.step(rng_step, state, action, env_params)\n        return (rng, state2, obs2), (state2, reward, done, info, logits, action, obs)\n    carry, traj = jax.lax.scan(step, (rng, state0, obs), None, length=max_steps)\n    return carry, traj\n\njit_rollout = jax.jit(rollout)\nrng = jax.random.PRNGKey(0)\ncarry, traj = jit_rollout(rng)\nstates, rewards, dones, infos, logits, actions, obss = traj\ndones_np = np.asarray(dones)\nrewards_np = np.asarray(rewards)\nprint('dones where true', np.nonzero(dones_np)[0])\nprint('rewards nonzero', np.nonzero(rewards_np)[0], rewards_np[np.nonzero(rewards_np)[0]])\nprint('final timestep', carry[1].timestep)\n# print timesteps over scan? state2.timestep not in traj; but states are env states\nts = np.asarray([s.timestep for s in states])\nprint('timesteps first 5', ts[:5])\nprint('goalR true indices', np.nonzero(np.asarray([i['GoalR'] for i in infos]))[0])\nprint('distances first 10', [float(i['distance']) for i in infos[:10]])\nprint('actions entry0 first 30', np.asarray(actions)[:30,0])\nprint('rewards first 30', rewards_np[:30])\n\n\n=== rollout_test.py len=5012 ===\nimport time\nimport numpy as np\nimport jax, jax.numpy as jnp\nfrom kinetix.environment.env import make_kinetix_env\nfrom kinetix.environment.spaces import ActionType, ObservationType\nfrom kinetix.util.saving import load_from_json_file\n\nNPZ_ACTOR = {\n    \"params/Dense_0/kernel\": \"embed.W\",\n    \"params/Dense_0/bias\": \"embed.b\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_0/Dense_0/kernel\": \"actor0.W\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_0/Dense_0/bias\": \"actor0.b\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_1/Dense_0/kernel\": \"actor1.W\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_1/Dense_0/bias\": \"actor1.b\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_2/Dense_0/kernel\": \"actor2.W\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_2/Dense_0/bias\": \"actor2.b\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_3/Dense_0/kernel\": \"actor3.W\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_3/Dense_0/bias\": \"actor3.b\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_4/Dense_0/kernel\": \"actor4.W\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_4/Dense_0/bias\": \"actor4.b\",\n    \"params/GeneralActorCriticRNN_0/Dense_0/kernel\": \"actor_head.W\",\n    \"params/GeneralActorCriticRNN_0/Dense_0/bias\": \"actor_head.b\",\n}\n\ndef load_actor(path):\n    d = np.load(path)\n    t ="}
