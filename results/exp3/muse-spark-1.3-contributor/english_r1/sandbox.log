{"t": 1793709456.9124491, "s": 0.07, "code": "import numpy as np\nd=np.load(\"blocks.npz\")\nchecks=[(0,1140,\"ln1_w.0\"),(0,461,\"ln1_w.0\"),(1,225,\"ln2_w.1\"),(1,1053,\"ln2_w.1\"),(2,823,\"ln2_w.2\"),(3,613,\"ln2_w.2\" if False else \"ln2_w.3\")]\n# note: W_fc reads from ln2 output? Actually in Pre-LN: attn uses ln1, mlp uses ln2. W_fc is MLP, so uses ln2. Correction:\nchecks=[(0,1140,\"ln2_w.0\"),(0,461,\"ln2_w.0\"),(1,225,\"ln2_w.1\"),(1,1053,\"ln2_w.1\"),(2,823,\"ln2_w.2\"),(3,613,\"ln2_w.3\"),(3,1473,\"ln2_w.3\")]\nfor layer,hid,lnkey in checks:\n    Wfc=d[f\"W_fc.{layer}\"][hid]\n    gamma=d[lnkey]\n    idx=np.argsort(np.abs(Wfc))[-10:][::-1]\n    print(f\"L{layer} hid{hid} via {lnkey}:\")\n    for j in idx:\n        print(f\"  dim{j}: w={Wfc[j]:+.3f} gamma={gamma[j]:+.4f} prod={Wfc[j]*gamma[j]:+.4f}\")\n# also attn QK read via ln1: check L1 W_k col222 etc.\nfor layer in [0,1,2,3]:\n    gamma=d[f\"ln1_w.{layer}\"]\n    print(f\"L{layer} ln1 gamma for 72,78,222,25,254,360:\", {dim: f\"{gamma[dim]:+.3f}\" for dim in [72,78,222,25,254,360]})\n", "out": "L0 hid1140 via ln2_w.0:\n  dim328: w=+0.829 gamma=+1.2691 prod=+1.0527\n  dim298: w=-0.737 gamma=+0.8891 prod=-0.6551\n  dim255: w=-0.680 gamma=+0.9854 prod=-0.6703\n  dim383: w=-0.597 gamma=+1.1699 prod=-0.6983\n  dim357: w=-0.587 gamma=+1.2723 prod=-0.7465\n  dim248: w=+0.571 gamma=+1.2607 prod=+0.7197\n  dim338: w=-0.559 gamma=+1.2565 prod=-0.7023\n  dim367: w=+0.517 gamma=+1.2761 prod=+0.6593\n  dim339: w=+0.511 gamma=+0.7276 prod=+0.3719\n  dim43: w=-0.506 gamma=+0.6484 prod=-0.3284\nL0 hid461 via ln2_w.0:\n  dim292: w=+0.858 gamma=+1.3737 prod=+1.1780\n  dim361: w=-0.592 gamma=+1.3021 prod=-0.7705\n  dim296: w=+0.588 gamma=+0.8923 prod=+0.5249\n  dim359: w=+0.565 gamma=+0.7283 prod=+0.4113\n  dim123: w=-0.562 gamma=+1.2669 prod=-0.7117\n  dim305: w=+0.558 gamma=+0.7746 prod=+0.4319\n  dim312: w=-0.548 gamma=+1.0197 prod=-0.5589\n  dim63: w=-0.528 gamma=+1.3043 prod=-0.6883\n  dim338: w=-0.519 gamma=+1.2565 prod=-0.6520\n  dim53: w=-0.497 gamma=+1.1047 prod=-0.5486\nL1 hid225 via ln2_w.1:\n  dim254: w=+0.718 gamma=+0.1971 prod=+0.1415\n  dim373: w=-0.558 gamma=+0.7335 prod=-0.4094\n  dim150: w=+0.513 gamma=+1.1386 prod=+0.5841\n  dim25: w=-0.495 gamma=+0.3165 prod=-0.1568\n  dim379: w=-0.491 gamma=+1.0953 prod=-0.5377\n  dim282: w=-0.486 gamma=+1.1248 prod=-0.5461\n  dim166: w=-0.479 gamma=+0.9534 prod=-0.4567\n  dim273: w=-0.462 gamma=+0.0617 prod=-0.0285\n  dim152: w=-0.444 gamma=+0.8765 prod=-0.3890\n  dim181: w=-0.418 gamma=+1.1280 prod=-0.4710\nL1 hid1053 via ln2_w.1:\n  dim373: w=-0.512 gamma=+0.7335 prod=-0.3759\n  dim351: w=+0.502 gamma=+1.0638 prod=+0.5343\n  dim368: w=-0.473 gamma=+0.9128 prod=-0.4320\n  dim25: w=-0.449 gamma=+0.3165 prod=-0.1422\n  dim150: w=+0.440 gamma=+1.1386 prod=+0.5005\n  dim91: w=-0.411 gamma=+1.1105 prod=-0.4569\n  dim110: w=+0.405 gamma=+0.9877 prod=+0.3999\n  dim277: w=+0.386 gamma=+1.0095 prod=+0.3899\n  dim146: w=-0.383 gamma=+0.9526 prod=-0.3646\n  dim152: w=-0.380 gamma=+0.8765 prod=-0.3327\nL2 hid823 via ln2_w.2:\n  dim78: w=+1.228 gamma=+0.0606 prod=+0.0744\n  dim72: w=-0.897 gamma=+0.3504 prod=-0.3143\n  dim222: w=+0.565 gamma=+0.0011 prod=+0.0006\n  dim254: w=+0.302 gamma=+1.1983 prod=+0.3620\n  dim339: w=-0.285 gamma=+1.2657 prod=-0.3604\n  dim51: w=-0.272 gamma=+1.3243 prod=-0.3598\n  dim107: w=-0.256 gamma=+1.3240 prod=-0.3386\n  dim360: w=+0.250 gamma=+0.7269 prod=+0.1817\n  dim28: w=-0.249 gamma=+1.3175 prod=-0.3284\n  dim114: w=-0.235 gamma=+1.1927 prod=-0.2803\nL3 hid613 via ln2_w.3:\n  dim222: w=+1.058 gamma=+0.4364 prod=+0.4619\n  dim258: w=+0.477 gamma=+1.2364 prod=+0.5894\n  dim214: w=-0.434 gamma=+1.2676 prod=-0.5507\n  dim35: w=+0.424 gamma=+1.2107 prod=+0.5131\n  dim127: w=+0.417 gamma=+1.2477 prod=+0.5203\n  dim72: w=-0.414 gamma=+0.8487 prod=-0.3515\n  dim348: w=-0.389 gamma=+1.2451 prod=-0.4843\n  dim147: w=-0.381 gamma=+1.2842 prod=-0.4889\n  dim306: w=-0.365 gamma=+1.2611 prod=-0.4604\n  dim109: w=-0.350 gamma=+1.2659 prod=-0.4424\nL3 hid1473 via ln2_w.3:\n  dim367: w=+0.320 gamma=+1.2544 prod=+0.4009\n  dim353: w=-0.311 gamma=+1.2949 prod=-0.4029\n  dim102: w=-0.302 gamma=+1.3719 prod=-0.4144\n  dim302: w=+0.295 gamma=+1.1634 prod=+0.3436\n  dim25: w=-0.293 gamma=+1.1483 prod=-0.3361\n  dim261: w=+0.287 gamma=+1.2820 prod=+0.3679\n  dim8: w=+0.281 gamma=+1.3570 prod=+0.3808\n  dim372: w=-0.274 gamma=+1.2936 prod=-0.3543\n  dim238: w=-0.274 gamma=+1.3028 prod=-0.3566\n  dim360: w=+0.271 gamma=+1.0790 prod=+0.2927\nL0 ln1 gamma for 72,78,222,25,254,360: {72: '+0.706', 78: '+0.719', 222: '+0.836', 25: '+0.356', 254: '+0.331', 360: '+0.820'}\nL1 ln1 gamma for 72,78,222,25,254,360: {72: '+0.799', 78: '+0.781', 222: '+1.124', 25: '+0.353', 254: '+0.341', 360: '+0.136'}\nL2 ln1 gamma for 72,78,222,25,254,360: {72: '+0.386', 78: '+0.906', 222: '+1.014', 25: '+0.436', 254: '+0.470', 360: '+0.208'}\nL3 ln1 gamma for 72,78,222,25,254,360: {72: '+0.501', 78: '+0.763', 222: '+0.827', 25: '+0.687', 254: '+0.703', 360: '+0.294'}\n"}
{"t": 1793709523.791718, "s": 0.1, "code": "import numpy as np\nd=np.load(\"blocks.npz\")\ndef ln(x, w, b, eps=1e-5):\n    m=x.mean(axis=-1, keepdims=True)\n    v=x.var(axis=-1, keepdims=True)\n    return w*(x-m)/np.sqrt(v+eps)+b\ndef gelu(x):\n    return 0.5*x*(1+np.tanh(np.sqrt(2/np.pi)*(x+0.044715*x**3)))\ndef forward_seq(X):  # X: Tx384\n    T=X.shape[0]\n    h=X\n    for i in range(4):\n        # attn\n        xl=ln(h, d[f\"ln1_w.{i}\"], d[f\"ln1_b.{i}\"])\n        Q=(d[f\"W_q.{i}\"] @ xl.T).T  # Tx384\n        K=(d[f\"W_k.{i}\"] @ xl.T).T\n        V=(d[f\"W_v.{i}\"] @ xl.T).T\n        # split 6x64\n        Qh=Q.reshape(T,6,64); Kh=K.reshape(T,6,64); Vh=V.reshape(T,6,64)\n        # scores\n        scores=np.einsum(\"thd,shd->hts\", Qh, Kh)/np.sqrt(64)  # h,t,s\n        # causal\n        mask=np.triu(np.ones((T,T))*(-1e9), k=1)\n        scores=scores+mask[None,:,:]\n        # softmax\n        e=np.exp(scores-scores.max(axis=-1, keepdims=True))\n        attn=e/e.sum(axis=-1, keepdims=True)\n        O=np.einsum(\"hts,shd->thd\", attn, Vh).reshape(T,384)\n        Ao=(d[f\"W_o.{i}\"] @ O.T).T\n        h=h+Ao\n        # mlp\n        xl2=ln(h, d[f\"ln2_w.{i}\"], d[f\"ln2_b.{i}\"])\n        Fc=(d[f\"W_fc.{i}\"] @ xl2.T).T\n        Hg=gelu(Fc)\n        Mp=(d[f\"W_proj.{i}\"] @ Hg.T).T\n        h=h+Mp\n    return h\n\nnp.random.seed(0)\nfor trial in [\"randn\",\"onehot_flags\"]:\n    if trial==\"randn\":\n        X=np.random.randn(8,384).astype(np.float32)*0.5\n    else:\n        X=np.random.randn(8,384).astype(np.float32)*0.1\n        X[:,222]=2.0  # set flag\n        X[:,78]=1.5\n        X[:,103]=1.0\n    H=forward_seq(X)\n    print(trial, \"out mean\", H.mean(), \"std\", H.std(), \"max\", H.max(), \"min\", H.min(), \"norm\", np.linalg.norm(H,axis=1))\n    # flag evolution? need per-layer? quick: run with hooks\n    h=X.copy()\n    for i in range(4):\n        xl=ln(h, d[f\"ln1_w.{i}\"], d[f\"ln1_b.{i}\"])\n        print(f\" L{i} resid norm {np.linalg.norm(h,axis=1).mean():.2f} ln1 out std {xl.std():.3f} ln1 flag222 {xl[:,222].mean():+.3f} flag78 {xl[:,78].mean():+.3f} flag103 {xl[:,103].mean():+.3f}\")\n        # one attn step approx? just do full to update h for next print\n        # reuse forward for update\n        # to avoid dup, call forward_seq partial? simplified: use H from full? skip\n        # do manual update using same funcs as above (copy)\n        Q=(d[f\"W_q.{i}\"] @ xl.T).T.reshape(8,6,64)\n        K=(d[f\"W_k.{i}\"] @ xl.T).T.reshape(8,6,64)\n        V=(d[f\"W_v.{i}\"] @ xl.T).T.reshape(8,6,64)\n        scores=np.einsum(\"thd,shd->hts\", Q, K)/8.0\n        mask=np.triu(np.ones((8,8))*(-1e9), k=1)\n        scores=scores+mask[None,:,:]\n        e=np.exp(scores-scores.max(axis=-1,keepdims=True)); attn=e/e.sum(axis=-1,keepdims=True)\n        O=np.einsum(\"hts,shd->thd\", attn, V).reshape(8,384)\n        h=h+(d[f\"W_o.{i}\"] @ O.T).T\n        xl2=ln(h, d[f\"ln2_w.{i}\"], d[f\"ln2_b.{i}\"])\n        print(f\"     ln2 out std {xl2.std():.3f} flag222 {xl2[:,222].mean():+.3f} flag78 {xl2[:,78].mean():+.3f} flag103 {xl2[:,103].mean():+.3f}\")\n        h=h+(d[f\"W_proj.{i}\"] @ gelu((d[f\"W_fc.{i}\"] @ xl2.T).T).T).T if False else h  # placeholder\n        # actually compute correctly:\n        Fc=(d[f\"W_fc.{i}\"] @ xl2.T).T; Mp=(d[f\"W_proj.{i}\"] @ gelu(Fc).T).T; h=h+Mp\n", "out": "randn out mean 0.062223572206778106 std 12.222448909726067 max 294.78928038524055 min -67.52526829209948 norm [242.11130138 347.23012445 372.75839065 155.1855464  181.23753195\n 173.8895734  150.8936138  175.67327076]\n L0 resid norm 9.51 ln1 out std 0.339 ln1 flag222 -0.048 flag78 -0.130 flag103 -0.069\n     ln2 out std 0.622 flag222 -0.618 flag78 -0.510 flag103 -0.667\n L1 resid norm 102.65 ln1 out std 0.467 ln1 flag222 +1.985 flag78 +0.095 flag103 +0.949\n     ln2 out std 1.105 flag222 +0.004 flag78 -0.003 flag103 +4.834\n L2 resid norm 149.43 ln1 out std 0.623 ln1 flag222 +1.653 flag78 +0.538 flag103 +1.453\n     ln2 out std 1.240 flag222 -0.000 flag78 +0.125 flag103 +6.754\n L3 resid norm 169.54 ln1 out std 0.688 ln1 flag222 +1.654 flag78 +0.159 flag103 +4.837\n     ln2 out std 1.056 flag222 +1.707 flag78 -1.848 flag103 +7.876\nonehot_flags out mean 0.18320689222823452 std 16.66405165207161 max 315.5654913141508 min -58.02852988059725 norm [370.25600512 314.82094748 261.88910837 284.86962079 319.36564158\n 333.11288957 348.68068477 364.27120861]\n L0 resid norm 3.32 ln1 out std 0.643 ln1 flag222 +9.784 flag78 +6.398 flag103 +2.426\n     ln2 out std 0.300 flag222 -0.732 flag78 -1.237 flag103 -1.184\n L1 resid norm 125.84 ln1 out std 0.483 ln1 flag222 +6.262 flag78 -0.747 flag103 +2.372\n     ln2 out std 1.010 flag222 -0.001 flag78 -0.003 flag103 +12.105\n L2 resid norm 248.03 ln1 out std 0.461 ln1 flag222 +4.478 flag78 -0.194 flag103 +4.169\n     ln2 out std 0.967 flag222 +0.002 flag78 +0.080 flag103 +14.606\n L3 resid norm 316.98 ln1 out std 0.604 ln1 flag222 +3.470 flag78 -0.160 flag103 +9.852\n     ln2 out std 0.813 flag222 +1.667 flag78 -0.691 flag103 +12.501\n"}
{"t": 1793709559.1839628, "s": 0.1, "code": "import numpy as np\nd=np.load(\"blocks.npz\")\ndef ln(x,w,b,eps=1e-5):\n    return w*(x-x.mean(-1,keepdims=True))/np.sqrt(x.var(-1,keepdims=True)+eps)+b\ndef gelu(x):\n    return 0.5*x*(1+np.tanh(np.sqrt(2/np.pi)*(x+0.044715*x**3)))\nnp.random.seed(1)\nX=np.random.randn(4,384).astype(np.float32)*0.5\nh=X.copy()\nfor i in range(4):\n    xl=ln(h,d[f\"ln1_w.{i}\"],d[f\"ln1_b.{i}\"])\n    Q=(d[f\"W_q.{i}\"]@xl.T).T.reshape(4,6,64)\n    K=(d[f\"W_k.{i}\"]@xl.T).T.reshape(4,6,64)\n    V=(d[f\"W_v.{i}\"]@xl.T).T.reshape(4,6,64)\n    sc=np.einsum(\"thd,shd->hts\",Q,K)/8.0+np.triu(np.ones((4,4))*-1e9,k=1)[None]\n    e=np.exp(sc-sc.max(-1,keepdims=True)); a=e/e.sum(-1,keepdims=True)\n    O=np.einsum(\"hts,shd->thd\",a,V).reshape(4,384)\n    Ao=(d[f\"W_o.{i}\"]@O.T).T\n    print(f\"L{i} |h|={np.linalg.norm(h,axis=1).mean():.1f} |Ao|={np.linalg.norm(Ao,axis=1).mean():.1f} attn_ent={( -(a*np.log(a+1e-9)).sum(-1).mean()):.2f} max_attn={a.max():.3f}\")\n    h=h+Ao\n    xl2=ln(h,d[f\"ln2_w.{i}\"],d[f\"ln2_b.{i}\"])\n    Fc=(d[f\"W_fc.{i}\"]@xl2.T).T; Mp=(d[f\"W_proj.{i}\"]@gelu(Fc).T).T\n    print(f\"   |h+attn|={np.linalg.norm(h,axis=1).mean():.1f} |Mp|={np.linalg.norm(Mp,axis=1).mean():.1f} Fc_max={Fc.max():.2f} Fc_mean_relu={(np.maximum(Fc,0).mean()):.3f}\")\n    h=h+Mp\nprint(\"final top dims\", np.argsort(np.abs(h[0]))[-10:][::-1].tolist(), h[0][np.argsort(np.abs(h[0]))[-10:][::-1]].tolist())\nprint(\"final second row top\", np.argsort(np.abs(h[1]))[-10:][::-1].tolist())\n", "out": "L0 |h|=9.8 |Ao|=22.7 attn_ent=0.73 max_attn=1.000\n   |h+attn|=25.0 |Mp|=40.3 Fc_max=6.23 Fc_mean_relu=0.109\nL1 |h|=51.2 |Ao|=31.7 attn_ent=0.05 max_attn=1.000\n   |h+attn|=59.4 |Mp|=82.4 Fc_max=20.03 Fc_mean_relu=0.271\nL2 |h|=109.6 |Ao|=34.9 attn_ent=0.37 max_attn=1.000\n   |h+attn|=113.9 |Mp|=49.2 Fc_max=10.70 Fc_mean_relu=0.123\nL3 |h|=136.3 |Ao|=35.6 attn_ent=0.38 max_attn=1.000\n   |h+attn|=139.4 |Mp|=85.1 Fc_max=13.92 Fc_mean_relu=0.209\nfinal top dims [103, 292, 360, 222, 249, 72, 332, 217, 47, 205] [192.61292908039366, -46.02501049525063, 41.36849456886573, 40.849127610865466, -34.12539805633298, -25.235486869414462, 22.781741533139723, -18.462349279535015, 17.706665942097253, 17.47503803203197]\nfinal second row top [103, 249, 226, 302, 360, 184, 222, 95, 242, 273]\n"}
{"t": 1793709595.520384, "s": 0.15, "code": "import numpy as np, copy\nd0=np.load(\"blocks.npz\")\ndef ln(x,w,b,eps=1e-5):\n    return w*(x-x.mean(-1,keepdims=True))/np.sqrt(x.var(-1,keepdims=True)+eps)+b\ndef gelu(x):\n    return 0.5*x*(1+np.tanh(np.sqrt(2/np.pi)*(x+0.044715*x**3)))\ndef run(d, X):\n    h=X.copy(); ents=[]\n    for i in range(4):\n        xl=ln(h,d[f\"ln1_w.{i}\"],d[f\"ln1_b.{i}\"])\n        Q=(d[f\"W_q.{i}\"]@xl.T).T.reshape(X.shape[0],6,64)\n        K=(d[f\"W_k.{i}\"]@xl.T).T.reshape(X.shape[0],6,64)\n        V=(d[f\"W_v.{i}\"]@xl.T).T.reshape(X.shape[0],6,64)\n        sc=np.einsum(\"thd,shd->hts\",Q,K)/8.0+np.triu(np.ones((X.shape[0],X.shape[0]))*-1e9,k=1)[None]\n        e=np.exp(sc-sc.max(-1,keepdims=True)); a=e/e.sum(-1,keepdims=True)\n        ents.append(float((-(a*np.log(a+1e-9)).sum(-1).mean())))\n        O=np.einsum(\"hts,shd->thd\",a,V).reshape(X.shape[0],384)\n        Ao=(d[f\"W_o.{i}\"]@O.T).T; h=h+Ao\n        xl2=ln(h,d[f\"ln2_w.{i}\"],d[f\"ln2_b.{i}\"])\n        Mp=(d[f\"W_proj.{i}\"]@gelu((d[f\"W_fc.{i}\"]@xl2.T).T).T).T; h=h+Mp\n    return h, ents\nnp.random.seed(0)\nX1=np.random.randn(4,384).astype(np.float32)*0.5\nX2=np.random.randn(4,384).astype(np.float32)*0.5+1.0  # different distribution\nfor scale_qk, scale_out in [(1.0,1.0),(0.5,1.0),(1.0,0.5),(0.5,0.5),(0.3,0.3)]:\n    d=dict(d0)\n    for i in range(4):\n        d[f\"W_q.{i}\"]=d0[f\"W_q.{i}\"]*scale_qk\n        d[f\"W_k.{i}\"]=d0[f\"W_k.{i}\"]*scale_qk\n        d[f\"W_o.{i}\"]=d0[f\"W_o.{i}\"]*scale_out\n        d[f\"W_proj.{i}\"]=d0[f\"W_proj.{i}\"]*scale_out\n    h1,e1=run(d,X1); h2,e2=run(d,X2)\n    # sensitivity: does output change with input?\n    diff=np.linalg.norm(h1-h2,axis=1).mean()\n    print(f\"qk={scale_qk} out={scale_out} |h1|={np.linalg.norm(h1,axis=1).mean():.1f} max103_h1={h1[:,103].mean():+.1f} max103_h2={h2[:,103].mean():+.1f} diff_inputs={diff:.1f} ents={[f'{x:.2f}' for x in e1]} top0={np.argsort(np.abs(h1[0]))[-3:][::-1].tolist()}\")\n", "out": "qk=1.0 out=1.0 |h1|=279.3 max103_h1=+207.7 max103_h2=+123.0 diff_inputs=213.3 ents=['0.69', '0.07', '0.32', '0.53'] top0=[103, 292, 222]\nqk=0.5 out=1.0 |h1|=269.4 max103_h1=+200.5 max103_h2=+122.9 diff_inputs=204.1 ents=['0.77', '0.28', '0.63', '0.72'] top0=[103, 292, 222]\nqk=1.0 out=0.5 |h1|=142.5 max103_h1=+104.6 max103_h2=+69.7 diff_inputs=106.0 ents=['0.69', '0.06', '0.32', '0.51'] top0=[103, 222, 249]\nqk=0.5 out=0.5 |h1|=140.0 max103_h1=+103.3 max103_h2=+68.7 diff_inputs=103.1 ents=['0.77', '0.27', '0.66', '0.72'] top0=[103, 222, 249]\nqk=0.3 out=0.3 |h1|=83.7 max103_h1=+61.9 max103_h2=+41.9 diff_inputs=65.4 ents=['0.79', '0.58', '0.78', '0.79'] top0=[103, 249, 222]\n"}
{"t": 1793709618.25304, "s": 2.26, "code": "import numpy as np\nd=np.load(\"blocks.npz\")\ndef ln(x,w,b,eps=1e-5):\n    return w*(x-x.mean(-1,keepdims=True))/np.sqrt(x.var(-1,keepdims=True)+eps)+b\ndef gelu(x):\n    return 0.5*x*(1+np.tanh(np.sqrt(2/np.pi)*(x+0.044715*x**3)))\ndef forward(X):\n    h=X.copy()\n    for i in range(4):\n        xl=ln(h,d[f\"ln1_w.{i}\"],d[f\"ln1_b.{i}\"])\n        Q=(d[f\"W_q.{i}\"]@xl.T).T.reshape(X.shape[0],6,64)\n        K=(d[f\"W_k.{i}\"]@xl.T).T.reshape(X.shape[0],6,64)\n        V=(d[f\"W_v.{i}\"]@xl.T).T.reshape(X.shape[0],6,64)\n        sc=np.einsum(\"thd,shd->hts\",Q,K)/8.0+np.triu(np.ones((X.shape[0],X.shape[0]))*-1e9,k=1)[None]\n        e=np.exp(sc-sc.max(-1,keepdims=True)); a=e/e.sum(-1,keepdims=True)\n        O=np.einsum(\"hts,shd->thd\",a,V).reshape(X.shape[0],384)\n        h=h+(d[f\"W_o.{i}\"]@O.T).T\n        xl2=ln(h,d[f\"ln2_w.{i}\"],d[f\"ln2_b.{i}\"])\n        h=h+(d[f\"W_proj.{i}\"]@gelu((d[f\"W_fc.{i}\"]@xl2.T).T).T).T\n    return h\nnp.random.seed(0)\nX0=np.random.randn(2,384).astype(np.float32)*0.5\nh0=forward(X0)\nbase=h0[0,103]\nsens=[]\nfor j in range(384):\n    Xp=X0.copy(); Xp[0,j]+=1.0\n    hp=forward(Xp)\n    sens.append(float(hp[0,103]-base))\nsens=np.array(sens)\ntop=np.argsort(np.abs(sens))[-20:][::-1]\nprint(\"base103\", base)\nprint(\"top influential input dims for output103:\", top.tolist())\nprint(\"sens vals\", [f\"{sens[j]:+.2f}\" for j in top])\nprint(\"mean abs sens\", np.abs(sens).mean(), \"max\", np.abs(sens).max())\n# also check output 292,222 sensitivity?\n", "out": "base103 170.81066944238972\ntop influential input dims for output103: [35, 239, 360, 320, 351, 76, 180, 246, 356, 222, 184, 127, 39, 49, 273, 99, 105, 301, 158, 328]\nsens vals ['+113.95', '+105.64', '+98.10', '+72.54', '+56.90', '-54.66', '-52.13', '+51.91', '-47.82', '+47.70', '-47.32', '+46.66', '-43.50', '-40.67', '-40.44', '-39.44', '-39.33', '-38.14', '+37.68', '+37.35']\nmean abs sens 9.703002099574446 max 113.95326098955934\n"}
{"t": 1793709640.290266, "s": 0.2, "code": "import numpy as np\nd0=np.load(\"blocks.npz\")\ndef ln(x,w,b,eps=1e-5):\n    return w*(x-x.mean(-1,keepdims=True))/np.sqrt(x.var(-1,keepdims=True)+eps)+b\ndef gelu(x):\n    return 0.5*x*(1+np.tanh(np.sqrt(2/np.pi)*(x+0.044715*x**3)))\ndef forward(d,X):\n    h=X.copy(); ents=[]\n    for i in range(4):\n        xl=ln(h,d[f\"ln1_w.{i}\"],d[f\"ln1_b.{i}\"])\n        Q=(d[f\"W_q.{i}\"]@xl.T).T.reshape(X.shape[0],6,64)\n        K=(d[f\"W_k.{i}\"]@xl.T).T.reshape(X.shape[0],6,64)\n        V=(d[f\"W_v.{i}\"]@xl.T).T.reshape(X.shape[0],6,64)\n        sc=np.einsum(\"thd,shd->hts\",Q,K)/8.0+np.triu(np.ones((X.shape[0],X.shape[0]))*-1e9,k=1)[None]\n        e=np.exp(sc-sc.max(-1,keepdims=True)); a=e/e.sum(-1,keepdims=True)\n        ents.append(float((-(a*np.log(a+1e-9)).sum(-1).mean())))\n        h=h+(d[f\"W_o.{i}\"]@ (np.einsum(\"hts,shd->thd\",a,V).reshape(X.shape[0],384)).T).T\n        xl2=ln(h,d[f\"ln2_w.{i}\"],d[f\"ln2_b.{i}\"])\n        h=h+(d[f\"W_proj.{i}\"]@gelu((d[f\"W_fc.{i}\"]@xl2.T).T).T).T\n    return h,ents\nnp.random.seed(0)\nX0=np.random.randn(2,384).astype(np.float32)*0.5\nfor s in [1.0,0.5,0.3,0.2,0.1]:\n    d=dict(d0)\n    for i in range(4):\n        d[f\"W_o.{i}\"]=d0[f\"W_o.{i}\"]*s\n        d[f\"W_proj.{i}\"]=d0[f\"W_proj.{i}\"]*s\n        d[f\"W_q.{i}\"]=d0[f\"W_q.{i}\"]* (0.5 if s<1 else 1.0)  # also soften qk when scaling\n        d[f\"W_k.{i}\"]=d0[f\"W_k.{i}\"]* (0.5 if s<1 else 1.0)\n    h,_=forward(d,X0)\n    # quick sens on 10 dims\n    base=h[0,103]\n    sens=[]\n    for j in [35,239,360,320,351,76,180,246,356,222]:\n        Xp=X0.copy(); Xp[0,j]+=1.0\n        hp,_=forward(d,Xp)\n        sens.append(abs(float(hp[0,103]-base)))\n    print(f\"s={s} |h|={np.linalg.norm(h,axis=1).mean():.1f} base103={base:+.1f} mean_sens={np.mean(sens):.1f} max_sens={np.max(sens):.1f}\")\n", "out": "s=1.0 |h|=294.7 base103=+170.8 mean_sens=70.1 max_sens=114.0\ns=0.5 |h|=146.6 base103=+80.3 mean_sens=25.3 max_sens=44.9\ns=0.3 |h|=86.3 base103=+47.6 mean_sens=9.9 max_sens=19.1\ns=0.2 |h|=56.2 base103=+31.4 mean_sens=4.8 max_sens=9.3\ns=0.1 |h|=27.9 base103=+15.8 mean_sens=1.3 max_sens=2.5\n"}
{"t": 1793709654.931812, "s": 0.08, "code": "import numpy as np\nd=np.load(\"blocks.npz\")\nfor k in [\"ln1_w.0\",\"ln2_w.1\"]:\n    a=d[k]\n    neg=np.where(a<0)[0]\n    print(k, \"neg idx\", neg.tolist(), \"vals\", [f\"{a[j]:+.6f}\" for j in neg])\n    # small positive?\n    small=np.where((a>=0)&(a<0.1))[0]\n    print(\" small<0.1\", small[:20].tolist(), \"n\", len(small))\nprint(\"ln1_w.0 stats\", d[\"ln1_w.0\"].mean(), d[\"ln1_w.0\"].std(), \"min\", d[\"ln1_w.0\"].min())\nprint(\"ln2_w.1 stats\", d[\"ln2_w.1\"].mean(), d[\"ln2_w.1\"].std(), \"min\", d[\"ln2_w.1\"].min())\n", "out": "ln1_w.0 neg idx [58, 149, 232, 265, 331] vals ['-0.001012', '-0.000411', '-0.000654', '-0.000189', '-0.000772']\n small<0.1 [2, 3, 7, 12, 13, 15, 20, 21, 24, 27, 33, 41, 42, 48, 51, 55, 57, 63, 67, 68] n 120\nln2_w.1 neg idx [72, 222] vals ['-0.001936', '-0.001274']\n small<0.1 [78, 114, 273] n 3\nln1_w.0 stats 0.24030669 0.24358396 min -0.0010124741\nln2_w.1 stats 1.0428675 0.20026265 min -0.0019355153\n"}
{"t": 1793709671.450537, "s": 0.11, "code": "import numpy as np\nd0=np.load(\"blocks.npz\")\nd=dict(d0)\ns_out=0.2\ns_qk=0.5\nfor i in range(4):\n    d[f\"W_o.{i}\"]= (d0[f\"W_o.{i}\"]*s_out).astype(np.float32)\n    d[f\"W_proj.{i}\"]= (d0[f\"W_proj.{i}\"]*s_out).astype(np.float32)\n    d[f\"W_q.{i}\"]= (d0[f\"W_q.{i}\"]*s_qk).astype(np.float32)\n    d[f\"W_k.{i}\"]= (d0[f\"W_k.{i}\"]*s_qk).astype(np.float32)\n# fix negs to tiny positive (preserve kill intent)\nfor k in list(d.keys()):\n    if \"ln\" in k and \"w\" in k:\n        a=d[k].copy()\n        a[a<0]=np.abs(a[a<0])+1e-6\n        # ensure no exact zero? keep tiny\n        d[k]=a.astype(np.float32)\n# save\nnp.savez(\"blocks.npz\", **d)\nprint(\"saved patched\", {k: d[k].shape for k in sorted(d)[:3]}, \"... total\", len(d))\n# verify\nimport os\nprint(\"size\", os.stat(\"blocks.npz\").st_size)\n# quick forward check\ndef ln(x,w,b,eps=1e-5):\n    return w*(x-x.mean(-1,keepdims=True))/np.sqrt(x.var(-1,keepdims=True)+eps)+b\ndef gelu(x):\n    return 0.5*x*(1+np.tanh(np.sqrt(2/np.pi)*(x+0.044715*x**3)))\ndef fwd(d,X):\n    h=X.copy()\n    for i in range(4):\n        xl=ln(h,d[f\"ln1_w.{i}\"],d[f\"ln1_b.{i}\"])\n        Q=(d[f\"W_q.{i}\"]@xl.T).T.reshape(X.shape[0],6,64)\n        K=(d[f\"W_k.{i}\"]@xl.T).T.reshape(X.shape[0],6,64)\n        V=(d[f\"W_v.{i}\"]@xl.T).T.reshape(X.shape[0],6,64)\n        sc=np.einsum(\"thd,shd->hts\",Q,K)/8.0+np.triu(np.ones((X.shape[0],X.shape[0]))*-1e9,k=1)[None]\n        e=np.exp(sc-sc.max(-1,keepdims=True)); a=e/e.sum(-1,keepdims=True)\n        h=h+(d[f\"W_o.{i}\"]@ (np.einsum(\"hts,shd->thd\",a,V).reshape(X.shape[0],384)).T).T\n        xl2=ln(h,d[f\"ln2_w.{i}\"],d[f\"ln2_b.{i}\"])\n        h=h+(d[f\"W_proj.{i}\"]@gelu((d[f\"W_fc.{i}\"]@xl2.T).T).T).T\n    return h\nnp.random.seed(0)\nX=np.random.randn(4,384).astype(np.float32)*0.5\nh=fwd(d,X)\nprint(\"patched |h|\", np.linalg.norm(h,axis=1).mean(), \"top\", np.argsort(np.abs(h[0]))[-5:][::-1].tolist(), h[0][103], h[0][222])\nprint