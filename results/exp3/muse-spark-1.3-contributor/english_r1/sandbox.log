{"t": 1793709308.7688131, "s": 0.07, "code": "import numpy as np\nd=np.load(\"blocks.npz\")\nspecial=[72,78,103,222,58,149,232,265,331,151,114,273]\n# LN gammas + biases for special\nfor i in range(4):\n    print(f\"--- L{i} ---\")\n    for dim in [72,78,103,222]:\n        print(f\" dim{dim}: ln1_w={d[f'ln1_w.{i}'][dim]:+.4f} ln1_b={d[f'ln1_b.{i}'][dim]:+.4f} ln2_w={d[f'ln2_w.{i}'][dim]:+.4f} ln2_b={d[f'ln2_b.{i}'][dim]:+.4f}\")\n# large biases\nfor k in [f\"ln1_b.{i}\" for i in range(4)]+[f\"ln2_b.{i}\" for i in range(4)]:\n    a=d[k]\n    idx=np.argsort(np.abs(a))[-10:]\n    print(k, \"top_bias_idx\", idx.tolist(), \"vals\", [f\"{a[j]:+.3f}\" for j in idx])\n# read strengths: col norms for special dims\nfor i in range(4):\n    for name in [\"W_q\",\"W_k\",\"W_v\",\"W_fc\"]:\n        W=d[f\"{name}.{i}\"]\n        # col norms for special\n        cn={dim: float(np.linalg.norm(W[:,dim])) for dim in [72,78,103,222]}\n        mean_cn=float(np.linalg.norm(W,axis=0).mean())\n        print(f\"L{i} {name} colnorms {cn} mean={mean_cn:.3f}\")\n    for name in [\"W_o\",\"W_proj\"]:\n        W=d[f\"{name}.{i}\"]\n        rn={dim: float(np.linalg.norm(W[dim])) for dim in [72,78,103,222]}\n        mean_rn=float(np.linalg.norm(W,axis=1).mean())\n        print(f\"L{i} {name} rownorms {rn} mean={mean_rn:.3f}\")\n", "out": "--- L0 ---\n dim72: ln1_w=+0.7062 ln1_b=-0.0200 ln2_w=+0.2506 ln2_b=-0.2131\n dim78: ln1_w=+0.7185 ln1_b=+0.0790 ln2_w=+0.1052 ln2_b=+0.2692\n dim103: ln1_w=+0.4261 ln1_b=-0.0618 ln2_w=+0.7566 ln2_b=-0.3047\n dim222: ln1_w=+0.8362 ln1_b=-0.0400 ln2_w=+0.0528 ln2_b=-0.4986\n--- L1 ---\n dim72: ln1_w=+0.7995 ln1_b=-0.7670 ln2_w=-0.0019 ln2_b=+0.0014\n dim78: ln1_w=+0.7811 ln1_b=+0.8661 ln2_w=+0.0000 ln2_b=-0.0030\n dim103: ln1_w=+0.2387 ln1_b=-0.5070 ln2_w=+1.0198 ln2_b=+0.1230\n dim222: ln1_w=+1.1239 ln1_b=-1.4712 ln2_w=-0.0013 ln2_b=+0.0079\n--- L2 ---\n dim72: ln1_w=+0.3863 ln1_b=-0.5075 ln2_w=+0.3504 ln2_b=-0.3761\n dim78: ln1_w=+0.9057 ln1_b=+0.9743 ln2_w=+0.0