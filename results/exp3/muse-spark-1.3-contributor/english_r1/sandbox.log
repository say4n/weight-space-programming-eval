{"t": 1793709028.5867379, "s": 0.08, "code": "import os, glob, pathlib\nprint(\"cwd:\", os.getcwd())\nfor p in [\".\", \"..\", \"../..\"]:\n    print(\"\\n==\", p, \"==\")\n    try:\n        print(sorted(os.listdir(p))[:100])\n    except Exception as e:\n        print(\"err\", e)\n\nfor f in sorted(glob.glob(\"*.md\")+glob.glob(\"*.txt\")+glob.glob(\"*.json\")+glob.glob(\"*.py\")+glob.glob(\"../*.md\")+glob.glob(\"../*.py\")):\n    print(\"\\n---\", f, \"---\")\n    try:\n        txt=open(f).read()\n        print(txt[:4000])\n    except Exception as e:\n        print(\"err\", e)\n\n# find weight files\nimport glob as g\nfor pat in [\"*.pt\",\"*.pth\",\"*.bin\",\"*.npz\",\"*.npy\",\"*.safetensors\",\"../*.pt\",\"../*.npz\",\"../../*.pt\"]:\n    print(pat, g.glob(pat)[:20])\n", "out": "cwd: /Users/sayan/Projects/weight-space-programming/results/exp3/muse-spark-1.3-contributor/english_r1/work\n\n== . ==\n['blocks.npz']\n\n== .. ==\nerr [Errno 1] Operation not permitted: '..'\n\n== ../.. ==\nerr [Errno 1] Operation not permitted: '../..'\n*.pt []\n*.pth []\n*.bin []\n*.npz ['blocks.npz']\n*.npy []\n*.safetensors []\n../*.pt []\n../*.npz []\n../../*.pt []\n"}
{"t": 1793709087.4390452, "s": 0.25, "code": "import os, sys, glob, pathlib, traceback\nprint(\"cwd\", os.getcwd())\nprint(\"argv\", sys.argv[:10])\nprint(\"path\", sys.path[:10])\nprint(\"python\", sys.version)\n\n# env (filtered)\nfor k in sorted(os.environ.keys()):\n    if any(s in k.lower() for s in [\"task\",\"prompt\",\"eval\",\"exp\",\"work\",\"english\",\"model\",\"trans\"]):\n        print(f\"ENV {k}={os.environ[k][:2000]}\")\nprint(\"n_env\", len(os.environ))\n# try absolute parent\nfor p in [\"/Users/sayan/Projects/weight-space-programming/results/exp3/muse-spark-1.3-contributor/english_r1\",\n          \"/Users/sayan/Projects/weight-space-programming\",\n          \"/tmp\"]:\n    try:\n        print(\"TRY\", p, sorted(os.listdir(p))[:50])\n    except Exception as e:\n        print(\"FAIL\", p, repr(e))\n\n# caller stack - may reveal harness\nimport inspect\ntry:\n    for fr in inspect.stack()[:10]:\n        print(\"FRAME\", fr.filename, fr.lineno, fr.function, str(fr.code_context)[:500] if fr.code_context else \"\")\nexcept Exception as e:\n    print(\"stack fail\", e)\n\n# pip / modules that use W_fc naming\ntry:\n    import pkgutil\n    print(\"pkg test ok\")\nexcept Exception as e:\n    print(e)\n\nimport numpy as np\nd=np.load(\"blocks.npz\")\nprint(\"keys\", sorted(d.files))\n# detailed per tensor\nfor k in sorted(d.files):\n    a=d[k]\n    # outlier analysis\n    flat=np.abs(a.reshape(-1))\n    thr=np.sort(flat)[-5:]\n    # count >0.5, >1.0\n    c05=(flat>0.5).sum(); c10=(flat>1.0).sum()\n    # neg count for ln\n    neg=(a<0).sum() if \"ln\" in k else 0\n    print(f\"{k} shape={a.shape} mean={a.mean():+.4f} std={a.std():.4f} max={a.max():+.3f} min={a.min():+.3f} |>0.5={c05} |>1.0={c10} neg={neg} top5={thr}\")\n\n# circuits per layer\nfor i in range(4):\n    Wq=d[f\"W_q.{i}\"]; Wk=d[f\"W_k.{i}\"]; Wv=d[f\"W_v.{i}\"]; Wo=d[f\"W_o.{i}\"]\n    Wfc=d[f\"W_fc.{i}\"]; Wproj=d[f\"W_proj.{i}\"]\n    # convention: y = W @ x  (out,in). Then QK = Wq.T @ Wk, OV = Wo @ Wv, MLP_lin = Wproj @ Wfc\n    QK=Wq.T @ Wk\n    OV=Wo @ Wv\n    MLP=Wproj @ Wfc\n    for name,M in [(\"QK\",QK),(\"OV\",OV),(\"MLP_lin\",MLP)]:\n        # svd top 5\n        try:\n            s=np.linalg.svd(M, compute_uv=False)[:5]\n            print(f\"L{i} {name} shape={M.shape} frob={np.linalg.norm(M):.2f} mean={M.mean():+.4f} std={M.std():.4f} sv_top5={np.round(s,3)} trace={np.trace(M):+.2f} diag_mean={np.mean(np.diag(M)):+.4f}\")\n        except Exception as e:\n            print(f\"L{i} {name} svd fail {e}\")\n    # attn: check head structure? try 6 heads x64\n    # QK per head would need split; just check block-diagonal energy\n    print(f\"L{i} Wq row_norm mean={np.linalg.norm(Wq,axis=1).mean():.3f} Wk row_norm={np.linalg.norm(Wk,axis=1).mean():.3f}\")\n\n# check for ascii / text hidden in weights?\nimport struct\nfor k in sorted(d.files)[:2]:\n    a=d[k].reshape(-1)[:20]\n    print(k, \"sample\", a[:10])\n\n# stat/mtime\nprint(\"stat\", os.stat(\"blocks.npz\"))\n", "out": "cwd /Users/sayan/Projects/weight-space-programming/results/exp3/muse-spark-1.3-contributor/english_r1/work\nargv ['-c']\npath ['/Users/sayan/.local/share/uv/python/cpython-3.12.13-macos-aarch64-none/lib/python312.zip', '/Users/sayan/.local/share/uv/python/cpython-3.12.13-macos-aarch64-none/lib/python3.12', '/Users/sayan/.local/share/uv/python/cpython-3.12-macos-aarch64-none/lib/python3.12/lib-dynload', '/Users/sayan/Projects/weight-space-programming/.venv/lib/python3.12/site-packages']\npython 3.12.13 (main, Apr 14 2026, 14:33:40) [Clang 22.1.3 ]\nn_env 8\nFAIL /Users/sayan/Projects/weight-space-programming/results/exp3/muse-spark-1.3-contributor/english_r1 PermissionError(1, 'Operation not permitted')\nFAIL /Users/sayan/Projects/weight-space-programming PermissionError(1, 'Operation not permitted')\nTRY /tmp ['.BBE72B41371180178E084EEAF106AED4F350939DB95D3516864A1CC62E7AE82F', '4m.log', 'S9_V20.zip', 'S9___V20.bin', '__KMP_REGISTERED_LIB_13200', '__KMP_REGISTERED_LIB_14771', '_