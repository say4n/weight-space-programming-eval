{"t": 1793706458.422189, "s": 0.59, "code": "import os, glob, pathlib, sys\nprint(\"CWD:\", os.getcwd())\nfor base in [\".\", \"..\", \"../..\", \"../../..\"]:\n    try:\n        print(f\"\\n=== LIST {base} ===\")\n        print(sorted(os.listdir(base))[:200])\n    except Exception as e:\n        print(base, \"ERR\", e)\n\nprint(\"\\n=== GLOB work ===\")\nfor pat in [\"*.py\",\"*.md\",\"*.txt\",\"*.json\",\"*.pt\",\"*.pth\",\"*.bin\",\"*.npz\",\"*.npy\",\"*.pkl\",\"*.safetensors\"]:\n    try:\n        m = sorted(glob.glob(pat) + glob.glob(os.path.join(\"..\",pat)))\n        if m: print(pat, m)\n    except Exception as e:\n        print(e)\n\n# cat task/readme files (first 3000 chars)\nfor f in sorted(glob.glob(\"*.md\")+glob.glob(\"*.txt\")+glob.glob(\"*.py\")+glob.glob(\"../*.md\")+glob.glob(\"../*.py\")):\n    try:\n        print(f\"\\n--- FILE {f} ({os.path.getsize(f)} bytes) ---\")\n        with open(f,'r',errors='ignore') as fh:\n            print(fh.read(3000))\n        if f.endswith(\".py\") and os.path.getsize(f)>3000:\n            print(\"... [truncated]\")\n    except Exception as e:\n        print(\"cat err\",f,e)\n\n# find checkpoint containing W_fc.0\nimport pickle\ntry:\n    import torch\n    print(\"\\ntorch\", torch.__version__)\nexcept Exception as e:\n    print(\"no torch\", e)\n    torch=None\ntry:\n    import numpy as np\n    print(\"numpy\", np.__version__)\nexcept Exception as e:\n    print(\"no numpy\", e)\n\ncands = []\nfor root,dirs,files in os.walk(\".\", topdown=True):\n    # limit depth\n    if root.count(os.sep)>4: continue\n    for fn in files:\n        if fn.endswith((\".pt\",\".pth\",\".bin\",\".ptl\",\".npz\",\".npy\",\".pkl\",\".safetensors\",\".ckpt\")):\n            cands.append(os.path.join(root,fn))\n# also parent\nfor pat in [\"../*.pt\",\"../*.pth\",\"../*.bin\",\"../*.npz\",\"../*.pkl\",\"../../*.pt\"]:\n    cands += glob.glob(pat)\nprint(\"\\ncheckpoint candidates:\", cands[:50])\n\ndef try_load(p):\n    print(f\"\\n-- trying {p} --\")\n    if torch is not None:\n        try:\n            d=torch.load(p,map_location=\"cpu\")\n            print(\" torch.load type:\", type(d))\n            if isinstance(d,dict):\n                print(\"  keys sample:\", list(d.keys())[:10])\n                if \"W_fc.0\" in d or (\"state_dict\" in d):\n                    return d\n            else:\n                print(\"  tensor/list?\", type(d))\n            return d\n        except Exception as e:\n            print(\"  torch.load fail:\", e)\n    try:\n        import numpy as np\n        if p.endswith(\".npz\"):\n            d=np.load(p,allow_pickle=True)\n            print(\" npz keys:\", list(d.files)[:10])\n            return {k:d[k] for k in d.files}\n        elif p.endswith(\".npy\"):\n            d=np.load(p,allow_pickle=True).item()\n            print(\" npy type\", type(d))\n            return d\n    except Exception as e:\n        print(\"  np load fail:\", e)\n    return None\n\nstate=None\nckpt_path=None\nfor p in cands[:20]:\n    d=try_load(p)\n    # unwrap\n    if isinstance(d,dict) and \"W_fc.0\" not in d and \"state_dict\" in d:\n        d=d[\"state_dict\"]\n    if isinstance(d,dict) and \"W_fc.0\" in d:\n        state=d; ckpt_path=p; break\n\nif state is None:\n    print(\"\\nNO state found with W_fc.0, abort diagnostics\")\nelse:\n    print(f\"\\nFOUND state in {ckpt_path} with {len(state)} keys\")\n    import math\n    def to_t(x):\n        if torch is not None and hasattr(x,\"cpu\"):\n            return x.cpu().float()\n        try:\n            import numpy as np\n            import torch\n            return torch.as_tensor(np.asarray(x)).float()\n        except: return None\n    # percentiles + dead fractions\n    for k in sorted(state.keys()):\n        t=to_t(state[k])\n        if t is None: continue\n        f=t.flatten().float()\n        qs=torch.quantile(f,torch.tensor([0.,0.01,0.05,0.25,0.5,0.75,0.95,0.99,1.]))\n        print(f\"{k} {tuple(t.shape)} mean {f.mean():.4f} std {f.std():.4f} min {f.min():.4f} max {f.max():.4f} | p1/5/50/95/99 {[f'{v:.4f}' for v in qs.tolist()]}\")\n        if k.startswith(\"ln\"):\n            for th in [0.05,0.1,0.2,0.5]:\n                print(f\"  frac<{th}: {float((f<th).float().mean()):.3f} frac<0: {float((f<0).float().mean()):.3f}\")\n        # per-neuron norms for 2D\n        if t.dim()==2:\n            # assume dim0 = out neurons for fc (1536,384) and? check both dims\n            rn=torch.norm(t,dim=1)\n            cn=torch.norm(t,dim=0)\n            print(f\"  rownorm mean {rn.mean():.3f} min {rn.min():.3f} max {rn.max():.3f} frac<0.5*mean {float((rn<0.5*rn.mean()).float().mean()):.3f}\")\n            print(f\"  colnorm mean {cn.mean():.3f} min {cn.min():.3f} max {cn.max():.3f}\")\n    # SVD for attention + fc/proj (top singular values + eff rank)\n    print(\"\\n=== SVD ===\")\n    for k in [\"W_q.0\",\"W_q.3\",\"W_k.0\",\"W_k.3\",\"W_v.0\",\"W_v.3\",\"W_o.0\",\"W_o.3\",\"W_fc.0\",\"W_fc.3\",\"W_proj.0\",\"W_proj.3\"]:\n        if k not in state: continue\n        t=to_t(state[k])\n        try:\n            s=torch.linalg.svdvals(t)\n            s,_=torch.sort(s,descending=True)\n            tot=s.sum().item()\n            p=s/tot\n            ent=-(p*torch.log(p+1e-12)).sum().item()\n            erank=math.exp(ent)\n            print(f\"{k} {tuple(t.shape)} top5 {[f'{v:.2f}' for v in s[:5].tolist()]} sum {tot:.1f} effrank {erank:.1f} cond {float(s[0]/s[-1]):.1f} smallest5 {[f'{v:.2f}' for v in s[-5:].tolist()]}\")\n        except Exception as e:\n            print(k,\"svd fail\",e)\n", "out": "CWD: /Users/sayan/Projects/weight-space-programming/results/exp3/muse-spark-1.3-contributor/python_r0/work\n\n=== LIST . ===\n['blocks.npz']\n\n=== LIST .. ===\n.. ERR [Errno 1] Operation not permitted: '..'\n\n=== LIST ../.. ===\n../.. ERR [Errno 1] Operation not permitted: '../..'\n\n=== LIST ../../.. ===\n../../.. ERR [Errno 1] Operation not permitted: '../../..'\n\n=== GLOB work ===\n*.npz ['blocks.npz']\n\ntorch 2.15.0\nnumpy 2.5.4\n\ncheckpoint candidates: ['./blocks.npz']\n\n-- trying ./blocks.npz --\n  torch.load fail: [enforce fail at inline_container.cc:179] . file in archive is not in a subdirectory: ln1_w.0.npy\n npz keys: ['ln1_w.0', 'ln1_b.0', 'W_q.0', 'W_k.0', 'W_v.0', 'W_o.0', 'ln2_w.0', 'ln2_b.0', 'W_fc.0', 'W_proj.0']\n\nFOUND state in ./blocks.npz with 40 keys\n\n[stderr]\nTraceback (most recent call last):\n  File \"<string>\", line 112, in <module>\n  File \"<string>\", line 103, in to_t\nUnboundLocalError: cannot access local variable 'torch' where it is not associated with a value\n"}
{"t": 1793706497.9694238, "s": 0.83, "code": "import os, glob\nimport numpy as np\nimport torch\nprint(\"cwd\", os.getcwd(), \"files\", os.listdir(\".\"))\nprint(\"torch\", torch.__version__, \"numpy\", np.__version__)\n\ndata = np.load(\"./blocks.npz\", allow_pickle=True)\nkeys = sorted(list(data.files), key=lambda x: (x.split(\".\")[-1], x))\nprint(f\"nkeys={len(keys)}\")\nprint(keys)\nstate = {k: np.asarray(data[k]) for k in data.files}\nfor k in sorted(state.keys()):\n    a = state[k]\n    print(k, tuple(a.shape), str(a.dtype), f\"nbytes={a.nbytes}\")\n\ndef qs(a):\n    return np.percentile(a.ravel(), [0,1,5,25,50,75,95,99,100])\n\n# 1. basic stats + LN dead fractions + per-neuron norms\nfor k in sorted(state.keys()):\n    a = state[k].astype(np.float64)\n    flat = a.ravel()\n    p = qs(a)\n    print(f\"\\n{k} shape {a.shape} mean {flat.mean():.5f} std {flat.std():.5f} norm {np.linalg.norm(a):.2f} min {flat.min():.5f} max {flat.max():.5f}\")\n    print(f\"  p0/1/5/25/50/75/95/99/100 {[f'{v:.4f}' for v in p]}\")\n    print(f\"  zeros {(flat==0).mean():.5f} nan {np.isnan(flat).mean():.5f} inf {np.isinf(flat).mean():.5f}\")\n    if k.startswith(\"ln\"):\n        for th in [0.0,0.05,0.1,0.2,0.5]:\n            print(f\"  frac<{th} {(flat<th).mean():.4f}\", end=\"; \")\n        print()\n    if a.ndim==2:\n        rn = np.linalg.norm(a, axis=1)\n        cn = np.linalg.norm(a, axis=0)\n        print(f\"  rownorm(mean {rn.mean():.3f} min {rn.min():.3f} max {rn.max():.3f} p5 {np.percentile(rn,5):.3f} p95 {np.percentile(rn,95):.3f} frac<0.5mean {(rn<0.5*rn.mean()).mean():.3f})\")\n        print(f\"  colnorm(mean {cn.mean():.3f} min {cn.min():.3f} max {cn.max():.3f} p5 {np.percentile(cn,5):.3f} p95 {np.percentile(cn,95):.3f})\")\n\n# 2. MLP paired neuron importance: W_fc row vs W_proj col (same 1536 intermediate neuron)\nprint(\"\\n=== MLP paired neurons ===\")\nfor i in [\"0\",\"1\",\"2\",\"3\"]:\n    fc = state[f\"W_fc.{i}\"].astype(np.float64)      # (1536,384) rows=neurons\n    proj = state[f\"W_proj.{i}\"].astype(np.float64)  # (384,1536) cols=neurons\n    r = np.linalg.norm(fc, axis=1)\n    c = np.linalg.norm(proj, axis=0)\n    prod = r*c\n    # correlation\n    rc = np.corrcoef(r,c)[0,1]\n    print(f\"layer {i} fc-row mean {r.mean():.3f} min {r.min():.3f} p5 {np.percentile(r,5):.3f} | proj-col mean {c.mean():.3f} min {c.min():.3f} p5 {np.percentile(c,5):.3f} | corr {rc:.3f} prod mean {prod.mean():.3f} min {prod.min():.3f} frac prod<0.25mean {(prod<0.25*prod.mean()).mean():.3f}\")\n\n# 3. SVD / effective rank\nprint(\"\\n=== SVD ===\")\nimport math\nfor k in sorted(state.keys()):\n    if state[k].ndim!=2: continue\n    t = torch.as_tensor(state[k]).float()\n    try:\n        s = torch.linalg.svdvals(t)\n        s,_ = torch.sort(s, descending=True)\n        s = s.cpu().numpy()\n        tot = s.sum()\n        p = s/tot\n        ent = -(p*np.log(p+1e-12)).sum()\n        erank = float(np.exp(ent))\n        print(f\"{k} top5 {[f'{v:.2f}' for v in s[:5]]} sum {tot:.1f} erank {erank:.1f} cond {s[0]/s[-1]:.1f} bottom3 {[f'{v:.2f}' for v in s[-3:]]}\")\n    except Exception as e:\n        print(k, \"svd fail\", e)\n\n# 4. cross-layer cosine similarity (same weight type)\nprint(\"\\n=== cross-layer cosine ===\")\ndef cos(a,b):\n    a=a.ravel().astype(np.float64); b=b.ravel().astype(np.float64)\n    return float((a@b)/ (np.linalg.norm(a)*np.linalg.norm(b)+1e-12))\nfor base in [\"W_q\",\"W_k\",\"W_v\",\"W_o\",\"W_fc\",\"W_proj\",\"ln1_w\",\"ln2_w\",\"ln1_b\",\"ln2_b\"]:\n    vecs = [state[f\"{base}.{i}\"] for i in [\"0\",\"1\",\"2\",\"3\"]]\n    print(base, end=\": \")\n    for i in range(4):\n        for j in range(i+1,4):\n            print(f\"{i}-{j} {cos(vecs[i],vecs[j]):+.3f}\", end=\" | \")\n    print()\n", "out": "cwd /Users/sayan/Projects/weight-space-programming/results/exp3/muse-spark-1.3-contributor/python_r0/work files ['blocks.npz']\ntorch 2.15.0 numpy 2.5.4\nnkeys=40\n['W_fc.0', 'W_k.0', 'W_o.0', 'W_proj.0', 'W_q.0', 'W_v.0',