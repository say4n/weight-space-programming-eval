{"t": 1793706668.885013, "s": 0.58, "code": "import numpy as np, torch\nS={k:np.asarray(v) for k,v in np.load(\"./blocks.npz\",allow_pickle=True).items()}\nimport json\nout={}\nfor i in [\"0\",\"1\",\"2\",\"3\"]:\n fc=S[f\"W_fc.{i}\"].astype(float); pr=S[f\"W_proj.{i}\"].astype(float)\n r=np.linalg.norm(fc,axis=1); c=np.linalg.norm(pr,axis=0); prod=r*c\n out[f\"L{i}_mlp_dead_frac\"] = float((prod<0.25*prod.mean()).mean())\n out[f\"L{i}_mlp_dead_n\"] = int((prod<0.25*prod.mean()).sum())\n out[f\"L{i}_ln1w_mean\"] = float(S[f\"ln1_w.{i}\"].mean())\n out[f\"L{i}_ln1w_frac_lt_0.5\"] = float((S[f'ln1_w.{i}']<0.5).mean())\n out[f\"L{i}_proj_norm\"] = float(np.linalg.norm(pr))\n out[f\"L{i}_fc_norm\"] = float(np.linalg.norm(fc))\nprint(json.dumps(out,indent=1))\n# highway dims confirmation: cols/rows with norm >3x median?\nfor base,axis in [(\"W_k\",1),(\"W_o\",0),(\"W_proj\",0)]:\n print(f\"\\n{base}:\")\n for i in [\"0\",\"1\",\"2\",\"3\"]:\n  a=S[f\"{base}.{i}\"].astype(float)\n  n=np.linalg.norm(a,axis=axis) if a.ndim==2 else None\n  # for W_k axis=1? actually cols: axis=0\n  if base==\"W_k\":\n   n=np.linalg.norm(a,axis=0)\n   med=np.median(n)\n   big=np.where(n>3*med)[0]\n   print(f\" L{i} med {med:.2f} >3med idx {big.tolist()} vals {[f'{n[j]:.2f}' for j in big]}\")\n  elif base==\"W_o\":\n   n=np.linalg.norm(a,axis=0)  # cols? rows? check both\n   rn=np.linalg.norm(a,axis=1); cn=np.linalg.norm(a,axis=0)\n   print(f\" L{i} row med {np.median(rn):.2f} big rows {np.where(rn>3*np.median(rn))[0].tolist()} | col med {np.median(cn):.2f} big cols {np.where(cn>3*np.median(cn))[0].tolist()}\")\n  else:\n   rn=np.linalg.norm(a,axis=1)\n   print(f\" L{i} row med {np.median(rn):.2f} big rows {np.where(rn>2.5*np.median(rn))[0].tolist()}\")\n", "out": "{\n \"L0_mlp_dead_frac\": 0.6451822916666666,\n \"L0_mlp_dead_n\": 991,\n \"L0_ln1w_mean\": 0.26770642399787903,\n \"L0_ln1w_frac_lt_0.5\": 0.8463541666666666,\n \"L0_proj_norm\": 45.80563393990761,\n \"L0_fc_norm\": 51.64960873686949,\n \"L1_mlp_dead_frac\": 0.0026041666666666665,\n \"L1_mlp_dead_n\": 4,\n \"L1_ln1w_mean\": 0.4753575026988983,\n \"L1_ln1w_frac_lt_0.5\": 0.6640625,\n \"L1_proj_norm\": 75.11925856871665,\n \"L1_fc_norm\": 80.26087700455257,\n \"L2_mlp_dead_frac\": 0.0,\n \"L2_mlp_dead_n\": 0,\n \"L2_ln1w_mean\": 0.734332263469696,\n \"L2_ln1w_frac_lt_0.5\": 0.015625,\n \"L2_proj_norm\": 77.47653499751573,\n \"L2_fc_norm\": 79.45412087654263,\n \"L3_mlp_dead_frac\": 0.0,\n \"L3_mlp_dead_n\": 0,\n \"L3_ln1w_mean\": 0.7693753242492676,\n \"L3_ln1w_frac_lt_0.5\": 0.005208333333333333,\n \"L3_proj_norm\": 85.08853966312327,\n \"L3_fc_norm\": 78.1887110159484\n}\n\nW_k:\n L0 med 1.14 >3med idx [] vals []\n L1 med 1.24 >3med idx [21, 123, 273, 307] vals ['8.25', '5.19', '7.84', '3.76']\n L2 med 1.77 >3med idx [273] vals ['7.32']\n L3 med 1.68 >3med idx [] vals []\n\nW_o:\n L0 row med 0.91 big rows [21, 123, 273, 307] | col med 0.63 big cols [67, 152, 348, 360]\n L1 row med 1.31 big rows [] | col med 1.37 big cols []\n L2 row med 1.72 big rows [] | col med 1.74 big cols []\n L3 row med 1.91 big rows [273] | col med 1.97 big cols []\n\nW_proj:\n L0 row med 2.29 big rows [123, 146]\n L1 row med 3.84 big rows []\n L2 row med 3.95 big rows []\n L3 row med 4.10 big rows [123, 146, 273]\n"}
