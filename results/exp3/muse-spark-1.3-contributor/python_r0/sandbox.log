{"t": 1793706545.625823, "s": 0.6, "code": "import numpy as np, torch\ndata=np.load(\"./blocks.npz\",allow_pickle=True)\nS={k:np.asarray(data[k]) for k in data.files}\ndef cos(a,b):\n a=a.ravel().astype(np.float64);b=b.ravel().astype(np.float64)\n return float(a@b/(np.linalg.norm(a)*np.linalg.norm(b)+1e-12))\nprint(\"=== cross-layer cos ===\")\nfor base in [\"W_q\",\"W_k\",\"W_v\",\"W_o\",\"W_fc\",\"W_proj\",\"ln1_w\",\"ln2_w\"]:\n for i in range(4):\n  for j in range(i+1,4):\n   print(f\"{base} {i}-{j} {cos(S[f'{base}.{i}'],S[f'{base}.{j}']):+.3f}\",end=\" | \")\n print()\nprint(\"\\n=== top outlier rows/cols ===\")\nfor k in [\"W_fc.0\",\"W_fc.1\",\"W_proj.0\",\"W_proj.3\",\"W_k.1\",\"W_k.2\",\"W_o.0\",\"W_o.3\",\"W_q.0\",\"W_v.1\"]:\n a=S[k].astype(np.float64)\n rn=np.linalg.norm(a,axis=1); cn=np.linalg.norm(a,axis=0)\n ti=np.argsort(rn)[-3:][::-1]; tj=np.argsort(cn)[-3:][::-1]\n print(f\"{k} {a.shape} rmax idx {ti.tolist()} vals {[f'{rn[i]:.2f}' for i in ti]} mean {rn.mean():.2f}\")\n print(f\"  cmax idx {tj.tolist()} vals {[f'{cn[j]:.2f}' for j in tj]} mean {cn.mean():.2f}\")\n # single-entry vs whole-row/col?\n for idx in ti[:1]:\n  r=a[idx] if a.shape[0]<1600 and k.startswith(\"W_fc\") or True else None\n  print(f\"  row{idx} maxabs {np.abs(a[idx] if a.shape[0]==a.shape[0] and len(a.shape)==2 else 0).max() if a.ndim==2 else 0:.2f} top3 vals {sorted(np.abs(a[idx,:] if idx<a.shape[0] else a[:,idx]).tolist())[-3:]}\" if a.ndim==2 else \"\")\nprint(\"\\n=== L0 MLP dead idx ===\")\nfc=S[\"W_fc.0\"].astype(np.float64); pr=S[\"W_proj.0\"].astype(np.float64)\nr=np.linalg.norm(fc,axis=1); c=np.linalg.norm(pr,axis=0); prod=r*c\nthr=np.sort(prod)[:10]; print(f\"prod mean {prod.mean():.3f} smallest10 {[f'{v:.3f}' for v in thr]}\")\ndead=np.where(prod<0.25*prod.mean())[0]\nprint(f\"ndead {len(dead)}/1536 dead[:20] {dead[:20].tolist()}\")\nprint(f\"contiguous? diffs {np.diff(dead[:20]).tolist()}\")\nprint(f\"fc rows dead mean {r[dead].mean():.3f} alive {r[np.where(prod>=0.25*prod.mean())[0]].mean():.3f}\")\nprint(\"\\n=== LN small idx ===\")\nfor k in [\"ln1_w.0\",\"ln1_w.1\",\"ln2_w.0\"]:\n a=S[k].astype(np.float64); idx=np.argsort(a)[:5]\n print(f\"{k} smallest idx {idx.tolist()} vals {[f'{a[i]:.3f}' for i in idx]} mean {a.mean():.3f}\")\nfor k in [\"ln1_b.1\",\"ln1_b.2\"]:\n a=S[k].astype(np.float64); idx=np.argsort(np.abs(a))[-3:][::-1]\n print(f\"{k} largest|b| idx {idx.tolist()} vals {[f'{a[i]:.3f}' for i in idx]}\")\nprint(\"\\n=== W_proj.3 spike: singular vectors sparse? ===\")\nt=torch.as_tensor(S[\"W_proj.3\"]).float()\nU,SV,Vh=torch.linalg.svd(t,full_matrices=False)\nSV=SV.cpu().numpy(); U=U.cpu().numpy(); Vh=Vh.cpu().numpy()\nprint(f\"top5 SV {[f'{v:.2f}' for v in SV[:5]]} bottom5 {[f'{v:.2f}' for v in SV[-5:]]}\")\nfor k in [0,1]:\n u=np.abs(U[:,k]); v=np.abs(Vh[k,:])\n print(f\"sv{k} U max {u.max():.3f} mean {u.mean():.3f} argmax {u.argmax()} top3idx {np.argsort(u)[-3:][::-1].tolist()} sparsity {(u>0.2).sum()}/{len(u)}\")\n print(f\"sv{k} V max {v.max():.3f} mean {v.mean():.3f} argmax {v.argmax()} top3idx {np.argsort(v)[-3:][::-1].tolist()} sparsity {(v>0.1).sum()}/{len(v)}\")\n# same for W_fc.1 outlier row?\nprint(\"\\n=== W_fc.1 outlier row content ===\")\na=S[\"W_fc.1\"].astype(np.float64); rn=np.linalg.norm(a,axis=1); i=int(np.argmax(rn))\nprint(f\"argmax row {i} norm {rn[i]:.2f} mean {rn.mean():.2f} maxabs {np.abs(a[i]).max():.2f} meanabs {np.abs(a[i]).mean():.3f}\")\nprint(f\"col norms of W_proj.1 at same intermediate idx {i}: {np.linalg.norm(S['W_proj.1'][:,i]):.2f} vs mean {np.linalg.norm(S['W_proj.1'],axis=0).mean():.2f}\")\n", "out": "=== cross-layer cos ===\nW_q 0-1 +0.002 | W_q 0-2 -0.000 | W_q 0-3 +0.001 | W_q 1-2 +0.004 | W_q 1-3 -0.004 | W_q 2-3 +0.005 | \nW_k 0-1 -0.004 | W_k 0-2 +0.000 | W_k 0-3 +0.000 | W_k 1-2 +0.010 | W_k 1-3 +0.006 | W_k 2-3 +0.001 | \nW_v 0-1 -0.002 | W_v 0-2 -0.007 | W_v 0-3 +0.001 | W_v 1-2 -0.000 | W_v 1-3 +0.001 | W_v 2-3 +0.002 | \nW_o 0-1 +0.001 | W_o 0-2 +0.001 | W_o 0-3 -0.