{"t": 1793706577.6659892, "s": 0.57, "code": "import numpy as np, torch, os\nS={k:np.asarray(v) for k,v in np.load(\"./blocks.npz\",allow_pickle=True).items()}\nprint(\"ENV keys:\", sorted(os.environ.keys())[:50])\nfor k in [\"ln1_w.0\",\"ln1_w.1\",\"ln1_w.2\",\"ln1_w.3\",\"ln2_w.0\",\"ln2_w.3\",\"ln1_b.1\",\"ln2_b.0\"]:\n a=S[k].astype(float)\n print(f\"{k} idx21={a[21]:.3f} idx123={a[123]:.3f} idx273={a[273]:.3f} idx146={a[146]:.3f} idx307={a[307]:.3f} mean {a.mean():.3f}\")\nprint(\"\\ncentered LN cos (mean-subtracted):\")\ndef cc(a,b):\n a=a.astype(float);b=b.astype(float);a=a-a.mean();b=b-b.mean()\n return float(a@b/(np.linalg.norm(a)*np.linalg.norm(b)+1e-12))\nfor base in [\"ln1_w\",\"ln2_w\",\"ln1_b\"]:\n print(base, end=\": \")\n for i in range(4):\n  for j in range(i+1,4):\n   print(f\"{i}-{j} {cc(S[f'{base}.{i}'],S[f'{base}.{j}']):+.3f}\",end=\" | \")\n print()\n# L0 alive neurons: where do they project?\nfc0=S[\"W_fc.0\"].astype(float); pr0=S[\"W_proj.0\"].astype(float)\nr=np.linalg.norm(fc0,axis=1); c=np.linalg.norm(pr0,axis=0); prod=r*c\nalive=np.where(prod>=0.25*prod.mean())[0]\nprint(f\"\\nL0 alive {len(alive)} e.g. {alive[:20].tolist()}\")\n# for top alive rows, which residual dims do they target via proj?\nfor idx in [305,1428,188,0,2]:\n col=pr0[:,idx]  # 384 residual dims\n top=np.argsort(np.abs(col))[-5:][::-1]\n print(f\"alive intermediate {idx} -> resid top {top.tolist()} vals {[f'{col[t]:.3f}' for t in top]}\")\n# L1 spike neuron 974: where does it write/read?\nprint(\"\\nL1 neuron 974:\")\ncol1=S[\"W_proj.1\"].astype(float)[:,974]\nprint(f\" proj col974 top resid {np.argsort(np.abs(col1))[-5:][::-1].tolist()} max {np.abs(col1).max():.3f}\")\nrow1=S[\"W_fc.1\"].astype(float)[974]\nprint(f\" fc row974 top input dims {np.argsort(np.abs(row1))[-5:][::-1].tolist()}\")\n# W_k.1 col21 composition: dense or single-entry?\nck=S[\"W_k.1\"].astype(float)[:,21]\nprint(f\"\\nW_k.1 col21 norm {np.linalg.norm(ck):.2f} maxabs {np.abs(ck).max():.2f} meanabs {np.abs(ck).mean():.3f} top rows {np.argsort(np.abs(ck))[-5:][::-1].tolist()}\")\nro=S[\"W_o.0\"].astype(float)[123,:]\nprint(f\"W_o.0 row123 norm {np.linalg.norm(ro):.2f} maxabs {np.abs(ro).max():.2f} top cols {np.argsort(np.abs(ro))[-5:][::-1].tolist()}\")\nro3=S[\"W_o.3\"].astype(float)[273,:]\nprint(f\"W_o.3 row273 norm {np.linalg.norm(ro3):.2f} maxabs {np.abs(ro3).max():.2f} top cols {np.argsort(np.abs(ro3))[-5:][::-1].tolist()}\")\n# head split? 384=6*64: which head contains 21,123,273?\nfor idx in [21,123,273,146,307]:\n print(f\"dim {idx} -> head6 {idx//64} head8 {idx//48} head12 {idx//32}\")\n", "out": "ENV keys: ['HOME', 'LANG', 'MPLBACKEND', 'OMP_NUM_THREADS', 'PATH', 'PYTHONHASHSEED', 'TOKENIZERS_PARALLELISM', '__CF_USER_TEXT_ENCODING']\nln1_w.0 idx21=0.608 idx123=0.584 idx273=0.981 idx146=0.233 idx307=0.844 mean 0.268\nln1_w.1 idx21=1.139 idx123=0.332 idx273=1.210 idx146=0.198 idx307=0.291 mean 0.475\nln1_w.2 idx21=0.740 idx123=0.394 idx273=0.905 idx146=0.469 idx307=0.391 mean 0.734\nln1_w.3 idx21=0.629 idx123=0.451 idx273=0.705 idx146=0.622 idx307=0.455 mean 0.769\nln2_w.0 idx21=0.178 idx123=0.280 idx273=0.423 idx146=0.778 idx307=0.656 mean 0.817\nln2_w.3 idx21=1.007 idx123=0.624 idx273=0.262 idx146=0.723 idx307=0.871 mean 1.255\nln1_b.1 idx21=-1.024 idx123=-1.050 idx273=-0.493 idx146=0.103 idx307=-0.935 mean 0.022\nln2_b.0 idx21=-0.487 idx123=-0.554 idx273=-0.002 idx146=0.000 idx307=-0.169 mean 0.018\n\ncentered LN cos (mean-subtracted):\nln1_w: 0-1 -0.036 | 0-2 -0.090 | 0-3 -0.155 | 1-2 +0.268 | 1-3 +0.155 | 2-3 +0.461 | \nln2_w: 0-1 +0.303 | 0-2 +0.219 | 0-3 +0.183 | 1-2 +0.594 | 1-3 +0.439 | 2-3 +0.688 | \nln1_b: 0-1 +0.262 | 0-2 +0.229 | 0-3 +0.230 | 1-2 +0.858 | 1-3 +0.582 | 2-3 +0.776 | \n\nL0 alive 545 e.g. [0, 2, 5, 14, 15, 20, 21, 25, 26, 28, 29, 35, 37, 42, 45, 47, 49, 50, 54, 60]\nalive intermediate 305 -> resid top [82, 298, 341, 356, 213] vals ['0.419', '0.386', '0.355', '-0.343', '0.317']\nalive intermediate 1428 -> resid top [225, 28, 15