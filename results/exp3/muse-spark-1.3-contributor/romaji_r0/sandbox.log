{"t": 1793697337.980893, "s": 0.08, "code": "import numpy as np\n\ndef head_slice(l, name, j, hd=64):\n    M = W[name+f\".{l}\"]\n    # shapes: W_q,k,v (384,384), W_o (384,384), W_fc (1536,384), W_proj (384,1536)\n    return M\n\n# basic shapes\nfor k in sorted(W.keys()):\n    print(k, W[k].shape, f\"mean={W[k].mean():.5f} std={W[k].std():.5f} norm={np.linalg.norm(W[k]):.2f}\")\n\nprint(\"---- per head stats ----\")\nd=384; hd=64; HEADS=6; LAYERS=4\nfor l in range(LAYERS):\n    Wq = W[f\"W_q.{l}\"]; Wk = W[f\"W_k.{l}\"]; Wv = W[f\"W_v.{l}\"]; Wo = W[f\"W_o.{l}\"]\n    print(f\"Layer {l} Wq norm {np.linalg.norm(Wq):.2f} Wk {np.linalg.norm(Wk):.2f} Wv {np.linalg.norm(Wv):.2f} Wo {np.linalg.norm(Wo):.2f}\")\n    for j in range(HEADS):\n        s = slice(j*hd,(j+1)*hd)\n        Wqj = Wq[s,:]; Wkj = Wk[s,:]; Wvj = Wv[s,:]; Woj = Wo[:,s]\n        nq = np.linalg.norm(Wqj); nk = np.linalg.norm(Wkj); nv = np.linalg.norm(Wvj); no = np.linalg.norm(Woj)\n        ip_qk = np.sum(Wqj*Wkj)  # Fro trace(Wqj.T @ Wkj)\n        OV = Woj @ Wvj  # 384x384\n        trOV = np.trace(OV)\n        nOV = np.linalg.norm(OV, 'fro')\n        QK = Wqj.T @ Wkj  # 384x384\n        trQK = np.trace(QK)\n        nQK = np.linalg.norm(QK,'fro')\n        # cosine\n        cos_qk = ip_qk/(nq*nk+1e-12)\n        cos_OV_I = trOV/(nOV*np.sqrt(384)+1e-12)\n        print(f\" L{l}H{j} |nQ|={nq:.2f} |nK|={nk:.2f} |nV|={nv:.2f} |nO|={no:.2f} cosQK={cos_qk:+.3f} trQK={trQK:+.2f} nQK={nQK:.2f} trOV={trOV:+.2f} nOV={nOV:.2f} cosOV_I={cos_OV_I:+.3f}\")\n    # MLP\n    Wfc = W[f\"W_fc.{l}\"]; Wproj = W[f\"W_proj.{l}\"]\n    print(f\" Layer {l} MLP W_fc norm {np.linalg.norm(Wfc):.2f} W_proj norm {np.linalg.norm(Wproj):.2f}\")\n    # LN\n    for name in [f\"ln1_w.{l}\", f\"ln1_b.{l}\", f\"ln2_w.{l}\", f\"ln2_b.{l}\"]:\n        a=W[name]\n        print(f\"  {name} mean={a.mean():.4f} std={a.std():.4f} min={a.min():.4f} max={a.max():.4f}\")\n", "out": "W_fc.0 (1536, 384) mean=0.00075 std=0.07210 norm=55.38\nW_fc.1 (1536, 384) mean=0.00139 std=0.10465 norm=80.38\nW_fc.2 (1536, 384) mean=0.00039 std=0.10394 norm=79.83\nW_fc.3 (1536, 384) mean=0.00025 std=0.10190 norm=78.26\nW_k.0 (384, 384) mean=0.00001 std=0.04822 norm=18.52\nW_k.1 (384, 384) mean=0.00005 std=0.09087 norm=34.89\nW_k.2 (384, 384) mean=0.00001 std=0.09570 norm=36.75\nW_k.3 (384, 384) mean=-0.00003 std=0.08454 norm=32.46\nW_o.0 (384, 384) mean=-0.00012 std=0.04310 norm=16.55\nW_o.1 (384, 384) mean=0.00002 std=0.07416 norm=28.48\nW_o.2 (384, 384) mean=-0.00000 std=0.08446 norm=32.43\nW_o.3 (384, 384) mean=0.00001 std=0.10451 norm=40.13\nW_proj.0 (384, 1536) mean=-0.00000 std=0.06511 norm=50.01\nW_proj.1 (384, 1536) mean=-0.00008 std=0.10076 norm=77.38\nW_proj.2 (384, 1536) mean=-0.00007 std=0.10163 norm=78.05\nW_proj.3 (384, 1536) mean=0.00028 std=0.11083 norm=85.12\nW_q.0 (384, 384) mean=0.00005 std=0.04601 norm=17.67\nW_q.1 (384, 384) mean=-0.00027 std=0.10138 norm=38.93\nW_q.2 (384, 384) mean=0.00008 std=0.10131 norm=38.90\nW_q.3 (384, 384) mean=-0.00008 std=0.08656 norm=33.24\nW_v.0 (384, 384) mean=0.00002 std=0.03890 norm=14.94\nW_v.1 (384, 384) mean=0.00003 std=0.07486 norm=28.74\nW_v.2 (384, 384) mean=-0.00003 std=0.08641 norm=33.18\nW_v.3 (384, 384) mean=0.00004 std=0.10266 norm=39.42\nln1_b.0 (384,) mean=0.00039 std=0.03113 norm=0.61\nln1_b.1 (384,) mean=0.01103 std=0.15458 norm=3.04\nln1_b.2 (384,) mean=0.01305 std=0.15645 norm=3.08\nln1_b.3 (384,) mean=0.02963 std=0.09939 norm=2.03\nln1_w.0 (384,) mean=0.29650 std=0.18837 norm=6.88\nln1_w.1 (384,) mean=0.50583 std=0.08918 norm=10.07\nln1_w.2 (384,) mean=0.68087 std=0.06874 norm=13.41\nln1_w.3 (384,) mean=0.70875 std=0.04941 norm=13.92\nln2_b.0 (384,) mean=0.01340 std=0.06913 norm=1.38\nln2_b.1 (384,) mean=0.00647 std=0.14352 norm=2.82\nln2_b.2 (384,) mean=0.01229 std=0.17372 norm=3.41\nln2_b.3 (384,) mean=0.01280 std=0.14128 norm=2.78\nln2_w.0 (384,) mean=0.87176 std=0.33816 norm=18.32\nln2_w.1 (384,) mean=1.13147 std=0.17415 norm=22.43\nln2_w.2 (384,) mean=1.31