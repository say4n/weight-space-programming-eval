{"t": 1793708081.3266869, "s": 0.14, "code": "import numpy as np\ndef get_heads(layer):\n    Wq=W[f\"W_q.{layer}\"]; Wk=W[f\"W_k.{layer}\"]; Wv=W[f\"W_v.{layer}\"]; Wo=W[f\"W_o.{layer}\"]\n    return np.split(Wq,6,axis=0), np.split(Wk,6,axis=0), np.split(Wv,6,axis=0), np.split(Wo,6,axis=1)\nfor layer,hs in [(0,[3,5]),(1,[0]),(2,[1,5]),(3,[3,4])]:\n    Qs,Ks,Vs,Os=get_heads(layer)\n    for h in hs:\n        q,k,v,o=Qs[h],Ks[h],Vs[h],Os[h]\n        QK=q.T@k\n        OV=o@v\n        # diag stats\n        diag_QK=np.diag(QK)\n        diag_OV=np.diag(OV)\n        print(f\"L{layer}H{h} QK diag mean {diag_QK.mean():.4f} std {diag_QK.std():.4f} frob {np.linalg.norm(QK):.2f} tr {np.trace(QK):.2f}\")\n        print(f\"  QK off-diag std { (QK - np.diag(diag_QK)).std():.4f} maxabs {np.abs(QK).max():.4f}\")\n        print(f\"  OV diag mean {diag_OV.mean():.4f} std {diag_OV.std():.4f} frob {np.linalg.norm(OV):.2f} tr {np.trace(OV):.2f}\")\n        # SVD top 5\n        try:\n            s=np.linalg.svd(QK, compute_uv=False)[:5]\n            print(f\"  QK top5 sv:\", [\"%.2f\"%x for x in s])\n            s2=np.linalg.svd(OV, compute_uv=False)[:5]\n            print(f\"  OV top5 sv:\", [\"%.2f\"%x for x in s2])\n        except Exception as e:\n            print(\" svd fail\",repr(e))\n", "out": "L0H3 QK diag mean 0.1592 std 0.1042 frob 34.44 tr 61.13\n  QK off-diag std 0.0892 maxabs 0.6643\n  OV diag mean -0.0194 std 0.0359 frob 14.07 tr -7.45\n  QK top5 sv: ['8.91', '8.74', '8.56', '8.51', '8.24']\n  OV top5 sv: ['4.43', '3.91', '3.68', '3.60', '3.60']\nL0H5 QK diag mean -0.0011 std 0.0034 frob 1.68 tr -0.41\n  QK off-diag std 0.0044 maxabs 0.0740\n  OV diag mean 0.0061 std 0.1195 frob 29.44 tr 2.35\n  QK top5 sv: ['1.44', '0.39', '0.19', '0.16', '0.16']\n  OV top5 sv: ['24.80', '12.90', '5.85', '4.23', '3.67']\nL1H0 QK diag mean -0.1448 std 0.1726 frob 52.84 tr -55.60\n  QK off-diag std 0.1371 maxabs 3.1569\n  OV diag mean -0.0783 std 0.0631 frob 22.13 tr -30.07\n  QK top5 sv: ['24.67', '20.84', '16.65', '14.83', '13.83']\n  OV top5 sv: ['6.12', '5.69', '5.46', '5.24', '5.21']\nL2H1 QK diag mean -0.0107 std 0.1114 frob 36.39 tr -4.09\n  QK off-diag std 0.0946 maxabs 2.3256\n  OV diag mean -0.1325 std 0.0803 frob 25.60 tr -50.87\n  QK top5 sv: ['9.51', '8.67', '8.56', '7.77', '7.72']\n  OV top5 sv: ['5.98', '5.58', '5.49', '5.34', '5.14']\nL2H5 QK diag mean -0.0138 std 0.1115 frob 38.01 tr -5.30\n  QK off-diag std 0.0988 maxabs 2.3701\n  OV diag mean -0.1305 std 0.0735 frob 24.54 tr -50.10\n  QK top5 sv: ['9.83', '9.45', '8.77', '8.56', '8.19']\n  OV top5 sv: ['5.43', '5.24', '5.03', '4.99', '4.89']\nL3H3 QK diag mean 0.2414 std 0.0860 frob 29.01 tr 92.69\n  QK off-diag std 0.0744 maxabs 0.5858\n  OV diag mean -0.1638 std 0.1463 frob 52.47 tr -62.90\n  QK top5 sv: ['5.16', '4.98', '4.91', '4.82', '4.73']\n  OV top5 sv: ['15.15', '13.93', '13.77', '13.18', '12.73']\nL3H4 QK diag mean 0.0003 std 0.0268 frob 10.01 tr 0.12\n  QK off-diag std 0.0260 maxabs 0.2849\n  OV diag mean -0.1410 std 0.1564 frob 68.19 tr -54.13\n  QK top5 sv: ['3.73', '3.39', '2.74', '2.50', '2.11']\n  OV top5 sv: ['29.44', '24.23', '23.52', '20.75', '19.86']\n"}
