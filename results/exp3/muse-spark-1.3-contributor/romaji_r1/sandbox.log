{"t": 1793708232.370301, "s": 0.08, "code": "import numpy as np\nfor layer in [0,1,2,3]:\n    for name in [f'ln1_b.{layer}', f'ln2_b.{layer}', f'ln1_w.{layer}', f'ln2_w.{layer}']:\n        a=W[name]\n        for dim in [21,99,184,180,381]:\n            print(f\"{name} dim{dim}={float(a[dim]):.4f}\", end=\" \")\n        print()\n    print(\"---\")\n", "out": "ln1_b.0 dim21=-0.0380 ln1_b.0 dim99=0.0162 ln1_b.0 dim184=0.0475 ln1_b.0 dim180=0.0460 ln1_b.0 dim381=0.0188 \nln2_b.0 dim21=-0.0715 ln2_b.0 dim99=-0.6236 ln2_b.0 dim184=-0.1574 ln2_b.0 dim180=-0.1041 ln2_b.0 dim381=0.0131 \nln1_w.0 dim21=0.5348 ln1_w.0 dim99=0.9171 ln1_w.0 dim184=0.9740 ln1_w.0 dim180=0.9785 ln1_w.0 dim381=0.0352 \nln2_w.0 dim21=0.1141 ln2_w.0 dim99=0.1870 ln2_w.0 dim184=0.6753 ln2_w.0 dim180=0.3584 ln2_w.0 dim381=0.6832 \n---\nln1_b.1 dim21=-0.4299 ln1_b.1 dim99=-1.3355 ln1_b.1 dim184=-0.5617 ln1_b.1 dim180=-0.1462 ln1_b.1 dim381=-0.0056 \nln2_b.1 dim21=0.0004 ln2_b.1 dim99=-0.1490 ln2_b.1 dim184=0.0789 ln2_b.1 dim180=0.1132 ln2_b.1 dim381=0.0467 \nln1_w.1 dim21=1.0846 ln1_w.1 dim99=0.7163 ln1_w.1 dim184=0.2495 ln1_w.1 dim180=0.4039 ln1_w.1 dim381=0.5113 \nln2_w.1 dim21=0.0019 ln2_w.1 dim99=0.0568 ln2_w.1 dim184=0.9586 ln2_w.1 dim180=0.8622 ln2_w.1 dim381=0.8496 \n---\nln1_b.2 dim21=-0.4534 ln1_b.2 dim99=-1.6589 ln1_b.2 dim184=-0.5046 ln1_b.2 dim180=-0.0549 ln1_b.2 dim381=0.0546 \nln2_b.2 dim21=-0.0061 ln2_b.2 dim99=0.2176 ln2_b.2 dim184=-0.3832 ln2_b.2 dim180=-0.0632 ln2_b.2 dim381=0.0716 \nln1_w.2 dim21=1.0927 ln1_w.2 dim99=0.9428 ln1_w.2 dim184=0.3373 ln1_w.2 dim180=0.6354 ln1_w.2 dim381=0.6544 \nln2_w.2 dim21=0.0120 ln2_w.2 dim99=0.6119 ln2_w.2 dim184=0.6113 ln2_w.2 dim180=1.2699 ln2_w.2 dim381=1.2479 \n---\nln1_b.3 dim21=-0.3152 ln1_b.3 dim99=-0.7639 ln1_b.3 dim184=-0.2889 ln1_b.3 dim180=0.0087 ln1_b.3 dim381=0.1126 \nln2_b.3 dim21=-0.5402 ln2_b.3 dim99=-0.2315 ln2_b.3 dim184=0.0256 ln2_b.3 dim180=0.1093 ln2_b.3 dim381=-0.0597 \nln1_w.3 dim21=0.8020 ln1_w.3 dim99=0.7512 ln1_w.3 dim184=0.5