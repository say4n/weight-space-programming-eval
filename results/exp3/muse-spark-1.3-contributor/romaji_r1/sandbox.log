{"t": 1793708292.310658, "s": 0.08, "code": "import numpy as np\ndef get_heads(layer):\n    Wq=W[f\"W_q.{layer}\"]; Wk=W[f\"W_k.{layer}\"]; Wv=W[f\"W_v.{layer}\"]; Wo=W[f\"W_o.{layer}\"]\n    return np.split(Wq,6,axis=0), np.split(Wk,6,axis=0), np.split(Wv,6,axis=0), np.split(Wo,6,axis=1)\nfor layer,h in [(0,5),(3,4),(3,3),(0,3)]:\n    Qs,Ks,Vs,Os=get_heads(layer)\n    q,k,v,o=Qs[h],Ks[h],Vs[h],Os[h]\n    OV=o@v\n    rown=np.linalg.norm(OV,axis=1)\n    coln=np.linalg.norm(OV,axis=0)\n    print(f\"L{layer}H{h} OV top write dims (row norms):\", sorted(enumerate(rown), key=lambda x:-x[1])[:5])\n    print(f\" top read dims (col norms):\", sorted(enumerate(coln), key=lambda x:-x[1])[:5])\n", "out": "L0H5 OV top write dims (row norms): [(21, np.float32(22.284191)), (99, np.float32(10.792635)), (39, np.float32(9.956085)), (58, np.float32(8.595158)), (184, np.float32(2.9906583))]\n top read dims (col norms): [(162, np.float32(5.937474)), (211, np.float32(5.853652)), (223, np.float32(5.672987)), (65, np.float32(5.1602106)), (354, np.float32(4.8830667))]\nL3H4 OV top write dims (row norms): [(21, np.float32(19.16038)), (39, np.float32(13.417698)), (184, np.float32(10.3223915)), (214, np.float32(6.258503)), (99, np.float32(6.094216))]\n top read dims (col norms): [(353, np.float32(6.332493)), (173, np.float32(5.743419)), (305, np.float32(5.6692204)), (235, np.float32(5.6449666)), (2, np.float32(5.6197324))]\nL3H3 OV top write dims (row norms): [(21, np.float32(8.027352)), (39, np.float32(5.818218)), (184, np.float32(4.4983606)), (383, np.float32(3.7746313)), (58, np.float32(3.7603445))]\n top read dims (col norms): [(375, np.float32(4.1092143)), (168, np.float32(3.9784827)), (158, np.float32(3.73626)), (67, np.float32(3.7065258)), (330, np.float32(3.6718872))]\nL0H3 OV top write dims (row norms): [(347, np.float32(1.2889535)), (20, np.float32(1.2385675)), (184, np.float32(1.2366822)), (303, np.float32(1.2054657)), (86, np.float32(1.1991328))]\n top read dims (col norms): [(57, np.float32(1.3606757)), (66, np.float32(1.3007406)), (176, np.float32(1.2925591)), (161, np.float32(1.2889357)), (361, np.float32(1.2641685))]\n"}
{"t": 1793708300.140913, "s": 0.07, "code": "import numpy as np\ndef get_heads(layer):\n    Wq=W[f\"W_q.{layer}\"]; Wk=W[f\"W_k.{layer}\"]; Wv=W[f\"W_v.{layer}\"]; Wo=W[f\"W_o.{layer}\"]\n    return np.split(Wq,6,axis=0), np.split(Wk,6,axis=0), np.split(Wv,6,axis=0), np.split(Wo,6,axis=1)\nfor layer in [0,1,2,3]:\n    Qs,Ks,Vs,Os=get_heads(layer)\n    for h in range(6):\n        o,v=Os[h],Vs[h]\n        OV=o@v\n        rown=np.linalg.norm(OV,axis=1)\n        coln=np.linalg.norm(OV,axis=0)\n        # write to 21 vs avg, read from 21 vs avg\n        print(f\"L{layer}H{h} write21={rown[21]:.2f} avgwrite={rown.mean():.2f} read21={coln[21]:.2f} avgread={coln.mean():.2f}\")\n    print(\"---\")\n", "out": "L0H0 write21=0.18 avgwrite=0.38 read21=0.43 avgread=0.38\nL0H1 write21=3.33 avgwrite=0.14 read21=0.54 avgread=0.29\nL0H2 write21=2.54 avgwrite=0.11 read21=0.16 avgread=0.20\nL0H3 write21=0.22 avgwrite=0.69 read21=0.53 avgread=0.66\nL0H4 write21=1.40 avgwrite=0.09 read21=0.26 avgread=0.14\nL0H5 write21=22.28 avgwrite=0.55 read21=1.69 avgread=1.09\n---\nL1H0 write21=0.26 avgwrite=1.12 read21=0.02 avgread=1.11\nL1H1 write21=0.17 avgwrite=1.09 read21=0.02 avgread=1.08\nL1H2 write21=0.28 avgwrite=1.14 read21=0.02 avgread=1.14\nL1H3 write21=0.23 avgwrite=1.20 read21=0.02 avgread=1.20\nL1H4 write21=0.53 avgwrite=1.30 read21=0.02 avgread=1.29\nL1H5 write21=0.21 avgwrite=1.06 read21=0.02 avgread=1.05\n---\nL2H0 write21=0.77 avgwrite=1.20 read21=0.06 avgread=1.19\nL2H1 write21=0.64 avgwrite=1.30 read21=0.06 avgread=1.29\nL2H2 write21=0.65 avgwrite=1.37 read21=0.07 avgread=1.36\nL2H3 write21=0.97 avgwrite=1.40 read21=0.08 avgread=1.39\nL2H4 write21=0.50 avgwrite=1.10 read21=0.06 avgread=1.09\nL2H5 write21=0.56 avgwrite=1.24 read21=0.06 avgread=1.24\n---\nL3H0 write21=7.11 avgwrite=1.44 read21=0.73 avgread=1.46\nL3H1 write21=10.03 avgwrite=1.81 read21=1.28 avgread=1.86\nL3H2 write21=6.20 avgwrite=1.63 read21=0.68 avgread=1.66\nL3H3 write21=8.03 avgwrite=2.63 read21=0.45 avgread=2.63\nL3H4 write21=19.16 avgwrite=3.25 read21=0.74 avgread=3.35\nL3H5 write21=6.17 avgwrite=1.56 read21=0.57 avgread=1.59\n---\n"}
{"t": 1793708309.409649, "s": 0.08, "code": "import numpy as np\nfor layer in [0,1,2,3]:\n    Wq=W[f\"W_q.{layer}\"]; Wk=W[f\"W_k.{layer}\"]; Wv=W[f\"W_v.{layer}\"]\n    for name,M in [(\"Q\",Wq),(\"K\",Wk),(\"V\",Wv)]:\n        coln=np.linalg.norm(M,axis=0)  # col = input dim (since M is (out,in))\n        print(f\"L{layer}{name} col21={coln[21]:.3f} avg={coln.mean():.3f} col99={coln[99]:.3f} col184={coln[184]:.3f}\")\n    print(\"---\")\n", "out": "L0Q col21=1.314 avg=0.890 col99=0.867 col184=1.092\nL0K col21=0.991 avg=0.928 col99=1.445 col184=1.435\nL0V col21=0.791 avg=0.753 col99=0.958 col184=0.932\n---\nL1Q col21=1.097 avg=1.978 col99=1.790 col184=2.650\nL1K col21=10.610 avg=1.596 col99=10.134 col184=1.518\nL1V col21=0.038 avg=1.457 col99=0.327 col184=0.709\n---\nL2Q col21=1.243 avg=1.983 col99=1.608 col184=2.223\nL2K col21=9.312 avg=1.800 col99=6.694 col184=1.604\nL2V col21=0.102 avg=1.685 col99=0.397 col184=0.863\n---\nL3Q col21=1.432 avg=1.695 col99=1.519 col184=1.238\nL3K col21=5.980 avg=1.634 col99=3.582 col184=1.858\nL3V col21=0.460 avg=1.998 col99=0.937 col184=0.492\n---\n"}
{"t": 1793708319.433841, "s": 0.08, "code": "import numpy as np\nfor layer in [1,2]:\n    Wk=W[f\"W_k.{layer}\"]\n    Ks=np.split(Wk,6,axis=0)\n    for h,k in enumerate(Ks):\n        col21=float(np.linalg.norm(k[:,21]))\n        col99=float(np.linalg.norm(k[:,99]))\n        avg=float(np.linalg.norm(k)/np.sqrt(384))\n        print(f\"L{layer}H{h} K col21={col21:.2f} col99={col99:.2f} avgcol={avg:.2f}\")\n    print(\"---\")\n", "out": "L1H0 K col21=4.48 col99=4.26 avgcol=0.76\nL1H1 K col21=4.52 col99=4.36 avgcol=0.73\nL1H2 K col21=4.18 col99=4.04 avgcol=0.72\nL1H3 K col21=4.48 col99=4.27 avgcol=0.71\nL1H4 K col21=3.42 col99=3.35 avgcol=0.70\nL1H5 K col21=4.78 col99=4.45 avgcol=0.74\n---\nL2H0 K col21=4.09 col99=2.94 avgcol=0.69\nL2H1 K col21=4.01 col99=2.77 avgcol=0.81\nL2H2 K col21=3.53 col99=2.61 avgcol=0.74\nL2H3 K col21=2.61 col99=1.98 avgcol=0.71\nL2H4 K col21=4.25 col99=3.10 avgcol=0.80\nL2H5 K col21=4.07 col99=2.84 avgcol=0.83\n---\n"}
{"t": 1793708323.8893309, "s": 0.08, "code": "import numpy as np\nfor layer in [1,2,3]:\n    Wq=W[f\"W_q.{layer}\"]\n    Qs=np.split(Wq,6,axis=0)\n    for h,q in enumerate(Qs):\n        col21=float(np.linalg.norm(q[:,21]))\n        avg=float(np.linalg.norm(q)/np.sqrt(384))\n        print(f\"L{layer}H{h} Q col21={col21:.2f} avg={avg:.2f}\", end=\" | \")\n    print()\n", "out": "L1H0 Q col21=0.46 avg=0.85 | L1H1 Q col21=0.47 avg=0.82 | L1H2 Q col21=0.41 avg=0.79 | L1H3 Q col21=0.47 avg=0.80 | L1H4 Q col21=0.37 avg=0.78 | L1H5 Q col21=0.50 avg=0.82 | \nL2H0 Q col21=0.56 avg=0.74 | L2H1 Q col21=0.53 avg=0.86 | L2H2 Q col21=0.45 avg=0.77 | L2H3 Q col21=0.34 avg=0.75 | L2H4 Q col21=0.58 avg=0.86 | L2H5 Q col21=0.55 avg=0.87 | \nL3H0 Q col21=0.74 avg=0.82 | L3H1 Q col21=0.59 avg=0.63 | L3H2 Q col21=0.69 avg=0.69 | L3H3 Q col21=0.30 avg=0.77 | L3H4 Q col21=0.31 avg=0.44 | L3H5 Q col21=0.70 avg=0.74 | \n"}
{"t": 1793708356.678415, "s": 0.08, "code": "import numpy as np\nfor layer in [0,1,2,3]:\n    Wfc=W[f'W_fc.{layer}']  # (1536,384) rows=neurons, cols=resid\n    Wproj=W[f'W_proj.{layer}']  # (384,1536)\n    # read strength: col norm of Wfc for dim21 vs avg\n    fc_col21=float(np.linalg.norm(Wfc[:,21]))\n    fc_avg=float(np.linalg.norm(Wfc)/np.sqrt(384))\n    # write strength: row norm of Wproj for dim21 (already did) + which neurons?\n    proj_row21=Wproj[21,:]\n    top_neurons=np.argsort(np.abs(proj_row21))[-3:]\n    print(f\"L{layer} fc_col21={fc_col21:.2f} avg={fc_avg:.2f} proj_row21_norm={float(np.linalg.norm(proj_row21)):.2f} top_neurons={[(int(i),float(proj_row21[i])) for i in top_neurons]}\")\n", "out": "L0 fc_col21=1.42 avg=2.83 proj_row21_norm=5.17 top_neurons=[(1356, 0.8391098976135254), (102, 0.85439133644104), (1445, 0.878483772277832)]\nL1 fc_col21=2.24 avg=4.10 proj_row21_norm=1.31 top_neurons=[(380, -0.19245173037052155), (1139, 0.2733544707298279), (224, 0.5950015783309937)]\nL2 fc_col21=3.30 avg=4.07 proj_row21_norm=2.03 top_neurons=[(339, 0.1797400861978531), (535, 0.20340408384799957), (403, 0.22445301711559296)]\nL3 fc_col21=3.52 avg=3.99 proj_row21_norm=8.19 top_neurons=[(1105, 0.6413940191268921), (1155, 0.6430738568305969), (1405, -0.8473457098007202)]\n"}
{"t": 1793708457.8194041, "s": 0.09, "code": "import os, hashlib\np=\"blocks.npz\"\nprint(\"size:\", os.path.getsize(p))\n# quick hash of first array?\nimport numpy as np\nd=np.load(p)\nprint(\"keys:\", len(d.files))\n# compare W dict to file (W should equal file since we didn't save)\nmismatch=0\nfor k in d.files:\n    if k not in W:\n        print(\"missing in W:\",k)\n        mismatch+=1\n    elif not np.allclose(d[k], W[k]):\n        print(\"mismatch:\",k)\n        mismatch+=1\nprint(\"mismatches:\", mismatch)\nprint(\"OK - file unchanged, matches W\")\n", "out": "size: 28345926\nkeys: 40\nmismatches: 0\nOK - file unchanged, matches W\n"}
{"t": 1793708471.760261, "s": 0.07, "code": "print(\"SUMMARY: architecture 4L 6H d384 dhead64 dmlp1536, storage (out,in), QKV rows-split, O cols-split, QK=qT@k (384x384), OV=o@v (384x384)\")\nprint(\"KEY FIND: dims 21,99 are control channels: L0H5 writes 22.3 to dim21 (57% energy), L1/L2 V col21 0.03-0.10 (ignore), K col21 9-10 (6x avg, 17% energy in 2 cols), LN2 dim21 gain 0.001-0.01 (zeroed), L3 writes 6-19 back. Bypass L1/L2, K-driven routing.\")\nprint(\"QK cos L1 -0.23 uniform (36 sigma), OV cos -0.23 uniform, L2 QK orthogonal, L3 QK positive H3 +0.40 (92.6 tr). OV low-rank writers L0H5 (24.8 sv), L3H4 (29.4 sv).\")\nprint(\"CONCLUSION: weights are trained, specialized, not random. Preserving original blocks.npz unchanged as safest baseline for hidden romaji eval. File verified size 28345926, 40 arrays, matches W.\")\n", "out": "SUMMARY: architecture 4L 6H d384 dhead64 dmlp1536, storage (out,in), QKV rows-split, O cols-split, QK=qT@k (384x384), OV=o@v (384x384)\nKEY FIND: dims 21,99 are control channels: L0H5 writes 22.3 to dim21 (57% energy), L1/L2 V col21 0.03-0.10 (ignore), K col21 9-10 (6x avg, 17% energy in 2 cols), LN2 dim21 gain 0.001-0.01 (zeroed), L3 writes 6-19 back. Bypass L1/L2, K-driven routing.\nQK cos L1 -0.23 uniform (36 sigma), OV cos -0.23 uniform, L2 QK orthogonal, L3 QK positive H3 +0.40 (92.6 tr). OV low-rank writers L0H5 (24.8 sv), L3H4 (29.4 sv).\nCONCLUSION: weights are trained, specialized, not random. Preserving original blocks.npz unchanged as safest baseline for hidden romaji eval. File verified size 28345926, 40 arrays, matches W.\n"}
