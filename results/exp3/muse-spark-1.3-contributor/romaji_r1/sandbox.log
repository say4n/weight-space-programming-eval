{"t": 1793697546.203613, "s": 0.52, "code": "import torch, os, glob\nckpt = torch.load(sorted(glob.glob(\"*.pt\"))[0], map_location=\"cpu\")\n# adapt key names to yours\nfor k in ['W_o.0','W_proj.0','W_proj.1','W_fc.0','W_k.1','W_k.2','W_o.3']:\n    w = ckpt[k] if k in ckpt else ckpt['blocks.'+k]\n    flat = w.flatten()\n    vals, idx = torch.topk(flat.abs(), 5)\n    print(k, vals.tolist(), idx.tolist())\n    print(\"  hist:\", torch.histc(flat, bins=5, min=float(flat.min()), max=float(flat.max())).tolist())\n\nfor k in ['ln1_w.0','ln1_w.1','ln2_w.1','ln2_w.2']:\n    w = ckpt[k] if k in ckpt else ckpt['blocks.'+k]\n    print(k, \"mean\", float(w.mean()), \"n<0.05\", int((w<0.05).sum()), (w<0.05).nonzero().flatten()[:10].tolist())\n", "out": "\n[stderr]\nTraceback (most recent call last):\n  File \"<string>\", line 5, in <module>\nIndexError: list index out of range\n"}
{"t": 1793697568.618405, "s": 0.07, "code": "import os, sys, glob, pathlib\nprint(\"CWD:\", os.getcwd())\nprint(\"LS work:\", sorted(os.listdir(\".\")))\nfor d in [\".\", \"..\", \"../..\"]:\n    try:\n        print(d, \"->\", sorted(os.listdir(d))[:100])\n    except Exception as e:\n        print(d, \"err\", e)\n\nfor pat in [\"*.pt\", \"*.bin\", \"*.safetensors\", \"*.npz\", \"*.pkl\", \"*.json\", \"*.py\", \"**/*.pt\", \"**/*.safetensors\", \"**/*.bin\", \"../*.pt\", \"../../*.pt\"]:\n    try:\n        hits = sorted(glob.glob(pat, recursive=True))\n        if hits:\n            print(pat, hits[:20])\n    except Exception as e:\n        print(pat, \"err\", e)\n\n# show what task files exist without crashing\nfor f in sorted(glob.glob(\"*.py\")) + sorted(glob.glob(\"../*.py\")):\n    print(\"PY:\", f)\n", "out": "CWD: /Users/sayan/Projects/weight-space-programming/results/exp3/muse-spark-1.3-contributor/romaji_r1/work\nLS work: ['blocks.npz']\n. -> ['blocks.npz']\n.. err [Errno 1] Operation not permitted: '..'\n../.. err [Errno 1] Operation not permitted: '../..'\n*.npz ['blocks.npz']\n"}
{"t": 1793697616.501204, "s": 0.02, "code": "import numpy as np\nz = np.load('blocks.npz')\nfiles = list(z.files)\nprint('nfiles', len(files))\n# sort by layer then name\ndef sortk(k):\n    try:\n        lyr = int(k.split('.')[-1])\n        pre = '.'.join(k.split('.')[:-1])\n        return (lyr, pre)\n    except:\n        return (99, k)\nfiles_s = sorted(files, key=sortk)\nprint(files_s)\nfor k in files_s:\n    a = z[k]\n    print(k, tuple(a.shape), str(a.dtype), 'nbytes', a.nbytes)\n\nprint('--- per-tensor stats ---')\nfor k in files_s:\n    a = z[k].astype(np.float64)\n    flat = a.ravel()\n    mean = flat.mean()\n    std = flat.std()\n    rms = np.sqrt((flat**2).mean())\n    norm = np.sqrt((flat**2).sum())\n    mn = flat.min()\n    mx = flat.max()\n    p1, p5, p50, p95, p99 = np.percentile(flat, [1,5,50,95,99])\n    frac05 = (np.abs(flat)>0.5).mean()\n    frac10 = (np.abs(flat)>1.0).mean()\n    nnan = np.isnan(flat).sum()\n    ninf = np.isinf(flat).sum()\n    print(f\"{k} mean={mean:.6f} std={std:.6f} rms={rms:.6f} norm={norm:.2f} min={mn:.4f} p1={p1:.4f} p5={p5:.4f} med={p50:.4f} p95={p95:.4f} p99={p99:.4f} max={mx:.4f} |w|>0.5={frac05:.4f} |w|>1={frac10:.5f} nan={nnan} inf={ninf}\")\n\nprint('--- LN health ---')\nfor k in files_s:\n    if k.startswith('ln'):\n        a = z[k].astype(np.float64).ravel()\n        print(k, 'mean', float(a.mean()), 'min', float(a.min()), 'max', float(a.max()), 'n<0.05', int((a<0.05).sum()), 'n<0.2', int((a<0.2).sum()), 'n>1.5', int((a>1.5).sum()))\n\nprint('--- outliers top3 ---')\nfor k in files_s:\n    if k.startswith('W_'):\n        a = z[k]\n        flat = np.abs(a.astype(np.float64).ravel())\n        idx = np.argpartition(flat, -3)[-3:]\n        idx = idx[np.argsort(-flat[idx])]\n        vals = flat[idx]\n        # unravel\n        unr = [np.unravel_index(int(i), a.shape) for i in idx]\n        print(k, 'topabs', [float(v) for v in vals], unr)\n\nprint('--- attn spectral (384x384 only) ---')\nfor k in files_s:\n    if k.startswith('W_q') or k.startswith('W_k') or k.startswith('W_v') or k.startswith('W_o'):\n        a = z[k].astype(np.float64)\n        if a.shape==(384,384):\n            try:\n                s = np.linalg.svd(a, compute_uv=False)\n                print(k, 'sv_top5', [f\"{v:.3f}\" for v in s[:5]], 'sv_min', f\"{s[-1]:.4f}\", 'cond', f\"{s[0]/max(s[-1],1e-12):.2f}\", 'fro', f\"{np.sqrt((s**2).sum()):.2f}\", 'effrank', f\"{(s.sum()**2/(s**2).sum():.2f)}\")\n            except Exception as e:\n                print(k, 'svd err', e)\n\nprint('--- MLP neuron norms ---')\nfor lyr in [0,1,2,3]:\n    try:\n        fc = z[f'W_fc.{lyr}'].astype(np.float64)  # 1536,384 ?\n        proj = z[f'W_proj.{lyr}'].astype(np.float64)  # 384,1536 ?\n        # row norm of fc = per-output neuron, col norm of proj input dim? align on 1536 dim\n        # fc row i uses 384 inputs, proj col i uses 384 outputs? Actually proj shape (384,1536), col = 1536 dim\n        fc_row = np.sqrt((fc**2).sum(axis=1))\n        proj_col = np.sqrt((proj**2).sum(axis=0))\n        # combined\n        combo = fc_row * proj_col if fc_row.shape==proj_col.shape else fc_row\n        top = np.argsort(-combo)[:5]\n        print(f'lyr{lyr} fc_row max5', [f\"{fc_row[i]:.3f}\" for i in top], 'proj_col max5', [f\"{proj_col[i]:.3f}\" for i in top], 'idx', top.tolist(), 'combo', [f\"{combo[i]:.3f}\" for i in top])\n    except Exception as e:\n        print(f'lyr{lyr} mlp err', e)\nprint('done')\n", "out": "\n[stderr]\n  File \"<string>\", line 64\n    print(k, 'sv_top5', [f\"{v:.3f}\" for v in s[:5]], 'sv_min', f\"{s[-1]:.4f}\", 'cond', f\"{s[0]/max(s[-1],1e-12):.2f}\", 'fro', f\"{np.sqrt((s**2).sum()):.2f}\", 'effrank', f\"{(s.sum()**2/(s**2).sum():.2f)}\")\n                                                                                                                                                                            ^\nSyntaxError: f-string: expecting a valid expression after '{'\n"}
{"t": 1793697632.809515, "s": 0.29, "code": "import numpy as np\nz = np.load('blocks.npz')\nfiles = list(z.files)\nprint('nfiles', len(files))\ndef sortk(k):\n    try:\n        lyr = int(k.split('.')[-1])\n        pre = '.'.join(k.split('.')[:-1])\n        return (lyr, pre)\n    except:\n        return (99, k)\nfiles_s = sorted(files, key=sortk)\nprint(files_s)\nfor k in files_s:\n    a = z[k]\n    print(k, tuple(a.shape), str(a.dtype), 'nbytes', a.nbytes)\nprint('--- per-tensor stats ---')\nfor k in files_s:\n    a = z[k].astype(np.float64)\n    flat = a.ravel()\n    mean = float(flat.mean())\n    std = float(flat.std())\n    rms = float(np.sqrt((flat**2).mean()))\n    norm = float(np.sqrt((flat**2).sum()))\n    mn = float(flat.min())\n    mx = float(flat.max())\n    p1, p5, p50, p95, p99 = np.percentile(flat, [1,5,50,95,99])\n    frac05 = float((np.abs(flat)>0.5).mean())\n    frac10 = float((np.abs(flat)>1.0).mean())\n    print(k, 'mean', round(mean,6), 'std', round(std,6), 'rms', round(rms,6), 'norm', round(norm,2), 'min', round(mn,4), 'p1', round(float(p1),4), 'p5', round(float(p5),4), 'med', round(float(p50),4), 'p95', round(float(p95),4), 'p99', round(float(p99),4), 'max', round(mx,4), 'gt05', round(frac05,4), 'gt10', round(frac10,5))\nprint('--- LN health ---')\nfor k in files_s:\n    if k.startswith('ln'):\n        a = z[k].astype(np.float64).ravel()\n        print(k, 'mean', round(float(a.mean()),4), 'min', round(float(a.min()),4), 'max', round(float(a.max()),4), 'n_lt_05', int((a<0.05).sum()), 'n_lt_2', int((a<0.2).sum()), 'n_gt_15', int((a>1.5).sum()))\nprint('--- outliers top3 ---')\nfor k in files_s:\n    if k.startswith('W_'):\n        a = z[k]\n        flat = np.abs(a.astype(np.float64).ravel())\n        idx = np.argpartition(flat, -3)[-3:]\n        idx = idx[np.argsort(-flat[idx])]\n        vals = flat[idx]\n        unr = [np.unravel_index(int(i), a.shape) for i in idx]\n        print(k, 'topabs', [round(float(v),4) for v in vals], unr)\nprint('--- attn spectral ---')\nfor k in files_s:\n    if k.startswith('W_q') or k.startswith('W_k') or k.startswith('W_v') or k.startswith('W_o'):\n        a = z[k].astype(np.float64)\n        if a.shape==(384,384):\n            try:\n                s = np.linalg.svd(a, compute_uv=False)\n                smax = float(s[0])\n                smin = float(s[-1])\n                cond = smax / max(smin, 1e-12)\n                fro = float(np.sqrt((s**2).sum()))\n                ssum = float(s.sum())\n                ssq = float((s**2).sum())\n                eff = (ssum*ssum)/max(ssq, 1e-12)\n                top5 = [round(float(v),3) for v in s[:5]]\n                print(k, 'top5', top5, 'smin', round(smin,4), 'cond', round(cond,2), 'fro', round(fro,2), 'effrank', round(float(eff),2))\n            except Exception as e:\n                print(k, 'svd err', e)\nprint('--- MLP neuron norms ---')\nfor lyr in [0,1,2,3]:\n    try:\n        fc = z['W_fc.'+str(lyr)].astype(np.float64)\n        proj = z['W_proj.'+str(lyr)].astype(np.float64)\n        fc_row = np.sqrt((fc**2).sum(axis=1))\n        proj_col = np.sqrt((proj**2).sum(axis=0))\n        combo = fc_row * proj_col\n        top = np.argsort(-combo)[:5]\n        print('lyr', lyr, 'idx', top.tolist(), 'combo', [round(float(combo[i]),3) for i in top], 'fc', [round(float(fc_row[i]),3) for i in top], 'proj', [round(float(proj_col[i]),3) for i in top])\n    except Exception as e:\n        print('lyr', lyr, 'mlp err', e)\nprint('done')\n", "out": "nfiles 40\n['W_fc.0', 'W_k.0', 'W_o.0', 'W_proj.0', 'W_q.0', 'W_v.0', 'ln1_b.0', 'ln1_w.0', 'ln2_b.0', 'ln2_w.0', 'W_fc.1', 'W_k.1', 'W_o.1', 'W_proj.1', 'W_q.1', 'W_v.1', 'ln1_b.1', 'ln1_w.1', 'ln2_b.1', 'ln2_w.1', 'W_fc.2', 'W_k.2', 'W_o.2', 'W_proj.2', 'W_q.2', 'W_v.2', 'ln1_b.2', 'ln1_w.2', 'ln2_b.2', 'ln2_w.2', 'W_fc.3', 'W_k.3', 'W_o.3', 'W_proj.3', 'W_q.3', 'W_v.3', 'ln1_b.3', 'ln1_w.3', 'ln2_b.3', 'ln2_w.3']\nW_fc.0 (1536, 384) float32 nbytes 2359296\nW_k.0 (384, 384) float32 nbytes 58