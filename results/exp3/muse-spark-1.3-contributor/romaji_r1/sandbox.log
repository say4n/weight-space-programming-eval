{"t": 1793707820.254882, "s": 0.09, "code": "import os\nfor p in [\"/Users/sayan\", \"/Users/sayan/Projects\", \"/Users/sayan/Projects/weight-space-programming/results/exp3\", \"/Users/sayan/Projects/weight-space-programming/results/exp3/muse-spark-1.3-contributor\", \"/private/tmp\"]:\n    try:\n        lst=os.listdir(p)\n        print(\"OK\",p,\"n=\",len(lst),\"sample=\",lst[:30])\n    except Exception as e:\n        print(\"FAIL\",p,repr(e))\n# check tmp scripts that might be relevant\nfor f in [\"/tmp/dbg.py\",\"/tmp/rollout_test.py\",\"/tmp/rollout_test2.py\",\"/tmp/cmp.log\",\"/tmp/ks4.log\",\"/tmp/ksp.log\"]:\n    try:\n        with open(f) as fh:\n            print(\"----\",f,\"----\")\n            print(fh.read(4000))\n    except Exception as e:\n        print(\"read fail\",f,repr(e))\n", "out": "OK /Users/sayan n= 74 sample= ['backup-icloud.log', '.config', 'Music', '3D Models', '.kaggle', '.docker', 'visa (photos)', 'screenshots', 'go', '.DS_Store', '.gnupg', '.vscode-shared', 'dotfiles', '.lldb', '.CFUserTextEncoding', '.opengrep', '.zshrc', 'OrbStack', '.local', 'Projects', 'Pictures', '.bun', '.zprofile', '.platformio', 'node_modules', '.bundle', 'scratchpad', '.semgrep', '.zsh_history', 'frames']\nOK /Users/sayan/Projects n= 37 sample= ['fluxfeed-ios-webpage', 'fluxfeed', '.DS_Store', 'hacs-tapo-l630', 'overseerr-ios', 'Systemic', 'systemic-ios-webpage', 'overseerr-ios-webpage', 'iso-oa', 'resume', 'luk.flashcard', 'scratchpad', 'kicad', 'Bangs', 'whats-up', 'blog', 'fuel-buddy-ios', 'weight-space-programming', 'crustacean', 'inky-slideshow', 'openfoam-harness', 'barebones', 'say4n.gitlab.io', 'mlxgpt', 'pi-sync', 'godot-2d', '3d-models', 'bangs-everywhere-ios-website', 'nickel-screensaver', 'beszel']\nFAIL /Users/sayan/Projects/weight-space-programming/results/exp3 PermissionError(1, 'Operation not permitted')\nFAIL /Users/sayan/Projects/weight-space-programming/results/exp3/muse-spark-1.3-contributor PermissionError(1, 'Operation not permitted')\nOK /private/tmp n= 112 sample= ['t.json', '__KMP_REGISTERED_LIB_21619', '__fish_git_ready', '__KMP_REGISTERED_LIB_15440', 'audit-4m', 'sb_test_cases', '__KMP_REGISTERED_LIB_84095', '__KMP_REGISTERED_LIB_15886', '__KMP_REGISTERED_LIB_34901', 'audit_repo', 'rp.bin', '__KMP_REGISTERED_LIB_35301', 'chainplain', 'mt', '__KMP_REGISTERED_LIB_39536', '__KMP_REGISTERED_LIB_44159', 's9.html', '__KMP_REGISTERED_LIB_13200', '__KMP_REGISTERED_LIB_36329', '__KMP_REGISTERED_LIB_16787', 'backup-icloud-launchd.log', 'sidetest', '__KMP_REGISTERED_LIB_58130', '__KMP_REGISTERED_LIB_92628', '__KMP_REGISTERED_LIB_16745', 'powerlog', 'audit_dec_components', '__KMP_REGISTERED_LIB_37638', 'chainc', '__KMP_REGISTERED_LIB_93341']\n---- /tmp/dbg.py ----\nimport numpy as np\nimport jax, jax.numpy as jnp\nfrom kinetix.environment.env import make_kinetix_env\nfrom kinetix.environment.spaces import ActionType, ObservationType\nfrom kinetix.util.saving import load_from_json_file\n\nNPZ_ACTOR = {\n    \"params/Dense_0/kernel\": \"embed.W\", \"params/Dense_0/bias\": \"embed.b\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_0/Dense_0/kernel\": \"actor0.W\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_0/Dense_0/bias\": \"actor0.b\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_1/Dense_0/kernel\": \"actor1.W\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_1/Dense_0/bias\": \"actor1.b\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_2/Dense_0/kernel\": \"actor2.W\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_2/Dense_0/bias\": \"actor2.b\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_3/Dense_0/kernel\": \"actor3.W\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_3/Dense_0/bias\": \"actor3.b\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_4/Dense_0/kernel\": \"actor4.W\",\n    \"params/GeneralActorCriticRNN_0/DenseAndActivation_4/Dense_0/bias\": \"actor4.b\",\n    \"params/GeneralActorCriticRNN_0/Dense_0/kernel\": \"actor_head.W\",\n    \"params/GeneralActorCriticRNN_0/Dense_0/bias\": \"actor_head.b\",\n}\ndef load_actor(path):\n    d = np.load(path)\n    t = {}\n    for npz_name, name in NPZ_ACTOR.items():\n        t[name] = jnp.asarray(d[npz_name], dtype=jnp.float32)\n    return t\n\ndef forward(t, x):\n    h = jnp.maximum(0.0, x @ t['embed.W'] + t['embed.b'])\n    for k in range(5):\n        h = jnp.tanh(h @ t[f'actor{k}.W'] + t[f'actor{k}.b'])\n    return h @ t['actor_head.W'] + t['actor_head.b']\n\ndef sample_action(rng, logits):\n    rngs = jax.random.split(rng, 6)\n    return jnp.stack([jax.random.categorical(rngs[0], logits[0:3]),\n                      jax.random.categorical(rngs[1], logits[3:6]),\n                      jax.random.categorical(rngs[2], logits[6:9]),\n                      jax.random.categorical(rngs[3], logits[9:12]),\n                      jax.random.categorical(rngs[4], logits[12:14]),\n                      jax.random.categorical(rngs[5], logits[14:16])])\n\nstate, static_env_params, env_params = load_from_json_file('l/h2_car_ramp')\nenv = make_kinetix_env(ActionType.MULTI_DISCRETE, ObservationType.SYMBOLIC_FLAT, lambda rng: state, env_params, static_env_params, auto_reset=False)\nt = load_actor('upstream/exp4_fix_car/networks/ppo_final_seed0.npz')\nmax_steps = int(env_params.max_timesteps)\n\ndef rollout(rng):\n    obs, state0 = env.reset(rng, env_params)\n    def step(carry, _):\n        rng, state, obs = carry\n        rng, rng_action, rng_step = jax.random.split(rng, 3)\n        logits = forward(t, obs)\n        action = sample_action(rng_action, logits)\n        obs2, state2, reward, done, info = env.step(rng_step, state, action, env_params)\n        return (rng, state2, obs2), (state2, reward, done, info, logits, action, obs)\n    carry, traj = jax.lax.scan(step, (rng, state0, obs), None, length=max_steps)\n    return carry, traj\n\njit_rollout = jax.jit(rollout)\nrng = jax.random.PRNGKey(0)\ncarry, traj = jit_rollout(rng)\nstates, rewards, dones, infos, logits, actions, obss = traj\ndones_np = np.asarray(dones)\nrewards_np = np.asarray(rewards)\nprint('dones where true', np.nonzero(dones_np)[0])\nprint('rewards nonzero', np.nonzero(rewards_np)[0], rewards_np[np.nonzero(rewards_np)[0]])\nprint('final timestep', carry[1].timestep)\n# print timesteps over scan? state2.timestep not in traj; but states are env states\nts = np.asarray([s.timestep for s in states])\nprint('timesteps first 5', ts[:5])\nprint('goalR true indices', np.nonzero(np.asarray([i['GoalR'] for i in infos]))[0])\nprint('distances first 10', [float(i['distance']) for i in infos[:10]])\nprint('actions entry0 first 30', np.asarray(actions)[:30,0])\nprint('rewards first 30', rewards_np[:30])\n\n---- /tmp/rollout_test.py ----\nimport time\nimport numpy as np\nimport jax, jax.numpy as jnp\nfrom kinetix.environment.env import make_kinetix_env\nfrom kinetix.environment.spaces import ActionType, ObservationType\nf"}
