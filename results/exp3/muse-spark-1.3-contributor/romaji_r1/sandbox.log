{"t": 1793707581.7854311, "s": 0.08, "code": "import numpy as np\n\ndef head_slices(l, j, hd=64):\n    s = slice(j*hd, (j+1)*hd)\n    Wq = W[f'W_q.{l}'][s, :]  # hd x d\n    Wk = W[f'W_k.{l}'][s, :]\n    Wv = W[f'W_v.{l}'][s, :]\n    Wo = W[f'W_o.{l}'][:, s]  # d x hd  (columns)\n    return Wq, Wk, Wv, Wo\n\nfor l in range(4):\n    print(f\"=== Layer {l} ===\")\n    print(f\"ln1_w mean {W[f'ln1_w.{l}'].mean():.4f} std {W[f'ln1_w.{l}'].std():.4f} min {W[f'ln1_w.{l}'].min():.4f} max {W[f'ln1_w.{l}'].max():.4f}\")\n    print(f\"ln1_b mean {W[f'ln1_b.{l}'].mean():.4f} std {W[f'ln1_b.{l}'].std():.4f}\")\n    print(f\"ln2_w mean {W[f'ln2_w.{l}'].mean():.4f} std {W[f'ln2_w.{l}'].std():.4f}\")\n    print(f\"W_q.{l} frob {np.linalg.norm(W[f'W_q.{l}']):.2f} mean {W[f'W_q.{l}'].mean():.5f} std {W[f'W_q.{l}'].std():.5f}\")\n    print(f\"W_k.{l} frob {np.linalg.norm(W[f'W_k.{l}']):.2f} std {W[f'W_k.{l}'].std():.5f}\")\n    print(f\"W_v.{l} frob {np.linalg.norm(W[f'W_v.{l}']):.2f} std {W[f'W_v.{l}'].std():.5f}\")\n    print(f\"W_o.{l} frob {np.linalg.norm(W[f'W_o.{l}']):.2f} std {W[f'W_o.{l}'].std():.5f}\")\n    print(f\"W_fc.{l} frob {np.linalg.norm(W[f'W_fc.{l}']):.2f} std {W[f'W_fc.{l}'].std():.5f}\")\n    print(f\"W_proj.{l} frob {np.linalg.norm(W[f'W_proj.{l}']):.2f} std {W[f'W_proj.{l}'].std():.5f}\")\n    for j in range(6):\n        Wq,Wk,Wv,Wo = head_slices(l,j)\n        QK = Wq.T @ Wk  # d x d\n        OV = Wo @ Wv\n        print(f\"L{l}H{j}: |Wq|={np.linalg.norm(Wq):.2f} |Wk|={np.linalg.norm(Wk):.2f} |Wv|={np.linalg.norm(Wv):.2f} |Wo|={np.linalg.norm(Wo):.2f} |QK|_f={np.linalg.norm(QK):.2f} tr(QK)={np.trace(QK):.2f} |OV|_f={np.linalg.norm(OV):.2f} tr(OV)={np.trace(OV):.2f}\")\n", "out": "=== Layer 0 ===\nln1_w mean 0.2965 std 0.1884 min 0.0352 max 0.9785\nln1_b mean 0.0004 std 0.0311\nln2_w mean 0.8718 std 0.3382\nW_q.0 frob 17.67 mean 0.00005 std 0.04601\nW_k.0 frob 18.52 std 0.04822\nW_v.0 frob 14.94 std 0.03890\nW_o.0 frob 16.55 std 0.04310\nW_fc.0 frob 55.38 std 0.07210\nW_proj.0 frob 50.01 std 0.06511\nL0H0: |Wq|=7.14 |Wk|=7.40 |Wv|=5.92 |Wo|=6.13 |QK|_f=11.06 tr(QK)=-12.96 |OV|_f=7.88 tr(OV)=-0.68\nL0H1: |Wq|=4.49 |Wk|=4.93 |Wv|=4.32 |Wo|=4.82 |QK|_f=7.60 tr(QK)=-6.78 |OV|_f=6.87 tr(OV)=0.53\nL0H2: |Wq|=4.07 |Wk|=4.36 |Wv|=4.02 |Wo|=4.36 |QK|_f=5.07 tr(QK)=-4.79 |OV|_f=4.90 tr(OV)=0.28\nL0H3: |Wq|=14.14 |Wk|=14.66 |Wv|=8.26 |Wo|=9.44 |QK|_f=34.44 tr(QK)=61.13 |OV|_f=14.07 tr(OV)=-7.45\nL0H4: |Wq|=4.20 |Wk|=4.61 |Wv|=3.69 |Wo|=3.66 |QK|_f=5.09 tr(QK)=-4.36 |OV|_f=3.12 tr(OV)=-0.41\nL0H5: |Wq|=2.63 |Wk|=2.94 |Wv|=8.45 |Wo|=9.56 |QK|_f=1.68 tr(QK)=-0.41 |OV|_f=29.44 tr(OV)=2.35\n=== Layer 1 ===\nln1_w mean 0.5058 std 0.0892 min 0.1970 max 1.0846\nln1_b mean 0.0110 std 0.1546\nln2_w mean 1.1315 std 0.1741\nW_q.1 frob 38.93 mean -0.00027 std 0.10138\nW_k.1 frob 34.89 std 0.09087\nW_v.1 frob 28.74 std 0.07486\nW_o.1 frob 28.48 std 0.07416\nW_fc.1 frob 80.38 std 0.10465\nW_proj.1 frob 77.38 std 0.10076\nL1H0: |Wq|=16.63 |Wk|=14.95 |Wv|=11.76 |Wo|=11.71 |QK|_f=52.84 tr(QK)=-55.60 |OV|_f=22.13 tr(OV)=-30.07\nL1H1: |Wq|=16.02 |Wk|=14.34 |Wv|=11.24 |Wo|=11.40 |QK|_f=48.26 tr(QK)=-46.75 |OV|_f=21.59 tr(OV)=-29.58\nL1H2: |Wq|=15.58 |Wk|=14.14 |Wv|=11.74 |Wo|=11.38 |QK|_f=45.70 tr(QK)=-58.09 |OV|_f=22.75 tr(OV)=-33.61\nL1H3: |Wq|=15.75 |Wk|=13.95 |Wv|=11.80 |Wo|=11.88 |QK|_f=45.90 tr(QK)=-46.54 |OV|_f=23.88 tr(OV)=-36.07\nL1H4: |Wq|=15.20 |Wk|=13.64 |Wv|=12.73 |Wo|=12.11 |QK|_f=42.43 tr(QK)=-61.24 |OV|_f=25.84 tr(OV)=-37.33\nL1H5: |Wq|=16.15 |Wk|=14.42 |Wv|=11.07 |Wo|=11.24 |QK|_f=48.98 tr(QK)=-49.66 |OV|_f=20.97 tr(OV)=-28.92\n=== Layer 2 ===\nln1_w mean 0.6809 std 0.0687 min 0.3175 max 1.0927\nln1_b mean 0.0131 std 0.1565\nln2_w mean 1.3104 std 0.1148\nW_q.2 frob 38.90 mean 0.00008 std 0.10131\nW_k.2 frob 36.75 std 0.09570\nW_v.2 frob 33.18 std 0.08641\nW_o.2 frob 32.43 std 0.08446\nW_fc.2 frob 79.83 std 0.10394\nW_proj.2 frob 78.05 std 0.10163\nL2H0: |Wq|=14.49 |Wk|=13.57 |Wv|=13.05 |Wo|=12.69 |QK|_f=26.83 tr(QK)=-26.97 |OV|_f=23.75 tr