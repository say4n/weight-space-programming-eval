{"t": 1793708040.6162, "s": 0.18, "code": "import numpy as np\n# W is preloaded, use it\nfor key in ['W_o.0','W_proj.1','W_k.1','W_k.2','W_q.0','W_fc.0']:\n    a=W[key]\n    amax=np.max(np.abs(a))\n    idx=np.unravel_index(np.argmax(np.abs(a)), a.shape)\n    print(key, \"shape\", a.shape, \"maxabs\", float(amax), \"at\", idx, \"val\", float(a[idx]), \"mean\", float(a.mean()), \"std\", float(a.std()))\n    # top 5\n    flat=np.abs(a).flatten()\n    top=np.argsort(flat)[-5:][::-1]\n    print(\" top5 idx/val:\", [(int(i), float(a.flatten()[i])) for i in top])\n", "out": "W_o.0 shape (384, 384) maxabs 1.1239163875579834 at (np.int64(21), np.int64(381)) val -1.1239163875579834 mean -0.0001200871411128901 std 0.043097514659166336\n top5 idx/val: [(8445, -1.1239163875579834), (8409, 1.0822527408599854), (8403, -1.0764760971069336), (8418, 1.0507903099060059), (8389, -1.0458980798721313)]\nW_proj.1 shape (384, 1536) maxabs 2.660118579864502 at (np.int64(184), np.int64(1139)) val 2.660118579864502 mean -8.241306932177395e-05 std 0.10076087713241577\n top5 idx/val: [(283763, 2.660118579864502), (282848, 1.8620582818984985), (283801, 0.7073200941085815), (283669, 0.6085568070411682), (32480, 0.5950015783309937)]\nW_k.1 shape (384, 384) maxabs 1.2756876945495605 at (np.int64(375), np.int64(99)) val 1.2756876945495605 mean 5.424266419140622e-05 std 0.09086615592241287\n top5 idx/val: [(144099, 1.2756876945495605), (88803, 1.196699619293213), (130275, 1.1696133613586426), (96867, 1.1229896545410156), (143715, -1.0865174531936646)]\nW_k.2 shape (384, 384) maxabs 1.223537802696228 at (np.int64(321), np.int64(21)) val -1.223537802696228 mean 1.4820711840002332e-05 std 0.09570319950580597\n top5 idx/val: [(123285, -1.223537802696228), (57621, 1.1936063766479492), (40725, 1.132498860359192), (131733, 1.0652929544448853), (55701, 1.0087310075759888)]\nW_q.0 shape (384, 384) maxabs 0.463882714509964 at (np.int64(240), np.int64(153)) val -0.463882714509964 mean 5.47205563634634e-05 std 0