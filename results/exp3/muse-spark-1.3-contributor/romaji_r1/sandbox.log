{"t": 1793697663.196883, "s": 0.09, "code": "import numpy as np\nz = np.load('blocks.npz')\nprint('loaded', list(z.files)[:5])\n\n# 1. dead / outlier LN indices\nfor k in ['ln1_w.0','ln1_w.1','ln1_w.2','ln1_w.3','ln2_w.0','ln2_w.1','ln2_w.2','ln2_w.3']:\n    a = z[k].astype(np.float64)\n    imin = int(np.argmin(a))\n    imax = int(np.argmax(a))\n    srt = np.argsort(a)\n    print(k, 'min_idx', imin, round(float(a[imin]),5), 'max_idx', imax, round(float(a[imax]),5), '5smallest', srt[:5].tolist(), [round(float(a[i]),4) for i in srt[:5]])\n\nfor k in ['ln1_b.0','ln1_b.1','ln1_b.2','ln1_b.3','ln2_b.0','ln2_b.1','ln2_b.2','ln2_b.3']:\n    a = z[k].astype(np.float64)\n    idx = np.argsort(-np.abs(a))[:5]\n    print(k, 'topabs_idx', idx.tolist(), [round(float(a[i]),4) for i in idx])\n\n# 2. row norms for O/proj -> confirm 21/184\nfor k in ['W_o.0','W_o.1','W_o.2','W_o.3','W_proj.0','W_proj.1','W_proj.2','W_proj.3']:\n    a = z[k].astype(np.float64)\n    rn = np.sqrt((a**2).sum(axis=1))\n    top = np.argsort(-rn)[:5]\n    print(k, 'row_top', top.tolist(), [round(float(rn[i]),3) for i in top], 'row21', round(float(rn[21]),3), 'row184', round(float(rn[184]),3))\n\n# 3. col norms for Q/K/V -> confirm 21/99\nfor k in ['W_q.0','W_q.1','W_q.2','W_q.3','W_k.0','W_k.1','W_k.2','W_k.3','W_v.0','W_v.1','W_v.2','W_v.3']:\n    a = z[k].astype(np.float64)\n    cn = np.sqrt((a**2).sum(axis=0))\n    top = np.argsort(-cn)[:5]\n    print(k, 'col_top', top.tolist(), [round(float(cn[i]),3) for i in top])\n\n# 4. detail L1 highway neuron 1139\nfc1 = z['W_fc.1'].astype(np.float64)\nproj1 = z['W_proj.1'].astype(np.float64)\nprint('L1-neuron1139 fc_row mean', round(float(fc1[1139].mean()),5), 'std', round(float(fc1[1139].std()),5), 'norm', round(float(np.sqrt((fc1[1139]**2).sum())),3))\nprint('L1-neuron1139 proj_col norm', round(float(np.sqrt((proj1[:,1139]**2).sum())),3), 'proj184_1139', round(float(proj1[184,1139]),4))\nprint('L1-proj row184 norm', round(float(np.sqrt((proj1[184]**2).sum())),3), 'row184 mean', round(float(proj1[184].mean()),5), 'top in row184', np.argsort(-np.abs(proj1[184]))[:5].tolist())\nprint('L1-fc row1139 top cols', np.argsort(-np.abs(fc1[1139]))[:5].tolist())\n\n# 5. detail L0 neurons 1514 and row21/184 cross-layer\nfor lyr in [0,1,2,3]:\n    fc = z['W_fc.'+str(lyr)].astype(np.float64)\n    proj = z['W_proj.'+str(lyr)].astype(np.float64)\n    o = z['W_o.'+str(lyr)].astype(np.float64)\n    print('lyr', lyr, 'o_row21_norm', round(float(np.sqrt((o[21]**2).sum())),3), 'o_row184_norm', round(float(np.sqrt((o[184]**2).sum())),3), 'proj_row184_norm', round(float(np.sqrt((proj[184]**2).sum())),3))\nprint('done')\n", "out": "loaded ['ln1_w.0', 'ln1_b.0', 'W_q.0', 'W_k.0', 'W_v.0']\nln1_w.0 min_idx 381 0.03522 max_idx 180 0.97846 5smallest [381, 42, 95, 17, 147] [0.0352, 0.0606, 0.0607, 0.0622, 0.0673]\nln1_w.1 min_idx 52 0.19701 max_idx 21 1.08462 5smallest [52, 184, 227, 165, 192] [0.197, 0.2495, 0.2585, 0.2647, 0.286]\nln1_w.2 min_idx 383 0.3175 max_idx 21 1.09272 5smallest [383, 184, 39, 336, 58] [0.3175, 0.3373, 0.4223, 0.467, 0.4775]\nln1_w.3 min_idx 383 0.4078 max_idx 333 0.81546 5smallest [383, 58, 39, 45, 266] [0.4078, 0.4661, 0.4723, 0.5111, 0.5241]\nln2_w.0 min_idx 372 0.04203 max_idx 150 1.77496 5smallest [372, 354, 21, 163, 99] [0.042, 0.0926, 0.1141, 0.1286, 0.187]\nln2_w.1 min_idx 21 0.00187 max_idx 242 1.51965 5smallest [21, 99, 163, 58, 39] [0.0019, 0.0568, 0.2201, 0.2217, 0.3414]\nln2_w.2 min_idx 21 0.01202 max_idx 322 1.50783 5smallest [21, 184, 99, 58, 39] [0.012, 0.6113, 0.6119, 0.657, 0.6932]\nln2_w.3 min_idx 21 0.2328 max_idx 240 1.45324 5smallest [21, 184, 99, 58, 39] [0.2328, 0.7243, 0.7352, 0.8134, 0.8524]\nln1_b.0 topabs_idx [312, 146, 12, 104, 289] [-0.0954, 0.0906, 0.0856, -0.0841, 0.0826]\nln1_b.1 topabs_idx [39, 58, 99, 184, 383] [-1.5676, 1.3651, -1.3355, -0.5617, -0.4622]\nln1_b.2 topabs_idx [99, 58, 39, 383, 184] [-1.6589, 1.3318, -1.1991, -0.507, -0.5046]\nln1_b.3 topabs_idx [58, 99, 5, 383, 266] [0.8241, -