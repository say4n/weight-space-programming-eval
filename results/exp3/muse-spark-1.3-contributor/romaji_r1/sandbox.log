{"t": 1793707837.100655, "s": 0.17, "code": "import os, fnmatch\ndef search(root, max_files=200):\n    hits=[]\n    count=0\n    for dirpath, dirnames, filenames in os.walk(root, topdown=True, followlinks=False):\n        # prune blocked\n        # avoid huge dirs\n        if len(dirpath.split(os.sep))>8:\n            dirnames[:]=[]\n            continue\n        for fn in filenames:\n            count+=1\n            if \"romaji\" in fn.lower() or \"weight\" in fn.lower():\n                hits.append(os.path.join(dirpath,fn))\n                print(\"HIT\",os.path.join(dirpath,fn))\n                if len(hits)>50:\n                    return hits\n        if count>5000:\n            print(\"stop count at\",dirpath,count)\n            return hits\n    print(\"done\",root,\"scanned\",count,\"hits\",len(hits))\n    return hits\nfor r in [\"/tmp\", \"/Users/sayan/scratchpad\"]:\n    try:\n        print(\"=== search\",r,\"===\")\n        search(r)\n    except Exception as e:\n        print(\"search fail\",r,repr(e))\n", "out": "=== search /tmp ===\nstop count at /tmp/kt/lib/python3.12/site-packages/pygame 5080\n=== search /Users/sayan/scratchpad ===\ndone /Users/sayan/scratchpad scanned 68 hits 0\n"}
