=0.068745 min=0.3175 max=1.0927\nln1_b.2 (384,) float32 mean=0.013054 std=0.156454 min=-1.6589 max=1.3318\nW_q.2 (384, 384) float32 mean=0.000083 std=0.101309 min=-0.4865 max=0.4916\nW_k.2 (384, 384) float32 mean=0.000015 std=0.095703 min=-1.2235 max=1.1936\nW_v.2 (384, 384) float32 mean=-0.000035 std=0.086413 min=-0.4009 max=0.3919\nW_o.2 (384, 384) float32 mean=-0.000005 std=0.084465 min=-0.5312 max=0.5185\nln2_w.2 (384,) float32 mean=1.310406 std=0.114848 min=0.0120 max=1.5078\nln2_b.2 (384,) float32 mean=0.012291 std=0.173720 min=-0.5170 max=0.4489\nW_fc.2 (1536, 384) float32 mean=0.000387 std=0.103942 min=-0.5244 max=0.5953\nW_proj.2 (384, 1536) float32 mean=-0.000071 std=0.101625 min=-0.5107 max=0.8014\nln1_w.3 (384,) float32 mean=0.708749 std=0.049413 min=0.4078 max=0.8155\nln1_b.3 (384,) float32 mean=0.029631 std=0.099392 min=-0.7639 max=0.8241\nW_q.3 (384, 384) float32 mean=-0.000082 std=0.086559 min=-0.3908 max=0.4595\nW_k.3 (384, 384) float32 mean=-0.000025 std=0.084540 min=-0.9139 max=0.9735\nW_v.3 (384, 384) float32 mean=0.000043 std=0.102661 min=-0.5080 max=0.5939\nW_o.3 (384, 384) float32 mean=0.000009 std=0.104513 min=-1.5167 max=1.5269\nln2_w.3 (384,) float32 mean=1.266806 std=0.089446 min=0.2328 max=1.4532\nln2_b.3 (384,) float32 mean=0.012795 std=0.141279 min=-0.5402 max=0.3932\nW_fc.3 (1536, 384) float32 mean=0.000252 std=0.101900 min=-0.4902 max=0.5500\nW_proj.3 (384, 1536) float32 mean=0.000283 std=0.110832 min=-1.0584 max=1.4766\n"}
{"t": 1793707733.012734, "s": 0.09, "code": "import numpy as np\nd=np.load(\"blocks.npz\")\ndef head_norms(W, axis_split=1, n_head=6):\n    # try split columns\n    if axis_split==1:\n        chunks=np.split(W, n_head, axis=1)\n    else:\n        chunks=np.split(W, n_head, axis=0)\n    return [float(np.linalg.norm(c)) for c in chunks], chunks\nfor layer in [0]:\n    Wq=d[f\"W_q.{layer}\"]; Wk=d[f\"W_k.{layer}\"]\n    n,_c=np.split(Wq,6,axis=1)\n    print(\"layer\",layer,\"Wq col-split norms:\",[float(np.linalg.norm(c)) for c in np.split(Wq,6,axis=1)])\n    print(\"Wk col-split norms:\",[float(np.linalg.norm(c)) for c in np.split(Wk,6,axis=1)])\n    Wv=d[f\"W_v.{layer}\"]; Wo=d[f\"W_o.{layer}\"]\n    print(\"Wv col-split:\",[float(np.linalg.norm(c)) for c in np.split(Wv,6,axis=1)])\n    print(\"Wo row-split:\",[float(np.linalg.norm(c)) for c in np.split(Wo,6,axis=0)])\n    print(\"Wo col-split:\",[float(np.linalg.norm(c)) for c in np.split(Wo,6,axis=1)])\n    # QK circuits both orientations for H0,H3,H5\n    for h in [0,3,5]:\n        q=np.split(Wq,6,axis=1)[h]\n        k=np.split(Wk,6,axis=1)[h]\n        QK_big=q@k.T\n        QK_small=q.T@k\n        print(f\"H{h} big frob={np.linalg.norm(QK_big):.2f} small frob={np.linalg.norm(QK_small):.2f} tr={np.trace(QK_big):.2f} tr_small={np.trace(QK_small):.2f}\")\n    # OV both orientations\n    for h in [0,3,5]:\n        v=np.split(Wv,6,axis=1)[h]\n        o_row=np.split(Wo,6,axis=0)[h]\n        o_col=np.split(Wo,6,axis=1)[h]\n        print(f\"H{h} OV row: o({o_row.shape})v({v.shape}) OV1=o@v={np.linalg.norm(o_row@v):.2f} tr={np.trace(o_row@v):.2f} OV2=v@o={np.linalg.norm(v@o_row):.2f} tr={np.trace(v@o_row):.2f}\")\n", "out": "\n[stderr]\nTraceback (most recent call last):\n  File \"<string>\", line 15, in <module>\nValueError: too many values to unpack (expected 2)\n"}
{"t": 1793707738.591407, "s": 0.07, "code": "import numpy as np\nd=np.load(\"blocks.npz\")\nfor layer in [0]:\n    Wq=d[f\"W_q.{layer}\"]; Wk=d[f\"W_k.{layer}\"]\n    print(\"Wq col-split norms:\",[float(np.linalg.norm(c)) for c in np.split(Wq,6,axis=1)])\n    print(\"Wk col-split norms:\",[float(np.linalg.norm(c)) for c in np.split(Wk,6,axis=1)])\n    Wv=d[f\"W_v.{layer}\"]; Wo=d[f\"W_o.{layer}\"]\n    print(\"Wv col-split:\",[float(np.linalg.norm(c)) for c in np.split(Wv,6,axis=1)])\n    print(\"Wo row-split:\",[float(np.linalg.norm(c)) for c in np.split(Wo,6,axis=0)])\n    print(\"Wo col-split:\",[float(np.linalg.norm(c)) for c in np.split(Wo,6,axis=1)])\n    for h in [0,3,5]:\n        q=np.split(Wq,6,axis=1)[h]\n        k=np.split(Wk,6,axis=1)[h]\n        QK_big=q@k.T\n        QK_small=q.T@k\n        print(f\"H{h} big frob={np.linalg.norm(QK_big):.2f} small frob={np.linalg.norm(QK_small):.2f} tr={np.trace(QK_big):.2f} tr_small={np.trace(QK_small):.2f}\")\n    for h in [0,3,5]:\n        v=np.split(Wv,6,axis=1)[h]\n        o_row=np.split(Wo,6,axis=0)[h]\n        print(f\"H{h} shapes o{o_row.shape} v{v.shape} v@o frob={np.linalg.norm(v@o_row):.2f} tr={np.trace(v@o_row):.2f} o@v frob={np.linalg.norm(o_row@v):.2f} tr={np.trace(o_row@v):.2f}\")\n", "out": "Wq col-split norms: [7.487449645996094, 6.9365034103393555, 7.122413158416748, 7.31229829788208, 7.330658435821533, 7.077395915985107]\nWk col-split norms: [7.671998977661133, 7.383116245269775, 7.635391712188721, 7.846006870269775, 7.579227447509766, 7.223025798797607]\nWv col-split: [6.1111836433410645, 6.181969165802002, 6.1455230712890625, 6.110808372497559, 6.003168106079102, 6.03264045715332]\nWo row-split: [10.409011840820312, 6.564160346984863, 5.771674156188965, 5.471519470214844, 5.465321063995361, 5.415814399719238]\nWo col-split: [6.12699556350708, 4.824526309967041, 4.360475540161133, 9.4445219039917, 3.6569511890411377, 9.564732551574707]\nH0 big frob=9.80 small frob=6.63 tr=5.81 tr_small=5.81\nH3 big frob=9.92 small frob=6.54 tr=6.11 tr_small=6.11\nH5 big frob=8.69 small frob=5.69 tr=4.09 tr_small=4.09\nH0 shapes o(64, 384) v(384, 64) v@o frob=9.34 tr=-1.24 o@v frob=14.85 tr=-1.24\nH3 shapes o(64, 384) v(384, 64) v@o frob=4.06 tr=-1.46 o@v frob=2.95 tr=-1.46\nH5 shapes o(64, 384) v(384, 64) v@o frob=3.92 tr=-1.56 o@v frob=3.39 tr=-1.56\n"}
{"t": 1793707778.296494, "s": 0.06, "code": "import numpy as np\nd=np.load(\"blocks.npz\")\nfor layer in [0,1]:\n    print(\"== layer\",layer,\"==\")\n    for name in [\"W_q\",\"W_k\",\"W_v\",\"W_o\"]:\n        W=d[f\"{name}.{layer}\"]\n        col=[float(np.linalg.norm(c)) for c in np.split(W,6,axis=1)]\n        row=[float(np.linalg.norm(c)) for c in np.split(W,6,axis=0)]\n        print(name,\"col:\",[\"%.2f\"%x for x in col],\"row:\",[\"%.2f\"%x for x in row])\n", "out": "== layer 0 ==\nW_q col: ['7.49', '6.94', '7.12', '7.31', '7.33', '7.08'] row: ['7.14', '4.49', '4.07', '14.14', '4.20', '2.63']\nW_k col: ['7.67', '7.38', '7.64', '7.85', '7.58', '7.22'] row: ['7.40', '4.93', '4.36', '14.66', '4.61', '2.94']\nW_v col: ['6.11', '6.18', '6.15', '6.11', '6.00', '6.03'] row: ['5.92', '4.32', '4.02', '8.26', '3.69', '8.45']\nW_o col: ['6.13', '4.82', '4.36', '9.44', '3.66', '9.56'] row: ['10.41', '6.56', '5.77', '5.47', '5.47', '5.42']\n== layer 1 ==\nW_q col: ['15.86', '15.96', '15.84', '16.06', '15.87', '15.77'] row: ['16.63', '16.02', '15.58', '15.75', '15.20', '16.15']\nW_k col: ['19.37', '15.65', '12.13', '12.37', '12.16', '12.22'] row: ['14.95', '14.34', '14.14', '13.95', '13.64', '14.42']\nW_v col: ['11.51', '11.69', '11.74', '11.79', '11.84', '11.83'] row: ['11.76', '11.24', '11.74', '11.80', '12.73', '11.07']\nW_o col: ['11.71', '11.40', '11.38', '11.88', '12.11', '11.24'] row: ['11.61', '11.61', '11.75', '11.55', '11.69', '11.55']\n"}
{"t": 1793707792.89461, "s": 0.08, "code": "import numpy as np\nd=np.load(\"blocks.npz\")\ndef get_heads(layer):\n    Wq=d[f\"W_q.{layer}\"]; Wk=d[f\"W_k.{layer}\"]; Wv=d[f\"W_v.{layer}\"]; Wo=d[f\"W_o.{layer}\"]\n    Qs=np.split(Wq,6,axis=0)\n    Ks=np.split(Wk,6,axis=0)\n    Vs=np.split(Wv,6,axis=0)\n    Os=np.split(Wo,6,axis=1)\n    return Qs,Ks,Vs,Os\nfor layer in [0,1,2,3]:\n    Qs,Ks,Vs,Os=get_heads(layer)\n    print(f\"== Layer {layer} ==\")\n    for h in range(6):\n        q,k,v,o=Qs[h],Ks[h],Vs[h],Os[h]\n        QK_small=q@k.T\n        QK_big=q.T@k\n        OV_small=v@o\n        OV_big=o@v\n        print(f\"H{h} QK_small={np.linalg.norm(QK_small):.2f} QK_big={np.linalg.norm(QK_big):.2f} tr={np.trace(QK_small):.2f} OV_small={np.linalg.norm(OV_small):.2f} OV_big={np.linalg.norm(OV_big):.2f} trOV={np.trace(OV_small):.2f}\")\n", "out": "== Layer 0 ==\nH0 QK_small=7.01 QK_big=11.06 tr=-12.96 OV_small=1.47 OV_big=7.88 trOV=-0.68\nH1 QK_small=3.76 QK_big=7.60 tr=-6.78 OV_small=2.14 OV_big=6.87 trOV=0.53\nH2 QK_small=2.47 QK_big=5.07 tr=-4.79 OV_small=1.53 OV_big=4.90 trOV=0.28\nH3 QK_small=32.21 QK_big=34.44 tr=61.13 OV_small=3.73 OV_big=14.07 trOV=-7.45\nH4 QK_small=2.22 QK_big=5.09 tr=-4.36 OV_small=0.98 OV_big=3.12 trOV=-0.41\nH5 QK_small=0.48 QK_big=1.68 tr=-0.41 OV_small=6.83 OV_big=29.44 trOV=2.35\n== Layer 1 ==\nH0 QK_small=24.97 QK_big=52.84 tr=-55.60 OV_small=8.00 OV_big=22.13 trOV=-30.07\nH1 QK_small=21.32 QK_big=48.26 tr=-46.75 OV_small=7.91 OV_big=21.59 trOV=-29.58\nH2 QK_small=22.19 QK_big=45.70 tr=-58.09 OV_small=8.74 OV_big=22.75 trOV=-33.61\nH3 QK_small=20.60 QK_big=45.90 tr=-46.54 OV_small=8.96 OV_big=23.88 trOV=-36.07\nH4 QK_small=20.00 QK_big=42.43 tr=-61.24 OV_small=9.81 OV_big=25.84 trOV=-37.33\nH5 QK_small=22.61 QK_big=48.98 tr=-49.66 OV_small=7.70 OV_big=20.97 trOV=-28.92\n== Layer 2 ==\nH0 QK_small=12.06 QK_big=26.83 tr=-26.97 OV_small=9.16 OV_big=23.75 trOV=-24.51\nH1 QK_small=14.97 QK_big=36.39 tr=-4.09 OV_small=11.57 OV_big=25.60 trOV=-5