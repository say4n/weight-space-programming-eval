{"t": 1793697690.529152, "s": 0.07, "code": "import numpy as np\nz = np.load('blocks.npz')\ndef top5_idx(vals):\n    idx = np.argsort(-vals)[:5]\n    return idx.tolist(), [round(float(vals[i]),3) for i in idx]\nprint('--- QKV O row AND col ---')\nfor k in ['W_q.0','W_q.1','W_q.2','W_q.3','W_k.0','W_k.1','W_k.2','W_k.3','W_v.0','W_v.1','W_v.2','W_v.3','W_o.0','W_o.1','W_o.2','W_o.3']:\n    a = z[k].astype(np.float64)\n    rn = np.sqrt((a**2).sum(axis=1))\n    cn = np.sqrt((a**2).sum(axis=0))\n    ridx, rval = top5_idx(rn)\n    cidx, cval = top5_idx(cn)\n    print(k, 'row_top', ridx, rval, 'col_top', cidx, cval)\nprint('--- FC col input vs row neuron ---')\nfor lyr in [0,1,2,3]:\n    a = z['W_fc.'+str(lyr)].astype(np.float64)\n    rn = np.sqrt((a**2).sum(axis=1))\n    cn = np.sqrt((a**2).sum(axis=0))\n    ridx, rval = top5_idx(rn)\n    cidx, cval = top5_idx(cn)\n    print('W_fc.'+str(lyr), 'neuron_row_top', ridx, rval, 'input_col_top', cidx, cval, 'col21', round(float(cn[21]),3), 'col184', round(float(cn[184]),3), 'col39', round(float(cn[39]),3), 'col58', round(float(cn[58]),3), 'col99', round(float(cn[99]),3))\nprint('--- Proj col neuron vs row output ---')\nfor lyr in [0,1,2,3]:\n    a = z['W_proj.'+str(lyr)].astype(np.float64)\n    rn = np.sqrt((a**2).sum(axis=1))\n    cn = np.sqrt((a**2).sum(axis=0))\n    ridx, rval = top5_idx(rn)\n    cidx, cval = top5_idx(cn)\n    print('W_proj.'+str(lyr), 'out_row_top', ridx, rval, 'neuron_col_top', cidx, cval)\nprint('--- QK overlap: do Q and K share input dims? ---')\nfor lyr in [0,1,2,3]:\n    q = z['W_q.'+str(lyr)].astype(np.float64)\n    k = z['W_k.'+str(lyr)].astype(np.float64)\n    qcn = np.sqrt((q**2).sum(axis=0))\n    kcn = np.sqrt((k**2).sum(axis=0))\n    prod = qcn * kcn\n    idx, val = top5_idx(prod)\n    print('lyr', lyr, 'QK_colprod_top', idx, val)\nprint('done')\n", "out": "--- QKV O row AND col ---\nW_q.0 row_top [240, 212, 201, 210, 205] [2.304, 2.294, 2.186, 2.173, 2.17] col_top [256, 21, 10, 314, 191] [1.377, 1.314, 1.209, 1.195, 1.168]\nW_q.1 row_top [211, 31, 25, 378, 21] [2.486, 2.365, 2.353, 2.351, 2.347] col_top [184, 225, 259, 47, 241] [2.65, 2.402, 2.386, 2.372, 2.365]\nW_q.2 row_top [304, 358, 347, 382, 266] [2.253, 2.252, 2.252, 2.245, 2.243] col_top [184, 334, 199, 124, 364] [2.223, 2.221, 2.203, 2.172, 2.17]\nW_q.3 row_top [28, 0, 41, 51, 12] [2.098, 2.082, 2.077, 2.065, 2.063] col_top [45, 75, 103, 243, 50] [1.935, 1.933, 1.901, 1.871, 1.863]\nW_k.0 row_top [201, 212, 240, 210, 231] [2.244, 2.235, 2.228, 2.161, 2.158] col_top [162, 211, 180, 99, 184] [1.653, 1.486, 1.466, 1.445, 1.435]\nW_k.1 row_top [57, 378, 52, 21, 211] [2.187, 2.168, 2.163, 2.152, 2.137] col_top [21, 99, 39, 58, 209] [10.61, 10.134, 7.835, 7.707, 2.007]\nW_k.2 row_top [329, 120, 361, 341, 367] [2.201, 2.138, 2.136, 2.134, 2.133] col_top [21, 99, 39, 58, 163] [9.312, 6.694, 5.385, 4.962, 2.014]\nW_k.3 row_top [36, 28, 9, 41, 12] [2.039, 2.029, 2.028, 2.022, 2.019] col_top [21, 99, 39, 58, 383] [5.98, 3.582, 3.179, 2.818, 1.919]\nW_v.0 row_top [363, 336, 225, 3, 366] [2.011, 1.721, 1.686, 1.644, 1.64] col_top [211, 223, 228, 65, 162] [1.364, 1.265, 1.184, 1.157, 1.154]\nW_v.1 row_top [260, 265, 220, 299, 122] [2.007, 1.918, 1.876, 1.872, 1.821] col_top [206, 353, 306, 326, 325] [1.703, 1.701, 1.7, 1.679, 1.678]\nW_v.2 row_top [231, 255, 223, 67, 225] [1.937, 1.908, 1.897, 1.88, 1.879] col_top [13, 131, 234, 284, 282] [1.877, 1.874, 1.867, 1.863, 1.847]\nW_v.3 row_top [301, 258, 300, 317, 282] [2.675, 2.652, 2.609, 2.599, 2.559] col_top [232, 233, 145, 2, 235] [2.356, 2.328, 2.316, 2.312, 2.309]\nW_o.0 row_top [21, 39, 58, 99, 184] [6.042, 5.246, 3.982, 3.901, 2.167] col_top [3, 225, 249, 233, 242] [1.892, 1.773, 1.718, 1.682, 1.68]\nW_o.1 row_top [184, 39, 383, 209, 105] [2.773, 2.398, 1.743, 1.644, 1.643] col_top [260, 220, 122, 265, 250] [1.853, 1.801, 1.788, 1.784, 1.762]\nW_o.2 row_top [184, 39, 58, 383, 52] [3.25, 2.762, 2.413, 2.092, 1.931] col_top [231, 223, 160, 225, 134] [1.873, 1.835, 1.818, 1.816, 1.812]\nW_o.3 row_top [21, 39, 184, 99, 58] [10.125, 5.364, 3.96, 3.884, 3.297] col_top [309, 272, 317, 258, 301] [2.688, 2.662, 2.627, 2.626, 2.624]\n--- FC col input vs row neuron ---\nW_fc.0 neuron_row_top [1514, 524, 169, 905, 1356] [4.502, 4.152, 4.005, 3.655, 3.58] input_col_top [168, 67, 123, 142, 150] [3.859, 3.725, 3.723, 3.713, 3.699] col21 1.419 col184 1.893 col39 2.556 col58 2.585 col99 2.318\nW_fc.1 neuron_row_top [1139, 380, 950, 224, 765] [3.192, 3.129, 3.007, 2.923, 2.775] input_col_top [270, 103, 297, 160, 215] [4.407, 4.377, 4.373, 4.367, 4.367] col21 2.242 col184 3.05 col39 2.283 col58 2.341 col99 2.271\nW_fc.2 neuron_row_top [464, 963, 438, 883, 545] [2.507, 2.463, 2.402, 2.401, 2.399] input_col_top [221, 35, 223, 288, 245] [4.25, 4.247, 4.245, 4.243, 4.24] col21 3.298 col184 3.213 col39 2.397 col58 2.493 col99 2.398\nW_fc.3 neuron_row_top [583, 337, 832, 1112, 1487] [3.194, 3.071, 2.923, 2.866, 2.812] input_col_top [368, 353, 208, 10, 131] [4.181, 4.17, 4.142, 4.142, 4.141] col21 3.515 col184 2.685 col39 2.585 col58 3.231 col99 3.589\n--- Proj col neuron vs row output ---\nW_proj.0 out_row_top [184, 21, 266, 383, 294] [8.562, 5.174, 3.414, 3.25, 3.099] neuron_col_top [1206, 334, 836, 550, 294] [3.825, 3.769, 3.541, 3.346, 3.311]\nW_proj.1 out_row_top [184, 383, 5, 344, 346] [5.777, 4.617, 4.193, 4.14, 4.133] neuron_col_top [950, 1139, 765, 380, 1106] [2.871, 2.828, 2.651, 2.57, 2.523]\nW_proj.2 out_row_top [184, 383, 77, 39, 377] [5.828, 4.378, 4.288, 4.25, 4.238] neuron_col_top [963, 438, 1238, 545, 858] [2.731, 2.61, 2.481, 2.406, 2.405]\nW_proj.3 out_row_top [184, 39, 5, 383, 219] [13.494, 10.63, 10.37, 8.719, 8.274] neuron_col_top [1155, 1363, 827, 1466, 1219] [3.971, 3.505, 3.425, 3.397, 3.384]\n--- QK overlap: do Q and K share input dims? ---\nlyr 0 QK_colprod_top [256, 162, 184, 180, 211] [1.928, 1.576, 1.568, 1.524, 1.494]\nlyr 1 QK_colprod_top [99, 39, 58, 21, 209] [18.141, 14.089, 13.609, 11.639, 4.381]\nlyr 2 QK_colprod_top [21, 99, 39, 58, 163] [11.577, 10.764, 8.627, 6.811, 4.126]\nlyr 3 QK_colprod_top [21, 99, 58, 39, 63] [8.566, 5.443, 4.479, 4.427, 3.318]\ndone\n"}
{"t": 1793697716.9842181, "s": 0.08, "code": "import numpy as np\nz = np.load('blocks.npz')\ndef head_sums(mat, nheads):\n    # mat (384,384) rows = output head-dim, cols = input\n    # split rows into nheads chunks\n    h = 384 // nheads\n    rn = np.sqrt((mat.astype(np.float64)**2).sum(axis=1))\n    sums = []\n    for i in range(nheads):\n        s = rn[i*h:(i+1)*h].sum()\n        sums.append(round(float(s),2))\n    return sums\nfor nheads in [4,6,8,12]:\n    print('nheads', nheads, 'chunk', 384//nheads)\n    for k in ['W_o.0','W_o.1','W_o.2','W_o.3','W_q.1','W_k.1']:\n        print(k, head_sums(z[k], nheads))\n    print('---')\n# where do 21,39,58,99,184,383 fall?\nfor nheads in [4,6,8]:\n    h = 384//nheads\n    for d in [21,39,58,99,184,383,52,209]:\n        print('dim', d, 'head', d//h, 'for nheads', nheads)\n# O row21 vs row39 correlation? same input pattern?\nfor lyr in [0,3]:\n    o = z['W_o.'+str(lyr)].astype(np.float64)\n    # cosine between outlier rows\n    for a,b in [(21,39),(21,58),(21,99),(21,184),(39,58)]:\n        va = o[a]; vb = o[b]\n        cos = float((va*vb).sum()/max(np.sqrt((va**2).sum()*(vb**2).sum()),1e-12))\n        print('lyr',lyr,'cos Orow',a,b,round(cos,3))\nprint('done')\n", "out": "nheads 4 chunk 96\nW_o.0 [77.7, 67.78, 65.03, 64.13]\nW_o.1 [138.84, 139.21, 139.05, 138.79]\nW_o.2 [158.97, 159.07, 157.9, 157.57]\nW_o.3 [200.3, 189.85, 186.66, 186.8]\nW_q.1 [197.36, 187.33, 185.21, 190.13]\nW_k.1 [176.7, 169.53, 164.83, 169.92]\n---\nnheads 6 chunk 64\nW_o.0 [56.5, 45.13, 43.85, 43.38, 43.23, 42.55]\nW_o.1 [92.06, 92.72, 93.27, 92.27, 93.34, 92.22]\nW_o.2 [106.57, 105.0, 106.47, 105.15, 105.44, 104.88]\nW_o.3 [137.96, 125.74, 126.45, 124.73, 123.42, 125.31]\nW_q.1 [132.68, 127.82, 124.19, 125.47, 121.13, 128.74]\nW_k.1 [119.23, 114.3, 112.71, 111.12, 108.71, 114.92]\n---\nnheads 8 chunk 48\nW_o.0 [42.33, 35.38, 34.43, 33.36, 33.15, 31.88, 32.42, 31.71]\nW_o.1 [69.66, 69.18, 68.97, 70.24, 69.71, 69.34, 69.71, 69.09]\nW_o.2 [79.16, 79.81, 78.25, 80.81, 78.83, 79.07, 78.47, 79.1]\nW_o.3 [105.66, 94.64, 94.63, 95.21, 93.63, 93.03, 93.17, 93.63]\nW_q.1 [99.31, 98.05, 94.88, 92.44, 93.85, 91.36, 93.8, 96.33]\nW_k.1 [89.28, 87.42, 85.28, 84.25, 82.97, 81.86, 83.7, 86.22]\n---\nnheads 12 chunk 32\nW_o.0 [26.95, 29.56, 21.2, 23.93, 21.25, 22.6, 22.27, 21.11, 21.65, 21.58, 22.25, 20.3]\nW_o.1 [45.7, 46.36, 46.78, 45.94, 46.53, 46.74, 46.78, 45.49, 46.77, 46.57, 45.87, 46.35]\nW_o.2 [51.65, 54.91, 52.4, 52.6, 52.16, 54.31, 52.82, 52.33, 52.75, 52.68, 51.81, 53.07]\nW_o.3 [70.94, 67.02, 62.34, 63.4, 62.19, 64.27, 62.31, 62.42, 61.93, 61.49, 62.41, 62.9]\nW_q.1 [65.77, 66.91, 64.68, 63.14, 62.47, 61.71, 63.17, 62.31, 59.74, 61.39, 63.33, 65.41]\nW_k.1 [59.5, 59.73, 57.47, 56.83, 56.2, 56.5, 55.54, 55.58, 53.71, 55.0, 56.62, 58.3]\n---\ndim 21 head 0 for nheads 4\ndim 39 head 0 for nheads 4\ndim 58 head 0 for nheads 4\ndim 99 head 1 for nheads 4\ndim 184 head 1 for nheads 4\ndim 383 head 3 for nheads 4\ndim 52 head 0 for nheads 4\ndim 209 head 2 for nheads 4\ndim 21 head 0 for nheads 6\ndim 39 head 0 for nheads 6\ndim 58 head 0 for nheads 6\ndim 99 head 1 for nheads 6\ndim 184 head 2 for nheads 6\ndim 383 head 5 for nheads 6\ndim 52 head 0 for nheads 6\ndim 209 head 3 for nheads 6\ndim 21 head 0 for nheads 8\ndim 39 head 0 for nheads 8\ndim 58 head 1 for nheads 8\ndim 99 head 2 for nheads 8\ndim 184 head 3 for nheads 8\ndim 383 head 7 for nheads 8\ndim 52 head 1 for nheads 8\ndim 209 head 4 for nheads 8\nlyr 0 cos Orow 21 39 0.024\nlyr 0 cos Orow 21 58 -0.1\nlyr 0 cos Orow 21 99 0.343\nlyr 0 cos Orow 21 184 -0.174\nlyr 0 cos Orow 39 58 -0.95\nlyr 3 cos Orow 21 39 -0.145\nlyr 3 cos Orow 21 58 -0.017\nlyr 3 cos Orow 21 99 0.337\nlyr 3 cos Orow 21 184 -0.091\nlyr 3 cos Orow 39 58 -0.42\ndone\n"}
{"t": 1793697743.274982, "s": 0.51, "code": "import numpy as np, os, sys\nprint('python', sys.version.split()[0])\ntry:\n    import torch\n    print('torch', torch.__version__)\nexcept Exception as e:\n    print('torch import', e)\n# safe env, no .. access\nfor k in ['PWD','PYTHONPATH','EVAL','TASK','VOCAB']:\n    print(k, os.environ.get(k,'-'))\n\nz = np.load('blocks.npz')\n# simulate Pre-LN block L1 with random tokens to see massive dims\nrng = np.random.default_rng(0)\ndef ln(x, w, b, eps=1e-5):\n    m = x.mean(axis=-1, keepdims=True)\n    v = ((x-m)**2).mean(axis=-1, keepdims=True)\n    return (x-m)/np.sqrt(v+eps)*w + b\nfor lyr in [1,2]:\n    w1 = z['ln1_w.'+str(lyr)].astype(np.float64)\n    b1 = z['ln1_b.'+str(lyr)].astype(np.float64)\n    w2 = z['ln2_w.'+str(lyr)].astype(np.float64)\n    Wq = z['W_q.'+str(lyr)].astype(np.float64)\n    Wk = z['W_k.'+str(lyr)].astype(np.float64)\n    x = rng.standard_normal((4,384))\n    h = ln(x, w1, b1)\n    # per-dim abs mean after LN1\n    m = np.abs(h).mean(axis=0)\n    top = np.argsort(-m)[:6]\n    print('lyr',lyr,'LN1 out top dims', top.tolist(), [round(float(m[i]),3) for i in top])\n    Q = h @ Wq.T\n    K = h @ Wk.T\n    qm = np.abs(Q).mean(axis=0)\n    km = np.abs(K).mean(axis=0)\n    print('lyr',lyr,'Q abs top', np.argsort(-qm)[:5].tolist(), 'K abs top', np.argsort(-km)[:5].tolist())\n    # attention logits for token0 vs others, contribution per input dim d: Q0[d]*K[d] ?\n    # decompose logit = sum_d Q0[d]*K1[d]\n    q0 = Q[0]; k1 = K[1]\n    contrib = q0*k1\n    ct = np.argsort(-np.abs(contrib))[:6]\n    print('lyr',lyr,'logit contrib top dims', ct.tolist(), [round(float(contrib[i]),3) for i in ct], 'logit sum', round(float(contrib.sum()),3))\nprint('done')\n", "out": "python 3.12.13\ntorch 2.15.0\nPWD -\nPYTHONPATH -\nEVAL -\nTASK -\nVOCAB -\nlyr 1 LN1 out top dims [39, 99, 58, 21, 219, 291] [1.578, 1.385, 1.265, 1.104, 1.076, 1.026]\nlyr 1 Q abs top [19, 17, 174, 56, 180] K abs top [80, 377, 98, 73, 13]\nlyr 1 logit contrib top dims [118, 315, 73, 342, 380, 238] [-12.127, 11.68, -10.763, 9.67, 9.09, 9.054] logit sum 313.115\nlyr 2 LN1 out top dims [99, 39, 339, 107, 157, 255] [2.524, 1.404, 1.365, 1.128, 1.1, 1.08]\nlyr 2 Q abs top [112, 318, 74, 319, 9] K abs top [368, 362, 124, 293, 251]\nlyr 2 logit contrib top dims [139, 304, 293, 0, 373, 172] [-14.426, 10.87, -8.117, 7.807, -7.661, 7.37] logit sum -1.472\ndone\n"}
{"t": 1793697768.180305, "s": 0.07, "code": "import numpy as np\nz = np.load('blocks.npz')\nfor lyr in [1,2,0,3]:\n    Wq = z['W_q.'+str(lyr)].astype(np.float64)\n    Wk = z['W_k.'+str(lyr)].astype(np.float64)\n    Wo = z['W_o.'+str(lyr)].astype(np.float64)\n    M = Wq.T @ Wk\n    am = np.abs(M)\n    idx = np.argpartition(am.ravel(), -6)[-6:]\n    idx = idx[np.argsort(-am.ravel()[idx])]\n    print('lyr',lyr,'M=WqT@Wk top (i_qinput,j_kinput) val')\n    for k in idx:\n        i = int(k//384); j = int(k%384)\n        print(' ',i,j,round(float(M[i,j]),2))\n    # what are LN1 w/b at those i,j?\n    w1 = z['ln1_w.'+str(lyr)].astype(np.float64)\n    b1 = z['ln1_b.'+str(lyr)].astype(np.float64)\n    print('lyr',lyr,'w1/b1 at 21',round(float(w1[21]),3),round(float(b1[21]),3),'39',round(float(w1[39]),3),round(float(b1[39]),3),'58',round(float(w1[58]),3),round(float(b1[58]),3),'99',round(float(w1[99]),3),round(float(b1[99]),3),'184',round(float(w1[184]),3),round(float(b1[184]),3))\nprint('--- Wo*Wv? O row vs V col ---')\nfor lyr in [0,3]:\n    Wv = z['W_v.'+str(lyr)].astype(np.float64)\n    Wo = z['W_o.'+str(lyr)].astype(np.float64)\n    # effective map Vinput -> residual: Wo @ Wv  (if x row: x@WvT@WoT? need orientation, but magnitude check)\n    E = Wo @ Wv\n    am = np.abs(E)\n    idx = np.argpartition(am.ravel(), -4)[-4:]\n    idx = idx[np.argsort(-am.ravel()[idx])]\n    print('lyr',lyr,'E=Wo@Wv top (out_resid,in) ',[(int(k//384),int(k%384),round(float(E.flat[k]),2)) for k in idx])\nprint('done')\n", "out": "lyr 1 M=WqT@Wk top (i_qinput,j_kinput) val\n  184 21 -17.26\n  58 21 16.78\n  39 21 -16.76\n  99 21 -15.24\n  163 99 -13.44\n  126 21 -13.18\nlyr 1 w1/b1 at 21 1.085 -0.43 39 0.299 -1.568 58 0.375 1.365 99 0.716 -1.336 184 0.249 -0.562\nlyr 2 M=WqT@Wk top (i_qinput,j_kinput) val\n  39 21 -13.46\n  58 21 10.55\n  99 21 -9.71\n  21 99 7.98\n  21 39 5.8\n  99 39 5.74\nlyr 2 w1/b1 at 21 1.093 -0.453 39 0.422 -1.199 58 0.477 1.332 99 0.943 -1.659 184 0.337 -0.505\nlyr 0 M=WqT@Wk top (i_qinput,j_kinput) val\n  256 175 0.67\n  44 162 0.65\n  99 211 -0.61\n  256 271 -0.58\n  180 306 0.58\n  246 65 0.58\nlyr 0 w1/b1 at 21 0.535 -0.038 39 0.799 -0.008 58 0.45 0.032 99 0.917 0.016 184 0.974 0.047\nlyr 3 M=WqT@Wk top (i_qinput,j_kinput) val\n  39 21 -4.98\n  99 21 -4.77\n  21 99 4.7\n  21 39 3.78\n  21 58 -3.29\n  86 21 2.31\nlyr 3 w1/b1 at 21 0.802 -0.315 39 0.472 -0.232 58 0.466 0.824 99 0.751 -0.764 184 0.562 -0.289\n--- Wo*Wv? O row vs V col ---\nlyr 0 E=Wo@Wv top (out_resid,in)  [(21, 211, 7.39), (21, 223, -6.7), (21, 65, 6.07), (21, 228, -5.88)]\nlyr 3 E=Wo@Wv top (out_resid,in)  [(21, 47, 4.23), (21, 241, 4.22), (21, 358, 4.11), (21, 382, -4.1)]\ndone\n"}
{"t": 1793697801.7950149, "s": 0.09, "code": "import numpy as np, os\nprint('cwd', os.getcwd())\nprint('ls', sorted(os.listdir('.')))\nz = np.load('blocks.npz')\nprint('orig keys', len(z.files))\n# try write test file, not overwriting orig\na = z['W_proj.1'].astype(np.float64)\nprint('orig max', float(a.max()), 'at', np.unravel_index(int(np.argmax(a)), a.shape))\n# what would clipping do?\np99 = float(np.percentile(a, 99.9))\nprint('p99.9', round(p99,4), 'p99', round(float(np.percentile(a,99)),4), 'median abs', round(float(np.median(np.abs(a))),4))\n# LN dead channel restore candidate values\nfor k in ['ln2_w.1','ln2_w.2','ln1_w.0']:\n    v = z[k].astype(np.float64)\n    print(k, 'median', round(float(np.median(v)),4), 'mean', round(float(v.mean()),4), 'min_idx', int(np.argmin(v)), round(float(v.min()),5))\n# test write\ntry:\n    np.savez('blocks_test_write.npz', test=np.array([1,2,3]))\n    print('write ok', os.path.exists('blocks_test_write.npz'))\n    os.remove('blocks_test_write.npz')\n    print('remove ok')\nexcept Exception as e:\n    print('write fail', e)\nprint('done no overwrite')\n", "out": "cwd /Users/sayan/Projects/weight-space-programming/results/exp3/muse-spark-1.3-contributor/romaji_r1/work\nls ['blocks.npz']\norig keys 40\norig max 2.660118579864502 at (np.int64(184), np.int64(1139))\np99.9 0.317 p99 0.2361 median abs 0.0668\nln2_w.1 median 1.1552 mean 1.1315 min_idx 21 0.00187\nln2_w.2 median 1.3222 mean 1.3104 min_idx 21 0.01202\nln1_w.0 median 0.2422 mean 0.2965 min_idx 381 0.03522\nwrite ok True\nremove ok\ndone no overwrite\n"}
{"t": 1793697822.526169, "s": 0.08, "code": "import numpy as np\nz = np.load('blocks.npz')\nsink = [21,39,58,99,184]\nprint('sink set', sink)\nfor lyr in [0,1,2,3]:\n    Wq = z['W_q.'+str(lyr)].astype(np.float64)\n    Wk = z['W_k.'+str(lyr)].astype(np.float64)\n    Wo = z['W_o.'+str(lyr)].astype(np.float64)\n    M = Wq.T @ Wk\n    tot = float((M**2).sum())\n    # sink cols/rows in M: M[i,j] i=q_in, j=k_in\n    # energy where j in sink (K sink reads)\n    e_j = float((M[:, sink]**2).sum())/tot\n    # energy where i in sink\n    e_i = float((M[sink, :]**2).sum())/tot\n    e_both = float((M[np.ix_(sink,sink)]**2).sum())/tot\n    print('lyr',lyr,'M tot',round(tot,1),'frac j_sink',round(e_j,3),'i_sink',round(e_i,3),'both',round(e_both,3))\n    # O: row sink vs rest\n    tot_o = float((Wo**2).sum())\n    e_orow = float((Wo[sink,:]**2).sum())/tot_o\n    print('lyr',lyr,'Wo row_sink frac',round(e_orow,3),'row21',round(float((Wo[21]**2).sum()/tot_o),3),'row184',round(float((Wo[184]**2).sum()/tot_o),3))\n    # Proj row sink\n    P = z['W_proj.'+str(lyr)].astype(np.float64)\n    tot_p = float((P**2).sum())\n    e_prow = float((P[sink,:]**2).sum())/tot_p\n    # FC col sink (input sink ignored?)\n    F = z['W_fc.'+str(lyr)].astype(np.float64)\n    tot_f = float((F**2).sum())\n    e_fcol = float((F[:,sink]**2).sum())/tot_f\n    print('lyr',lyr,'Proj row_sink frac',round(e_prow,3),'FC col_sink frac',round(e_fcol,3))\nprint('done')\n", "out": "sink set [21, 39, 58, 99, 184]\nlyr 0 M tot 1412.0 frac j_sink 0.022 i_sink 0.02 both 0.001\nlyr 0 Wo row_sink frac 0.364 row21 0.133 row184 0.017\nlyr 0 Proj row_sink frac 0.047 FC col_sink frac 0.008\nlyr 1 M tot 30963.8 frac j_sink 0.566 i_sink 0.067 both 0.06\nlyr 1 Wo row_sink frac 0.021 row21 0.0 row184 0.009\nlyr 1 Proj row_sink frac 0.009 FC col_sink frac 0.005\nlyr 2 M tot 9145.8 frac j_sink 0.273 i_sink 0.08 both 0.073\nlyr 2 Wo row_sink frac 0.027 row21 0.001 row184 0.01\nlyr 2 Proj row_sink frac 0.013 FC col_sink frac 0.006\nlyr 3 M tot 4526.8 frac j_sink 0.088 i_sink 0.037 both 0.025\nlyr 3 Wo row_sink frac 0.107 row21 0.064 row184 0.01\nlyr 3 Proj row_sink frac 0.056 FC col_sink frac 0.008\ndone\n"}
{"t": 1793697850.496448, "s": 0.08, "code": "import numpy as np\nz = np.load('blocks.npz')\nfor lyr, neur in [(0,1514),(1,1139),(2,963),(3,1155)]:\n    fc = z['W_fc.'+str(lyr)].astype(np.float64)\n    proj = z['W_proj.'+str(lyr)].astype(np.float64)\n    row = fc[neur]\n    col = proj[:,neur]\n    # where does row read from? top input dims\n    top_in = np.argsort(-np.abs(row))[:8]\n    print('L'+str(lyr)+' neur'+str(neur)+' FC reads', top_in.tolist(), [round(float(row[i]),3) for i in top_in])\n    # where does col write to? top output dims\n    top_out = np.argsort(-np.abs(col))[:8]\n    print('L'+str(lyr)+' neur'+str(neur)+' Proj writes', top_out.tolist(), [round(float(col[i]),3) for i in top_out], 'norm', round(float(np.sqrt((col**2).sum())),3))\n    # is input sink or content? compare to V dims 211 etc vs sink 21 etc\n    print(' read 21',round(float(row[21]),3),'39',round(float(row[39]),3),'58',round(float(row[58]),3),'99',round(float(row[99]),3),'184',round(float(row[184]),3))\n    print(' write 21',round(float(col[21]),3),'39',round(float(col[39]),3),'58',round(float(col[58]),3),'99',round(float(col[99]),3),'184',round(float(col[184]),3))\nprint('done')\n", "out": "L0 neur1514 FC reads [369, 289, 218, 213, 134, 333, 156, 308] [-0.838, 0.779, 0.707, -0.666, -0.646, -0.551, -0.55, 0.546]\nL0 neur1514 Proj writes [166, 61, 46, 208, 269, 163, 372, 267] [-0.393, -0.375, 0.369, 0.365, 0.344, 0.332, 0.332, -0.328] norm 2.811\n read 21 -0.029 39 -0.125 58 0.06 99 -0.076 184 -0.29\n write 21 -0.031 39 -0.099 58 0.039 99 0.003 184 -0.045\nL1 neur1139 FC reads [165, 52, 3, 292, 31, 18, 372, 101] [-0.654, 0.645, -0.645, -0.58, -0.463, -0.454, 0.408, -0.404]\nL1 neur1139 Proj writes [184, 266, 21, 63, 99, 39, 58, 383] [2.66, -0.428, 0.273, 0.248, 0.246, 0.223, -0.17, 0.108] norm 2.828\n read 21 0.099 39 -0.299 58 0.317 99 0.066 184 0.324\n write 21 0.273 39 0.223 58 -0.17 99 0.246 184 2.66\nL2 neur963 FC reads [117, 112, 341, 42, 131, 127, 216, 309] [-0.524, 0.439, -0.41, 0.376, 0.373, 0.363, 0.341, 0.326]\nL2 neur963 Proj writes [206, 77, 336, 195, 173, 202, 317, 191] [-0.415, 0.413, -0.395, -0.368, 0.358, -0.341, -0.329, 0.326] norm 2.731\n read 21 -0.017 39 -0.075 58 0.07 99 -0.025 184 -0.011\n write 21 0.037 39 -0.103 58 0.26 99 0.138 184 -0.22\nL3 neur1155 FC reads [79, 53, 47, 161, 93, 359, 27, 370] [-0.413, -0.395, 0.371, -0.358, 0.357, -0.346, -0.337, -0.315]\nL3 neur1155 Proj writes [26, 184, 155, 21, 15, 47, 39, 312] [-0.748, 0.676, 0.657, 0.643, 0.623, 0.616, 0.569, -0.55] norm 3.971\n read 21 0.238 39 -0.15 58 0.042 99 0.074 184 -0.15\n write 21 0.643 39 0.569 58 -0.236 99 0.06 184 0.676\ndone\n"}
{"t": 1793697868.9907231, "s": 0.07, "code": "import numpy as np\nz = np.load('blocks.npz')\nsink = [21,39,58,99,184]\nfor lyr in [1,2,0]:\n    Wq = z['W_q.'+str(lyr)].astype(np.float64)\n    Wk = z['W_k.'+str(lyr)].astype(np.float64)\n    M = Wq.T @ Wk\n    tot = float((M**2).sum())\n    # zero K-sink cols (j in sink) -> what fraction lost?\n    M_nosinkK = M.copy()\n    M_nosinkK[:, sink] = 0\n    tot_nosinkK = float((M_nosinkK**2).sum())\n    print('lyr',lyr,'M tot',round(tot,1),'wo Ksink',round(tot_nosinkK,1),'frac lost',round(1-tot_nosinkK/max(tot,1e-9),3))\n    # zero Q-sink rows (i in sink)\n    M_nosinkQ = M.copy()\n    M_nosinkQ[sink, :] = 0\n    print('lyr',lyr,'wo Qsink frac lost',round(1-float((M_nosinkQ**2).sum())/max(tot,1e-9),3))\n    # clip single largest M entry?\n    am = np.abs(M)\n    k = int(np.argmax(am))\n    print('lyr',lyr,'max M', round(float(M.flat[k]),2), 'at', (k//384,k%384), 'frac of energy', round(float(M.flat[k]**2)/max(tot,1e-9),4))\n# O ablation: zero row21/184?\nfor lyr in [0,3]:\n    Wo = z['W_o.'+str(lyr)].astype(np.float64)\n    tot = float((Wo**2).sum())\n    for r in [21,184,39]:\n        print('lyr',lyr,'Wo zero row',r,'frac lost',round(float((Wo[r]**2).sum())/tot,4))\nprint('done')\n", "out": "lyr 1 M tot 30963.8 wo Ksink 13452.8 frac lost 0.566\nlyr 1 wo Qsink frac lost 0.067\nlyr 1 max M -17.26 at (184, 21) frac of energy 0.0096\nlyr 2 M tot 9145.8 wo Ksink 6652.3 frac lost 0.273\nlyr 2 wo Qsink frac lost 0.08\nlyr 2 max M -13.46 at (39, 21) frac of energy 0.0198\nlyr 0 M tot 1412.0 wo Ksink 1380.7 frac lost 0.022\nlyr 0 wo Qsink frac lost 0.02\nlyr 0 max M 0.67 at (256, 175) frac of energy 0.0003\nlyr 0 Wo zero row 21 frac lost 0.1333\nlyr 0 Wo zero row 184 frac lost 0.0171\nlyr 0 Wo zero row 39 frac lost 0.1005\nlyr 3 Wo zero row 21 frac lost 0.0637\nlyr 3 Wo zero row 184 frac lost 0.0097\nlyr 3 Wo zero row 39 frac lost 0.0179\ndone\n"}
