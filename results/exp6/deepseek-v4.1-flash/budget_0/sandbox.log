{"t": 1793692556.5299048, "s": 0.05, "code": "import numpy as np\n\n# load zero arrays and work on copies\nL1W = load('L1.W').copy()\nL1b = load('L1.b').copy()\nL2W = load('L2.W').copy()\nL2b = load('L2.b').copy()\nL3W = load('L3.W').copy()\nL3b = load('L3.b').copy()\nL4W = load('L4.W').copy()\nL4b = load('L4.b').copy()\nL5W = load('L5.W').copy()\nL5b = load('L5.b').copy()\nL6W = load('L6.W').copy()\nL6b = load('L6.b').copy()\noutW = load('out.W').copy()\noutb = load('out.b').copy()\n\n# helper\ndef uid(p, c):\n    return p * 6 + c\n\ndef neighbors(p):\n    r, c = divmod(p, 9)\n    ns = []\n    if r > 0: ns.append((r-1)*9+c)\n    if r < 8: ns.append((r+1)*9+c)\n    if c > 0: ns.append(r*9+c-1)\n    if c < 8: ns.append(r*9+c+1)\n    return ns\n\ndef degree(p):\n    return len(neighbors(p))\n\n# positional prior table by sorted distances to nearest edges\ntable = {\n    (0,0): -5.0,\n    (0,1): -4.0,\n    (0,2): -3.0,\n    (0,3): -2.5,\n    (0,4): -2.0,\n    (1,1): -0.8,\n    (1,2):  0.0,\n    (1,3):  0.0,\n    (1,4):  0.0,\n    (2,2):  6.0,\n    (2,3):  5.0,\n    (2,4):  4.0,\n    (3,3):  5.0,\n    (3,4):  3.5,\n    (4,4):  4.0,\n}\ndef prior(p):\n    r, c = divmod(p, 9)\n    a, b = min(r, 8-r), min(c, 8-c)\n    x, y = sorted((a, b))\n    return table.get((x, y), 0.0)\n\n# ---------------- Layer 1 ----------------\n# per-point channels:\n# c0 O, c1 X, c2 E, c3 own orth count A, c4 opp orth count B, c5 empty orth count C\nfor p in range(81):\n    r, c = divmod(p, 9)\n    # c0: own occupancy\n    L1W[inp(r,c,0), uid(p,0)] = 1.0\n    # c1: opponent occupancy\n    L1W[inp(r,c,1), uid(p,1)] = 1.0\n    # c2: empty indicator = 1 - O - X\n    L1b[uid(p,2)] = 1.0\n    L1W[inp(r,c,0), uid(p,2)] = -1.0\n    L1W[inp(r,c,1), uid(p,2)] = -1.0\n    # c3: own orth count\n    for q in neighbors(p):\n        qr, qc = divmod(q, 9)\n        L1W[inp(qr,qc,0), uid(p,3)] = 1.0\n    # c4: opponent orth count\n    for q in neighbors(p):\n        qr, qc = divmod(q, 9)\n        L1W[inp(qr,qc,1), uid(p,4)] = 1.0\n    # c5: empty orth count = degree - own_neighbors - opp_neighbors\n    L1b[uid(p,5)] = float(degree(p))\n    for q in neighbors(p):\n        qr, qc = divmod(q, 9)\n        L1W[inp(qr,qc,0), uid(p,5)] = -1.0\n        L1W[inp(qr,qc,1), uid(p,5)] = -1.0\n\n# global channels at layer 1\n# 486 total stones, 487 own stones, 488 opp stones, 489 white-to-move flag\nfor p in range(81):\n    r, c = divmod(p, 9)\n    L1W[inp(r,c,0), 486] += 1.0\n    L1W[inp(r,c,1), 486] += 1.0\n    L1W[inp(r,c,0), 487] += 1.0\n    L1W[inp(r,c,1), 488] += 1.0\n    L1W[inp(r,c,2), 489] += 1.0 / 81.0\n\n# ---------------- Layer 2 ----------------\n# b0 O, b1 X, b2 C, b3 opp_support(C>=2), b4 opp_pressure, b5 own_pressure\nfor p in range(81):\n    # b0, b1, b2 identities\n    L2W[uid(p,0), uid(p,0)] = 1.0\n    L2W[uid(p,1), uid(p,1)] = 1.0\n    L2W[uid(p,5), uid(p,2)] = 1.0  # C from layer1 c5\n    # b3 = relu(10 X + C - 11.5)\n    L2W[uid(p,1), uid(p,3)] = 10.0\n    L2W[uid(p,5), uid(p,3)] = 1.0\n    L2b[uid(p,3)] = -11.5\n    # b4 = relu(10 X - C - 6.5)\n    L2W[uid(p,1), uid(p,4)] = 10.0\n    L2W[uid(p,5), uid(p,4)] = -1.0\n    L2b[uid(p,4)] = -6.5\n    # b5 = relu(10 O - C - 6.5)\n    L2W[uid(p,0), uid(p,5)] = 10.0\n    L2W[uid(p,5), uid(p,5)] = -1.0\n    L2b[uid(p,5)] = -6.5\n\n# preserve globals, add opening-stage globals\nfor u in (486,487,488,489):\n    L2W[u, u] = 1.0\n# G4 = relu(40 - N)\nL2W[486, 490] = -1.0\nL2b[490] = 40.0\n# G5 = relu(30 - N)\nL2W[486, 491] = -1.0\nL2b[491] = 30.0\n# G6 = relu(N - 30)\nL2W[486, 492] = 1.0\nL2b[492] = -30.0\n\n# ---------------- Layer 3 ----------------\n# c0 A, c1 B, c2 C, c3 corrected opp attack, c4 own pressure, c5 own support\nfor p in range(81):\n    # A = sum own occupancy over orth neighbors\n    for q in neighbors(p):\n        L3W[uid(q,0), uid(p,0)] = 1.0\n    # B = sum opp occupancy over orth neighbors\n    for q in neighbors(p):\n        L3W[uid(q,1), uid(p,1)] = 1.0\n    # C\n    L3W[uid(p,2), uid(p,2)] = 1.0\n    # c3 = relu(sum_q [opp_pressure(q) - opp_support(q)])\n    for q in neighbors(p):\n        L3W[uid(q,4), uid(p,3)] = 1.0\n        L3W[uid(q,3), uid(p,3)] = -1.0\n    # c4 = sum own_pressure over orth neighbors\n    for q in neighbors(p):\n        L3W[uid(q,5), uid(p,4)] = 1.0\n    # c5 = relu(sum_q [10*O(q) + C(q) - 11.5])\n    for q in neighbors(p):\n        L3W[uid(q,0), uid(p,5)] = 10.0\n        L3W[uid(q,2), uid(p,5)] = 1.0\n    L3b[uid(p,5)] = -11.5 * degree(p)\n\n# preserve globals 486..492\nfor u in range(486, 493):\n    L3W[u, u] = 1.0\n\n# ---------------- Layer 4 ----------------\n# d0 A, d1 B, d2 C, d3 opp_attack, d4 own_pressure, d5 broad own support\nfor p in range(81):\n    L4W[uid(p,0), uid(p,0)] = 1.0\n    L4W[uid(p,1), uid(p,1)] = 1.0\n    L4W[uid(p,2), uid(p,2)] = 1.0\n    L4W[uid(p,3), uid(p,3)] = 1.0\n    L4W[uid(p,4), uid(p,4)] = 1.0\n    # d5 = c5(p) + 0.5 * sum_{q in N(p)} c5(q)\n    L4W[uid(p,5), uid(p,5)] = 1.0\n    for q in neighbors(p):\n        L4W[uid(q,5), uid(p,5)] = 0.5\n\nfor u in range(486, 493):\n    L4W[u, u] = 1.0\n\n# ---------------- Layer 5 ----------------\n# s0 base, s1 opp attack, s2 own pressure, s3 self-atari penalty,\n# s4 eye-fill penalty, s5 broad own support\nfor p in range(81):\n    # base = 100 + 0.40 A + 0.25 B + 0.30 C\n    L5W[uid(p,0), uid(p,0)] = 0.40\n    L5W[uid(p,1), uid(p,0)] = 0.25\n    L5W[uid(p,2), uid(p,0)] = 0.30\n    L5b[uid(p,0)] = 100.0\n    # s1 = opp_attack\n    L5W[uid(p,3), uid(p,1)] = 1.0\n    # s2 = own_pressure\n    L5W[uid(p,4), uid(p,2)] = 1.0\n    # s3 = relu(1.5 - C - 2*opp_attack - 2*broad support)\n    L5W[uid(p,2), uid(p,3)] = -1.0\n    L5W[uid(p,3), uid(p,3)] = -2.0\n    L5W[uid(p,5), uid(p,3)] = -2.0\n    L5b[uid(p,3)] = 1.5\n    # s4 = relu(A - 2.5 - 5B - 2C - 2*opp_attack)\n    L5W[uid(p,0), uid(p,4)] = 1.0\n    L5W[uid(p,1), uid(p,4)] = -5.0\n    L5W[uid(p,2), uid(p,4)] = -2.0\n    L5W[uid(p,3), uid(p,4)] = -2.0\n    L5b[uid(p,4)] = -2.5\n    # s5 = broad own support\n    L5W[uid(p,5), uid(p,5)] = 1.0\n\nfor u in range(486, 493):\n    L5W[u, u] = 1.0\n\n# ---------------- Layer 6 ----------------\n# identity pass-through of the six per-point components and globals\nfor p in range(81):\n    for c in range(6):\n        L6W[uid(p,c), uid(p,c)] = 1.0\nfor u in range(486, 493):\n    L6W[u, u] = 1.0\n\n# ---------------- Output ----------------\ncoefs = [1.0, 1.5, 1.8, -4.0, -6.0, 0.15]\nfor p in range(81):\n    for c, w in enumerate(coefs):\n        outW[uid(p,c), p] = w\n    outb[p] = prior(p)\n\n# opening-stage positional boost from G4 = relu(40 - N)\nfor p in range(81):\n    outW[490, p] = prior(p) * 0.02\n\n# pass is essentially never preferred unless it is the only legal move\noutb[81] = -1000.0\noutW[:, 81] = 0.0\n\n# save\nsave('L1.W', L1W.astype(np.float32))\nsave('L1.b', L1b.astype(np.float32))\nsave('L2.W', L2W.astype(np.float32))\nsave('L2.b', L2b.astype(np.float32))\nsave('L3.W', L3W.astype(np.float32))\nsave('L3.b', L3b.astype(np.float32))\nsave('L4.W', L4W.astype(np.float32))\nsave('L4.b', L4b.astype(np.float32))\nsave('L5.W', L5W.astype(np.float32))\nsave('L5.b', L5b.astype(np.float32))\nsave('L6.W', L6W.astype(np.float32))\nsave('L6.b', L6b.astype(np.float32))\nsave('out.W', outW.astype(np.float32))\nsave('out.b', outb.astype(np.float32))\n\nprint(\"saved\")\nprint(\"positional prior min/max\", min(prior(p) for p in range(81)), max(prior(p) for p in range(81)))\nprint(\"saved names\", saved())\n", "out": "saved\npositional prior min/max -5.0 6.0\nsaved names ['L1.W', 'L1.b', 'L2.W', 'L2.b', 'L3.W', 'L3.b', 'L4.W', 'L4.b', 'L5.W', 'L5.b', 'L6.W', 'L6.b', 'out.W', 'out.b']\n"}
