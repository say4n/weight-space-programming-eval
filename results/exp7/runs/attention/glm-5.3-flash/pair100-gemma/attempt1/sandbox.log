{"t": 1793706385.6746151, "s": 0.25, "code": "import os, json\ncwd=os.getcwd()\nprint(\"cwd\",cwd)\nfor rel in [\".\",\"case\",\"case/A\",\"case/B\"]:\n    try: print(rel, os.listdir(os.path.join(cwd,rel)))\n    except Exception as e: print(rel, repr(e))\n\ntry:\n    cp=Checkpoint(\"A\")\n    print(\"A config\", json.dumps(cp.config, indent=2)[:10000])\n    print(\"A meta\", json.dumps(cp.metadata, indent=2)[:10000])\n    print(\"A keys\", len(cp.keys()))\n    print([(k, cp.shape(k), cp.info[k].get(\"dtype\")) for k in cp.keys()[:50]])\nexcept Exception as e: print(\"A failed\", repr(e))\n\ntry:\n    ca=Checkpoint(\"B\")\n    print(\"B config\", json.dumps(ca.config, indent=2)[:10000])\n    print(\"B meta\", json.dumps(ca.metadata, indent=2)[:10000])\nexcept Exception as e: print(\"B failed\", repr(e))\n\ntry:\n    for side in [\"A\",\"B\"]:\n        tk=Tokenizer(side)\n        print(\"tok\",side,\"n\",len(tk.id_to_token),\"special\",tk.special)\n        print(\"tokens\",[(i,tk.token(i),repr(tk.token(i))) for i in sorted(tk.id_to_token)[:20]])\nexcept Exception as e: print(\"tok failed\", repr(e))\n", "out": "cwd /Users/sayan/Projects/weight-space-programming/results/exp7/runs/attention/glm-5.3-flash/pair100-gemma/attempt1/work\n. ['case']\ncase ['A', 'B']\ncase/A ['model.safetensors', 'tokenizer_config.json', 'config.json', 'tokenizer.json', 'tok_ids.json', 'chat_template.jinja']\ncase/B ['model.safetensors', 'tokenizer_config.json', 'config.json', 'tokenizer.json', 'tok_ids.json', 'chat_template.jinja']\nA config {\n  \"_sliding_window_pattern\": 6,\n  \"architectures\": [\n    \"Gemma3ForCausalLM\"\n  ],\n  \"attention_bias\": false,\n  \"attention_dropout\": 0.0,\n  \"attn_logit_softcapping\": null,\n  \"bos_token_id\": 2,\n  \"dtype\": \"float32\",\n  \"eos_token_id\": 1,\n  \"final_logit_softcapping\": null,\n  \"head_dim\": 256,\n  \"hidden_activation\": \"gelu_pytorch_tanh\",\n  \"hidden_size\": 640,\n  \"initializer_range\": 0.02,\n  \"intermediate_size\": 