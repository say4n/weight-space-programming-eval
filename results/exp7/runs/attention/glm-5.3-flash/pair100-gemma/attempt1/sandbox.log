{"t": 1793706216.6410828, "s": 0.07, "code": "import os, re, json, struct, glob, math\nimport numpy as np\n\nhere = os.getcwd()\nprint(\"cwd:\", here)\n\ncas = None\nfor c in [os.path.join(here, \"case\"), os.path.join(here, \"..\", \"case\"),\n          os.path.join(here, \"..\", \"..\", \"case\"), \"case\", \"../case\", \"../../case\"]:\n    if os.path.isdir(os.path.join(c, \"A\")) and os.path.isdir(os.path.join(c, \"B\")):\n        cas = os.path.abspath(c); break\nprint(\"CASE:\", cas)\nif cas is None:\n    print(\"cwd contents:\", sorted(os.listdir(here)))\n    raise SystemExit(1)\n\n# prelude introspection (informational only)\ninit = set(globals().keys())\nprel = sorted(n for n in init if not n.startswith(\"_\")\n              and n not in (\"os\",\"re\",\"json\",\"struct\",\"glob\",\"math\",\"np\"))\nprint(\"prelude symbols:\", prel)\n\nclass SF:\n    \"\"\"lazy safetensors reader\"\"\"\n    def __init__(self, folder):\n        ps = sorted(glob.glob(os.path.join(folder, \"*.safetensors\")))\n        if not ps: raise FileNotFoundError(folder)\n        self.ix = {}\n        for p in ps:\n            with open(p, \"rb\") as f:\n                hl = struct.unpack(\"<Q\", f.read(8))[0]\n                hdr = json.loads(f.read(hl).decode(\"utf-8\"))\n            for k, v in hdr.items():\n                if k != \"__metadata__\": self.ix[k] = (p, hl, v)\n    def tensor(self, name, f32=True):\n        p, hl, ent = self.ix[name]\n        dt, shp, (s, e) = ent[\"dtype\"], ent[\"shape\"], ent[\"data_offsets\"]\n        with open(p, \"rb\") as f:\n            f.seek(8 + hl + s); buf = f.read(e - s)\n        if dt == \"BF16\":\n            u = np.frombuffer(buf, dtype=np.uint16).astype(np.uint32) << 16\n            a = u.view(np.float32)\n        elif dt == \"F32\": a = np.frombuffer(buf, dtype=np.float32)\n        elif dt == \"F16\": a = np.frombuffer(buf, dtype=np.float16)\n        else: raise ValueError(dt)\n        a = a.reshape(shp)\n        return a.astype(np.float32) if f32 else a\n\ndef raw_equal(name, sfA, sfB):\n    pa, hla, ea = sfA.ix[name]; pb, hlb, eb = sfB.ix[name]\n    if ea[\"dtype\"] != eb[\"dtype\"] or ea[\"shape\"] != eb[\"shape\"]: return False\n    n = ea[\"data_offsets\"][1] - ea[\"data_offsets\"][0]\n    CH = 1 << 22\n    with open(pa, \"rb\") as fa, open(pb, \"rb\") as fb:\n        fa.seek(8 + hla + ea[\"data_offsets\"][0]); fb.seek(8 + hlb + eb[\"data_offsets\"][0])\n        while n > 0:\n            k = min(CH, n)\n            if fa.read(k) != fb.read(k): return False\n            n -= k\n    return True\n\ndef l2(a):\n    x = np.asarray(a, dtype=np.float32).ravel()\n    return float(np.sqrt(np.dot(x, x)))\ndef layer_of(k):\n    m = re.search(r\"layers\\.(\\d+)\\.\", k)\n    return int(m.group(1)) if m else -1\ndef part_of(k):\n    if \".self_attn.\" in k: return \"attn\"\n    if \".mlp.\" in k: return \"mlp\"\n    if \"norm\" in k: return \"norm\"\n    return \"other\"\n\nA = SF(os.path.join(cas, \"A\")); B = SF(os.path.join(cas, \"B\"))\nna, nb = set(A.names()), set(B.names())\nprint(\"keys A:\", len(na), \"B:\", len(nb), \"same:\", na == nb)\n\ncfg = json.load(open(os.path.join(cas, \"A\", \"config.json\")))\nfor k in [\"model_type\",\"hidden_size\",\"num_hidden_layers\",\"num_attention_heads\",\n          \"num_key_value_heads\",\"head_dim\",\"intermediate_size\",\"vocab_size\",\n          \"tie_word_embeddings\",\"max_position_embeddings\"]:\n    if k in cfg: print(\"config:\", k, \"=\", cfg[k])\nprint(\"files in A:\", sorted(os.listdir(os.path.join(cas, \"A\"))))\n\nemb_keys = [k for k in sorted(A.names()) if \"embed_tokens\" in k or \"lm_head\" in k]\nfor k in emb_keys:\n    print(\"identical(%s):\" % k, raw_equal(k, A, B))\n\nrows = []\nfor k in sorted(A.names()):\n    if k in emb_keys or \"rotary\" in k or \"inv_freq\" in k: continue\n    try:\n        a = A.tensor(k); b = B.tensor(k)\n        d = a - b\n        an, bn = l2(a), l2(b); dn = l2(d)\n        cosv = float(np.dot(a.ravel(), b.ravel()) / (an * bn + 1e-12))\n        rows.append(dict(k=k, L=layer_of(k), part=part_of(k), shape=list(a.shape),\n                         dn=dn, an=an, bn=bn, rel=dn / (an + 1e-9), cos=cosv))\n    except Exception as e:\n        print(\"ERR on\", k, repr(e))\njson.dump(rows, open(\"metrics1.json\", \"w\"))\n\ntot = {}\nfor r in rows:\n    t = tot.setdefault((r[\"L\"], r[\"part\"]), [0.0, 0.0])\n    t[0] += r[\"dn\"] ** 2; t[1] += r[\"an\"] ** 2\nprint(\"\\n L |  dAttn  baseAttn |  dMLP   baseMLP | dNorm | layerRel%\")\nlay = sorted(set(r[\"L\"] for r in rows))\nfor L in lay:\n    da = tot.get((L,\"attn\"),[0,0]); dm = tot.get((L,\"mlp\"),[0,0]); dno = tot.get((L,\"norm\"),[0,0])\n    dab, bab = math.sqrt(da[0]), math.sqrt(da[1])\n    dmb, bmb = math.sqrt(dm[0]), math.sqrt(dm[1])\n    dnb, bnb = math.sqrt(dno[0]), math.sqrt(dno[1])\n    denom = math.sqrt(bab**2 + bmb**2 + bnb**2)\n    rel = 100 * math.sqrt(dab**2 + dmb**2 + dnb**2) / (denom + 1e-9)\n    print(f\"{L:2d} | {dab:7.3f} {bab:9.2f} | {dmb:7.3f} {bmb:8.2f} | {dnb:5.3f} | {rel:7.2f}\")\ndall = math.sqrt(sum(r[\"dn\"]**2 for r in rows)); aall = math.sqrt(sum(r[\"an\"]**2 for r in rows))\nball = math.sqrt(sum(r[\"bn\"]**2 for r in rows))\nprint(f\"TOTALS: |Delta|={dall:.3f}  |A|={aall:.2f} |B|={ball:.2f}\")\n\nprint(\"\\n== top 20 tensors by |B-A| ==\")\nfor r in sorted(rows, key=lambda r: -r[\"dn\"])[:20]:\n    print(f\"{r['k'][:46]:<46} d={r['dn']:8.3f} rel={100*r['rel']:6.2f}% cosAB={r['cos']:+.3f}\")\nprint(\"\\n== top 12 by relative change ==\")\nsel = [r for r in rows if r[\"an\"] > 0.05]\nfor r in sorted(sel, key=lambda r: -r[\"rel\"])[:12]:\n    print(f\"{r['k'][:46]:<46} rel={100*r['rel']:7.2f}% d={r['dn']:8.3f} cosAB={r['cos']:+.3f}\")\nprint(\"\\n== 8 tensors with lowest A<->B cosine (most model-specific drift) ==\")\nfor r in sorted(sel, key=lambda r: r[\"cos\"])[:8]:\n    print(f\"{r['k'][:46]:<46} cos={r['cos']:+.3f} d={r['dn']:8.3f} rel={100*r['rel']:6.2f}%\")\n", "out": "cwd: /Users/sayan/Projects/weight-space-programming/results/exp7/runs/attention/glm-5.3-flash/pair100-gemma/attempt1/work\nCASE: /Users/sayan/Projects/weight-space-programming/results/exp7/runs/attention/glm-5.3-flash/pair100-gemma/attempt1/work/case\nprelude symbols: ['Checkpoint', 'Tokenizer', 'c', 'cas', 'here']\n\n[stderr]\nTraceback (most recent call last):\n  File \"<string>\", line 137, in <module>\nAttributeError: 'SF' object has no attribute 'names'\n"}
