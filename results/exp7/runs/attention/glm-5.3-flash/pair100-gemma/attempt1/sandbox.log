{"t": 1793706301.155285, "s": 0.07, "code": "import os, sys, pathlib, inspect, traceback\n\nprint(\"CWD\", os.getcwd())\nprint(\"ARGV\", sys.argv)\n\nprint(\"\\n--- PRELUDE TYPES ---\")\nfor name in [\"Checkpoint\", \"Tokenizer\", \"c\", \"cas\", \"here\"]:\n    try:\n        value = globals()[name]\n        print(name, type(value), repr(value)[:500])\n    except Exception:\n        print(name, \"MISSING\")\n\nprint(\"\\n--- FILE TREE ---\")\nroot = pathlib.Path(\".\")\nfor p in sorted(root.rglob(\"*\")):\n    if p.is_file():\n        print(p, p.stat().st_size)\n\nprint(\"\\n--- FILE CONTENTS ---\")\nfor p in sorted(root.rglob(\"*\")):\n    if p.is_file() and p.suffix in {\n        \".md\", \".txt\", \".py\", \".json\", \".yaml\", \".yml\", \".toml\", \".cfg\", \".ini\"\n    }:\n        print(f\"\\n===== {p} =====\")\n        try:\n            text = p.read_text(errors=\"replace\")\n            print(text[:50000])\n        except Exception as e:\n            print(\"ERROR\", repr(e))\n", "out": "CWD /Users/sayan/Projects/weight-space-programming/results/exp7/runs/attention/glm-5.3-flash/pair100-gemma/attempt1/work\nARGV ['-c']\n\n--- PRELUDE TYPES ---\nCheckpoint <class 'type'> <class '__main__.Checkpoint'>\nTokenizer <class 'type'> <class '__main__.Tokenizer'>\nc MISSING\ncas MISSING\nhere MISSING\n\n--- FILE TREE ---\n\n--- FILE CONTENTS ---\n"}
{"t": 1793706319.21997, "s": 0.07, "code": "import sys, inspect, pprint\n\nprint(\"GLOBALS\")\npprint.pprint([k for k in globals() if not k.startswith(\"__\")])\n\nfor name in [\"Checkpoint\", \"Tokenizer\"]:\n    obj = globals().get(name)\n    print(f\"\\n===== {name} =====\")\n    print(\"repr:\", repr(obj))\n    print(\"module:\", getattr(obj, \"__module__\", None))\n    print(\"doc:\", inspect.getdoc(obj))\n    print(\"mro:\", [x.__name__ for x in getattr(obj, \"__mro__\", [])])\n    print(\"annotations:\", getattr(obj, \"__annotations__\", None))\n    print(\"dict keys:\", list(getattr(obj, \"__dict__\", {}).keys()))\n    print(\"dir:\", dir(obj))\n    try:\n        print(\"source:\")\n        print(inspect.getsource(obj))\n    except Exception as e:\n        print(\"no source:\", repr(e))\n\nprint(\"\\nSECTION SOURCES\")\ntry:\n    print(inspect.getsource(Checkpoint.__init__))\nexcept Exception as e:\n    print(\"CP init unavailable:\", repr(e))\ntry:\n    print(inspect.getsource(Tokenizer.__init__))\nexcept Exception as e:\n    print(\"Tokenizer init unavailable:\", repr(e))\ntry:\n    print(inspect.getsource(Checkpoint.load))\nexcept Exception as e:\n    print(\"Checkpoint.load unavailable:\", repr(e))\n\nprint(\"\\nLOADED MODULES\")\npprint.pprint(sorted([m for m in sys.modules if \"case\" in m or \"checkpoint\" in m or \"tokenizer\" in m]))\n", "out": "GLOBALS\n['json',\n 'os',\n 're',\n 'struct',\n 'np',\n 'Checkpoint',\n 'Tokenizer',\n 'sys',\n 'inspect',\n 'pprint']\n\n===== Checkpoint =====\nrepr: <class '__main__.Checkpoint'>\nmodule: __main__\ndoc: One checkpoint folder, case/A or case/B; tensors read lazily.\nmro: ['Checkpoint', 'object']\nannotations: {}\ndict keys: ['__module__', '__doc__', '__init__', 'keys', 'shape', 'get', '__dict__', '__weakref__', '__annotations__']\ndir: ['__annotations__', '__class__', '__delattr__', '__dict__', '__dir__', '__doc__', '__eq__', '__format__', '__ge__', '__getattribute__', '__getstate__', '__gt__', '__hash__', '__init__', '__init_subclass__', '__le__', '__lt__', '__module__', '__ne__', '__new__', '__reduce__', '__reduce_ex__', '__repr__', '__setattr__', '__sizeof__', '__str__', '__subclasshook__', '__weakref__', 'get', 'keys', 'shape']\nsource:\nno source: OSError('source code not available')\n\n===== Tokenizer =====\nrepr: <class '__main__.Tokenizer'>\nmodule: __main__\ndoc: Reads the precomputed id->token table (built with the real tokenizer).\nmro: ['Tokenizer', 'object']\nannotations: {}\ndict keys: ['__module__', '__doc__', '__init__', 'token', 'decode', 'text', '__dict__', '__weakref__', '__annotations__']\ndir: ['__annotations__', '__class__', '__delattr__', '__dict__', '__dir__', '__doc__', '__eq__', '__format__', '__ge__', '__getattribute__', '__getstate__', '__gt__', '__hash__', '__init__', '__init_subclass__', '__le__', '__lt__', '__module__', '__ne__', '__new__', '__reduce__', '__reduce_ex__', '__repr__', '__setattr__', '__sizeof__', '__str__', '__subclasshook__', '__weakref__', 'decode', 'text', 'token']\nsource:\nno source: OSError('source code not available')\n\nSECTION SOURCES\nCP init unavailable: OSError('could not get source code')\nTokenizer init unavailable: OSError('could not get source code')\nCheckpoint.load unavailable: AttributeError(\"type object 'Checkpoint' has no attribute 'load'\")\n\nLOADED MODULES\n['re._casefix']\n"}
