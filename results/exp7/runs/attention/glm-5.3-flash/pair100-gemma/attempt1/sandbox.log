{"t": 1793706801.902535, "s": 0.78, "code": "import collections, numpy as np\na=Checkpoint(\"A\"); b=Checkpoint(\"B\")\nrows=[]\nfor k in a.keys():\n    x=a.get(k); y=b.get(k); d=y-x\n    nx=np.linalg.norm(x.ravel())\n    ny=np.linalg.norm(y.ravel())\n    nd=np.linalg.norm(d.ravel())\n    rho=nd/(nx+1e-30)\n    if nx: rows.append((rho,k,x.shape,nx,nd))\nrows=sorted(rows, reverse=True)[:200]\nfor rho,k,shape,nx,nd in rows: print(f\"{rho:.9f} {k} {shape} normA={nx:.6g} diff={nd:.6g}\")\nprint(\"top groups\")\nd=collections.defaultdict(list)\nfor k in a.keys():\n    parts=k.split(\".\")\n    cat=\".\".join(parts[-2:-1])+\".\"+parts[-1]\n    d[cat].append(k)\nfor cat,ks in d.items(): print(cat, sum(np.linalg.norm((b.get(k)-a.get(k)).ravel())**2 for k in ks))\nprint(\"layer totals\")\nd=collections.defaultdict(list)\nfor k in a.keys():\n    if k.startswith(\"model.layers.\"):\n        d[\"model.layers.\"+k.split(\".\")[2]].append(k)\nfor cat,ks in d.items(): print(cat, sum(np.linalg.norm((b.get(k)-a.get(k)).ravel())**2 for k in ks))\n", "out": "0.018544767 model.layers.4.mlp.down_proj.weight (640, 2048) normA=13.9214 diff=0.258169\n0.018265121 model.layers.14.mlp.down_proj.weight (640, 2048) normA=15.3993 diff=0.28127\n0.017202342 model.layers.8.mlp.down_proj.weight (640, 2048) normA=14.8375 diff=0.25524\n0.016829485 model.layers.1.mlp.down_proj.weight (640, 2048) normA=15.5667 diff=0.26198\n0.016610194 model.layers.13.mlp.down_proj.weight (640, 2048) normA=16.576 diff=0.27533\n0.016578548 model.layers.10.mlp.down_proj.weight (640, 2048) normA=15.5782 diff=0.258265\n0.016410820 model.layers.3.mlp.down_proj.weight (640, 2048) normA=15.8841 diff=0.260672\n0.015384793 model.layers.15.mlp.down_proj.weight (640, 2048) normA=18.3507 diff=0.282321\n0.014871523 model.layers.6.mlp.down_proj.weight (640, 2048) normA=17.1081 diff=0.254424\n0.014007878 model.layers.17.mlp.down_proj.weight (640, 2048) normA=18.2639 diff=0.255838\n0.013993155 model.layers.2.mlp.down_proj.weight (640, 