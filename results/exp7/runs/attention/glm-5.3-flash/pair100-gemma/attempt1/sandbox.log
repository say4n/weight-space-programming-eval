ons__', '__builtins__', 'json', 'os', 're', 'struct', 'np', 'Checkpoint', 'Tokenizer', 'dis', 'inspect', 'pprint', 'sys']\n\nLOCAL Checkpoint: type=<class 'type'> repr=\"<class '__main__.Checkpoint'>\"\n\nLOCAL Tokenizer: type=<class 'type'> repr=\"<class '__main__.Tokenizer'>\"\n\nMETHOD INFO\n\n===== Checkpoint =====\n\nmethod: __init__ fn: <function Checkpoint.__init__ at 0x10131f1a0>\nsignature: (self, side)\ndoc: Initialize self.  See help(type(self)) for accurate signature.\ncodevars: ('self', 'side', 'path', 'f', 'n', 'header')\nfreenames: () cellvars: ()\nfileline: <string> 11\n 11           0 RESUME                   0\n\n 12           2 LOAD_GLOBAL              0 (os)\n             12 LOAD_ATTR                2 (path)\n             32 LOAD_ATTR                5 (NULL|self + join)\n             52 LOAD_CONST               1 ('case')\n             54 LOAD_FAST                1 (side)\n             56 CALL                     2\n             64 LOAD_FAST                0 (self)\n             66 STORE_ATTR               3 (dir)\n\n 13          76 LOAD_GLOBAL              0 (os)\n             86 LOAD_ATTR                2 (path)\n            106 LOAD_ATTR                5 (NULL|self + join)\n            126 LOAD_FAST                0 (self)\n            128 LOAD_ATTR                6 (dir)\n            148 LOAD_CONST               2 ('model.safetensors')\n            150 CALL                     2\n            158 STORE_FAST               2 (path)\n\n 14         160 LOAD_GLOBAL              9 (NULL + open)\n            170 LOAD_FAST                2 (path)\n            172 LOAD_CONST               3 ('rb')\n            174 CALL                     2\n            182 BEFORE_WITH\n            184 STORE_FAST               3 (f)\n\n 15         186 LOAD_GLOBAL             11 (NULL + struct)\n            196 LOAD_ATTR               12 (unpack)\n            216 LOAD_CONST               4 ('<Q')\n            218 LOAD_FAST                3 (f)\n            220 LOAD_ATTR