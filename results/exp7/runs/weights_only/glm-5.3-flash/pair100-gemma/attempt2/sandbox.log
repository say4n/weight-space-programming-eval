{"t": 1793707189.388767, "s": 0.54, "code": "import os, json, glob, collections\nimport numpy as np\n\nprint(\"cwd:\", os.getcwd())\nfor d in [\".\", \"..\", \"../..\"]:\n    try: print(d, \"->\", sorted(os.listdir(d))[:24])\n    except Exception as e: print(d, \"err:\", e)\n\ndef find(tag):\n    for p in [f\"case/{tag}\", f\"../case/{tag}\", f\"../../case/{tag}\", tag, f\"./{tag}\", f\"../{tag}\"]:\n        if os.path.isdir(p) and glob.glob(os.path.join(p, \"*.safetensors\")):\n            return p\n    return None\n\nPA, PB = find(\"A\"), find(\"B\")\nif PA is None or PB is None:\n    for root, dirs, files in os.walk(\"..\"):\n        if root.count(os.sep) > 6: dirs[:] = []\n        if glob.glob(os.path.join(root, \"*.safetensors\")): print(\"safetensors found at:\", root)\nprint(\"A dir:\", PA, \"| B dir:\", PB)\n\ndef rd_file(path):\n    with open(path, \"rb\") as f:\n        n = int(np.frombuffer(f.read(8), dtype=\"<u8\")[0])\n        hdr = json.loads(f.read(n).decode()); blob = f.read()\n    out = {}\n    for k, v in hdr.items():\n        if k.startswith(\"__\"): continue\n        s, e = v[\"data_offsets\"]; dt = v[\"dtype\"]\n        if dt == \"BF16\":\n            u = np.frombuffer(blob, np.uint16, (e - s) // 2, s)\n            a = (u.astype(np.uint32) << 16).view(np.float32)\n        elif dt == \"F16\":\n            a = np.frombuffer(blob, np.uint16, (e - s) // 2, s).view(np.float16)\n        elif dt == \"F32\":\n            a = np.frombuffer(blob, np.float32, (e - s) // 4, s)\n        else: raise ValueError(f\"{k}: {dt}\")\n        out[k] = a.reshape(v[\"shape\"]).astype(np.float32)\n    return out\n\ndef load_ckpt(d):\n    out = {}\n    for fp in sorted(glob.glob(os.path.join(d, \"*.safetensors\"))): out.update(rd_file(fp))\n    return out\n\nA, B = load_ckpt(PA), load_ckpt(PB)\nks = sorted(A)\nprint(\"tensors A:\", len(ks), \"B:\", len(B), \"| same key sets:\", set(A) == set(B))\nprint(\"embedding/lm_head keys:\", [k for k in ks if \"embed\" in k or \"lm_head\" in k] or \"none (as expected)\")\nprint(f\"non-embedding params: {sum(np.prod(A[k].shape) for k in ks)/1e6:.1f}M\")\n\ncfgA = json.load(open(os.path.join(PA, \"config.json\")))\ncfgB = json.load(open(os.path.join(PB, \"config.json\")))\nprint(\"configs identical:\", cfgA == cfgB)\nfor kk in [\"hidden_size\",\"num_hidden_layers\",\"num_attention_heads\",\"num_key_value_heads\",\"head_dim\",\"intermediate_size\",\"vocab_size\",\"tie_word_embeddings\",\"rope_theta\",\"rms_norm_eps\"]:\n    if kk in cfgA: print(f\"  {kk} = {cfgA[kk]}\")\nprint(\"attn sample shapes:\", {k.split(\".\")[-2]: tuple(A[k].shape) for k in ks if \"self_attn\" in k} if True else \"\")\n\nrows, tot = [], 0.0\nfor k in ks:\n    a, b = A[k], B[k]; d = b - a\n    nd = float(np.linalg.norm(d)); na = float(np.linalg.norm(a)); nb = float(np.linalg.norm(b))\n    cos = float(np.dot(a.reshape(-1), b.reshape(-1))) / max(na * nb, 1e-30)\n    rows.append((nd, na, nb, cos, k)); tot += nd * nd\nrows.sort(key=lambda r: -r[0])\nprint(f\"\\n||B-A||_F total = {np.sqrt(tot):.4f} | ~zero-delta tensors: {sum(1 for r in rows if r[0] < 1e-6)}/{len(rows)}\")\nprint(\"\\ntop 25 tensors by ||Delta||:\")\nfor nd, na, nb, cos, k in rows[:25]:\n    print(f\"{k[:58]:58s} d={nd:8.4f} |A|={na:8.3f} cos={cos:6.4f} rel={nd/max(na,1e-9):6.3f}\")\nrest = sum(r[0]**2 for r in rows[25:])\nprint(f\"top-25 share of Delta energy: {1 - rest/tot:.1%}\")\n\nprint(\"\\nDelta spectra, top 8 matrices (s_i/sigma0, i<8 | eff.rank (SUMs^2)^2/SUMs^4 | E10,E32 = cum energy share):\")\nfor nd, na, nb, cos, k in rows[:8]:\n    s = np.linalg.svd(B[k] - A[k], compute_uv=False); s = s / s[0]\n    r = (s**2).sum()**2 / (s**4).sum()\n    e10 = float((s[:10]**2).sum() / (s**2).sum()); e32 = float((s[:32]**2).sum() / (s**2).sum())\n    print(f\"{k[:58]:58s} s={np.round(s[:8],3).tolist()} r={r:5.1f} E10={e10:.2f} E32={e32:.2f}\")\n\ndef classify(k):\n    if \"self_attn.q_proj\" in k: return \"q\"\n    if \"self_attn.k_proj\" in k: return \"k\"\n    if \"self_attn.v_proj\" in k: return \"v\"\n    if \"self_attn.o_proj\" in k: return \"o\"\n    if \"mlp.gate\" in k: return \"gate\"\n    if \"mlp.up\" in k: return \"up\"\n    if \"mlp.down\" in k: return \"down\"\n    if \"input_layernorm\" in k: return \"ln_in\"\n    if \"post_attention_layernorm\" in k: return \"ln_post\"\n    if \".q_norm\" in k: return \"qn\"\n    if \".k_norm\" in k: return \"kn\"\n    if k == \"model.norm.weight\": return \"normF\"\n    return \"other\"\n\nacc = {}\nfor nd, na, nb, cos, k in rows:\n    L = int(k.split(\".layers.\")[1].split(\".\")[0]) if \".layers.\" in k else (-1 if k == \"model.norm.weight\" else -2)\n    acc.setdefault(L, collections.defaultdict(float))[classify(k)] += nd**2\nprint(\"\\nper-layer Delta energy map:\")\nprint(\" Lay |   attn |    mlp | breakdown\")\nfor L in sorted(acc):\n    t = acc[L]\n    parts = \" \".join(f\"{c}:{np.sqrt(t[c]):7.3f}\" for c in [\"q\",\"k\",\"v\",\"o\",\"gate\",\"up\",\"down\",\"ln_in\",\"ln_post\",\"qn\",\"kn\",\"normF\"] if c in t)\n    lab = f\"L{L:02d}\" if L >= 0 else (\"Fin\" if L == -1 else \"??\")\n    at = np.sqrt(sum(t.get(c,0) for c in [\"q\",\"k\",\"v\",\"o\"]))\n    ml = np.sqrt(sum(t.get(c,0) for c in [\"gate\",\"up\",\"down\"]))\n    print(f\" {lab} | {at:7.3f} | {ml:7.3f} | {parts}\")\n\nH = cfgA.get(\"num_attention_heads\", 4)\nprint(\"\\nper-head ||Delta|| of q row-blocks / o col-blocks:\")\nprint(\" Lay |      q h0   h1   h2   h3 |      o h0   h1   h2   h3\")\nfor L in sorted(x for x in acc if x >= 0):\n    dq = B[f\"model.layers.{L}.self_attn.q_proj.weight\"] - A[f\"model.layers.{L}.self_attn.q_proj.weight\"]\n    do = B[f\"model.layers.{L}.self_attn.o_proj.weight\"] - A[f\"model.layers.{L}.self_attn.o_proj.weight\"]\n    dh = dq.shape[0] // H\n    qq = [float(np.linalg.norm(dq[i*dh:(i+1)*dh])) for i in range(H)]\n    dh2 = do.shape[1] // H\n    oo = [float(np.linalg.norm(do[:, i*dh2:(i+1)*dh2])) for i in range(H)]\n    print(f\"  {L:02d} |        \" + \" \".join(f\"{x:5.2f}\" for x in qq) + \" |        \" + \" \".join(f\"{x:5.2f}\" for x in oo))\nprint(\"done.\")\n", "out": "cwd: /Users/sayan/Projects/weight-space-programming/results/exp7/runs/weights_only/glm-5.3-flash/pair100-gemma/attempt2/work\n. -> ['case']\n.. err: [Errno 1] Operation not permitted: '..'\n../.. err: [Errno 1] Operation not permitted: '../..'\nA dir: case/A | B dir: case/B\ntensors A: 235 B: 235 | same key sets: True\nembedding/lm_head keys: none (as expected)\nnon-embedding params: 100.3M\nconfigs identical: True\n  hidden_size = 640\n  num_hidden_layers = 18\n  num_attention_heads = 4\n  num_key_value_heads = 1\n  head_dim = 256\n  intermediate_size = 2048\n  vocab_size = 262144\n  tie_word_embeddings = True\n  rms_norm_eps = 1e-06\nattn sample shapes: {'k_norm': (256,), 'k_proj': (256, 640), 'o_proj': (640, 1024), 'q_norm': (256,), 'q_proj': (1024, 640), 'v_proj': (256, 640)}\n\n||B-A||_F total = 2.4429 | ~zero-delta tensors: 31/235\n\ntop 25 tensors by ||Delta||:\nmodel.layers.14.mlp.gate_proj.weight                       d=  0.3010 |A|=  44.674 cos=1.0000 rel= 0.007\nmodel.layers.14.mlp.up_proj.weight                         d=  0.2993 |A|=  44.614 cos=1.0000 rel= 0.007\nmodel.layers.13.mlp.gate_proj.weight                       d=  0.2985 |A|=  44.663 cos=1.0000 rel= 0.007\nmodel.layers.15.mlp.gate_proj.weight                       d=  0.2984 |A|=  44.694 cos=1.0000 rel= 0.007\nmodel.layers.15.mlp.up_proj.weight                         d=  0.2965 |A|=  44.678 cos=1.0000 rel= 0.007\nmodel.layers.12.mlp.gate_proj.weight                       d=  0.2951 |A|=  44.775 cos=1.0000 rel= 0.007\nmodel.layers.13.mlp.up_proj.weight                         d=  0.2945 |A|=  44.582 cos=1.0000 rel= 0.007\nmodel.layers.16.mlp.gate_proj.weight                       d=  0.2909 |A|=  44.587 cos=1.0000 rel= 0.007\nmodel.layers.6.mlp.gate_proj.weight                        d=  0.2909 |A|=  44.714 cos=1.0000 rel= 0.007\nmodel.layers.16.mlp.up_proj.weight                 