{"t": 1793709062.286773, "s": 0.08, "code": "import os, json, struct, pathlib\n\nprint(\"cwd:\", os.getcwd())\nfor root in [\"case/A\", \"case/B\", \"work\", \".\", \"/Users/sayan/Projects/weight-space-programming/results/exp7/runs/weights_only/muse-spark-1.3-contributor/pair100-gemma/attempt2/work\"]:\n    try:\n        print(root, \":\", os.listdir(root)[:50])\n    except Exception as e:\n        print(root, \"ERR\", e)\n\n# config\nfor p in [\"case/A/config.json\", \"case/B/config.json\"]:\n    try:\n        print(\"=\"*80)\n        print(p)\n        with open(p) as f:\n            cfg=json.load(f)\n        print(json.dumps(cfg, indent=2)[:8000])\n    except Exception as e:\n        print(\"ERR\", p, e)\n\ndef read_header(path):\n    with open(path,\"rb\") as f:\n        n=struct.unpack(\"<Q\", f.read(8))[0]\n        h=f.read(n)\n        j=json.loads(h)\n        # data start = 8+n\n        fsize=os.path.getsize(path)\n        return j, n, fsize\n\nfor p in [\"case/A/model.safetensors\", \"case/B/model.safetensors\"]:\n    try:\n        j,n,fsize=read_header(p)\n        print(\"=\"*80)\n        print(p, \"header_len\", n, \"file_size\", fsize)\n        # list keys\n        keys=sorted([k for k in j.keys() if k!=\"__metadata__\"])\n        print(\"num tensors:\", len(keys))\n        print(\"metadata:\", j.get(\"__metadata__\"))\n        for k in keys:\n            print(k, j[k].get(\"dtype\"), j[k].get(\"shape\"), j[k].get(\"data_offsets\"))\n            if len(keys)>200:\n                pass\n        # if many, truncate print already; but show all\n    except Exception as e:\n        import traceback; traceback.print_exc()\n        print(\"ERR\",p,e)\n", "out": "cwd: /Users/sayan/Projects/weight-space-programming/results/exp7/runs/weights_only/muse-spark-1.3-contributor/pair100-gemma/attempt2/work\ncase/A : ['model.safetensors', 'config.json']\ncase/B : ['model.safetensors', 'config.json']\nwork ERR [Errno 2] No such file or directory: 'work'\n. : ['case']\n/User